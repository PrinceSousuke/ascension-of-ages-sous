      "reward_registry_framework.md"
    ]
  },
  "naming_convention": {
    "template": "<age_or_global>_<family_or_theme>_<tier_or_variant>_<class>",
    "classes": [
      "support_bundle",
      "choice_bundle",
      "themed_cache",
      "rare_boss_cache",
      "proof_symbolic"
    ],
    "tiers": ["T0", "T1", "T2", "T3", "T4"]
  },
  "tier_definitions": {
    "T0": {
      "label": "utility_drip",
      "power_ceiling": "tiny_relief_only",
      "disallow": ["age_identity_material_jumps", "late_machine_unlocks"]
    },
    "T1": {
      "label": "meaningful_support",
      "power_ceiling": "one_clear_support_upgrade",
      "disallow": ["branch_completion_by_reward", "high_tier_combat_jackpots"]
    },
    "T2": {
      "label": "strong_themed_cache",
      "power_ceiling": "noticeable_chapter_help_without_lane_skip",
      "disallow": ["full_system_bypass", "cross_age_identity_skip"]
    },
    "T3": {
      "label": "rare_boss_cache",
      "power_ceiling": "exciting_bounded_combat_payoff",
      "disallow": ["guaranteed_late_age_identity_items"]
    },
    "T4": {
      "label": "prestige_capstone_cache",
      "power_ceiling": "high_value_prestige_with_symbolic_weight",
      "disallow": ["early_age_use", "stage_skip_rewards"]
    }
  },
  "crate_pool_structure": {
    "common": {
      "purpose": "routine utility and sustain",
      "contents": ["food", "water", "repair", "basic components", "route aids"]
    },
    "useful": {
      "purpose": "strong branch support",
      "contents": ["starter machines", "routing upgrades", "bounded tools", "storage support"]
    },
    "rare": {
      "purpose": "high-value bounded payoff",
      "contents": ["specialized components", "combat utility", "advanced support pieces"]
    },
    "jackpot": {
      "purpose": "exciting but constrained high-value roll",
      "contents": ["prestige-adjacent bounded highlights", "trophy-side utility"]
    },
    "tier_weights": {
      "T1": { "common": 70, "useful": 30, "rare": 0, "jackpot": 0 },
      "T2": { "common": 45, "useful": 45, "rare": 10, "jackpot": 0 },
      "T3": { "common": 20, "useful": 50, "rare": 25, "jackpot": 5 },
      "T4": { "common": 0, "useful": 35, "rare": 45, "jackpot": 20 }
    }
  },
  "quest_type_policy": {
    "ordinary_build_use": {
      "preferred_classes": ["support_bundle"],
      "tier_range": ["T0", "T1"],
      "proof_preferred": false,
      "allow_choice": false,
      "allow_random_rolls": "low_only"
    },
    "branch_opener": {
      "preferred_classes": ["support_bundle", "choice_bundle"],
      "tier_range": ["T1"],
      "proof_preferred": false,
      "allow_choice": true,
      "allow_random_rolls": "low"
    },
    "first_use_payoff": {
      "preferred_classes": ["support_bundle", "themed_cache"],
      "tier_range": ["T1", "T2"],
      "proof_preferred": false,
      "allow_choice": false,
      "allow_random_rolls": "low"
    },
    "branch_completion": {
      "preferred_classes": ["themed_cache", "choice_bundle"],
      "tier_range": ["T2"],
      "proof_preferred": false,
      "allow_choice": true,
      "allow_random_rolls": "medium"
    },
    "chapter_completion": {
      "preferred_classes": ["themed_cache"],
      "tier_range": ["T2", "T3"],
      "proof_preferred": false,
      "allow_choice": true,
      "allow_random_rolls": "medium"
    },
    "gate_quest": {
      "preferred_classes": ["proof_symbolic", "support_bundle"],
      "tier_range": ["T0", "T1"],
      "proof_preferred": true,
      "allow_choice": false,
      "allow_random_rolls": "none"
    },
    "boss_validator": {
      "preferred_classes": ["proof_symbolic", "rare_boss_cache"],
      "tier_range": ["T3"],
      "proof_preferred": true,
      "allow_choice": false,
      "allow_random_rolls": "medium_to_high"
    },
    "optional_boss_annex": {
      "preferred_classes": ["rare_boss_cache"],
      "tier_range": ["T3", "T4"],
      "proof_preferred": true,
      "allow_choice": true,
      "allow_random_rolls": "high"
    },
    "prestige_capstone": {
      "preferred_classes": ["proof_symbolic", "rare_boss_cache"],
      "tier_range": ["T4"],
      "proof_preferred": true,
      "allow_choice": true,
      "allow_random_rolls": "high"
    }
  },
  "age_identities": {
    "dark_age": {
      "tone": "survival_relief_and_route_support",
      "avoid": ["iron_or_better_identity_drops", "advanced_machine_components"]
    },
    "medieval": {
      "tone": "workshop_relief_and_first_machine_literacy",
      "avoid": ["industrial_specialization_kits", "digital_network_core_skip"]
    },
    "renaissance": {
      "tone": "exploration_dimension_prep_and_bounded_combat_support",
      "avoid": ["full_realm_ladder_unlocks", "late_factory_identity_caches"]
    },
    "industrial_age": {
      "tone": "machine_campus_startup_and_flow_stability",
      "avoid": ["industrial_nuclear_scale_jackpots"]
    },
    "industrial_revolution": {
      "tone": "process_specialization_and_throughput_maturity",
      "avoid": ["nuclear_hazard_identity_items", "space_launch_identity_items"]
    },
    "atomic": {
      "tone": "containment_reactors_hardened_grids_and_strategic_force",
      "avoid": ["offworld_owner_specific_rewards"]
    },
    "space": {
      "tone": "launch_remote_ops_and_offworld_logistics",
      "avoid": ["ascension_only_prestige_identity"]
    },
    "ascension": {
      "tone": "prestige_convergence_and_reliquary_capstones",
      "avoid": ["low_tier_clutter_as_primary_payoff"]
    }
  },
