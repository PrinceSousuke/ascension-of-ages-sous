	]
	quest.2C3F5B7D8E9A1020.quest_subtitle: "Permanent buff library"
	quest.2C3F5B7D8E9A1020.title: "Wild Cabbages"
	quest.2C3F5B7D8E9A1021.quest_desc: [
		"Plant on farmland. Grows in four stages, slightly slower than wheat."
		""
		"Each fully-grown cabbage drops one head plus 1-3 seeds. Slice heads on the cutting board for leaves used in rolls."
