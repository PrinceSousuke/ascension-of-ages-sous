		"Run coal through the coke oven."
		"Coal coke fuels the crude blast furnace."
	]
	quest.3D4F6B8C9E0A0303.quest_subtitle: "Slow-burn fuel from the coke oven."
	quest.3D4F6B8C9E0A0303.title: "Coal Coke"
	quest.3D4F6B8C9E0A0304.quest_desc: [
		"Collect creosote from the coke oven."
		"It turns planks into treated wood."
	]
	quest.3D4F6B8C9E0A0304.quest_subtitle: "Byproduct of coking; used for treated wood."
	quest.3D4F6B8C9E0A0304.title: "Creosote"
