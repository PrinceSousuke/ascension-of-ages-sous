	]
	quest.2C3F5B7D8E9A1030.quest_subtitle: "Smart kitchen book"
	quest.2C3F5B7D8E9A1030.title: "Tomato Sauce"
	quest.2C3F5B7D8E9A1031.quest_desc: [
		"Meat wrapped in cabbage leaves, simmered in the pot until tender."
		""
		"Restores a large chunk of hunger and saturation â€” one of the strongest cheap meals in the chapter. Stacks to 16."
