	quest.2C3F5B7D8E9A1017.quest_subtitle: "Found in savannas"
	quest.2C3F5B7D8E9A1017.title: "Wild Tomatoes"
	quest.2C3F5B7D8E9A1018.quest_desc: [
		"Plant on farmland and wait. Tomato plants grow in two stages."
		""
		"Stage one is a vine â€” place a stake next to it for higher yields. Without a stake, the plant still works but drops fewer tomatoes per harvest."
	]
	quest.2C3F5B7D8E9A1018.title: "Tomato Seeds"
	quest.2C3F5B7D8E9A1019.quest_desc: [
		"The fruit itself â€” edible raw, but better cooked."
		""
		"Base of tomato sauce, ratatouille, pasta dishes, and soups. Stacks to 64, rots slowly in a fridge."
	]
	quest.2C3F5B7D8E9A1019.title: "Tomato"
	quest.2C3F5B7D8E9A1020.quest_desc: [
		"Grows in forest and flower-forest biomes â€” small green bushes hugging the ground."
		""
