	quest.2C3F5B7D8E9A1035.title: "Dumplings"
	quest.2C3F5B7D8E9A1036.quest_desc: [
		"Tomato, cabbage, onion â€” the everyday vegetable stew."
		""
		"Cheap to assemble, restores a full row of hunger."
	]
	quest.2C3F5B7D8E9A1036.title: "Ratatouille"
	quest.2C3F5B7D8E9A1037.quest_desc: [
		"Hot noodles in a savoury broth â€” wheat dough, vegetables, and bone broth in the cooking pot."
		""
		"Easy to mass-produce once the dough chain runs. Restores a large block of hunger and lingering saturation."
	]
	quest.2C3F5B7D8E9A1037.title: "Noodle Soup"
	quest.2C3F5B7D8E9A1038.quest_desc: [
		"Dough plus greens, pan-fried on the skillet."
		""
		"Dry noodles with a cabbage-onion-tomato tumble. Faster to make than noodle soup, cheaper in materials, nearly as filling."
	]
	quest.2C3F5B7D8E9A1038.title: "Vegetable Noodles"
	quest.2C3F5B7D8E9A1039.quest_desc: [
		"Cooked rice tossed with egg and vegetables on a hot skillet."
		""
		"The skillet recipe uses fewer ingredients than the pot version and finishes faster. A staple when the chicken coop is running."
	]
	quest.2C3F5B7D8E9A1039.title: "Fried Rice"
	quest.2C3F5B7D8E9A1040.quest_desc: [
		"A pot that grows a single crop without farmland."
		""
		"Place dirt, plant a seed â€” the pot handles water and light automatically."
	]
	quest.2C3F5B7D8E9A1040.quest_subtitle: "Farming in a block"
	quest.2C3F5B7D8E9A1040.title: "Botany Pot"
	quest.2C3F5B7D8E9A1041.quest_desc: [
		"A botany pot that dumps its yield into a hopper below."
		""
		"Drop seeds in, let them cycle, pipe the output anywhere."
	]
	quest.2C3F5B7D8E9A1041.quest_subtitle: "Hands-off harvesting"
	quest.2C3F5B7D8E9A1041.title: "Hopper Botany Pot"
	quest.2C3F5B7D8E9A1042.quest_desc: [
		"The plain wooden barrel â€” 27 slots, 1 upgrade slot, the storage backbone of this chapter."
		""
		"Tier-upgrade it in-place later without losing contents. Same upgrade slots and same internals as the chest, just a different silhouette."
	]
	quest.2C3F5B7D8E9A1042.title: "Barrel"
	quest.2C3F5B7D8E9A1043.quest_desc: [
		"27 slots, 8 upgrade slots."
		""
		"Chests and barrels share the same upgrade pool â€” one philosophy, two shapes."
	]
	quest.2C3F5B7D8E9A1043.title: "Chest"
	quest.2C3F5B7D8E9A1044.quest_desc: [
		"The empty slot every upgrade starts from."
		""
		"Craft upgrades by surrounding this base with the appropriate materials."
	]
	quest.2C3F5B7D8E9A1044.title: "Upgrade Base"
	quest.2C3F5B7D8E9A1045.quest_desc: [
		"Barrel plated with copper â€” 45 slots, 3 upgrade slots."
		""
		"Roughly double the raw storage of a wooden barrel, with room for filters or a stack upgrade alongside. The first real step up."
	]
	quest.2C3F5B7D8E9A1045.title: "Copper Barrel"
	quest.2C3F5B7D8E9A1046.quest_desc: [
		"Copper-plated chest â€” same 45 slots and 3 upgrade slots as the copper barrel."
		""
		"Pick between chest and barrel by shape: chests lie flat and open with a GUI, barrels stand and auto-feed items placed on top."
	]
	quest.2C3F5B7D8E9A1046.title: "Copper Chest"
	quest.2C3F5B7D8E9A1047.quest_desc: [
		"Iron-plated barrel â€” 72 slots, 5 upgrade slots."
		""
		"The standard early-game bulk storage block. Enough upgrade room for stack + filter + pickup without running out of sockets."
	]
	quest.2C3F5B7D8E9A1047.title: "Iron Barrel"
	quest.2C3F5B7D8E9A1048.quest_desc: [
		"Iron-plated chest â€” 72 slots, 5 upgrade slots, same capacity as the iron barrel."
		""
		"Pair with an iron barrel for full shape coverage. This is the tier most players camp at until late-game, when gold and diamond upgrades open up."
	]
	quest.2C3F5B7D8E9A1048.title: "Iron Chest"
	quest.2C3F5B7D8E9A1049.quest_desc: [
		"Slot into an existing wooden barrel or chest to promote it in-place â€” no inventory loss, no relocating."
		""
		"The upgrade consumes itself on application. Worth it: rebuilding a storage wall by hand is exactly as fun as it sounds."
	]
	quest.2C3F5B7D8E9A1049.quest_subtitle: "Promote without relocating"
	quest.2C3F5B7D8E9A1049.title: "Wood â†’ Copper Upgrade"
	quest.2C3F5B7D8E9A1050.quest_desc: [
		"Bumps a copper-tier barrel or chest up to iron tier without rebuilding."
		""
		"Same in-place upgrade pattern as the wood â†’ copper step. Preserves contents, preserves upgrades, preserves your sanity."
	]
	quest.2C3F5B7D8E9A1050.title: "Copper â†’ Iron Upgrade"
	quest.2C3F5B7D8E9A1051.quest_desc: [
		"&6The Drawer Controller&r â€” one interface for every connected barrel."
		""
		"Link barrels and chests with the Storage IO / Output pair, and the controller becomes a single searchable inventory."
		""
		"This is how you replace a chest wall with a terminal."
	]
	quest.2C3F5B7D8E9A1051.quest_subtitle: "One terminal for all storage"
	quest.2C3F5B7D8E9A1051.title: "&6The Controller&r"
	quest.2C3F5B7D8E9A1052.quest_desc: [
		"Hopper-like block that funnels items into the controller's network."
		""
		"Place adjacent to the controller, or chain through other Storage IO blocks. Whatever hits the IO ends up sorted across every connected barrel."
	]
	quest.2C3F5B7D8E9A1052.title: "Storage IO"
	quest.2C3F5B7D8E9A1053.quest_desc: [
		"Pulls matching items out of the network â€” the reverse of Storage IO."
		""
		"Pair with a filter upgrade on the controller to route specific items into pipes, machines, or the crafter. Think of it as a network faucet."
	]
	quest.2C3F5B7D8E9A1053.title: "Storage Output"
	quest.2C3F5B7D8E9A1054.quest_desc: [
		"Doubles a storage block's stack size. Apply twice for 4x, three times for 8x."
		""
		"Stacks multiplicatively with the block's tier. An iron barrel with three stack upgrades holds 8 stacks of 512 â€” roughly a small chest room compressed into one block."
	]
	quest.2C3F5B7D8E9A1054.quest_subtitle: "Double the stack size"
	quest.2C3F5B7D8E9A1054.title: "Stack Upgrade I"
	quest.2C3F5B7D8E9A1055.quest_desc: [
		"Automatically compacts nuggets â†’ ingots â†’ blocks inside the storage."
		""
		"Saves slot space for metal farms."
	]
	quest.2C3F5B7D8E9A1055.title: "Compacting Upgrade"
	quest.2C3F5B7D8E9A1056.quest_desc: [
		"The barrel eats nearby item drops into its inventory."
		""
		"Great for farms and mob grinders."
	]
	quest.2C3F5B7D8E9A1056.title: "Pickup Upgrade"
	quest.2C3F5B7D8E9A1057.quest_desc: [
		"Whitelist or blacklist what the barrel accepts. Essential for building sorting walls."
		""
		"Right-click the filter in the upgrade slot to configure. Auto-fill filters by dropping an item onto the corresponding slot â€” no typing item IDs by hand."
	]
	quest.2C3F5B7D8E9A1057.title: "Filter Upgrade"
	quest.2C3F5B7D8E9A1058.quest_desc: [
		"Craft directly from a barrel's contents without opening the full inventory."
		""
		"Opens a mini crafting grid inside the storage GUI. Pulls ingredients from the same barrel, so a single storage block becomes a self-contained workshop."
	]
	quest.2C3F5B7D8E9A1058.title: "Crafting Upgrade"
	quest.2C3F5B7D8E9A1059.quest_desc: [
		"Portable storage. 27 slots, worn on the back."
		""
		"Upgrades slot in the same way as barrels."
	]
	quest.2C3F5B7D8E9A1059.quest_subtitle: "Inventory, to go"
	quest.2C3F5B7D8E9A1059.title: "Backpack"
	quest.2C3F5B7D8E9A1060.quest_desc: [
		"The empty socket every backpack upgrade starts from."
		""
		"Surround it with the appropriate materials to craft stack, filter, or pickup upgrades â€” same philosophy as the storage upgrade base, different recipes."
	]
	quest.2C3F5B7D8E9A1060.quest_subtitle: "Aquaculture entry"
	quest.2C3F5B7D8E9A1060.title: "Backpack Upgrade Base"
	quest.2C3F5B7D8E9A1061.quest_desc: [
		"Copper-plated backpack â€” roughly 45 slots, 3 upgrade slots."
		""
		"The first meaningful jump after the plain backpack. Enough upgrade room for a stack upgrade alongside a filter or pickup."
	]
	quest.2C3F5B7D8E9A1061.title: "Copper Backpack"
	quest.2C3F5B7D8E9A1062.quest_desc: [
		"Iron-plated backpack â€” 72 slots, 5 upgrade slots."
		""
		"The sweet spot for early-to-mid exploration. Wear one under your chestplate; the extra inventory pays for itself on the first dungeon run."
	]
	quest.2C3F5B7D8E9A1062.title: "Iron Backpack"
	quest.2C3F5B7D8E9A1063.quest_desc: [
		"The baseline stack upgrade for a backpack â€” doubles stack size per slot."
		""
		"Cheapest of the stack tiers, easiest to craft early. Slot it in before any long expedition; you'll run out of Tier I rooms long before you run out of cave."
	]
	quest.2C3F5B7D8E9A1063.title: "Starter Stack Upgrade"
	quest.2C3F5B7D8E9A1064.quest_desc: [
		"Tier-one stack upgrade â€” multiplies a slot's capacity above the starter upgrade."
		""
		"Each higher tier further multiplies. Chain them in the upgrade slots: a fully stacked backpack can carry more cobblestone than most base storage rooms."
	]
