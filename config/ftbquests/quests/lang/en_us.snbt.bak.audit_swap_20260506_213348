	quest.2C3F5B7D8E9A1031.quest_subtitle: "Appliance integration"
	quest.2C3F5B7D8E9A1031.title: "Cabbage Rolls"
	quest.2C3F5B7D8E9A1032.quest_desc: [
		"Vanilla's stealth vegetable â€” grows from seeds on tilled farmland, taking up a neighbouring block when mature."
		""
