	quest.2C3F5B7D8E9A1021.title: "Cabbage Seeds"
	quest.2C3F5B7D8E9A1022.quest_desc: [
		"A full cabbage head â€” dense, heavy, and worth slicing."
		""
		"Place on a cutting board and right-click with any knife to yield four &acabbage leaves&r, the base of cabbage rolls and raw salads."
	]
	quest.2C3F5B7D8E9A1022.title: "Cabbage"
	quest.2C3F5B7D8E9A1023.quest_desc: [
