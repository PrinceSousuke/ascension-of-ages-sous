		"Learn the recipe once and you will make it by the"
		"hundred before the age is out."
	]
	quest.1B2E4F5A6C7D0102.title: "Andesite Alloy"
	quest.1B2E4F5A6C7D0103.quest_desc: [
		"Teeth meet teeth. Motion becomes transmission."
