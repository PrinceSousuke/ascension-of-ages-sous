	quest.2C3F5B7D8E9A1025.quest_subtitle: "Water-only crop"
	quest.2C3F5B7D8E9A1025.title: "Wild Rice"
	quest.2C3F5B7D8E9A1026.quest_desc: [
		"A full head of rice, ready to thresh into grains."
		""
		"Drops from mature wild rice plants. Break by hand to collect, or use a knife for extra panicles per harvest."
	]
	quest.2C3F5B7D8E9A1026.title: "Rice Panicle"
	quest.2C3F5B7D8E9A1027.quest_desc: [
		"Raw grain, threshed from rice panicles."
		""
		"Cook it in the pot with a bowl for &acooked rice&r, or blend it with eggs and vegetables on the skillet for &afried rice&r. Stacks well, keeps forever."
	]
	quest.2C3F5B7D8E9A1027.title: "Rice"
	quest.2C3F5B7D8E9A1028.quest_desc: [
		"Break the wheat crop at its fully-grown stage for one wheat plus 0-3 seeds."
		""
		"Use it for bread, pasta dough, hay bales, or feeding cows. Nearly every kitchen chain needs wheat somewhere."
	]
	quest.2C3F5B7D8E9A1028.title: "Wheat"
	quest.2C3F5B7D8E9A1029.quest_desc: [
		"Rice in a bowl â€” the cooking pot's most basic recipe."
		""
		"Stacks well, fills the hunger bar fast, and feeds into bigger dishes."
	]
	quest.2C3F5B7D8E9A1029.title: "Cooked Rice"
	quest.2C3F5B7D8E9A1030.quest_desc: [
		"Tomatoes, sugar, and salt simmered together in the pot."
