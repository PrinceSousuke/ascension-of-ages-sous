	chapter_group.080F7BA9FFB8FC07.title: "Otherworldly"
	chapter_group.0B038EB15EBBFD95.title: "The Renaissance"
	chapter_group.12B6640DF4C0DCFE.title: "Dark Ages"
	chapter_group.1A7F0E9D4C22B6F1.title: "Annexes"
	chapter_group.3F77A31B7D30C0AA.title: "Industrial Revolution"
	chapter_group.508B59840C508057.title: "Medieval Times"
	chapter_group.5E42E6B4A7C91D30.title: "Gilded Era"
