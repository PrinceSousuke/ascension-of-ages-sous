	chapter_group.7D28E4AEBC440F10.title: "Atomic Age"
	ftbquests.quests.08CDB6F751995F81.description: ["A &crusty bomb&r from the loot pools of old structures. It explodes. Not much else."]
	ftbquests.quests.0A05779A920E548B.description: [
		"Feed any food item to Hungry Grass. It produces mulch tiered by how good the food was."
		""
		"Get a &6high quality mulch&r — the best tier. Eats for double the hunger of the food you fed the grass."
	]
	ftbquests.quests.0C1D90EE8814578B.description: [
		"Use &dmolten amethyst&r on a &7cobweb&r to create a &5chrysite cobweb&r. Break it to get a &5chrysite string&r."
		""
		"&7(Chrysite strings also drop from killing Gnomes, if you don't feel like making cobwebs.)&r"
	]
	ftbquests.quests.0D5F461A22105BCF.description: [
		"Artifact shards come from suspicious dirt, suspicious red sand, and fossiliferous dirt in catacombs, obelisks, and buried ruins."
		""
		"Collect &b4 artifact shards&r. They assemble into something bigger."
	]
	ftbquests.quests.252ADD929CB55CBF.description: ["Exaustum Alliums produce Energy Balls occasionally. Edible for energy. Fuel for &5stranger things&r."]
	ftbquests.quests.29055EFFDCC6576E.description: [
		"Full adult Yeti — 50 HP, 6 armor, 8 attack. Power Score ~120."
		""
		"Still well under the Medieval gate (Umvuthi at 180), but this is the hardest thing in the snow biomes until then."
	]
	ftbquests.quests.3B1DBEF6FB655D29.description: [
		"Harvest one each of the &6biome-specific&r plants:"
		""
		"&6• Brambleroot&r — deserts, taigas; thorny"
		"&2• Creeper Orchid&r — explosive, stares into your soul"
		"&e• Exaustum Allium&r — isolated deserts; absorbs energy"
		"&7• Hungry Grass&r — makes you insatiably hungry if you touch it ungloved"
		"&a• Sthirn Bush&r — swampy slime-bush, slows anything in contact"
		""
		"&eThe Creep Orchid is used to summon a much later fight. Don't craft the bundle yet.&r"
	]
	ftbquests.quests.451E7BC527C955B7.description: [
		"Harvest one each of the &aoverworld-any&r plants:"
		""
		"&c• Blood Rose&r — thorny, grabs blood from anyone passing"
		"&b• Bubblis&r — grows on beaches, makes its own oxygen"
		"&f• Cloudelion&r — makes a cloud to protect itself"
		"&2• Glow Fungus&r — rocky surfaces"
		"&5• Toxic Cap&r — buried-stem poisonous fungus"
		""
		"&e&oUse the glove. Always.&r"
	]
	ftbquests.quests.49BBE54BCF735A82.description: [
		"The world is older than the iron in your hand. Relics of it lie everywhere — buried in the dirt, tangled in the roots, hiding in the burrows under your feet."
		""
		"Submit &fan iron ingot&r to mark your readiness. Two paths open: the &e&oArchaeologist's&r and the &a&oAlchemist's&r."
	]
	ftbquests.quests.53967D6D1E7151E0.description: [
		"&6Gnome Hat&r — stolen from a gnome. Cosmetic + small buff."
		"&6Gnome Boots&r — removes fall damage when underground."
		""
		"Collect both."
	]
	ftbquests.quests.5570BA2E7BCC50C2.description: [
		"Surround &fgold ingot&r with &aspores&r in a 3x3 crafting grid. One &5Mushroomite Chunk&r."
		""
		"Used in a &e&osmithing upgrade&r — applies to iron tools. No template needed."
	]
	ftbquests.quests.5607E15F448C5DC8.description: ["The core alchemist workstation. Crushes plants and raw ingredients into usable forms."]
	ftbquests.quests.5A2AD14FA6115E35.description: [
		"Crafted from fossil parts — a quiet idol that speeds crop growth for blocks around it."
		""
		"Useful for &2farming bases&r. Place one near your wheat, your potatoes, your sthirn bush."
	]
	ftbquests.quests.649D26540A9A5342.description: [
		"Two consumable totems from the fossil chain:"
		""
		"&5Totem of Souls&r — damages a target and returns some of it as health."
		"&bTotem of Torrents&r — dashes the player forward on land."
	]
	ftbquests.quests.6689B369ECBF5D7C.description: [
		"Smithing upgrade — iron tool + Mushroomite Chunk on a smithing table (no template)."
		""
		"Each tool &5poisons on hit&r with a small chance. Medieval-best."
		""
		"Submit all five: sword, pickaxe, axe, shovel, hoe."
	]
	ftbquests.quests.6A6D060DB1C65C5E.description: ["The &farcheology table&r is the workstation for handling finds. Place shards here. Place the vases. Make it a corner of the base."]
	ftbquests.quests.6D061DBB350F5529.description: [
		"A gnome in its burrow is hostile. 24 HP, 8 armor, small target."
		""
		"Kill one. Take what it drops."
	]
	ftbquests.quests.771A0BD657D158BA.description: [
		"You have the glove, the tools, the tier, the rings, the minions. Everything Medieval about the garden is yours."
		""
		"&e&oThe garden continues into Renaissance. The Gnome King is still in his den. The Spider Queen is still bound. The Frost Army has not yet been summoned.&r"
	]
	ftbquests.quests.7B598669D634519A.description: [
		"Find a &6gnome burrow&r — or make one with a &6gnome shovel&r. Break the burrow walls. Under the dirt is an &6empty burrow block&r."
		""
		"Collect &6one&r."
	]
	ftbquests.quests.7D36D95D74E1588E.description: [
		"The &aAlchemist's Glove&r is the one tool that lets you harvest magical plants without triggering their effects."
		""
		"Blood Rose? It bleeds you. Creep Orchid? Explodes on contact. Toxic Cap? Poisons you. The glove protects."
		""
		"Craft one: &fleather&r + &fwool&r + &5chrysite string&r."
	]
	ftbquests.quests.83C57C2EF37650E3.description: [
		"A music disc. Axolotl - Swings. Found in old structures."
		""
		"&7(Technically Archaeology but you're done curating so here's a little jukebox reward.)&r"
	]
	ftbquests.quests.86A33CCE6B47550B.description: [
		"Baby Yetis and Yetis live in snowy biomes. Antlers drop from both."
		""
		"&e&oDon't craft the antler horn yet — it summons a Renaissance-tier fight.&r"
	]
	ftbquests.quests.8B70783BCA945A87.description: [
		"Every relic brushed. Every plant harvested. Every minion summoned. The Medieval side of both mods is complete."
		""
		"Submit one &dIdentified Artifact&r (the Curator's stamp) and one &6High Quality Mulch&r (the Herbalist's stamp)."
		""
		"&e&oOther ages hold the rest — the diamond brush, the netherite brush, the three bosses, the festive gnome, the philosopher's stone. For now: done.&r"
	]
	ftbquests.quests.9A7E5AC6D9E65C2A.description: [
		"The &firon brush&r is the first real tool of the archaeologist. It turns suspicious blocks into treasure and fossiliferous dirt into bones."
		""
		"The diamond brush is faster. The netherite brush is faster still. Those are paths for later ages. &e&oBrush slow for now.&r"
	]
	ftbquests.quests.9B091E7CF09E54F8.description: [
		"&2Mixed soil&r lets you plant any magical plant on it. &2Mixed soil pot&r lets you grow them indoors."
		""
		"Essential for every magical plant you can't find wild or don't want to travel for."
	]
	ftbquests.quests.9D4FEF50DF6B571E.description: ["A drink made by gnomes. &eSlowness&r and &aHaste&r applied together — slow movement, fast mining."]
	ftbquests.quests.A1D9BC717D925307.description: ["Craft from brambleroot and sticks. A staff weapon — has a chance to summon brambleroot from the ground under whatever you hit."]
	ftbquests.quests.A8EBB14E08505F2F.description: [
		"&aAncient vases&r spawn in the structures in three color variants. Some drop as intact items, some break on their own."
		""
		"Collect &aone of each variant&r."
	]
	ftbquests.quests.AA6C37A232C251A3.description: [
		"Just a gold ring. Base for &e3 Medieval-legal enchanted rings&r coming up."
		""
		"&e&oThree more exist but are gated on Renaissance content.&r"
	]
	ftbquests.quests.AC7341403DA75E63.description: [
		"Each Identified Artifact rolls one of four enchants. The random-with-anti-repeat rule means four identifications should unlock every unique enchant: Penetrating Strike, Sea's Bounty, Soaring Winds, Tunneling."
		""
		"Submit &d4 identified artifacts&r. The diamond brush speeds this up if you're impatient — it's waiting in Renaissance."
		""
		"&e&oThe diamond brush is Renaissance. The netherite brush is IR.&r"
	]
	ftbquests.quests.AFFE5443C3B05BEE.description: [
		"The &6brick fireplace&r is both a comfort block and a ritual site."
		""
		"Cooked things stay warm near it. &2Festive Gnomes&r are summoned by offering cookies or milk on it. The &bFrost Army&r awakens when the &bYeti Antler Horn&r is blown over it."
		""
		"&e&oBoth summons are Renaissance content. Build the block now; use it later.&r"
	]
	ftbquests.quests.B10FBB821DA45320.description: [
		"Collect all three variants:"
		""
		"&7• Raw Mushrooms on a Stick&r — edible, not great"
		"&6• Cooked Mushrooms on a Stick&r — better snack"
		"&e• Golden Mushrooms on a Stick&r — resistance + regen buff; recipe is hidden and scattered around the Overworld"
	]
	ftbquests.quests.B5E2C30100000001.description: [
		"&bOrb of Prophecy&r — the portal key for the &bEternal Starlight&r dimension."
		""
		"Drops from &bThe Gatekeeper&r, pre-spawned at any &bPortal Ruins&r structure in the Overworld. Craftable from 4× &bblue_starlight_crystal_shard&r + 4× glass once you have shards."
		""
		"&eEternal Starlight is fixed eternal night — pack a light source.&r"
	]
	ftbquests.quests.B5E2C30100000001.subtitle: "Open the Eternal Starlight."
	ftbquests.quests.B5E2C30100000001.title: "Orb of Prophecy"
	ftbquests.quests.B5E2C30100000002.description: [
		"Pre-spawned inside every &bPortal Ruins&r structure — plains, forest, desert, jungle, and cold variants."
		""
		"175 HP, 15 ATK, no armor. Drops &borb_of_prophecy&r (100%), &bglimmering_tablet&r, and has chance at &bglistering&r weapons."
	]
	ftbquests.quests.B5E2C30100000002.subtitle: "Portal Ruins mini-boss."
	ftbquests.quests.B5E2C30100000002.title: "The Gatekeeper"
	ftbquests.quests.B5E2C30100000003.description: [
		"Lore book from &bThe Gatekeeper&r's drop table."
		""
		"Reads as context on the &bEternal Starlight&r and its bosses. Worth reading before you commit."
	]
	ftbquests.quests.B5E2C30100000003.title: "Glimmering Tablet"
	ftbquests.quests.B5E2C30100000004.description: [
		"Right-click the &bOrb of Prophecy&r on a live &bPortal Ruins&r frame to activate it — the &bstarlight_portal&r block appears inside the frame."
		""
		"Step through for eternal night across 14 biomes: starlight forest, permafrost, scarlet forest, dark swamp, crystallized desert, and ocean variants. Skylight works. Respawn anchors work."
	]
	ftbquests.quests.B5E2C30100000004.subtitle: "Place one. The dimension opens."
	ftbquests.quests.B5E2C30100000004.title: "Starlight Portal"
	ftbquests.quests.B5E2C30100000005.description: [
		"&bThe Gatekeeper&r drop. One of the &bEternal Starlight&r music discs."
		""
		"Plays on any jukebox. Flavor collectible."
	]
	ftbquests.quests.B5E2C30100000005.title: "Music Disc: Optimized Option"
	ftbquests.quests.B5E2C30100000006.description: [
		"The &bOrb of Prophecy&r is also a spell focus. Hold the orb and right-click while carrying &bmana_crystal&r to cast."
		""
		"Variants (&bblaze&r, &bwater&r, &blunar&r, &bterra&r, &bwind&r, &blight&r) bind to different spells. Experiment."
	]
	ftbquests.quests.B5E2C30100000006.subtitle: "The Orb casts spells."
	ftbquests.quests.B5E2C30100000006.title: "Mana Crystal"
	ftbquests.quests.B5E2C30100000007.description: [
		"Breaks out of &bblue_starlight_crystal&r blocks, ambient across the Starlight dimension."
		""
		"Four shards plus four glass re-crafts an &borb_of_prophecy&r if you lose yours."
	]
	ftbquests.quests.B5E2C30100000007.title: "Blue Starlight Crystal Shard"
	ftbquests.quests.B5E2C30100000008.description: [
		"&bred_starlight_crystal_shard&r — the counterpart to blue, found in the warmer Starlight biomes."
		""
		"Submitting one proves you've explored beyond the portal. The materials region opens next."
	]
	ftbquests.quests.B5E2C30100000008.subtitle: "Region A capstone."
	ftbquests.quests.B5E2C30100000008.title: "Starlit Foothold"
	ftbquests.quests.B5E2C30100000009.description: [
		"Smelted from &braw_aethersent&r, ambient in the Starlight dimension."
		""
		"Feeds the caster path — the &baethersent&r robe set and the &bstarfall_longbow&r."
	]
	ftbquests.quests.B5E2C30100000009.title: "Aethersent Ingot"
	ftbquests.quests.B5E2C3010000000A.description: [
		"Mid-tier Starlight metal. Powers &bamaramber&r tools and the &bamaramber_mask&r."
		""
		"Smelted from &braw_amaramber&r ore."
	]
	ftbquests.quests.B5E2C3010000000A.title: "Amaramber Ingot"
	ftbquests.quests.B5E2C3010000000B.description: [
		"First full-armor Starlight metal. Smelts from &braw_deepsilver&r ore."
		""
		"Feeds the melee branch — helmet, chestplate, leggings, boots, plus the deepsilver tool set."
	]
	ftbquests.quests.B5E2C3010000000B.title: "Deepsilver Ingot"
	ftbquests.quests.B5E2C3010000000C.description: [
		"Breaks out of &bglacite&r ore, exclusive to the &bPermafrost Forest&r biome."
		""
		"Feeds the &bglacite&r armor set plus unique &bglacite_shield&r and &bglacite_arrow&r."
	]
	ftbquests.quests.B5E2C3010000000C.subtitle: "Permafrost Forest exclusive."
	ftbquests.quests.B5E2C3010000000C.title: "Glacite Shard"
	ftbquests.quests.B5E2C3010000000D.description: [
		"Starlight crystalline material. Alternative upgrade path alongside glacite."
		""
		"Pulled from &bthioquartz&r ore in the warmer Starlight biomes."
	]
	ftbquests.quests.B5E2C3010000000D.title: "Thioquartz Shard"
	ftbquests.quests.B5E2C3010000000E.description: [
		"Hot-biome metal. Smelts into a full armor + tool set, including signature &bscythe&r and &bhammer&r variants."
		""
		"Ore pulled from thermal vent regions of the Starlight."
	]
	ftbquests.quests.B5E2C3010000000E.title: "Thermal Springstone Ingot"
	ftbquests.quests.B5E2C3010000000F.description: [
		"Mined in the warmer Starlight biomes."
		""
		"Blasts into &bflowglaze&r — the glassy substrate for every smithing-upgrade tier later in the chapter."
	]
	ftbquests.quests.B5E2C3010000000F.subtitle: "First ore of the smithing-upgrade path."
	ftbquests.quests.B5E2C3010000000F.title: "Raw Flowglaze"
	ftbquests.quests.B5E2C30100000010.description: [
		"Full four-piece robe set: &bcape&r, &bhood&r, &bbottoms&r, &bboots&r. Crafted from &baethersent_ingot&r."
		""
		"&eThe hood is the convergence proof piece later — keep at least one.&r"
	]
	ftbquests.quests.B5E2C30100000010.subtitle: "The caster path."
	ftbquests.quests.B5E2C30100000010.title: "Aethersent Robes"
	ftbquests.quests.B5E2C30100000011.description: [
		"Aethersent-tier ranged weapon. Pairs with &baethersent_arrow&r."
		""
		"The caster branch's answer to the melee flowglaze_sword."
	]
	ftbquests.quests.B5E2C30100000011.title: "Starfall Longbow"
	ftbquests.quests.B5E2C30100000012.description: [
		"Signature arrow for the caster branch. Higher damage and brief glow on impact."
		""
		"Crafted from &baethersent_ingot&r — no flint needed."
	]
	ftbquests.quests.B5E2C30100000012.title: "Aethersent Arrow"
	ftbquests.quests.B5E2C30100000013.description: [
		"Helmet, chestplate, leggings, boots — the first full Starlight armor tier."
		""
		"Crafted from &bdeepsilver_ingot&r. The tier ladder runs glacite → thermal_springstone → starlit_diamond → unrealium."
	]
	ftbquests.quests.B5E2C30100000013.subtitle: "The melee path begins."
	ftbquests.quests.B5E2C30100000013.title: "Deepsilver Armor Set"
	ftbquests.quests.B5E2C30100000014.description: [
		"Ice-themed armor, built from &bglacite_shard&r. Small cold-resist bonus inside Permafrost Forest."
		""
		"&eThe chestplate is the convergence proof piece later — save one.&r"
	]
	ftbquests.quests.B5E2C30100000014.subtitle: "Permafrost survival kit."
	ftbquests.quests.B5E2C30100000014.title: "Glacite Armor Set"
	ftbquests.quests.B5E2C30100000015.description: [
		"Heat-themed mid-tier armor, built from &bthermal_springstone_ingot&r."
		""
		"The ingot also unlocks the unique &bthermal_springstone_scythe&r and &bthermal_springstone_hammer&r."
	]
	ftbquests.quests.B5E2C30100000015.title: "Thermal Springstone Armor Set"
	ftbquests.quests.B5E2C30100000016.description: [
		"Smithing-upgrade armor — apply the &bflowglaze_upgrade_smithing_template&r onto diamond armor with &bstarlit_diamond&r."
		""
		"&ebThe leggings are the convergence proof piece later — keep one.&r"
	]
	ftbquests.quests.B5E2C30100000016.subtitle: "Requires the Flowglaze Template."
	ftbquests.quests.B5E2C30100000016.title: "Starlit Diamond Armor Set"
	ftbquests.quests.B5E2C30100000017.description: [
		"Dungeon-chest-only smithing template. Unlocks the &bflowglaze&r tool and armor tier."
		""
		"&eIf the pack does not ship a template-copy recipe, guard this template carefully. Losing it soft-locks the flowglaze path.&r"
	]
	ftbquests.quests.B5E2C30100000017.subtitle: "Golem Forge + Cursed Garden chests."
	ftbquests.quests.B5E2C30100000017.title: "Flowglaze Upgrade Template"
	ftbquests.quests.B5E2C30100000018.description: [
		"Terminal material of the Region B ore chain. Poured from &braw_flowglaze&r via the full Starlight ore progression."
		""
		"Holding flowglaze is your proof that the spine + both branches are complete. Feeds every smithing-upgrade weapon and armor piece ahead."
	]
	ftbquests.quests.B5E2C30100000018.subtitle: "Region B convergence. Ore chain complete."
	ftbquests.quests.B5E2C30100000018.title: "Starlit Sky Gear"
	ftbquests.quests.B5E2C30100000019.description: [
		"Smithing upgrade — apply &bstarfire_upgrade_smithing_template&r on a hammer with &bstarfire&r."
		""
		"Swings slower than a sword, hits a 3×3 area. Great for mob clearing around boss arenas."
	]
	ftbquests.quests.B5E2C30100000019.title: "Starfire Hammer"
	ftbquests.quests.B5E2C3010000001A.description: [
		"Built from &bcrystal&r ingredients harvested across the Starlight. Two-handed, wide sweep."
		""
		"Bridge weapon — worse than Unrealium, better than Glacite."
	]
	ftbquests.quests.B5E2C3010000001A.title: "Crystal Greatsword"
	ftbquests.quests.B5E2C3010000001B.description: [
		"Fast unique dagger. Each hit drains a sliver of mob HP into your saturation."
		""
		"Three Starlight bosses and an Overworld dragon wait — any order, any mix. &eBut &bsoul_dew&r (Lunar) and &boxidized_golem_steel&r (Golem) are both required for the Unrealium capstone.&r"
	]
	ftbquests.quests.B5E2C3010000001B.subtitle: "Region C entry. Pick your first boss."
	ftbquests.quests.B5E2C3010000001B.title: "Dagger of Hunger"
	ftbquests.quests.B5E2C3010000001C.description: [
		"Find the &bstarlight_golem_spawner&r block inside the &bGolem Forge&r structure."
		""
		"&eExtinguish the energy blocks surrounding the spawner to begin the fight.&r 200 HP, 10 ATK. Drops 8-10× &boxidized_golem_steel_ingot&r, &bforge_armor_trim_smithing_template&r (100%), &benergy_sword&r (75%)."
	]
	ftbquests.quests.B5E2C3010000001C.subtitle: "Puzzle-gated inside the Golem Forge."
	ftbquests.quests.B5E2C3010000001C.title: "Starlight Golem"
	ftbquests.quests.B5E2C3010000001D.description: [
		"&bStarlight Golem&r drop — half of the &bunrealium&r alloy."
		""
		"100%, 8-10 per kill. &bGolem Forge&r chests occasionally hold extra ingots."
	]
	ftbquests.quests.B5E2C3010000001D.title: "Oxidized Golem Steel Ingot"
	ftbquests.quests.B5E2C3010000001E.description: [
		"75% &bStarlight Golem&r drop. Brief stored-charge mechanic on heavy hits."
		""
		"Iconic mid-R5 weapon. Unrealium will outclass it later."
	]
	ftbquests.quests.B5E2C3010000001E.title: "Energy Sword"
	ftbquests.quests.B5E2C3010000001F.description: [
		"Decorative trim — apply on any armor piece with a template-copy workflow."
		""
		"&bStarlight Golem&r drop (100%). Pairs visually with oxidized golem steel."
	]
	ftbquests.quests.B5E2C3010000001F.title: "Forge Armor Trim"
	ftbquests.quests.B5E2C30100000020.description: [
		"Find the &bpermafrost_spawner&r block in the ashen snow layer deep inside the &bPermafrost Forest&r biome."
		""
		"120 HP, 10 ATK. Drops &bcoldsnap&r (100%), 5-12× &boxidized_golem_steel_nugget&r, 12-18× &bfrozen_tube&r."
	]
	ftbquests.quests.B5E2C30100000020.subtitle: "Ashen Snow layer. Permafrost Forest."
	ftbquests.quests.B5E2C30100000020.title: "Permafrost"
	ftbquests.quests.B5E2C30100000021.description: [
		"100% &bPermafrost&r drop. Slow-attacks apply a short freeze, preventing mob regeneration."
		""
		"Stacks with Glacite armor's cold passive."
	]
	ftbquests.quests.B5E2C30100000021.title: "Coldsnap"
	ftbquests.quests.B5E2C30100000022.description: [
		"Spawns dormant in the &bCursed Garden&r structure of the &bScarlet Forest&r biome."
		""
		"&eThe fight does not start until you ignite the monstrosity with flint and steel.&r 200 HP, 12 ATK. Drops &bmoonring_bow&r, &bcrescent_pendant&r, &btwining_armor_trim_smithing_template&r (all 100%), plus 3-4× &bsoul_dew&r — the Unrealium gate."
	]
	ftbquests.quests.B5E2C30100000022.subtitle: "Cursed Garden. Ignite it."
	ftbquests.quests.B5E2C30100000022.title: "Lunar Monstrosity"
	ftbquests.quests.B5E2C30100000023.description: [
		"100% &bLunar Monstrosity&r drop. Shoots bound-light projectiles with innate infinity — no arrows required."
		""
		"Best ranged option before the Unrealium Crossbow."
	]
	ftbquests.quests.B5E2C30100000023.title: "Moonring Bow"
	ftbquests.quests.B5E2C30100000024.description: [
		"100% &bLunar Monstrosity&r drop. Trinket — passive mana regen for Orb spells while worn."
		""
		"Equip in any curios/trinket slot."
	]
	ftbquests.quests.B5E2C30100000024.title: "Crescent Pendant"
	ftbquests.quests.B5E2C30100000025.description: [
		"Decorative armor trim. 100% &bLunar Monstrosity&r drop."
		""
		"Pairs visually with moonring and crescent themed gear."
	]
	ftbquests.quests.B5E2C30100000025.title: "Twining Armor Trim"
	ftbquests.quests.B5E2C30100000026.description: [
		"Carried by &bdragon_guard_sword&r and &bflaming_skeleton_guard&r minions climbing the &bDragon Tower&r."
		""
		"Kill any one guard for their shield. This is your deterministic tower-reach proof — skips the 2% &bancient_trial_key&r RNG."
	]
	ftbquests.quests.B5E2C30100000026.subtitle: "Proof-of-reach: Dragon Tower."
	ftbquests.quests.B5E2C30100000026.title: "Dragon Guard Shield"
	ftbquests.quests.B5E2C30100000027.description: [
		"Natural-spawn flying dragon atop the &bDragon Tower&r. Found in plains, jungle, swamp, savanna, and variant biomes."
		""
		"250 HP, 14 ATK, 15 armor, 1.0 KB resist, flight speed 1.6, follow range 128. &eThe tower is protected by ancient magic — you cannot break blocks to cheese the fight.&r"
		""
		"Drops 8-19× &bdragon_bone&r (armor material) and a &bdragon_skull&r trophy (100%)."
	]
	ftbquests.quests.B5E2C30100000027.subtitle: "1050 PS. Bring ranged."
	ftbquests.quests.B5E2C30100000027.title: "Ashlord, The Infernal Dragon"
	ftbquests.quests.B5E2C30100000028.description: [
		"100% &bAshlord&r drop. Display block."
		""
		"Place it on a pedestal to mark your first Renaissance-era dragon kill."
	]
	ftbquests.quests.B5E2C30100000028.title: "Dragon Skull Trophy"
	ftbquests.quests.B5E2C30100000029.description: [
		"Chestplate (8 bones), leggings (7), boots (4). All crafted from &bdragon_bone&r drops."
		""
		"&eThe set ships without a helmet — pair with an Aethersent hood or a Starlit Diamond helmet.&r"
	]
	ftbquests.quests.B5E2C30100000029.subtitle: "No helmet exists."
	ftbquests.quests.B5E2C30100000029.title: "Dragon Bones Armor"
	ftbquests.quests.B5E2C3010000002A.description: [
		"Rare &bLunar Monstrosity&r drop — 3-4 per kill."
		""
		"Paired with &boxidized_golem_steel_ingot&r in the forge to produce &bunrealium_ingot&r. Hold onto it."
	]
	ftbquests.quests.B5E2C3010000002A.subtitle: "Region C convergence. Gates Unrealium."
	ftbquests.quests.B5E2C3010000002A.title: "Soul Dew"
	ftbquests.quests.B5E2C3010000002B.description: [
		"Dungeon template — unlocks the &bstarfire&r tool tier, pairing with &bstarcore&r and &bblazing_starcore&r."
		""
		"&eSame template-duplication risk as Flowglaze. Guard it if no copy recipe ships.&r"
	]
	ftbquests.quests.B5E2C3010000002B.subtitle: "Same chests as Flowglaze."
	ftbquests.quests.B5E2C3010000002B.title: "Starfire Upgrade Template"
	ftbquests.quests.B5E2C3010000002C.description: [
		"Automation block — continuously grows &bstarlight crystals&r on adjacent &bcinder_brick&r blocks."
		""
		"Needs 8× &btooth_of_hunger&r (drops from &bthirst_walker&r in the Crystallized Desert). Submit both the catalyst and the teeth to prove the farm."
	]
	ftbquests.quests.B5E2C3010000002C.subtitle: "Late-R5 crystal farm."
	ftbquests.quests.B5E2C3010000002C.title: "Crystalborn Catalyst"
	ftbquests.quests.B5E2C3010000002D.description: [
		"Third rung of the star-core ladder. Forged from &bblazing_starcore&r + lunar/dark materials."
		""
		"Feeds the final Unrealium chain."
	]
	ftbquests.quests.B5E2C3010000002D.title: "Eclipse Core"
	ftbquests.quests.B5E2C3010000002E.description: [
		"Heated starcore — intermediate step between &bstarcore&r and &beclipse_core&r."
		""
		"Smelted with blazing components."
	]
	ftbquests.quests.B5E2C3010000002E.title: "Blazing Starcore"
	ftbquests.quests.B5E2C3010000002F.description: [
		"Base Starlight core. Drops from elite Starlight mobs and rare chest loot."
		""
		"First rung of the core ladder. Upgrades into &bblazing_starcore&r then &beclipse_core&r."
	]
	ftbquests.quests.B5E2C3010000002F.title: "Starcore"
	ftbquests.quests.B5E2C30100000030.description: [
		"Requires &bsoul_dew&r (Lunar Monstrosity) and &boxidized_golem_steel_ingot&r (Starlight Golem). No shortcut, no substitution."
		""
		"The endgame Starlight metal. Feeds a full armor + tool set."
	]
	ftbquests.quests.B5E2C30100000030.subtitle: "Dual-boss alloy."
	ftbquests.quests.B5E2C30100000030.title: "Unrealium Ingot"
	ftbquests.quests.B5E2C30100000031.description: [
		"Endgame Starlight melee weapon. Built from &bunrealium_ingot&r."
		""
		"Highest raw damage in the chapter."
	]
	ftbquests.quests.B5E2C30100000031.title: "Unrealium Sword"
	ftbquests.quests.B5E2C30100000032.description: [
		"Endgame Starlight ranged weapon. Built from &bunrealium_ingot&r."
		""
		"Pairs with vanilla or modded arrow tiers — including &baethersent_arrow&r."
	]
	ftbquests.quests.B5E2C30100000032.title: "Unrealium Crossbow"
	ftbquests.quests.B5E2C30100000033.description: [
		"Trinket — passive slow-fall while worn."
		""
		"Rare drop from &bshimmer_lacewing&r in the &bdark_swamp&r biome."
	]
	ftbquests.quests.B5E2C30100000033.title: "Butterfly Wings Amulet"
	ftbquests.quests.B5E2C30100000034.description: [
		"Both boss painting variants. &bEnergized&r is a 50% drop from &bStarlight Golem&r. &bMonstrous&r is a 50% drop from &bLunar Monstrosity&r."
		""
		"Cosmetic-only — no mechanical distinction. Hang them on a wall; the images subtly animate."
	]
	ftbquests.quests.B5E2C30100000034.subtitle: "Trophies from two bosses."
	ftbquests.quests.B5E2C30100000034.title: "Starlit Paintings"
	ftbquests.quests.B5E2C30100000036.description: [
		"Full four-piece armor from &bunrealium_ingot&r. Highest-tier protection available in the Starlight."
		""
		"Pair with &bunrealium_sword&r and &bunrealium_crossbow&r for the complete kit."
	]
	ftbquests.quests.B5E2C30100000036.subtitle: "Endgame Starlight kit."
	ftbquests.quests.B5E2C30100000036.title: "Unrealium Armor Set"
	ftbquests.quests.B5E2C30100000055.description: [
		"&bUnrealium Sickle&r — terminal proof of a dimension conquered, an Overworld dragon slain, and a dual-boss alloy forged."
		""
		"The Fallen Star is yours. The Renaissance forge will remember."
	]
	ftbquests.quests.B5E2C30100000055.subtitle: "Lunar. Golem. Ashlord. Done."
	ftbquests.quests.B5E2C30100000055.title: "The Fallen Star Mastered"
	ftbquests.quests.BE61A94251E15CF9.description: [
		"Four shards combine into an &bUnidentified Artifact&r. The shape suggests something — a cup, a key, a tooth — but the details are worn."
		""
		"&e&oYou will not know what it does until you identify it.&r"
	]
	ftbquests.quests.C0C4CF0A08B752A4.description: [
		"Shows nearby entities through walls. Also &edamages hostile mobs&r in its radius."
		""
		"Mode-switches between displaying all / monsters / animals / players via sneak-interact."
	]
	ftbquests.quests.C11C44BD2DB85242.description: [
		"Rings buff &asurrounding minions&r — only useful once you have summoning staves."
		""
		"&2• Ring of Shining&r — minions glow, easier to find"
		"&c• Ring of Vampirism&r — minions regenerate"
		"&b• Ring of Winds&r — minions gain speed"
		""
		"Craft all three. The other three rings (Flame, Protection, War) are locked behind Nether / Emerald / Spider Queen — later ages."
	]
	ftbquests.quests.CC3B7F82A0405125.description: [
		"&6Fossiliferous dirt&r yields bones when brushed. Seven species are buried under our biomes: chicken, creeper, guardian, ocelot, sheep, villager, wolf."
		""
		"Find and submit &6one head fossil of each species&r. Each has a quiet effect when placed — the wolf scares skeletons, the ocelot scares creepers, the chicken makes you feel lighter, and so on."
		""
		"&e&oThe body blocks exist too and stack with the heads — not required here, but worth collecting.&r"
	]
	ftbquests.quests.D47B05A560FB5962.description: [
		"All eight Medieval-legal summoning staves. Each summons a minion that fights for you:"
		""
		"&aBrown Shroom&r 8/2, &7Spiderling&r ×3 8/2, &cRed Shroom&r 14/4, &bFrozen Shroom&r 14/5, &2Ent&r 18/3 def 10, &6Gnome&r 24/3, &fBaby Yeti&r ×2 20/3, &bYeti&r 50/6."
		""
		"&e&oTwo more staves (Ice Giant Head, Alpha Shroom) are locked behind Renaissance boss drops.&r"
	]
	ftbquests.quests.D6723D01F0285DD7.description: [
		"Drop from the various shroom entities roaming the forests."
		""
		"&a• Mushroom Spores ×4&r — bulk material; feeds into Mushroomite"
		"&6• Glittering Spores ×1&r — upgrades and repairs rare equipment"
	]
	ftbquests.quests.D9D9B7281DC85ACD.description: [
		"Feed &aSthirn Bush&r to a sheep. Keep feeding. Eventually it produces a &dbezoar stone&r."
		""
		"&dRemoves poison effects and applies regeneration.&r Clutch in a pinch."
		""
		"&e&oThere is a stronger version gated behind a Renaissance boss drop.&r"
	]
	ftbquests.quests.DCEF653711EB5553.description: [
		"Use the unidentified artifact. A property reveals itself — &dPenetrating Strike&r, &dSea's Bounty&r, &dSoaring Winds&r, or &dTunneling&r."
		""
		"&e&oEach identification is a random roll.&r The chance of repeats decreases with each unique enchant you have already unlocked."
	]
	ftbquests.quests.E298767E0DD253AC.description: ["Use a glass bottle on a Blood Rose that has blood in it. The rose harvests blood from anyone walking past — yours, mobs', doesn't care."]
	ftbquests.quests.ED68FB27BBB35BD6.description: ["Smelt a &damethyst shard&r in a furnace. Simple as."]
	ftbquests.quests.F3F66779B806533B.description: [
		"Scattered fragments. &7Broken Baby Yeti Staff&r assembles from 2 pieces. &7Broken Spiderling Staff&r from 3."
		""
		"Assembly requires blood — yours or an opponent's, per the old tome."
		""
		"Collect &aone of each broken staff piece&r to prove the chain is active."
	]
	ftbquests.quests.FD59154EF5CC5F57.description: ["Drops from gnomes. Dirt-only but very fast, and &esneak+right-click&r to dig an empty gnome burrow."]
	quest.006C4A84E01B2F63.quest_desc: ["&6Zanite Gemstone&r — purple Aether gem mined deep in the floating islands. The Aether's iron-tier crafting material."]
	quest.006C4A84E01B2F63.quest_subtitle: "Sharper as you chip"
	quest.006C4A84E01B2F63.title: "Zanite Gemstone"
	quest.007C03B468439667.quest_desc: [
		"&5The Slider&r — the Aether's first dungeon boss, locked inside a bronze dungeon. A floating stone block that slides into walls and players."
		""
		"&aRing the bronze gong to start the fight.&r The Slider drops a victory medal and the dungeon's loot."
	]
	quest.007C03B468439667.quest_subtitle: "Stone cube, long room"
	quest.007C03B468439667.title: "Slider Slain"
	quest.0089B6C20C45DDCA.quest_desc: [
		"Upgrade your &6Smeltery to level 5&r — the maximum smeltery tier."
		""
		"&aFull smeltery recipe access.&r"
	]
	quest.00A3AD4BD4EE0FC7.quest_desc: [
		"Build a &6Guard Tower&r — a single-citizen guard post."
		""
		"Cheaper than a Barracks; useful for early-game colony defense."
	]
	quest.00B7F9EBC0426F32.quest_desc: [
		"&6Shadow Berry Jelly&r and &6Blossom Berry Jelly&r — Better End's themed jam-style food items, made from foraged End berries."
		""
		"&aBoth restore hunger with bonus saturation. Carry stacks if you spend serious time exploring End biomes.&r"
	]
	quest.015C2E45368EA657.quest_desc: [
		"The &6Wireless Grid&r is a portable Grid — bind it to your network with a Network Card and access storage from anywhere within the Wireless Transmitter's range."
		""
		"&5The first time you pull from your home base storage while standing in a mine 200 blocks away, it feels like cheating.&r It is, in the best way."
		""
		"&aCharge it at a Charger before each long expedition.&r"
	]
	quest.015C2E45368EA657.quest_subtitle: "Grid in your pocket."
	quest.015C2E45368EA657.title: "Wireless Grid"
	quest.016BFDF187EB3CC9.quest_desc: [
		"&5The Warden Helmet&r is the chapter capstone — a hexagonal-shaped quest gating the chapter's hardest convergence: kill the Warden, the Night Lich, Frostmaw, and the Underworld Knight, then finish the smithing chain."
		""
		"&cFour boss kills. No skipping. The helmet is the proof that you cleared the entire bestiary refugee gauntlet.&r"
		""
		"With the helmet equipped you wear the Deep Dark on your head. Wear it into the Maledictus Vigil and the rest of the Renaissance — it earned its place."
	]
	quest.016BFDF187EB3CC9.quest_subtitle: "Capstone — Warden armor complete."
	quest.016BFDF187EB3CC9.title: "Warden Helmet"
	quest.01E1EF862A35F38D.quest_desc: [
		"&6Flowglaze Upgrade Smithing Template&r — drops from rare Starlight chests and structures. You need this to refine raw flowglaze into the finished material."
		""
		"&cWithout this template, raw flowglaze is just a paperweight.&r Loot it from dungeon chests across the dimension."
	]
	quest.01E1EF862A35F38D.title: "Flowglaze Smithing Template"
	quest.023E6A8D95BDA2C7.quest_desc: ["The &6Soul Rapier&r — Gaze's quick-strike weapon, lighter than the saber with bonus crit chance against soul-bearing mobs."]
	quest.02832BFB312C42BB.quest_desc: [
		"The &6Flaming Ruby Upgrade Template&r — the third-tier BN upgrade, infusing a flaming ruby into already-cincinnasite gear."
		""
		"&5Endgame BN gear.&r Worth the smithing template hunt."
	]
	quest.02832BFB312C42BB.title: "Flaming Ruby Template"
	quest.030EAD87F43B0F51.quest_desc: [
		"&6Crescent Pendant&r — a Curios accessory dropped or crafted from Lunar Monstrosity remains. Slot it in your neck/charm slot for its passive effect."
		""
		"&aA solid mid-game accessory worth keeping equipped through the rest of the Renaissance.&r"
	]
	quest.030EAD87F43B0F51.title: "Crescent Pendant"
	quest.03601260F611D5CA.quest_desc: [
		"&6Processor Binding&r — leather/redstone-flavored binding pad that holds processor components together."
		""
		"&aOne binding per processor recipe. Stockpile alongside silicon.&r"
	]
	quest.03601260F611D5CA.title: "Processor Binding"
	quest.03BA0C965C1D8F75.quest_desc: [
		"Light a Nether portal and step through. The &6Nether&r is the Renaissance's first new dimension — fire, lava, ghasts, and a roster of new mobs from Better Nether, Luminous Nether, and Eternal Nether."
		""
		"&cThis chapter pushes the Nether harder than vanilla.&r Cataclysm bosses, FA forge tier T1 unlock, Mowzie's mobs, and the Wither all live here. Expect a long stay."
	]
	quest.03BA0C965C1D8F75.quest_subtitle: "Ten blocks, one gate"
	quest.03BA0C965C1D8F75.title: "Into the Nether"
	quest.03F30BE6A07068C9.quest_desc: ["The &6Victory Medal&r — Valkyrie Queen drop. Curio that grants stat bonuses for completing dungeon runs."]
	quest.03F30BE6A07068C9.quest_subtitle: "Keep every one"
	quest.03F30BE6A07068C9.title: "Victory Medal"
	quest.047A69DD462922A4.quest_desc: [
		"The &6Crude Scythe&r is Malum's spirit-harvesting tool. Kill a mob with this and instead of normal drops, the soul drops as a spirit shard."
		""
		"&aSpirits are the fuel for Malum rituals.&r Always carry a scythe when farming for souls."
	]
	quest.04C9AC6678A69875.quest_desc: [
		"The &6Golden Blacksmith Gavel&r — T2 of FA's Hephaestus Forge ladder. Unlocks deeper recipes than the iron gavel."
		""
		"&aTier-up note: this only matters if you commit to FA forge progression.&r The gavel ladder maps to age stage gates: T1 Medieval, T2 Renaissance, etc."
	]
	quest.04C9AC6678A69875.quest_subtitle: "FA mastery."
	quest.04C9AC6678A69875.title: "&5The Golden Gavel&r"
	quest.04D3BE769D8F9139.quest_desc: ["The &6Holystone Pickaxe&r — Aether's stone-tier pickaxe, made from holystone (the dimension's white-stone variant)."]
	quest.04D3BE769D8F9139.title: "Holystone Pickaxe"
	quest.04EDCD0B6D653077.quest_desc: [
		"&6Coldsnap&r is Permafrost's signature drop — a chilled blade that carries the boss's freezing aura with every swing."
		""
		"Useful as both a trophy and a working weapon, especially if your build leans into cold-themed effects."
	]
	quest.04EDCD0B6D653077.title: "Coldsnap"
	quest.056D9981DEF27D74.quest_desc: [
		"&6Eternal Pedestal&r (Better End) — a pedestal block found in End structures. Used in Better End's Eternal Crystal mechanics."
		""
		"&aActivate Eternal Crystals on these to enable certain late-End functions.&r"
	]
	quest.061FD91B5F815FFC.quest_desc: [
		"&5The Aeternium Sword&r is the End chapter capstone — Better End's terminal blade, forged from aeternium ingots smelted in the End's purest forges."
		""
		"&5You've completed the End:&r fifteen End Remastered eyes collected, the Ender Dragon slain, and every current End mod's bestiary surveyed. The chapter pays off with a hexagonal capstone that rewards every detour."
		""
		"&aWith this sword in hand, the Renaissance is essentially closed. The Maledictus Vigil can now demand whatever it likes — you have the gear.&r"
	]
	quest.061FD91B5F815FFC.title: "Aeternium Edge"
	quest.061FD91BE0000001.quest_desc: [
		"&5The Ender Guardian&r (Cataclysm) — a Cataclysm boss summoned with the Void Eye. Hits hard, has phases, drops a music disc."
		""
		"&cBring real End-tier gear. The Ender Guardian punishes button-mashing.&r"
	]
	quest.061FD91BE0000001.title: "The Ender Guardian"
	quest.061FD91BE0000003.quest_desc: [
		"&6Void Eye&r (Cataclysm) — a special eye dropped or crafted in the End. Required to summon Cataclysm's Ender Guardian boss."
		""
		"&7Optional but powerful — opens the Cataclysm boss branch.&r"
	]
	quest.061FD91BE0000003.title: "Eye of Void"
	quest.065C715299CFCF28.quest_desc: [
		"The &6Shriek Worm&r is one of the Otherside's three minor predators alongside the Sludge and Sculk Leech. Dives in and out of the ground, attacks from below."
		""
		"One of three kills required for the Warden capstone path. Easy on its own, annoying in numbers."
	]
	quest.065C715299CFCF28.title: "Shriek Worm"
	quest.06A26CE5030BF5DF.quest_desc: ["&6Edelwood Logs&r — twisted, dark trees that grow in haunted biomes. Their wood is the building block for FA's wand and ritual gear."]
	quest.0713486EDCE7D787.quest_desc: [
		"&6Earthrend Gauntlet&r (hold) — re-confirm you still have the gauntlet on hand for the late chapter convergence."
		""
		"&aThis hold-only quest gates the very end of the bestiary chapter, ensuring you didn't sell or lose the gauntlet on the way to Umvuthi.&r"
	]
	quest.07C26C046CDE2507.quest_desc: [
		"Build a &6Crusher&r — the citizen who pulverizes stones, gravel, and ore into dust."
		""
		"Useful crafting intermediate, especially for ore-doubling chains."
	]
	quest.082F612406308078.quest_desc: [
		"The &6Crafting on a Stick&r version of the crafting table — open a 3x3 grid from anywhere in your inventory. No more dropping a crafting block to make a single item in the field."
		""
		"&aLife-changing for early exploration.&r Also unlocks the rest of the on-a-stick lineup: loom, anvil, smithing, etc."
	]
	quest.083C2C410D72EC26.quest_desc: [
		"&6Ultra Importer&r — Cable Tiers' top-tier importer. Effectively instantaneous transfer from a packed inventory."
		""
		"For when 'fast' isn't enough and you need 'this entire chest now.'"
	]
	quest.083C2C410D72EC26.title: "Ultra Importer"
	quest.084EF9CB7FD7C395.quest_desc: [
		"The mushroom skewer ladder: &6Raw&r → &6Cooked&r → &6Golden&r &6Mushrooms on a Stick&r. A food chain themed around the mushroom-loving gnomes."
		""
		"&aGolden version&r grants minor buffs on top of hunger restoration. Eat one before a fight."
	]
	quest.084EF9CB7FD7C395.quest_subtitle: "&oSnack tier: raw, cooked, gold."
	quest.084EF9CB7FD7C395.title: "&6Mushrooms on a Stick"
	quest.085F473094778DCD.quest_desc: [
		"The &6Resource Scroll&r is a MineColonies utility item — right-click on a hut to view its required materials."
		""
		"&aFastest way to know what to deliver to a Builder.&r"
	]
	quest.08A174880BD0C2CB.quest_desc: [
		"The &6Unrealium Sword&r is the terminal Starlight melee weapon. Fast, powerful, and the cleanest upgrade path from any of the earlier sword-class weapons."
		""
		"If you've been swinging the Crystal Greatsword or the Energy Sword, this is the natural next step."
	]
	quest.08A174880BD0C2CB.title: "Unrealium Sword"
	quest.08B35FCEB44F2F03.quest_desc: [
		"The &6Hephaestus Forge T1&r — Forbidden Arcanus's first-tier multiblock forge. Unlocks deeper FA recipes that the gavels alone can't reach."
		""
		"&5T1 maps to Medieval; T2 to Renaissance; T3 to IR; T4 to Gilded; T5 to Atomic.&r Building this is the gateway to the FA endgame."
	]
	quest.08B35FCEB44F2F03.quest_subtitle: "T1 opens rituals, required for progression"
	quest.08B35FCEB44F2F03.title: "&5The Hephaestus Forge&r"
	quest.08CDB6F751995F81.quest_desc: [
		"The &6Bomb&r from Better Archeology — a thrown explosive that breaks blocks and damages mobs in a small radius."
		""
		"&cMines through walls,&r so handy for clearing trail ruins or breaching dungeon doors. Don't blow yourself up."
	]
	quest.08CDB6F751995F81.quest_subtitle: "&oFound, not made."
	quest.08CDB6F751995F81.title: "&cRusty Bomb"
	quest.093204723C800F46.quest_desc: [
		"&6Storage Disk 64k&r — RS's top-tier vanilla disk. 65,536 items. You'll never fill one with regular gameplay."
		""
		"Past this you're into Extra Disks territory."
	]
	quest.093204723C800F46.title: "64k Storage Disk"
	quest.093C52800DAF4913.quest_desc: [
		"A &6Yeti Antler&r — proof you've fought (or scavenged from) one of Alchemists Garden's most dangerous mountain mobs."
		""
		"&cYetis live in cold biomes&r and hit hard. Use the antler to craft yeti staves or as a high-tier reagent."
	]
	quest.093C52800DAF4913.quest_subtitle: "&oFrom the cold."
	quest.093C52800DAF4913.title: "&bYeti Antler"
	quest.097AED7C91033D5E.quest_desc: [
		"&5The threshold of Medieval Times.&r Completing this quest grants the &6medieval times&r stage, unlocking Create's mechanical machinery and the start of real industry."
		""
		"&cThis is the chapter gate.&r The Dark Ages are behind you; from here on, water wheels, cogwheels, and millstones become available."
		""
		"&aWelcome to the second age. Six to go.&r"
	]
	quest.097AED7C91033D5E.quest_subtitle: "Complete the blacksmithing transition to open Medieval Times."
	quest.097AED7C91033D5E.title: "Ready for Machines"
	quest.09B42DE5A859BA0D.quest_desc: [
		"&6King's Shovel&r — Gnome King's drop tool. Excellent shovel with bonus area-clearing properties."
		""
		"&aA real upgrade if you've been digging foundations all chapter.&r"
	]
	quest.09B42DE5A859BA0D.title: "King's Shovel"
	quest.09CA56F0E895545E.quest_desc: [
		"The &5Behemoth&r is Phantasm's signature End mob — a colossal, cattle-like beast that drops Behemoth Meat and Behemoth Steak when killed."
		""
		"&aOne of three convergence mob kills feeding the Ender Triplets fight.&r"
	]
	quest.09CA56F0E895545E.title: "The Behemoth"
	quest.0A05779A920E548B.quest_desc: [
		"&6High Quality Mulch&r is enriched fertilizer made from composted reagents. Boosts plant growth in Alchemists Garden plots."
		""
		"&aThe AG version of bone meal.&r Use sparingly on slow-growing exotic plants."
	]
	quest.0A05779A920E548B.quest_subtitle: "&oKeep feeding the grass."
	quest.0A05779A920E548B.title: "&6King's Feast"
	quest.0A47A8410AC5DDA8.quest_desc: [
		"&6Dragon Bones armor set&r — chestplate, leggings, boots crafted from Infernal Dragon remains. Heavy, fire-resistant, and unmistakably draconic."
		""
		"&7Note: no helmet in this set — pair it with a helm from another set or use the Dragon Skull cosmetically.&r"
	]
	quest.0A47A8410AC5DDA8.title: "Dragon Bones Set"
	quest.0A48ED53F2A5D600.quest_desc: [
		"&6Storage Disk 16k&r — the workhorse RS disk for an established base. 16,384 items per disk."
		""
		"&aBy the time you have a few of these in a drive, the inventory problem is solved.&r"
	]
	quest.0A48ED53F2A5D600.title: "16k Storage Disk"
	quest.0ABD97C61DE42DCF.quest_desc: [
		"&6Queen's Fang&r — Spider Queen's drop weapon. Venomous on hit."
		""
		"&aA novelty melee with poison effects. Carry as a trophy.&r"
	]
	quest.0ABD97C61DE42DCF.quest_subtitle: "Garden capstone"
	quest.0ABD97C61DE42DCF.title: "&2Queen's Fang&r"
	quest.0B009391E3F76D6E.quest_desc: [
		"Build a &6Fisherman's Hut&r — the citizen who fishes a nearby body of water."
		""
		"Steady supply of fish for food and Fishing Guild research."
	]
	quest.0B2F0452BC04A16A.quest_desc: ["&6Moa Fodder&r from Deep Aether — premium feed that boosts moa stats."]
	quest.0B2F0452BC04A16A.title: "Moa Fodder"
	quest.0B8FE04742316372.quest_desc: [
		"&6Resonarium Upgrade Smithing Template&r — applied at a smithing table to lift base tools/weapons up to resonarium tier."
		""
		"&cWithout this template, the resonarium tools you crafted are inert.&r Loot it from Deep Dark structures."
	]
	quest.0B8FE04742316372.quest_subtitle: "Three structures, three chances"
	quest.0B8FE04742316372.title: "Resonarium Upgrade Template"
	quest.0B96EC5055E6B817.quest_desc: [
		"Build &6all Barracks Towers&r — the four corner towers of a fully-fortified Barracks."
		""
		"Maximum colony defensive strength."
	]
	quest.0BB65C0D8FAA6FFA.quest_desc: [
		"The &6Ancient Compass&r is the Otherside dimension's key. It points toward the portal you need to assemble; with it, you cross over. Without it, you stay surface-bound."
		""
		"&cYou cannot reach the Otherside without this compass. No shortcuts.&r"
	]
	quest.0BB65C0D8FAA6FFA.quest_subtitle: "Points to the Otherside"
	quest.0BB65C0D8FAA6FFA.title: "Ancient Compass"
	quest.0C1D90EE8814578B.quest_desc: [
		"&6Chrysite String&r — gold-flecked thread spun from chrysite fibers. Used to bind staves, wrap ring bands, and reinforce the higher-tier alchemy items."
		""
		"&aOne of the rarer reagents.&r Plan ahead before committing it to a recipe."
	]
	quest.0C1D90EE8814578B.quest_subtitle: "&oAlso: kill a gnome. Whatever works."
	quest.0C1D90EE8814578B.title: "&5Chrysite String"
	quest.0C54EDE851B51EFA.quest_desc: ["&5Kill the Aether's deepest boss&r (encounter unlocked through Deep Aether's storm-themed dungeons). Drops the brass dungeon key and stormforged loot."]
	quest.0C54EDE851B51EFA.quest_subtitle: "Head first, segments second"
	quest.0C54EDE851B51EFA.title: "&dEye of the Storm Slain&r"
	quest.0C63DB5E0BA792BA.quest_desc: ["&6Warped Ender Pearl&r — corrupted ender pearl from Eternal Nether. Teleports oddly compared to vanilla; a reagent for warped recipes."]
	quest.0C63DB5E0BA792BA.title: "Warped Ender Pearl"
	quest.0C7D4F4B5EF4FB21.quest_desc: ["The &6Bronze Compass&r — Deep Aether navigator that points toward bronze dungeons in the Aether."]
	quest.0C7D4F4B5EF4FB21.quest_subtitle: "Points to Slider"
	quest.0C7D4F4B5EF4FB21.title: "Bronze Compass"
	quest.0CBBB1EB2144BCB5.quest_desc: [
		"&5The Gatekeeper&r is the doorman of the Starlight — a tall, robed sentinel who appears when you summon him with the Orb of Prophecy. Defeat him and the gateway opens; refuse him and you stay in the overworld forever."
		""
		"This is the entry boss, not the dimension's final challenge. He's tough but not Renaissance-finale tough — bring decent armor and a melee weapon you trust."
		""
		"&cHis attacks hit hard at range; close the distance fast.&r"
	]
	quest.0CBBB1EB2144BCB5.title: "The Gatekeeper"
	quest.0CDEE2F6D9DCA285.quest_desc: [
		"The &6Eternal Obsidian Skull&r — Forbidden Arcanus's curio that prevents lava damage. Crafted from a wither skull and obsidian via FA's recipe chain."
		""
		"&aLava-walking insurance.&r Wear it during deep Nether expeditions and lava lakes lose their teeth."
	]
	quest.0CDEE2F6D9DCA285.quest_subtitle: "Post-Wither prestige."
	quest.0CDEE2F6D9DCA285.title: "Eternal Obsidian Skull"
	quest.0D1584C4C0FE812F.quest_desc: [
		"&6Oxidized Golem Steel Ingot&r — salvaged from the corpse of the Starlight Golem. Tarnished, dense, and humming faintly with leftover energy."
		""
		"Feeds the Energy Sword recipe. The golem drops these in modest quantities, so you may need to farm respawns or trade for them."
	]
	quest.0D1584C4C0FE812F.title: "Oxidized Golem Steel Ingot"
	quest.0D56E3C121A776DF.quest_desc: [
		"Witness a &6citizen resurrection&r — the Undertaker raises a fallen colonist from the dead."
		""
		"&aA literal phoenix-flavored milestone — you've cheated death for one of your people.&r"
	]
	quest.0D5F461A22105BCF.quest_desc: [
		"Four &6Artifact Shards&r — fragments dug up from suspicious blocks. Combine on the archeology table to assemble unidentified artifacts, then identify them for relics."
		""
		"&aShards drop randomly while brushing.&r Stack them up; you'll need plenty for the totem and relic chains."
	]
	quest.0D5F461A22105BCF.quest_subtitle: "&oFour pieces of something lost."
	quest.0D5F461A22105BCF.title: "&bShattered Knowledge"
	quest.0D6E099A1A242153.quest_desc: [
		"The &6Build Tool (Gold Sceptre)&r is Structurize's blueprint placement wand. Right-click to open the build menu; select a schematic; place it in the world."
		""
		"&aThis is how every MineColonies hut gets placed.&r Mass-build pre-designed structures from the schematic library."
	]
	quest.0DCF77FBD06CCE19.quest_desc: [
		"The full &6Malignant Stronghold Armor Set&r — helmet, chestplate, leggings, boots. Malum's late-game heavy armor with curse-flavored bonuses."
		""
		"&5Looks intimidating&r and packs serious defense. Pair with malignant weapons for the dark-side build."
	]
	quest.0EB4D4318675D6D8.quest_desc: [
		"The Gaze &6Norse Rune Set&r: Gymir, Ymir, Fafnir (giants and dragons) plus Out of Phase, Touch of Void, Beyond the Veil, and Blighted Presence — eldritch flavors."
		""
		"&aMix and match&r for a build with crowd-control, pierce, or void-themed bonuses."
	]
	quest.0EBB4E5195610A82.quest_desc: [
		"Build a &6Sawmill&r — the wood-product crafter. Turns logs into planks, sticks, fences, and many wood-shaped products."
		""
		"&aOne of the colony's primary crafting buildings.&r"
	]
	quest.0F19970D8376775F.quest_desc: ["&6Skyroot Water Bucket&r — the Aether's special bucket. Aether water can extinguish fire and is required for portal lighting back to the Overworld."]
	quest.0F19970D8376775F.title: "Skyroot Water Bucket"
	quest.0F409DACBEB7BBF8.quest_desc: [
		"Place a &6Supply Chest Deployer&r — the alternative starter chest kit. Boat-themed, fewer huts but more material supplies."
		""
		"Choose between the camp and chest based on whether you want a faster-built starter or more building materials up front."
	]
	quest.0F5C9B340CAAE375.quest_desc: [
		"The &6External Storage&r treats an external inventory (chest, drawer, barrel) as if it were on the network — items in there are visible and accessible via the Grid."
		""
		"&aBetter than Importer/Exporter pairs when you want a chest to remain user-facing while still being part of the network.&r"
	]
	quest.0F5C9B340CAAE375.title: "External Storage"
	quest.0FCD1C33336AF3AB.quest_desc: [
		"Three decorated &6Vases&r — plain, creeper, and green. Each tells a piece of Better Archeology's worldbuilding."
		""
		"&7Pure decoration.&r Display them on shelves or use them as accent blocks for archeologist-themed builds."
	]
	quest.0FCD1C33336AF3AB.quest_subtitle: "&oThree variants."
	quest.0FCD1C33336AF3AB.title: "&aAncient Vases"
	quest.0FD6F5486176D462.quest_desc: [
		"&6Crystal Shard&r — Phantasm's signature reagent, harvested from crystal blocks throughout the new End biomes."
		""
		"This is the gateway to Phantasm's crystalline tool set, the optional Cataclysm Void Eye, and the Better End filalux wings."
	]
	quest.0FD6F5486176D462.quest_subtitle: "Crystalline tool feedstock."
	quest.0FD6F5486176D462.title: "Crystal Shard"
	quest.0FF97444C4E7CB2A.quest_desc: [
		"&6Soul Star&r — a Bosses of Mass Destruction summoning item used to call the Night Lich. &eDrops automatically after killing 50 undead-type mobs (skeletons, zombies, husks, drowned, phantoms, wither skeletons, strays, zombie villagers, zombified piglins, zoglins, giants, withers, and skeleton/zombie horses)&r — tracked by an internal kill counter. Right-click in the air to release; like an Ender Pearl it points toward the nearest Lich Tower. Place one in each of the four Chiseled Stone Altars on the tower's middle floor to spawn the boss."
		""
		"&aThis is the gate item for the Lich fight. Without four of them seated in the altars, the Lich does not appear.&r"
	]
	quest.0FF97444C4E7CB2A.quest_subtitle: "Summons the Night Lich"
	quest.0FF97444C4E7CB2A.title: "Soul Star"
	quest.0FFA75BE10B19C18.quest_desc: [
		"&6Quartz Enriched Iron&r — the foundation of every Refined Storage component, made by infusing iron ingots with nether quartz."
		""
		"This is the entry point for the &6Inventory Problem&r chapter — finally solving the storage chaos that has been growing since the Dark Ages. RS is more accessible than AE2; you trade some endgame depth for a much faster on-ramp."
		""
		"&aBuild a stack early. You'll burn through it in cables, casings, disks, and grids.&r"
	]
	quest.0FFA75BE10B19C18.quest_subtitle: "Chapter entry digital storage begins."
	quest.0FFA75BE10B19C18.title: "Quartz Enriched Iron"
	quest.1095B36D1CD41A80.quest_desc: [
		"&6Soul Stained Steel Ingot&r — iron infused with captured souls at the spirit crucible. The mid-tier metal of Malum, used for soul-stained tools and armor."
		""
		"&aBetween iron and diamond&r in stats, with a lifesteal-flavored bonus. Worth the soul investment."
	]
	quest.10EB3D7113765AB6.quest_desc: ["&6Mundabitur Dust&r — purifying dust crafted in FA's recipe chain. Used to cleanse cursed items and as a ritual reagent."]
	quest.11C25203906C0FD4.quest_desc: [
		"The &6Greenhouse&r infrastructure from Ecliptic Seasons lets you grow out-of-season crops by controlling temperature and humidity inside an enclosed structure."
		""
		"The &6Thermometer&r and &6Hygrometer&r read environmental conditions, the &6Growth Detector&r monitors crop progress, and the &6Seasonal Prayer Scroll&r is a ritual item for season-shifting magic."
		""
		"&7Optional but powerful — turns farming into year-round production once you've built it.&r"
	]
	quest.11C25203906C0FD4.quest_subtitle: "With seasons, you'll need to have a greenhouse t grow crops that aren't growing year-round. "
	quest.11C25203906C0FD4.title: "Greenhouse"
	quest.11D413E28EF327B6.quest_desc: [
		"The &6Moonring Bow&r is the Lunar Monstrosity's drop weapon — a dark, sinuous bow with a moonlit aesthetic."
		""
		"A second ranged option alongside the Starfall Longbow. Different feel, different stats — try both and pick your favorite."
	]
	quest.11D413E28EF327B6.title: "Moonring Bow"
	quest.120152510AD4B59A.quest_desc: [
		"Wear &6Build Goggles&r — show MineColonies build progress overlays in the world. See exactly what blocks are missing in any in-progress build."
		""
		"&aIndispensable for managing many simultaneous builds.&r"
	]
	quest.1220C6337AACDBC2.quest_desc: [
		"The &6Seidhr&r is a Gaze ritual item — invokes northern witch-magic for a powerful one-shot effect."
		""
		"&5Norse-themed and consumable.&r Save it for moments when you need a big effect now."
	]
	quest.126C053E173AECF9.quest_desc: [
		"The &6Aerwhale Saddle&r — saddle the giant aerial whales of the Aether for long-distance flight."
		""
		"&5The Aether's apex mount.&r Hard to find a wild aerwhale; harder still to tame one."
	]
	quest.126C053E173AECF9.title: "Aerwhale Saddle"
	quest.130E8FC7479E4271.quest_desc: [
		"Build a &6Shepherd's Hut&r — wool from sheep, plus mutton meat."
		""
		"Pair with a Dyer for colored wool products."
	]
	quest.13D66D6A506008F2.quest_desc: [
		"&6Soul Dew&r — the convergence reward of the Starlight's four-boss gauntlet. You've killed the Golem, Permafrost, the Lunar Monstrosity, and the Infernal Dragon. The Dew is what their combined energy crystallizes into."
		""
		"This is the dimension's true mid-late pivot. From here you climb to Starcore, Eclipse Core, and finally Unrealium — the Starlight's endgame metal."
		""
		"&cFour boss fights, no shortcuts. If you skipped any, the dependency chain stays locked.&r"
	]
	quest.13D66D6A506008F2.title: "Soul Dew"
	quest.146472AD229592B5.quest_desc: [
		"The &6Pattern Grid&r is where you author crafting patterns. Write a recipe into a blank pattern; insert that pattern into an Autocrafter; the network can now produce that item on demand."
		""
		"&aThis is the gateway to autocrafting. Every recipe you teach the system here becomes available system-wide.&r"
	]
	quest.146472AD229592B5.quest_subtitle: "Teach the network a recipe."
	quest.146472AD229592B5.title: "Pattern Grid"
	quest.14CF2A9A9C14E0CF.quest_desc: [
		"&6Unrealium Ingot&r — the Starlight's terminal metal. The thing the entire dimension was funneling you toward. Stronger than anything you've crafted before in the Renaissance."
		""
		"Unrealium gear (sword, crossbow, full armor set, sickle) takes you up to and through the Renaissance finale."
		""
		"&aIf you finish the Unrealium tree before Maledictus, you're in good shape for the gate fight.&r"
	]
	quest.14CF2A9A9C14E0CF.title: "Unrealium Ingot"
	quest.14DA3DC7C0009A6A.quest_desc: [
		"Reach a &6colony population of 50&r — substantial settlement size."
		""
		"Mid-game population milestone."
	]
	quest.1502A04F252A9DDB.quest_desc: [
		"The &6Unrealium Crossbow&r is the Starlight's terminal ranged weapon — heavier and more punishing than the Starfall or Moonring bows."
		""
		"Crossbows hold a fired charge so you can pre-load before you turn the corner. Useful against ambush mobs."
	]
	quest.1502A04F252A9DDB.title: "Unrealium Crossbow"
	quest.15B16D9C78DA0C1E.quest_desc: ["The &6Holy Sword&r — Aether's anti-undead blade. Bonus damage to undead and shadow mobs."]
	quest.15B16D9C78DA0C1E.title: "Holy Sword"
	quest.15B51FB56A64C303.quest_desc: [
		"The &6University Hut&r unlocks MineColonies' research tree. Place to assign citizens to researchers; researchers unlock new colony perks over time."
		""
		"&aResearch is what scales a colony from village to thriving town.&r Build it early."
	]
	quest.15F03A5E7E14C022.quest_desc: [
		"Build a &6Stonemason's Hut&r — the citizen who crafts stone products (slabs, stairs, walls, polished variants)."
		""
		"Pair with the Miner for full stone supply chain."
	]
	quest.15F65C76BE09F690.quest_desc: [
		"The &6Smoker&r cooks food twice as fast as a regular furnace and only accepts food items. Build one as soon as you have meat or potatoes piling up."
		""
		"&aFuel costs the same per item, but throughput doubles&r — a flat upgrade for any food economy."
	]
	quest.15F65C76BE09F690.quest_subtitle: "Cook your food faster, makes life easier."
	quest.15FBE4457080FD91.quest_desc: [
		"The &6Spirit Altar&r is Malum's central crafting block — a pedestal that consumes spirits and reagents to craft soul-infused items."
		""
		"&aPlace items on the altar, sprinkle the right spirits, then activate.&r Most Malum recipes flow through this block. Learn its rhythms."
	]
	quest.165351AD94769A37.quest_desc: [
		"&6Wireless Crafting Grid&r (RS Quartz Arsenal) — the wireless version of the Crafting Grid. Search, pull, craft, and put back without being at base."
		""
		"&aThe single best QOL item in the chapter once you live with it. Pair with the Network Card for setup.&r"
	]
	quest.165351AD94769A37.quest_subtitle: "Full crafting, anywhere in range."
	quest.165351AD94769A37.title: "Wireless Crafting Grid"
	quest.16720DA722F1938F.quest_desc: ["I highly recommend you get a backpack before you begin exploring for the boss questline, you're going to be out there a while. "]
	quest.169017ACA571DC51.quest_desc: ["&6Refined Soulstone&r — raw soulstone smelted in a furnace. Used in nearly every Malum recipe; stockpile a few stacks before getting deep into the mod."]
	quest.16E0EF63A6D4F3B6.quest_desc: [
		"&6End Stone Rubble Shield&r — Enderscape's themed shield, crafted from rubblemite drops."
		""
		"&aBetter than the vanilla shield in End contexts; pair with the magnia attractor for full Enderscape kit.&r"
	]
	quest.16E0EF63A6D4F3B6.title: "Rubble Shield"
	quest.17497F108CAB6C71.quest_desc: [
		"&6Knight Sword&r — the Underworld Knight's signature drop weapon. Heavy, hellfire-themed, and a memento of the arena fight."
		""
		"A solid mid-tier sword if you want a Block Factory's Bosses themed loadout."
	]
	quest.17497F108CAB6C71.title: "Knight Sword"
	quest.17F26BD4F5E66141.quest_desc: [
		"Step into the &6Otherside&r — the Deeper Darker dimension that lies through the Ancient Compass portal. Imagine the Deep Dark biome, scaled up to a whole world, with new ores, mobs, and apex predators."
		""
		"This is where the chapter's mid-tier farming happens: Stalkers, Sculk Snappers, Heart of the Deep, soul materials. The Sculk Transmitter recipe converges everything you collect here."
		""
		"&cThe Otherside is harder than the surface Deep Dark. Bring resonarium gear at minimum.&r"
	]
	quest.17F26BD4F5E66141.quest_subtitle: "Deeper and Darker's dimension"
	quest.17F26BD4F5E66141.title: "The Otherside Opens"
	quest.182BAF3009C3C6FE.quest_desc: ["The &6Aeternium Block&r — alternate progression branch via the ingot path. Wealth on display, again."]
	quest.182BAF3009C3C6FE.title: "Aeternium Anvil"
	quest.18D001A121FBEBCE.quest_desc: [
		"&6Shadoline Ingot&r — Enderscape's premium metal. Smelted from shadoline ore in shadow-touched biomes."
		""
		"Used in drift leggings and the magnia attractor."
	]
	quest.18D001A121FBEBCE.title: "Shadoline"
	quest.190D88699AB87245.quest_desc: [
		"The &6Waterskin&r holds drinking water you can sip on the go. Right-click on water to fill it, then right-click while holding it to drink — and it doubles as a cooling source if filled with cold water."
		""
		"&aFilling with hot water warms you on cold trips; cold water cools you in deserts.&r The waterskin is Cold Sweat's first portable temperature tool."
	]
	quest.190D88699AB87245.quest_subtitle: "Used to carry purified water around"
	quest.1998AA8EB20A3D62.quest_desc: [
		"The &6Boiler&r from Cold Sweat is a portable heat source. Place it down, fuel it, and stand near it to warm up — useful for expedition camps in cold biomes."
		""
		"&aPair with a Soulspring Lamp or Hellspring Lamp&r once you've reached the Nether for hands-free warmth."
	]
	quest.1998AA8EB20A3D62.quest_subtitle: "Heats a room up"
	quest.19D03831EB5EED02.quest_desc: [
		"Build a &6Blacksmith's Hut&r — the metal-product crafter. Makes iron tools, armor, and machine parts."
		""
		"&aThe primary iron-using crafter in the colony.&r"
	]
	quest.1AE2EB368D32B212.quest_desc: ["The &6Nature Staff&r — Aether weapon that channels healing or attack spells, depending on right- or left-click."]
	quest.1AE2EB368D32B212.quest_subtitle: "Aether toolkit complete."
	quest.1AE2EB368D32B212.title: "Nature Staff"
	quest.1B12808353A9BCD3.quest_desc: [
		"The &6Geas&r — a Gaze pact item. Bind yourself to a magical oath for a permanent buff at a permanent cost."
		""
		"&5Read the fine print.&r Geas effects can't be undone — pick the one that fits your build forever."
	]
	quest.1B12808353A9BCD3.quest_subtitle: "Trade armor for Soul Ward."
	quest.1B12808353A9BCD3.title: "&5The Pact of Encroaching Malice&r"
	quest.1B44888A62A69F2B.quest_desc: [
		"The full &6Soul Stained Steel Armor Set&r — helmet, chestplate, leggings, boots. A complete iron-tier replacement with soul affinity bonuses."
		""
		"&aWear the full set&r for the best resistance against magical damage and soul-based attacks."
	]
	quest.1B53435B792FC727.quest_desc: [
		"&6Storage Disk 4k&r — quadruple the capacity of a 1k. The first disk that actually feels useful for any volume of materials."
		""
		"Pair with the disk drive and you've got real storage."
	]
	quest.1B53435B792FC727.title: "4k Storage Disk"
	quest.1B7156DB58841951.quest_desc: [
		"&6Nebulite&r — Enderscape's signature ore. Mined from Enderscape's drift biomes."
		""
		"This is the entry to Enderscape's mirror → shadoline → drift gear chain."
	]
	quest.1B7156DB58841951.quest_subtitle: "Mirror fuel, pulled from End stone"
	quest.1B7156DB58841951.title: "Nebulite"
	quest.1BB227EC6C14ACEC.quest_desc: [
		"&6Rope and Nail&r is the anchor block for hanging hammocks from Comforts. Place two on opposite walls and stretch a hammock between them."
		""
		"&aYou can also use it as a low-key decoration for cabin builds.&r"
	]
	quest.1BB227EC6C14ACEC.quest_subtitle: "Use this to place down a hammock!"
	quest.1BB4E7CF49AB55E2.quest_desc: [
		"&6Ultra Autocrafter&r — Cable Tiers' top-tier autocrafter. Highest pattern density and fastest crafting in the chapter."
		""
		"&5The chapter's terminal autocrafting block.&r With this and a fleet of Diamond Crafters, RS is fully tuned. The inventory problem is not just solved — it's been solved for so long you've forgotten there ever was one."
	]
	quest.1BB4E7CF49AB55E2.title: "Ultra Autocrafter"
	quest.1BB8D66993D0E338.quest_desc: [
		"The &6Disk Drive&r holds storage disks — eight slots per drive. Place it on the network and it makes the inserted disks' contents available to the entire system."
		""
		"&aBuild several. Each disk drive is a stack of inventory; you'll fill them faster than expected.&r"
	]
	quest.1BB8D66993D0E338.quest_subtitle: "Houses your disks."
	quest.1BB8D66993D0E338.title: "Disk Drive"
	quest.1C01FB0F37AA3050.quest_desc: ["Five Deep Aether curios: &6Gravitite Ring&r, &6Aercloud Necklace&r, &6Spooky Ring&r, &6Medal of Honor&r, and &6Floaty Scarf&r. Slot bonuses for the deep Aether build."]
	quest.1C169735911C7979.quest_desc: ["&5The Aether's optional capstone&r — proof of the deepest dungeon clears."]
	quest.1C169735911C7979.quest_subtitle: "Ice fists, snowy plains"
	quest.1C169735911C7979.title: "&dSkor, the Yeti Slain&r"
	quest.1C16AEE8E29FB5A0.quest_desc: [
		"Hold a &6Banner of Rallying Guards&r — raises a temporary banner that summons your guards to your location."
		""
		"&aEmergency rally signal — useful when raids overrun the perimeter.&r"
	]
	quest.1C1958C07B0E3D6A.quest_desc: [
		"The &6Encyclopedia Unveiled&r — Gaze's in-game guidebook. Where Malum has the Encyclopedia Arcana, the Gaze companion has its own."
		""
		"&aRead it before crafting Gaze items.&r The interactions are intricate."
	]
	quest.1C5A2D2827131549.quest_desc: ["&6Aether Convergence Quest&r — collect a bronze key, victory medal, and brass key as proof of running the full dungeon ladder."]
	quest.1C5A2D2827131549.quest_subtitle: "Floating fist at y=15"
	quest.1C5A2D2827131549.title: "&dThe Nether Gauntlet Slain&r"
	quest.1C7CA951B9A0838E.quest_desc: ["The &6Gold Compass&r — Deep Aether's deepest navigator, locating gold dungeons and rare structures."]
	quest.1C7CA951B9A0838E.title: "Gold Compass"
	quest.1D0EF4F73039DF7A.quest_desc: ["The &6Blade of Luck&r — Deep Aether sword with a chance for bonus drops on kill."]
	quest.1D0EF4F73039DF7A.title: "Blade of Luck"
	quest.1D55F387978C926D.quest_desc: ["The full &6Skyjade Armor Set&r — Deep Aether's endgame heavy armor. Pair with the skyjade sword for the apex Aether build."]
	quest.1D55F387978C926D.quest_subtitle: "Fall damage nullified"
	quest.1D55F387978C926D.title: "Skyjade Panoply"
	quest.1D5FE83E8B73BE7B.quest_desc: [
		"&6Thioquartz Shard&r — a sulfurous, faintly translucent crystal mined near thermal vents and acidic biomes."
		""
		"Used in advanced Starlight recipes including the Starfire upgrade chain. Keep a stack on hand — you'll need it later."
	]
	quest.1D5FE83E8B73BE7B.title: "Thioquartz Shard"
	quest.1DECC5C19950ECEF.quest_desc: ["The &6Cloud Staff&r — Aether dungeon loot. Right-click to summon a temporary cloud platform under the player's feet."]
	quest.1DECC5C19950ECEF.title: "Cloud Staff"
	quest.1E1870FAD295DEDE.quest_desc: [
		"Place a &6Supply Camp Deployer&r — the starter kit that bootstraps a new colony."
		""
		"&aIncludes the basic huts to start a settlement — Town Hall, Builder, etc.&r Build it once per colony, near a flat starting area."
	]
	quest.1E26C1DB07329371.quest_desc: [
		"The &6Brambler&r is a hostile bramble-covered creature from Alchemists Garden, drops brambleroot and brambles when killed."
		""
		"&cSpiky and aggressive&r — kite from range or wear leather gloves to soak the contact damage."
	]
	quest.1E26C1DB07329371.quest_subtitle: "&oThorns under the target."
	quest.1E26C1DB07329371.title: "&6Brambler"
	quest.1E2CC1305BAFB7E2.quest_desc: [
		"&6Broken Baby Yeti Staff&r and &6Broken Spiderling Staff&r — fragmented staves recovered from rare drops. Repair them at a smithing or alchemy table."
		""
		"&aThe broken pre-tier&r before crafting their working counterparts. Don't throw them away."
	]
	quest.1E2CC1305BAFB7E2.quest_subtitle: "&oSomeone's homework."
	quest.1E2CC1305BAFB7E2.title: "&7Broken Staff Pieces"
	quest.1E569E8BEE81B269.quest_desc: [
		"&6Machine Casing&r — the chassis used by RS machines (Controller, Disk Drive, Crafter, Importer/Exporter, etc.)."
		""
		"You'll burn through these. Set up a quartz-enriched-iron + processor pipeline that pumps casings."
	]
	quest.1E569E8BEE81B269.title: "Machine Casing"
	quest.1F1F3EEF94C8A08D.quest_desc: [
		"The &6Starfire Hammer&r is a heavy two-handed weapon that hits like the impact crater it leaves behind. Slow swing, brutal damage."
		""
		"Pick it if you'd rather hit one thing very hard than several things quickly. The hammer feels right against the Starlight's heavier mobs."
	]
	quest.1F1F3EEF94C8A08D.title: "Starfire Hammer"
	quest.1F215CC13B2A1F81.quest_desc: [
		"&6Ancient Scroll&r — Monster Plus arcane drop. Reveals or unlocks Monster Plus advanced recipes."
		""
		"&7Crafting reagent for the dark armor and crystal weapons.&r"
	]
	quest.1FD63CC9FE27EE98.quest_desc: [
		"The &6Spirit Jar&r holds a fixed amount of one spirit type. Mass storage for the spirit currency that drives Malum's altar."
		""
		"&aLabel them in your spirit closet&r — Sacred, Wicked, Arcane, Eldritch, etc. Without sorted jars, your altar runs dry mid-ritual."
	]
	quest.201CB898A399F1D5.quest_desc: [
		"Build a &6Swineherder's Hut&r — the citizen who raises pigs for meat."
		""
		"Standard MineColonies meat supply."
	]
	quest.206159A3C7A78447.quest_desc: [
		"Build a &6Mystical Site&r — the colony's happiness booster. Increases citizen morale across the settlement."
		""
		"&aHappy citizens work faster and complain less.&r"
	]
	quest.2069A30CADB75289.quest_desc: ["The &6Cincinnasite-Diamond Upgrade Template&r — fuses cincinnasite with diamond gear, the BN equivalent of the Netherite upgrade path."]
	quest.2069A30CADB75289.title: "Cincinnasite-Diamond Template"
	quest.20EAD75882C8F835.quest_desc: [
		"The &6Network Card&r is how wireless devices know which network to connect to. Right-click it on a Network Receiver, then bind the wireless device with the card."
		""
		"&cWithout a Network Card, your wireless grids and portable grids can't connect. Always bind first.&r"
	]
	quest.20EAD75882C8F835.quest_subtitle: "Bind handheld tools to the network."
	quest.20EAD75882C8F835.title: "Network Card"
	quest.212833237642AD58.quest_desc: [
		"&6Raw Flowglaze&r — the unprocessed form of the Starlight's premium ceramic. Gathered from rare flow-infused deposits, then refined into proper Flowglaze with a smithing template."
		""
		"This is the gateway to the late Starlight tree — Flowglaze, the Starfire Hammer, the Crystal Greatsword, and the Dagger of Hunger all branch out from here."
	]
	quest.212833237642AD58.title: "Raw Flowglaze"
	quest.2141A51DFA5E7349.quest_desc: [
		"The &6Engineer's Manual&r is IE's in-game tutorial book. Explains every IE machine, recipe, and multiblock with diagrams."
		""
		"&aMandatory reading for IE progression — the diagrams save dozens of failed builds.&r"
	]
	quest.2141A51DFA5E7349.quest_subtitle: "Read before you build"
	quest.2141A51DFA5E7349.title: "Engineer's Manual"
	quest.2160974BDE2FAB89.quest_desc: [
		"&6Sculk Bone&r — your first proof that you've descended into the deepest layers of the world. Drops from skeletal sculk-creatures or mined from sculk-claimed structures."
		""
		"This is the entry quest for the Deep Dark chapter. From here the chapter forks into Deeper Darker's resonarium tree, the Otherside dimension, the Warden gauntlet, and the bestiary boss kills (Lich, Frostmaw, Underworld Knight)."
		""
		"&cThe Deep Dark layer is dangerous — bring wool, sneak gear, and don't trigger shriekers if you can help it.&r"
	]
	quest.2160974BDE2FAB89.quest_subtitle: "Chapter entry, the lightless below."
	quest.2160974BDE2FAB89.title: "Sculk Bone"
	quest.21D73852F0CA11EE.quest_desc: [
		"&6Reinforced Echo Shard&r — vanilla Echo Shards alloyed with Otherside materials into something far harder. The pre-Warden gating component."
		""
		"This is the last piece you need before you can fight the Warden with Deeper Darker gear in hand."
	]
	quest.21D73852F0CA11EE.title: "Reinforced Echo Shard"
	quest.21F54F447A9F98E8.quest_desc: [
		"&6Improved Processor&r — RS's tier-2 chip, made from a basic processor with extra silicon/redstone."
		""
		"Required for the Controller and most mid-tier RS components."
	]
	quest.21F54F447A9F98E8.title: "Improved Processor"
	quest.22390A3639521581.quest_desc: [
		"&6Bloom Berries&r — small, glowing fruits that grow on Otherside vegetation. Edible, mildly restorative, and one of the few things in the dimension that isn't trying to kill you."
		""
		"&7Stockpile a stack as emergency food on long Otherside expeditions.&r"
	]
	quest.22390A3639521581.title: "Bloom Berries"
	quest.226176A1C73431B5.quest_desc: [
		"Reach &6max fields&r — have all available farmer fields in your colony cultivated."
		""
		"Maximum food production capacity for your settlement."
	]
	quest.22B649FFBB813279.quest_desc: [
		"The &6Controller&r is the brain of your Refined Storage network — the single block every other RS device must cable back to. It also stores energy and powers the network."
		""
		"&5This is the chapter's centerpiece (size 1.5 diamond).&r From here forward, your inventory problem is solved: cables, disks, grids, autocrafters all wire back to this controller."
		""
		"&cOnly one Controller per network. Adding a second creates a second network, not a backup.&r"
	]
	quest.22B649FFBB813279.quest_subtitle: "The heart of the network."
	quest.22B649FFBB813279.title: "Controller"
	quest.22DE26D2C27E33A9.quest_desc: [
		"The &6Sculk Leech&r is a small, latching parasite that attaches and drains. Annoying alone, deadly if a swarm catches you mid-fight."
		""
		"The third of three Otherside-mob kills feeding the Warden encounter."
	]
	quest.22DE26D2C27E33A9.title: "Sculk Leech"
	quest.22F4C38E79DEFF1E.quest_desc: [
		"Donate &6Oak Logs&r to your colony. The simplest first contribution to the Warehouse."
		""
		"&aLumberjacks will replenish the supply once their hut is built.&r"
	]
	quest.22F4C38E79DEFF1E.quest_subtitle: "Ever dreamed of running your own city?"
	quest.22F4C38E79DEFF1E.title: "Not Such A Lonely World"
	quest.23012F6C4C522CEB.quest_desc: [
		"Build a &6Lumberjack's Hut&r — the citizen who chops trees and re-plants saplings."
		""
		"&aPrimary wood supply for a colony.&r Higher-tier lumberjacks chop faster and replant more reliably."
	]
	quest.23594A58EE25F2B3.quest_desc: [
		"&6Starfire Upgrade Smithing Template&r — the second smithing template you need in the Starlight, this one for the late-tier crafting chain leading to Unrealium."
		""
		"Loot it from high-tier Starlight structures or chests. Combined with the Soul Dew it gates the rest of the chapter."
	]
	quest.23594A58EE25F2B3.title: "Starfire Smithing Template"
	quest.23CB56BA9D66E0CF.quest_desc: ["The &6Basic Topaz Pedestal&r — Pastel's altar block. Place gems on it to combine, energize, and produce the mod's signature fused crystals."]
	quest.23F9E474E4782FE0.quest_desc: [
		"&6Drift Leggings&r (Enderscape) — Enderscape-themed leggings with drift biome aesthetics."
		""
		"&aPair with thallasium for a complete late-Renaissance End loadout.&r"
	]
	quest.23F9E474E4782FE0.quest_subtitle: "Low gravity. Mind the fall."
	quest.23F9E474E4782FE0.title: "Drift Leggings"
	quest.25245C85CEA5F613.quest_desc: [
		"&6Thallasium&r — BetterEnd's mid-tier metal, a green-tinted alloy used for early End armor and tools."
		""
		"Easier to make than aeternium and serves as a stepping stone — equivalent to iron in the End's metal hierarchy."
	]
	quest.25245C85CEA5F613.quest_subtitle: "The End has its own metals"
	quest.25245C85CEA5F613.title: "Thallasium"
	quest.252ADD929CB55CBF.quest_desc: [
		"The &6Energy Ball&r is a charged reagent used in mid-tier Alchemists Garden recipes. Crackles with stored magical force."
		""
		"&aFeed into staff and ring crafting&r for the upper-tier alchemy items."
	]
	quest.252ADD929CB55CBF.quest_subtitle: "&oExhaustion, bottled."
	quest.252ADD929CB55CBF.title: "&eEnergy Ball"
	quest.25CC66DE9E958AF2.quest_desc: ["The &6Hammer of Kingbdogz&r — boss drop with a charged AoE smash."]
	quest.25CC66DE9E958AF2.title: "Hammer of Kingbdogz"
	quest.2607962CD04BF6E9.quest_desc: [
		"&6Iron Crafter&r (Extra Storage) — a higher-tier autocrafter alternative with more pattern slots in one block."
		""
		"&aSaves space and cabling vs. a wall of vanilla RS Autocrafters.&r"
	]
	quest.2607962CD04BF6E9.title: "Iron Crafter"
	quest.2630EB142EF5B739.quest_desc: [
		"&6Enchanted Gravitite&r — Aether's diamond-tier ore. Found in the highest islands and mined with zanite picks or better."
		""
		"&aBlocks made from gravitite levitate when broken,&r making it useful for mid-air construction tricks."
	]
	quest.2630EB142EF5B739.quest_subtitle: "The third ore, melted first"
	quest.2630EB142EF5B739.title: "Enchanted Gravitite"
	quest.267DDED534149BD3.quest_desc: [
		"The &6Resonarium Axe&r is the headline weapon of the Deeper Darker tier. Heavy, deep-toned on impact, and a clean step above iron and diamond."
		""
		"Convergence quest: requires both the smithing template and base resonarium. Once you have this, the resonarium sword and pickaxe come almost for free."
	]
	quest.267DDED534149BD3.quest_subtitle: "All four pieces"
	quest.267DDED534149BD3.title: "Resonarium Armor"
	quest.26AF7DD51C9C3B19.quest_desc: ["&6Arcane Charcoal&r — coal infused with a captured arcane spirit. Burns cleaner and longer than regular charcoal, used in higher-tier altar fuel and some recipes."]
	quest.27405F3036E62186.quest_desc: [
		"&6Blue Starlight Crystal Shard&r — chipped from cool-toned crystal clusters that grow throughout the Starlight. Pairs with red shards in the Aethersent ingot recipe."
		""
		"Two shards, two colors — collect both to feed the Aethersent forge."
	]
	quest.27405F3036E62186.title: "Blue Starlight Crystal Shard"
	quest.27631F12D97B7FA8.quest_desc: ["Forge a &6Copper Pickaxe Head&r and &6Copper Sword Blade&r at the stone anvil with hammer, tongs, and copper ingots. Your first smithed metal parts. Shift right click a stone block with your hammer to turn it to a stone anvil to make these parts at. "]
	quest.2786253C2EB37639.quest_desc: ["The &6Combiner&r — Deep Aether crafting block for fusing gems and reagents."]
	quest.2786253C2EB37639.title: "Combiner"
	quest.27944E17BDF60435.quest_desc: [
		"&6Flowglaze&r — finished, refined Starlight ceramic. Smooth, faintly glowing, and the prerequisite for the Starlight's late-game weapons."
		""
		"This unlocks the Starfire Hammer, the Crystal Greatsword, and the Dagger of Hunger — three very different weapons, each its own playstyle."
	]
	quest.27944E17BDF60435.title: "Flowglaze"
	quest.280E76D5A93E6B6C.quest_desc: [
		"&5Gnome King&r (Alchemist's Garden) — a pint-sized but lethal forest monarch. Drops a loot bag and the King's Shovel."
		""
		"&aSidebar boss. Drops good loot for the time investment.&r"
	]
	quest.280E76D5A93E6B6C.quest_subtitle: "King of the burrow"
	quest.280E76D5A93E6B6C.title: "The Gnome King"
	quest.28DABB2573B15DFA.quest_desc: ["&6White Apple&r — Aether's golden apple equivalent, harvested from white apple trees. Eats for a strong heal."]
	quest.28DABB2573B15DFA.quest_subtitle: "Cures Inebriation"
	quest.28DABB2573B15DFA.title: "White Apple"
	quest.28F53CF46BDC20CC.quest_desc: ["&6Cincinnasite Ingot&r — Better Nether's signature alloy, smelted from cincinnasite ore. The metal that anchors most of BN's tool and armor recipes."]
	quest.28F53CF46BDC20CC.quest_subtitle: "Forged, not smelted"
	quest.28F53CF46BDC20CC.title: "Cincinnasite"
	quest.28FB6A2936D5FEE2.quest_desc: [
		"The &6Goat Fur Chestplate&r is your first piece of cold-weather armor from Cold Sweat. It insulates against cold with the warmth bonus baked into the recipe."
		""
		"&aPair with leather armor's other slots&r for an early hybrid set, or aim for a full goat fur kit before exploring icy biomes."
	]
	quest.28FB6A2936D5FEE2.quest_subtitle: "Goat fur keeps you warm, hoglin hide keeps you cool, chameleon stuff protects you from the jungle."
	quest.28FB6A2936D5FEE2.title: "Time To Thrive"
	quest.2902E58DB70F9404.quest_desc: [
		"&6Fire Clay&r is the heat-resistant clay needed for Productive Metalworks foundry construction. Crafted in a 3×3 checkerboard of clay balls and sand on a vanilla crafting table — yields 4 per craft."
		""
		"&aThe gateway material for Productive Metalworks foundry construction.&r"
	]
	quest.2902E58DB70F9404.quest_subtitle: "The foundry age begins"
	quest.2902E58DB70F9404.title: "&bFire Clay&r"
	quest.2902E58DB70F9405.quest_desc: [
		"&6Fire Bricks&r are heat-rated bricks — smelted fire clay. Required for the foundry walls and other heat-intensive blocks."
		""
		"Mass-produce; the foundry multiblock needs many."
	]
	quest.2902E58DB70F9405.title: "Fire Brick"
	quest.2902E58DB70F9407.quest_desc: [
		"&6Black Fire Bricks&r are the upgraded fire-brick variant for the &6Black Foundry&r — PMW's higher-tier foundry chassis."
		""
		"Heat-resistant black-tinted brick; aesthetic + functional."
	]
	quest.2902E58DB70F9407.quest_subtitle: "Foundry wall material"
	quest.2902E58DB70F9407.title: "Black Fire Bricks"
	quest.2902E58DB70F9409.quest_desc: [
		"The &6Black Foundry Drain&r is the I/O port for the foundry — pour finished molten metal out, or pipe in input fluid."
		""
		"Place at least one drain on the foundry's lower face."
	]
	quest.2902E58DB70F9409.quest_subtitle: "Multiblock heart"
	quest.2902E58DB70F9409.title: "Foundry Drain"
	quest.2902E58DB70F940A.quest_desc: [
		"The &6Black Foundry Tank&r is the foundry's molten-metal storage — a furnace internal capacity block. Stack multiple tanks vertically for higher throughput."
		""
		"Holds the molten metal pool that the foundry actively processes."
	]
	quest.2902E58DB70F940A.title: "Foundry Tank"
	quest.2902E58DB70F940B.quest_desc: [
		"The &6Black Foundry Window&r is the see-through panel variant of the foundry wall. Same structural role as a wall, but lets you watch the metals melt."
		""
		"Pure aesthetic."
	]
	quest.2902E58DB70F940B.quest_subtitle: "See the molten soup"
	quest.2902E58DB70F940B.title: "Foundry Window"
	quest.2902E58DB70F940C.quest_desc: [
		"The &6Foundry Tap&r is the spout for casting. Pours molten metal from the foundry into a casting table or basin below."
		""
		"Place above your casting setup."
	]
	quest.2902E58DB70F940C.title: "Foundry Tap"
	quest.2902E58DB70F940D.quest_desc: [
		"The &6Casting Table&r is for casting plates, ingots, gears — standard small-form casts."
		""
		"Pair with a cast item (ingot cast, plate cast) on the table; pour metal from above."
	]
	quest.2902E58DB70F940D.quest_subtitle: "Where metal takes shape"
	quest.2902E58DB70F940D.title: "Casting Table"
	quest.2902E58DB70F940E.quest_desc: [
		"The &6Casting Basin&r is for casting blocks — large-form metal blocks."
		""
		"Same flow as the casting table; produces blocks instead of ingots."
	]
	quest.2902E58DB70F940E.quest_subtitle: "Shaped output"
	quest.2902E58DB70F940E.title: "Casting Basin"
	quest.2902E58DB70F940F.quest_desc: [
		"The &6Ingot Cast&r is the mold for ingot casting. Place on a casting table; pour molten metal; produce ingots."
		""
		"Reusable — the cast doesn't burn up."
	]
	quest.2902E58DB70F940F.title: "Ingot Cast"
	quest.2902E58DB70F9411.quest_desc: [
		"The &6Rod Cast&r is the mold for rod casting. Same logic as the ingot cast, different shape."
		""
		"Pair with the ingot and plate casts for full PMW cast inventory."
	]
	quest.2902E58DB70F9411.title: "Rod Cast"
	quest.2902E58DB70F9412.quest_desc: [
		"The &6Plate Cast&r is the mold for plate casting."
		""
		"Mass-cast plates for downstream MI/Oritech/IE recipes."
	]
	quest.2902E58DB70F9412.quest_subtitle: "Melting capability"
	quest.2902E58DB70F9412.title: "Plate Cast"
	quest.2902E58DB70F9413.quest_desc: [
		"The &6Liquid Heating Coil&r is PMW's electric heating element — provides heat to the foundry without burning fuel."
		""
		"&aElectric upgrade over the burning-coal-for-heat baseline.&r"
	]
	quest.2902E58DB70F9413.quest_subtitle: "More coils, hotter melt"
	quest.2902E58DB70F9413.title: "Heating Coil"
	quest.2902E58DB70F9414.quest_desc: [
		"The &6Black Foundry Controller&r is the brain block of the foundry multiblock. (Duplicate quest covering the same item from the upgrade angle.)"
		""
		"&aOnce both copies of this quest exist in your tracking, the foundry path is fully recognized.&r"
	]
	quest.2902E58DB70F9414.quest_subtitle: "Build it, form it, prove it"
	quest.2902E58DB70F9414.title: "&6Foundry Formed&r"
	quest.2902E58DB70F9418.quest_desc: [
		"The &6Time Upgrade&r (ProductiveLib) accelerates a PMW machine's processing rate."
		""
		"Slot into compatible upgrade-accepting machines for faster output."
	]
	quest.2902E58DB70F9418.title: "Speed Upgrade I"
	quest.2902E58DB70F9422.quest_desc: [
		"The &6Coke Brick&r is Immersive Engineering's fire brick variant — chassis material for IE's Coke Oven multiblock."
		""
		"Build the IE Coke Oven from these."
	]
	quest.2902E58DB70F9422.quest_subtitle: "Gateway to Immersive Engineering"
	quest.2902E58DB70F9422.title: "Cokebrick"
	quest.2902E58DB70F9423.quest_desc: [
		"&6Coal Coke&r is the IE Coke Oven output — super-coal that burns hotter than regular coal."
		""
		"Required for the IE Blast Furnace; same role as MI's coke."
	]
	quest.2902E58DB70F9423.quest_subtitle: "Hotter. Longer. Blacker."
	quest.2902E58DB70F9423.title: "Coal Coke"
	quest.2902E58DB70F9424.quest_desc: [
		"&6Coke&r (block form) is 9-coal-coke storage. Mass-storage compact form."
		""
		"Decorative + functional storage block."
	]
	quest.2902E58DB70F9424.title: "Coke Block"
	quest.2902E58DB70F9425.quest_desc: [
		"The &6Creosote Bucket&r is the byproduct fluid from IE's Coke Oven. Used in treated wood production."
		""
		"Pair with planks in the IE Sawmill for treated wood output."
	]
	quest.2902E58DB70F9425.quest_subtitle: "Tar from the oven"
	quest.2902E58DB70F9425.title: "Creosote Bucket"
	quest.2902E58DB70F9426.quest_desc: [
		"&6Treated Wood&r is IE's weather-resistant wood. Made by soaking planks in creosote."
		""
		"&aRequired for many IE machine recipes — the IE Engineer's Workbench, fluid pump, and several others.&r"
	]
	quest.2902E58DB70F9426.quest_subtitle: "The scaffold of everything IE"
	quest.2902E58DB70F9426.title: "Treated Wood"
	quest.2902E58DB70F9427.quest_desc: [
		"The &6Treated Fence&r is the fence variant of treated wood. Decorative + functional."
		""
		"Pair with treated planks for industrial-flavored fencing."
	]
	quest.2902E58DB70F9427.title: "Treated Fence"
	quest.2902E58DB70F9428.quest_desc: [
		"The &6Treated Scaffold&r is IE's scaffolding-flavored treated wood block. Used in vertical builds."
		""
		"Climbable; useful for staging multi-story IE builds."
	]
	quest.2902E58DB70F9428.quest_subtitle: "IE documentation"
	quest.2902E58DB70F9428.title: "Treated Scaffold"
	quest.2902E58DB70F9429.quest_desc: [
		"The &6Treated Trapdoor&r is the trapdoor variant of treated wood."
		""
		"Same function as vanilla trapdoors; treated-wood aesthetic."
	]
	quest.2902E58DB70F9429.quest_subtitle: "IE's multitool"
	quest.2902E58DB70F9429.title: "Treated Trapdoor"
	quest.2902E58DB70F942A.quest_desc: [
		"The &6Engineer's Hammer&r is IE's universal tool. Right-click to rotate IE blocks; sneak-right-click to detach wires; reagent in many IE recipes."
		""
		"Carry alongside other mod wrenches."
	]
	quest.2902E58DB70F942A.quest_subtitle: "The engineer's best friend"
	quest.2902E58DB70F942A.title: "Engineer's Hammer"
	quest.2902E58DB70F942B.quest_desc: [
		"The &6IE Wirecutter&r removes IE wires cleanly. Without it, you'd have to break and rebuild connectors."
		""
		"&aQuality-of-life IE tool — carry alongside the hammer.&r"
	]
	quest.2902E58DB70F942B.title: "Wirecutter"
	quest.2902E58DB70F942C.quest_desc: [
		"&6IE Copper Wirecoil&r is the basic LV wire. Same role as IR3's copper wirecoil."
		""
		"Stockpile early; you'll wire dozens of LV connections."
	]
	quest.2902E58DB70F942C.quest_subtitle: "Low voltage, big reach"
	quest.2902E58DB70F942C.title: "Copper Wire Coil"
	quest.2902E58DB70F942D.quest_desc: [
		"The &6LV Connector&r is the IE wire-attachment point. Same role as the IR3 LV connector."
		""
		"Mount on machines and capacitors; right-click with copper wirecoil to start a wire run."
	]
	quest.2902E58DB70F942D.quest_subtitle: "IE's first power tier"
	quest.2902E58DB70F942D.title: "LV Connector"
	quest.2902E58DB70F942E.quest_desc: [
		"The &6LV Connector Relay&r is the mid-run wire repeater. Extends usable LV wire range without losing efficiency."
		""
		"Place along long runs to maintain signal."
	]
	quest.2902E58DB70F942E.quest_subtitle: "Wire waypoint"
	quest.2902E58DB70F942E.title: "LV Relay"
	quest.2902E58DB70F9430.quest_desc: [
		"&6Iron Dust&r is the ore-doubled iron intermediate. IE's Crusher (or any compatible crusher) doubles iron ore output via iron dust."
		""
		"Smelt for an iron ingot at standard rate."
	]
	quest.2902E58DB70F9430.title: "Iron Dust"
	quest.2902E58DB70F9431.quest_desc: [
		"The &6Mechanical Mixer&r (Create) is Create's basic mixing machine. Spin with rotational power; combine items in the basin below."
		""
		"&aRequired for many Create alloy and food recipes.&r"
	]
	quest.2902E58DB70F9431.quest_subtitle: "Create meets metallurgy"
	quest.2902E58DB70F9431.title: "Mechanical Mixer"
	quest.2902E58DB70F9434.quest_desc: [
		"&6Brass Ingots&r (All The Ores variant) are the standard brass alloy. Made from copper + zinc."
		""
		"Cross-tag compatible with Create brass and most other mods' brass."
	]
	quest.2902E58DB70F9434.quest_subtitle: "Copper + Zinc = progress"
	quest.2902E58DB70F9434.title: "&6Brass Ingot&r"
	quest.2902E58DB70F9435.quest_desc: [
		"The &6Stability Upgrade&r (ProductiveLib) reduces fluctuations in PMW machine processing."
		""
		"Slot into compatible machines to smooth output throughput."
	]
	quest.2902E58DB70F9435.title: "Stability Upgrade"
	quest.2902E58DB70F9436.quest_desc: [
		"The &6Time Upgrade II&r is the upgraded variant — faster processing acceleration than the basic time upgrade."
		""
		"Stack with stability upgrades for high-throughput PMW machines."
	]
	quest.2902E58DB70F9436.quest_subtitle: "Foundry goes brrr"
	quest.2902E58DB70F9436.title: "Speed Upgrade II"
	quest.2902E58DB70F9438.quest_desc: [
		"&6Treated Wood Sticks&r are crafted from treated wood. Used in IE Engineer's Workbench recipes and treated-wood-derived components."
		""
		"Cheap intermediate; produce in bulk."
	]
	quest.2902E58DB70F9438.title: "Treated Stick"
	quest.2902E58DB70F9439.quest_desc: [
		"&6Copper Wire&r (IE) is the bare wire form — un-coiled, used in some IE workbench recipes."
		""
		"Different from copper wirecoil — the wirecoil is the placed cable, this is the workbench reagent."
	]
	quest.2902E58DB70F9439.title: "Copper Wire"
	quest.2902E58DB70F9440.quest_desc: [
		"The &6IE Fluid Pipe&r is Immersive Engineering's industrial fluid line. Reinforced steel; lossless transmission."
		""
		"Pair with IE pumps for fluid networks."
	]
	quest.2902E58DB70F9440.quest_subtitle: "FA dark material"
	quest.2902E58DB70F9440.title: "Fluid Pipe"
	quest.2902E58DB70F9441.quest_desc: [
		"The &6IE Tank&r is a dedicated fluid storage block. Larger capacity than the wooden barrel."
		""
		"Connect via fluid pipe; right-click with bucket to drain or fill."
	]
	quest.2902E58DB70F9441.quest_subtitle: "Stack them, they merge"
	quest.2902E58DB70F9441.title: "IE Tank"
	quest.2902E58DB70F9442.quest_desc: [
		"&6Brass Plates&r (All The Ores) are flattened brass. Used in IE machine recipes and several cross-mod brass-tagged crafts."
		""
		"Press from brass ingots in any compatible compressor."
	]
	quest.2902E58DB70F9442.quest_subtitle: "Forge prep ingredient"
	quest.2902E58DB70F9442.title: "Brass Plate"
	quest.2902E58DB70F9445.quest_desc: [
		"&6Hempcrete&r is IE's plant-fiber concrete. Lighter and weaker than concrete but cheaper."
		""
		"Building material; useful for cladding tall industrial structures."
	]
	quest.2902E58DB70F9445.quest_subtitle: "Green-age masonry"
	quest.2902E58DB70F9445.title: "Hempcrete"
	quest.2902E58DB70F9446.quest_desc: [
		"&6Concrete&r (IE variant) is the heavy industrial building block. Strong, blast-resistant."
		""
		"Use as foundation material for serious factory builds."
	]
	quest.2902E58DB70F9446.quest_subtitle: "Explosion-proof industry"
	quest.2902E58DB70F9446.title: "&6Concrete&r"
	quest.2902E58DB70F9449.quest_desc: [
		"&6IE Fertilizer&r is the IE-flavored crop accelerant. Right-click on a crop to advance growth."
		""
		"Renewable bonemeal alternative."
	]
	quest.2902E58DB70F9449.title: "Fertilizer"
	quest.2902E58DB70F95F1.quest_desc: [
		"&6Edelwood Logs&r (Forbidden Arcanus) are FA's signature dark wood — dripping with edelwood oil."
		""
		"&aSqueeze logs in the FA press to extract edelwood oil.&r The oil is the FA early-game lighting fuel."
	]
	quest.2902E58DB70F95F1.quest_subtitle: "From the dark forest"
	quest.2902E58DB70F95F1.title: "Edelwood Log"
	quest.2902E58DB70F95F2.quest_desc: [
		"&6Edelwood Oil&r is FA's lantern fuel. Burns longer than torches with a distinct dark-orange light."
		""
		"Used in FA lantern recipes and several early ritual components."
	]
	quest.2902E58DB70F95F2.quest_subtitle: "Pressed from dark wood"
	quest.2902E58DB70F95F2.title: "Edelwood Oil"
	quest.29055EFFDCC6576E.quest_desc: [
		"&5Kill a Yeti.&r The big white mountain bruiser of Alchemists Garden. Drops yeti antlers, fur, and the occasional yeti staff component."
		""
		"&cThis is a real fight.&r Yetis tank a lot of damage, knock you back, and chase relentlessly. Bring iron armor minimum, healing items, and a good melee weapon."
	]
	quest.29055EFFDCC6576E.quest_subtitle: "&oMedieval mini-boss."
	quest.29055EFFDCC6576E.title: "&bSlay the Yeti"
	quest.2940A79987A07E07.quest_desc: [
		"Five &6Leather&r — the gateway material for everything from armor to books. Cows, horses, and rabbits drop it; fishing pulls it up occasionally."
		""
		"&aBuild a small cow farm early.&r Leather supplies your books, item frames, armor, and saddles for the entire run."
	]
	quest.2973560A44DEC9A5.quest_desc: [
		"&6Fishing Line&r is a crafting component for Aquaculture's upgraded fishing rods and tackle. The mod expands fishing far past the vanilla loot table — dozens of new fish species, biome-specific catches, and tackle box mechanics."
		""
		"Craft this to start the upgrade path toward better rods and richer catches."
	]
	quest.2973560A44DEC9A5.quest_subtitle: "A stronger line comes before metal rod upgrades."
	quest.2973560A44DEC9A5.title: "Fishing Line"
	quest.29A2BF4A1B962078.quest_desc: ["The &6Clibano Core&r is the heart of the Forbidden Arcanus furnace — smelts items with magical efficiency and unlocks special recipes regular furnaces can't handle."]
	quest.29D16962C2CF8701.quest_desc: [
		"The &6Encyclopedia Arcana&r is Malum's in-game guidebook. Right-click to open and read every recipe, ritual, and spirit interaction."
		""
		"&aEssential reference.&r Malum has a lot of moving parts; the encyclopedia explains them all."
	]
	quest.29D759EFE44E2422.quest_desc: [
		"The full &6Chameleon Armor&r set — leggings, helmet, boots — built from chameleon molt. Insulates against both heat and cold, making it the most versatile early-game thermal armor."
		""
		"&aIf you're heading anywhere extreme — desert, tundra, mountain peak — wear this set.&r The vanilla leather equivalent only insulates lightly; chameleon armor is built for the mod's full thermal range."
	]
	quest.29DE51ABF8B5D7FA.quest_desc: [
		"&5Spider Queen&r (Alchemist's Garden) — a colossal arachnid sidebar boss. Drops a loot bag and the Queen's Fang."
		""
		"&cVenomous attacks; bring milk for cleanse.&r"
	]
	quest.29DE51ABF8B5D7FA.quest_subtitle: "Queen of the threads"
	quest.29DE51ABF8B5D7FA.title: "The Spider Queen"
	quest.2A17B435F8B82514.quest_desc: ["The &6Storm Bow&r — Deep Aether bow that fires lightning-charged arrows."]
	quest.2A17B435F8B82514.title: "Storm Bow"
	quest.2A330E059C46608B.quest_desc: [
		"&6Unrealium armor set&r — the Starlight's terminal full plate. Helmet, chestplate, leggings, boots forged from the dimension's apex metal."
		""
		"This is what the entire chapter has been pointing at. Wear this into the Renaissance finale and the Maledictus Vigil isn't waiting on your gear quality."
	]
	quest.2A330E059C46608B.title: "Unrealium Armor"
	quest.2A91229A2D2EB967.quest_desc: [
		"The &6Iron Blacksmith Gavel&r — first tier of Forbidden Arcanus's Hephaestus Forge tool. Used on the forge to shape FA's specialty alloys."
		""
		"&aT1 of T5.&r Each tier (iron, gold, etc.) unlocks deeper recipes. The gavel ladder is FA's craft progression."
	]
	quest.2AB254F7C8BD229C.quest_desc: ["&6Hex Ash&r — burnt residue from cursed materials. A reagent for malignant (dark-side) Malum recipes."]
	quest.2B672171E340D5C5.quest_desc: [
		"&6Malignant Pewter Ingot&r — Malum's dark-side metal, infused with cursed energy. The endgame counterpart to soul-stained steel."
		""
		"&5The malignant path&r unlocks higher damage at the cost of self-harm or curse effects. Power with consequences."
	]
	quest.2B754088E3D31358.quest_desc: ["&6White Moa Egg&r — uncommon variant with more jumps than the blue."]
	quest.2B754088E3D31358.title: "White Moa Egg"
	quest.2B8CDC277ACCFD18.quest_desc: [
		"The &6Autocrafting Monitor&r shows in-progress crafts — what the system is currently trying to make and how it's stuck (missing ingredients, etc.)."
		""
		"&aIndispensable for diagnosing autocrafting failures. Place it next to your main Grid.&r"
	]
	quest.2B8CDC277ACCFD18.title: "Autocrafting Monitor"
	quest.2BA66AAE2E7B0103.quest_desc: [
		"The &6Brick Fireplace&r — a decorative mortared hearth from Alchemists Garden. Lit, it casts light and warmth, and looks great in cottage builds."
		""
		"&aPure decoration with a thematic glow.&r Pair with mortar and pestle stations for an alchemist-cottage vibe."
	]
	quest.2BA66AAE2E7B0103.quest_subtitle: "&oComfort block. Ritual site."
	quest.2BA66AAE2E7B0103.title: "&6Brick Fireplace"
	quest.2BD41E1142E44595.quest_desc: [
		"The &6Portable Grid&r is a Wireless Grid plus a small built-in storage — a true 'mini network in your hand,' usable in any dimension."
		""
		"&aGreat for expeditions to the Aether, Starlight, End. Carries some buffer storage so you can dump finds and keep going.&r"
	]
	quest.2BD41E1142E44595.title: "Portable Grid"
	quest.2C3EE3EDFA4A646B.quest_desc: ["&6Hallowed Gold Ingot&r — gold purified through Malum's altar. Sacred-spirit-infused metal used in higher-tier ritual gear."]
	quest.2C8B79C0ADE72F34.quest_desc: ["The &6Aeternium Hoe&r — alternate progression branch via the ingot path. The completionist's prize."]
	quest.2C8B79C0ADE72F34.title: "Aeternium Hoe Head"
	quest.2CA1ABCB10CAAD3E.quest_desc: ["&6Zanite Curios&r: Ring, Pendant, Gloves. Stat-bonus accessories slotted into curio slots for the zanite-themed playstyle."]
	quest.2CA1ABCB10CAAD3E.title: "Zanite Jewelry"
	quest.2CD0BFA1FFD74438.quest_desc: [
		"&6Oblifruit&r — Phantasm's End fruit, growing on bushes in End-overworld-styled biomes."
		""
		"&aEdible. Good emergency food while exploring outer islands.&r"
	]
	quest.2CD0BFA1FFD74438.quest_subtitle: "Pream-tree fruit."
	quest.2CD0BFA1FFD74438.title: "Oblifruit"
	quest.2D8C4A97AE031A9D.quest_desc: [
		"The Luminous Nether &6Gilded Bundle&r — the ritual loot bundle that drops mid-tier Nether trinkets when opened."
		""
		"&7Originally a 3-task bundle (Haunt Trim + Cultist Trim + Gilded Bundle). The two trims are flagged `§cDISABLED §cTEMPORARILY §cAS §cOF §cV1.3` in this LN version (1.3.2), so they were removed here to keep this quest completable. When LN re-enables the trims, the trim tasks should be added back.&r"
	]
	quest.2D8C4A97AE031A9D.title: "Ritual Trims"
	quest.2DD244E24CADB204.quest_desc: [
		"The complete set of &6Fossil Heads&r — chicken, creeper, guardian, ocelot, sheep, villager, and wolf. Each is a wearable mob skull with the bone-white archeological treatment."
		""
		"&aDecoration with grim flavor.&r Display them in your base or wear them like a player head."
	]
	quest.2DD244E24CADB204.quest_subtitle: "&oSeven species. One head each."
	quest.2DD244E24CADB204.title: "&6The Fossiliferous Dig"
	quest.2DD7E1853AC2A995.quest_desc: [
		"&5Kill Ignis.&r Cataclysm's flame golem boss — towering, fire-breathing, lava-pool spawning."
		""
		"&cFire resistance is mandatory.&r Brew up before the fight."
	]
	quest.2DD7E1853AC2A995.title: "Ignis"
	quest.2DD7E1853AC2A996.quest_desc: [
		"&6Flame Eye&r and &6Mech Eye&r from Cataclysm — keys for spawning the Harbinger and Ignis bosses."
		""
		"&7Optional sidequest&r if you want to challenge Cataclysm's Nether bosses."
	]
	quest.2DD7E1853AC2A996.title: "Cataclysm Eyes"
	quest.2DEB40BFC4EA18CE.quest_desc: [
		"The &6Sculk Transmitter&r is the chapter's signature device — a soul-and-deep-heart construct that lets you broadcast vibrations or relocate effects through the sculk network."
		""
		"This is the chapter icon for a reason: it's the ultimate Otherside crafting goal before you turn around and start the Warden gauntlet."
	]
	quest.2DEB40BFC4EA18CE.quest_subtitle: "Ancient Temple secret chest"
	quest.2DEB40BFC4EA18CE.title: "Sculk Transmitter"
	quest.2EA1F3E9461C0AD6.quest_desc: [
		"&6Lite&r — a Deeper Darker portable light source. Useful in any low-light biome, but especially in the Deep Dark where you need light without triggering shrieker noise."
		""
		"&aDrop one in your hotbar before any sculk-heavy expedition.&r"
	]
	quest.2EA1F3E9461C0AD6.title: "Lite"
	quest.2EF74E251B7CF27A.quest_desc: [
		"&6Glacite armor set&r — frost-touched plate built around the dimension's frozen tundra theme. Resists cold and looks the part."
		""
		"Pick it if you spend most of your time around the Starlight's frozen biomes or plan to fight Permafrost without freezing solid mid-fight."
	]
	quest.2EF74E251B7CF27A.title: "Glacite Set"
	quest.2F1466CEB0B375D5.quest_desc: [
		"Three rare drops: &6Sol Visage&r (Mowzie's Mobs Sun mask), &6Wrought Axe&r (Mowzie's barbarian axe), and 8 &6Pieces of Dark Metal&r (Born in Chaos)."
		""
		"&aHunter's reward&r — these drop from specific elite mobs in the Nether's edge regions."
	]
	quest.2F1466CEB0B375D5.quest_subtitle: "M5 still matters"
	quest.2F1466CEB0B375D5.title: "Forge Materials: Bestiary"
	quest.2F1C2B8AC5E11976.quest_desc: [
		"&6Warden Chestplate&r — the chapter's premium chestpiece, crafted from Warden carapace and reinforced echo shards."
		""
		"&7Optional but worth doing — the chest slot is the single biggest armor stat improvement available in this chapter.&r"
	]
	quest.2F1C2B8AC5E11976.title: "Warden Chestplate"
	quest.2F5D1E8DEDD27EE6.quest_desc: [
		"Three &6Burning Ashes&r — Cataclysm reagent collected from defeated Nether mobs and cataclysm structures."
		""
		"&aRequired to gear up for Cataclysm bosses.&r"
	]
	quest.2F5D1E8DEDD27EE6.quest_subtitle: "Ignis-grade ember proof."
	quest.2F5D1E8DEDD27EE6.title: "Burning Ashes"
	quest.2FD5037D4E720043.quest_desc: [
		"Acquire a &6Gold Assistant Hammer&r — the high-tier colony management tool."
		""
		"&aProof of colony mastery.&r Late-game MineColonies milestone."
	]
	quest.2FE37C2A2DD5505B.quest_desc: ["The &6Lightning Sword&r — Aether dungeon drop that arcs lightning between nearby targets on hit."]
	quest.2FE37C2A2DD5505B.title: "Lightning Sword"
	quest.3049005B6FE14734.quest_desc: [
		"The &6Stalker&r is the Otherside's signature ambush predator — patient, silent, and lethal up close."
		""
		"Drops feed into Soul Crystal recipes. Listen for it before you see it; the Otherside's audio cues matter."
	]
	quest.3049005B6FE14734.title: "Stalker"
	quest.305697393DA2FAE8.quest_desc: [
		"The complete &6Staff Collection&r — eight magical staves themed around AG biomes and creatures: brown shroom, spiderling, red shroom, frozen shroom, ent, gnome, baby yeti, and yeti."
		""
		"&5Each staff has a unique attack or summon ability.&r The yeti staff is the strongest; the others fill different niches. This is the chapter's deep pull for staff collectors."
	]
	quest.305697393DA2FAE8.quest_subtitle: "&oEight staves. Make an army."
	quest.305697393DA2FAE8.title: "&5Summoner"
	quest.306C4D4AC5E9AFDD.quest_desc: [
		"The &6Soul Stained Steel Sword&r — first real Malum weapon. Faster than iron with the soul-stained passive: deals bonus damage when swung against soul-rich targets."
		""
		"&aGreat against undead, illagers, and other soul-bearing mobs.&r"
	]
	quest.30877432D1026706.quest_desc: [
		"&6Citrine Shard&r — Pastel's gateway gemstone. Found in pastel-themed worldgen, broken into shards for crafting."
		""
		"&5Pastel is a gemstone-fusion mod&r in the magical-tradition trio. Citrine is the simplest entry; deeper gems unlock complex effects."
	]
	quest.30877432D1026706.quest_subtitle: "A prismatic tradition."
	quest.30877432D1026706.title: "Prismatic Shards"
	quest.309208FA6FB43EE6.quest_desc: [
		"&6Resonarium Pickaxe&r — the workhorse mining tool of the Deep Dark tier. Mines anything you'd expect including the deeper sculk-locked ores."
		""
		"&aBring it back into the Otherside dimension to access the higher-tier blocks Deeper Darker hides there.&r"
	]
	quest.309208FA6FB43EE6.title: "Resonarium Pickaxe"
	quest.30BAB4653F7DCC62.quest_desc: [
		"&6Elite Exporter&r — Cable Tiers' faster Exporter. Pair with an Elite Importer for matched throughput on both ends."
		""
		"&aRecommended for any node feeding into autocrafter inputs from base storage.&r"
	]
	quest.30BAB4653F7DCC62.title: "Elite Exporter"
	quest.317D9A77F0F11D68.quest_desc: [
		"&6Ice Crystal&r — a Mowzie's Mobs reagent used to summon &5Frostmaw&r, the giant ice beast. Found in cold biomes."
		""
		"&aGather a stack and pick a snowy biome before you summon — fighting Frostmaw on its home ground feels right.&r"
	]
	quest.317D9A77F0F11D68.quest_subtitle: "Summons Frostmaw"
	quest.317D9A77F0F11D68.title: "Ice Crystal"
	quest.31F70E7481C6CE82.quest_desc: [
		"&6Ancient Broken Sword&r — Ancient Hero's signature drop. Symbolic of the hero's last stand."
		""
		"&7Trophy weapon. Arguably looks better in a frame than in your hand.&r"
	]
	quest.327B6BA6B94DF9E9.quest_desc: [
		"&6Deepsilver Ingot&r — cool, dark, and mined from deep beneath the Starlight surface. Forms the core of the deepsilver armor set."
		""
		"Deepsilver gear is one of the four mid-tier armor sets in this chapter — pick the one that matches your biome and playstyle, or collect them all if you're a completionist."
	]
	quest.327B6BA6B94DF9E9.title: "Deepsilver Ingot"
	quest.329ACE742921BBBB.quest_desc: [
		"Five &6Goat Fur&r — shears it from goats. The basic insulation material for cold-weather Cold Sweat armor."
		""
		"&aGoats spawn on mountain peaks.&r Shear them like sheep; the fur regrows. Keep a few in your base for renewable warmth."
	]
	quest.32BA43DFCB5407B2.quest_desc: [
		"&6Fallen Star&r — Phantasm's signature End reagent. Found in the new End biomes the mod adds beyond the central island."
		""
		"&aPhantasm transforms the outer End from a barren chorus-fruit wasteland into a real biome ladder. Worth exploring.&r"
	]
	quest.32BA43DFCB5407B2.quest_subtitle: "End's Phantasm artifact."
	quest.32BA43DFCB5407B2.title: "Fallen Star"
	quest.33058894ACD9CB06.quest_desc: [
		"Build a &6Graveyard&r — the colony cemetery. Places to bury fallen citizens."
		""
		"&aSets up the Undertaker citizen role and the resurrection mechanic.&r"
	]
	quest.3321F8D46A99177F.quest_desc: ["&6Nether Ruby&r — Better Nether's signature gem, dropped or mined from ruby-bearing geodes. Used in upgraded weapon and template recipes."]
	quest.3321F8D46A99177F.title: "Nether Ruby"
	quest.339A80B6C7B12915.quest_desc: ["The &6Nether Beast Totem&r — Luminous Nether handheld &eproximity detector&r. When a Nether beast is nearby, the totem's eyes glow orange. It does NOT ward mobs off — it warns you they're near."]
	quest.339A80B6C7B12915.title: "Nether Beast Totem"
	quest.33BA016FBEA4E697.quest_desc: [
		"&6Magnia Attractor&r (Enderscape) — a magnetic-flavored utility item. Pulls items toward the holder."
		""
		"&aGreat for harvesting loot piles after a fight without manual pickup.&r"
	]
	quest.33BA016FBEA4E697.title: "Magnia Attractor"
	quest.33D99FA5CB244051.quest_desc: [
		"&6Storage Disk 1k&r — the smallest RS storage unit. Holds 1024 items (or 64 stacks of types, RS uses item-count not stack-count)."
		""
		"&7Mostly a stepping stone toward larger disks. Don't hoard 1k disks; upgrade them.&r"
	]
	quest.33D99FA5CB244051.title: "1k Storage Disk"
	quest.33FF440CE80B86A9.quest_desc: ["The full &6Stratus Armor Set&r — Deep Aether's apex armor, lightweight with high mobility bonuses."]
	quest.33FF440CE80B86A9.quest_subtitle: "Gravitite smithed up"
	quest.33FF440CE80B86A9.title: "Stratus Panoply"
	quest.34000000000003C1.quest_desc: [
		"The &6Stone Hoe&r is your first farming tool. Right-click on dirt or grass to till it into farmland — that's where seeds will grow."
		""
		"&aPlant near water&r so the farmland stays hydrated, otherwise it'll dry up and revert to dirt."
	]
	quest.34000000000003C1.quest_subtitle: "A hoe and a few seeds are the start of steadier food."
	quest.34000000000003C1.title: "First Farm"
	quest.34000000000003C5.quest_desc: [
		"Harvest sixteen &6Wheat&r from your fully grown crops. Wheat is the bedrock of bread, hay bales, and animal feed — the cereal that built civilizations."
		""
		"&aReplant immediately after each harvest&r to keep production rolling. Bone meal speeds growth if you're impatient."
	]
	quest.34000000000003C5.quest_subtitle: "More crop types give you better options when one season goes badly."
	quest.34000000000003C5.title: "Find More Crops"
	quest.34000000000003CD.quest_desc: [
		"Thirty-two &6Potatoes&r — a real harvest. Potatoes are caloric, easy to bulk up, and bake into baked potatoes that fill the hunger bar fast."
		""
		"Carrots and potatoes can be replanted directly without seeds, which makes them less labor-intensive than wheat once you have a starter stock."
	]
	quest.34000000000003CD.quest_subtitle: "A bigger harvest gives you room to plan ahead instead of scrambling."
	quest.34000000000003CD.title: "Seasonal Yield"
	quest.34000000000003D1.quest_desc: [
		"The &6Fishing Rod&r unlocks the second food economy. Cast into water, wait for the bobber to dip, and reel in fish, junk, and the occasional treasure."
		""
		"Fish is a renewable food source that doesn't need farmland, which makes it valuable when your crops are still growing."
	]
	quest.34000000000003D1.quest_subtitle: "Fishing gives you a backup food line when crops are slow or the season shifts."
	quest.34000000000003D1.title: "Backup Food"
	quest.3400000000001113.quest_desc: [
		"The &6Campfire&r is your first heat source. Place one and stand near it to warm up — Cold Sweat punishes you for ignoring temperature, and a fire keeps you alive on cold nights."
		""
		"You can also cook up to four pieces of food on top by right-clicking with raw meat. No fuel needed."
	]
	quest.3400000000001113.quest_subtitle: "A campfire is your first safe heat source for cold nights and shelter setup."
	quest.3400000000001113.title: "Campfire"
	quest.3400000000001116.quest_desc: [
		"The &6Furnace&r smelts ores, cooks food, and turns sand into glass. Eight cobblestone in a ring around an empty crafting slot — you'll build dozens of these over a Minecraft career."
		""
		"&aPut fuel in the bottom slot, input on top, output appears on the right.&r Coal lasts longest, but planks and saplings work in a pinch."
	]
	quest.3400000000001116.quest_subtitle: "A furnace lets you smelt glass, cook food, and start making safe water."
	quest.3400000000001116.title: "Furnace"
	quest.3400000000001119.quest_desc: [
		"A &6Bed&r lets you skip the night and sets your spawn point. Three wool over three planks — the most important block in your starter base."
		""
		"&cMonsters will interrupt your sleep if they're within sixteen blocks,&r so wall off your sleeping area before bedding down."
	]
	quest.3400000000001119.quest_subtitle: "A bed gives your shelter a safe reset point and helps you stop roaming at night."
	quest.3400000000001119.title: "Bed"
	quest.340000000000111C.quest_desc: [
		"Two &6Chests&r — your storage starts here. Place chests adjacent to each other and they'll automatically combine into a double chest with twice the slots."
		""
		"&aLabel them mentally early.&r 'Food', 'Stone', 'Wood' — you'll thank yourself in twenty hours when you're not digging through a single chaos chest."
	]
	quest.340000000000111C.quest_subtitle: "A small indoor stash makes it easier to keep survival supplies together."
	quest.340000000000111C.title: "Chest"
	quest.340000000000111F.quest_desc: [
		"Sixteen &6Torches&r — light is life. Hostile mobs spawn in dark spots, so flooding your base and mining tunnels with torches is non-negotiable."
		""
		"&aOne stick and one coal makes four torches.&r Cheap, easy, and the difference between a peaceful night and a creeper at the door."
	]
	quest.340000000000111F.quest_subtitle: "A lit shelter is safer and easier to use when night or weather turns bad."
	quest.340000000000111F.title: "Light Your Shelter"
	quest.3400000000001414.quest_desc: [
		"Punch tall grass to scatter &6Wheat Seeds&r — you'll need a small handful to start your first farm."
		""
		"Eight seeds is enough for a starter plot. From here, the food economy starts paying you back."
	]
	quest.3400000000001414.quest_subtitle: "Some crops grow better at different times of year."
	quest.3400000000001414.title: "Plant a Crop"
	quest.340000000000141D.quest_desc: [
		"A full set of &6Leather Armor&r — boots, leggings, chestplate, helmet. Cold Sweat treats leather as light insulation, so it's also a thermal layer, not just damage reduction."
		""
		"&aLeather drops from cows and horses; you can also fish it up.&r Once you've got iron, replace this set, but keep one piece around for cold-weather expeditions."
	]
	quest.340000000000141D.quest_subtitle: "Simple gear helps with early temperature pressure before better tools exist."
	quest.340000000000141D.title: "Weather Gear"
	quest.3400000000001424.quest_desc: [
		"Three wheat in a row makes one &6Bread&r — the simplest cooked food in the game and a reliable hunger anchor for your early days."
		""
		"&aBread doesn't require fuel or a furnace,&r so it's the cheapest cooked food you can produce. Bake big, eat well."
	]
	quest.3400000000001424.quest_subtitle: "A small supply of food helps when the weather turns bad."
	quest.3400000000001424.title: "Keep Food Ready"
	quest.3400000000001427.quest_desc: [
		"The &6Composter&r turns crops, seeds, and saplings into &6Bone Meal&r. Drop organic matter in until it fills, then harvest the bone meal to accelerate plant growth."
		""
		"It's a closed loop — feed the composter your crop excess and get back the fertilizer to grow more."
	]
	quest.3400000000001427.quest_subtitle: "Later, Mechanical Age tools can help with planting, harvesting, and processing food."
	quest.3400000000001427.title: "Better Farming Later"
	quest.342A1EF584823D2C.quest_desc: [
		"Add a torch recipe to a building. MineColonies' building-recipe system lets you teach colonists to craft items via assigned recipes."
		""
		"&aTeach the colony to self-supply lighting — pure quality of life.&r"
	]
	quest.344ECE9368E8366F.quest_desc: [
		"&6Aethersent Arrow&r — heavy, crystal-tipped ammunition for the Starfall Longbow. Hits harder than vanilla arrows and matches the bow's aesthetic."
		""
		"Craft them in stacks. You'll burn through them faster than you'd like once the Starlight's apex predators show up."
	]
	quest.344ECE9368E8366F.title: "Aethersent Arrow"
	quest.34C95D6E2A24D74F.quest_desc: [
		"The &6Requester&r (RSRequestify) is an automatic request agent — set it to 'keep N of item X in stock' and it submits autocraft requests when stocks dip."
		""
		"&aBuilds on the Storage Monitor's idea but with active request behavior, not just redstone signaling. The cleanest way to keep a stock list maintained.&r"
	]
	quest.34C95D6E2A24D74F.quest_subtitle: "Set it and forget it."
	quest.34C95D6E2A24D74F.title: "Requester"
	quest.35DCF8CE4CD143EB.quest_desc: [
		"The &6Void Conduit&r is Malum's item-routing block — pulls items from one inventory and sends them to another via the void."
		""
		"&aThink Create's funnel, but instant and through walls.&r Useful for sealed altar setups."
	]
	quest.360E9E02A494217C.quest_desc: [
		"Build a &6Barracks Tower&r — the corner-tower variant of the Barracks structure."
		""
		"Each tower houses additional guards beyond the main Barracks capacity."
	]
	quest.3677657520E0C0C1.quest_desc: [
		"The &6Starfall Longbow&r is the Starlight's signature ranged weapon — high draw weight, long range, and visually striking."
		""
		"Pair it with &6Aethersent Arrows&r for the full effect; ordinary arrows work but waste the bow's potential."
	]
	quest.3677657520E0C0C1.title: "Starfall Longbow"
	quest.373BA818670535A0.quest_desc: [
		"The &6Autocrafter&r is the heart of RS automation — load a pattern, the network now produces that recipe on demand."
		""
		"&5With autocrafters, the system's promise of 'request anything, the network builds it' becomes real.&r Recursive recipes (request a Controller — the system finds it doesn't have one, builds one from advanced processors, which it builds from silicon and binding, etc.) just work."
		""
		"&aBuild a row of these and dedicate each to one recipe. Trying to share autocrafters across many recipes is a path to confusion.&r"
	]
	quest.373BA818670535A0.quest_subtitle: "The network builds what you ask."
	quest.373BA818670535A0.title: "Autocrafter"
	quest.3747927FF3621EE1.quest_desc: ["&6Blue Moa Egg&r — common Moa color. Hatches into a rideable mount with limited gliding jumps."]
	quest.3747927FF3621EE1.title: "Blue Moa Egg"
	quest.379E477105EE5F9E.quest_desc: [
		"&6Mana Crystal&r — the Starlight's universal magical currency. These glowing shards grow on crystal trees and in clusters, and they feed almost every recipe in the dimension."
		""
		"Stockpile them. You will burn through them faster than you expect once you start crafting Aethersent gear and the higher-tier weapons."
	]
	quest.379E477105EE5F9E.title: "Mana Crystal"
	quest.37BE190EE466D697.quest_desc: [
		"Upgrade your &6Town Hall to level 5&r — the maximum tier of the colony's central building."
		""
		"&aLevel-5 Town Hall unlocks the highest-tier colony perks and citizen caps.&r"
	]
	quest.37E43341FA234E84.quest_desc: [
		"Build a &6Florist's Hut&r — the citizen who tends flower beds."
		""
		"Pure beauty + dye-source supplement. Pair with the Dyer for full color economy."
	]
	quest.3811D4BC332788DB.quest_desc: [
		"&6Soul Dust&r — fine, ashen residue gathered from Deep Dark soul deposits. A magical-flavored crafting reagent used in several Deeper Darker recipes."
		""
		"Pairs naturally with Soul Crystals later in the chapter. Hoard some now — the upgrade path uses a lot."
	]
	quest.3811D4BC332788DB.title: "Soul Dust"
	quest.38A6B6D54EB79323.quest_desc: [
		"&5Kill The Furnace.&r Luminous Nether's foundry boss — a giant possessed kiln that breathes fire and forges weapons mid-fight."
		""
		"&cBig HP, big damage.&r Kite, time the wind-ups, and don't melee while it's glowing."
	]
	quest.38A6B6D54EB79323.title: "The Furnace"
	quest.3950537316B58D15.quest_desc: [
		"The &6Runewood Totem Base&r anchors a Malum totem ritual. Stack rune-carved soulwood blocks on top to define a ritual circle, then activate by injecting a soul shard."
		""
		"&aRituals are how you cast big spells in Malum.&r The base is the start; the runes above it determine what the ritual does."
	]
	quest.3951D4DA061A900D.quest_desc: [
		"&6Arcane Crystals&r — the foundation of Forbidden Arcanus. Glittering shards mined from arcane crystal ore deep underground."
		""
		"&aFA's universal magical reagent.&r Stockpile a stack before going deep into the mod."
	]
	quest.3951D4DA061A900D.quest_subtitle: "The foundation."
	quest.3951D4DA061A900D.title: "Arcane Crystal"
	quest.39E394F665C85341.quest_desc: ["The &6Aeternium Shovel&r — alternate progression branch via the ingot path."]
	quest.39E394F665C85341.title: "Aeternium Shovel Head"
	quest.3A661256B68D13B5.quest_desc: ["&6Spore Bundle&r — Luminous Nether one-time-use consumable. While held, on your death it releases infectious spores that slow and damage nearby enemies. Not a crafting reagent — a get-back-up insurance item."]
	quest.3A661256B68D13B5.title: "Spore Bundle"
	quest.3ADFFFD3E319A205.quest_desc: [
		"&6Witch Eye&r — End Remastered eye dropped by witches in swamp huts (or wandering the swamp at night)."
		""
		"&aFarm a witch hut overnight; the eye drops are decent.&r"
	]
	quest.3ADFFFD3E319A205.quest_subtitle: "Brew it from a witch pupil"
	quest.3ADFFFD3E319A205.title: "A Witch's Eye"
	quest.3AE1C3290500638F.quest_desc: [
		"Reach a &6colony population of 10&r — the colony has graduated from outpost to small village."
		""
		"&aBuild more residences to support the growing population.&r"
	]
	quest.3B0F87AF02F13AF3.quest_desc: ["The &6Afterburner&r — Deep Aether item that boosts moa flight speed temporarily."]
	quest.3B0F87AF02F13AF3.quest_subtitle: "Fuels the Combiner"
	quest.3B0F87AF02F13AF3.title: "Afterburner"
	quest.3B177A2622E16785.quest_desc: [
		"The full &6Magic Ring Set&r: &6Glow Fungus Ring&r (light), &6Regeneration Ring&r (slow heal), and &6Speed Ring&r (movement boost)."
		""
		"&aWear one in a curio slot for a passive buff.&r Limited slots, so pick the one that matches your current task."
	]
	quest.3B177A2622E16785.quest_subtitle: "&oShining, Vampirism, Winds."
	quest.3B177A2622E16785.title: "&6The Medieval Rings"
	quest.3B19DD5032B7163F.quest_desc: [
		"&6Aethersent armor set&r — cape, hood, bottoms, boots. A four-piece archer's outfit with light, mobile stats and a distinctly Starlight aesthetic."
		""
		"Pair it with the &6Starfall Longbow&r for the canonical Starlight ranged build. The armor and bow share materials, so the crafting flows naturally."
	]
	quest.3B19DD5032B7163F.title: "Aethersent Set"
	quest.3B1DBEF6FB655D29.quest_desc: [
		"The second half of the herb roster: &6Brambleroot&r, &6Creeper Orchid&r, &6Exaustum Flower&r, &6Hungry Grass&r, and &6Sthirn Bush&r."
		""
		"&aThese are the more dangerous plants&r — creeper orchid hisses when disturbed, hungry grass eats hunger, exaustum drains stamina. Wear the leather glove."
	]
	quest.3B1DBEF6FB655D29.quest_subtitle: "&oBramble, orchid, allium, grass, bush."
	quest.3B1DBEF6FB655D29.title: "&6Garden Bundle B"
	quest.3B85C6C8992AFA48.quest_desc: ["The &6Wind Shield&r — Deep Aether shield that pushes enemies back when blocking."]
	quest.3B85C6C8992AFA48.title: "Wind Shield"
	quest.3B91163DE3DA885C.quest_desc: [
		"Build a &6Nether Worker's Hut&r — the citizen who travels to the Nether for nether-only resources."
		""
		"&aOne of the more advanced hut roles.&r The colony gets nether wart, blaze rods, etc., without you having to grind them."
	]
	quest.3BE223E78D122C17.quest_desc: [
		"&6Cooked End Fish&r (Better End) — End-biome fishing turned into a meal. Restores good hunger."
		""
		"&aWorth setting up a fishing spot in End water sources for emergency food.&r"
	]
	quest.3BE4B2D0C69E5D59.quest_desc: [
		"&6Resonarium&r — Deeper Darker's signature ore, mined from Deep Dark biomes. The base material for the dimension's resonating weapon and tool tree."
		""
		"This unlocks the resonarium plate → axe/sword/pickaxe path. A clean upgrade over diamond if you've been spelunking instead of dimension-hopping."
	]
	quest.3BE4B2D0C69E5D59.title: "Resonarium"
	quest.3CA89D7C376E04B8.quest_desc: ["The &6Invisibility Cloak&r — Aether curio that grants brief invisibility on a cooldown."]
	quest.3CA89D7C376E04B8.title: "Invisibility Cloak"
	quest.3CA98E14B6A82FF5.quest_desc: [
		"Ten &6Hoglin Hide&r — drops from hoglins in the Nether's crimson forests. Heavy insulation against cold (hoglins live in fire, after all), used in the heaviest Cold Sweat warm armor."
		""
		"&cHoglins are aggressive&r and will swarm you. Bring a sword, retreat to safety often, and consider building a small farm if you need volume."
	]
	quest.3D34678414E510E7.quest_desc: [
		"&5Frostmaw&r is Mowzie's Mobs' colossal ice beast — a four-armed, ice-bound apex predator that sleeps in glacial biomes until you wake it with an Ice Crystal."
		""
		"The second of three bestiary refugee bosses in this chapter. Drops powerful loot themed around frost and brute force."
		""
		"&cIt hits hard and has long-reach claws. Mobility matters more than armor here.&r"
	]
	quest.3D34678414E510E7.quest_subtitle: "Not everything dangerous lives underground."
	quest.3D34678414E510E7.title: "Kill Frostmaw"
	quest.3D3EEF2788FEEB30.quest_desc: [
		"&6Configuration Card&r — saves and copies the configuration of an importer/exporter/filter. Right-click to copy from one node, right-click again to apply to another."
		""
		"&aWhen you've finally got a perfect filter setup, this card lets you stamp it onto a dozen siblings in seconds.&r"
	]
	quest.3D3EEF2788FEEB30.title: "Configuration Card"
	quest.3DA4836445F62796.quest_desc: ["&6Skyjade Gloves&r — endgame Aether curio gauntlets that pair with the skyjade armor."]
	quest.3DA4836445F62796.title: "Skyjade Gloves"
	quest.3DAB993C5EBC76A3.quest_desc: [
		"&6Range Upgrade&r — extends the Wireless Transmitter's coverage radius. Stack multiples for serious distance."
		""
		"&aA fully-upgraded transmitter covers most of a base's surrounding territory.&r"
	]
	quest.3DAB993C5EBC76A3.title: "Range Upgrade"
	quest.3DB04EDE7D401C44.quest_desc: [
		"&6Aethersent Ingot&r — the Starlight's first metallic alloy, smelted from blue and red crystal shards together. The dimension's signature mid-tier material."
		""
		"This unlocks the &6Aethersent armor set&r and the &6Starfall Longbow&r — a complete archer kit. If you came to the Starlight for ranged combat, this is where it starts."
	]
	quest.3DB04EDE7D401C44.title: "Aethersent Ingot"
	quest.3DC34D71702473E8.quest_desc: ["The &6Cloud Cape&r — Deep Aether cape granting permanent slow-fall."]
	quest.3DC34D71702473E8.title: "Cloud Cape"
	quest.3E1B0691B2E5EEAC.quest_desc: ["&6Dark Matter&r — concentrated dark essence, the negative-energy reagent in FA's recipe chain."]
	quest.3EE311A9313570E2.quest_desc: [
		"The &6RS Wrench&r rotates and dismantles RS blocks. Sneak-right-click to disassemble cleanly with the contents preserved."
		""
		"&aKeep one in your hotbar. Disassembling without the wrench drops the block but breaks any disks/patterns inside.&r"
	]
	quest.3EE311A9313570E2.title: "Wrench"
	quest.3F33D0F200BD6ED5.quest_desc: [
		"A &6Blackwood Sapling&r from a Regions Unexplored biome. Plant it for a unique wood color that stands out from vanilla species."
		""
		"&7Optional. Useful for build palettes and themed bases.&r"
	]
	quest.3F33D0F200BD6ED5.quest_subtitle: "Different biomes have different temperatures and growing seasons, even modded biomes. For instance, a taiga is a winter biome. Only winter crops grow there. A jungle is a year-round growing biome. A desert is a summer only growing biome, so only summer crops grow there. Keep this in mind when choosing your base area, unless you're willing to build a greenhouse."
	quest.3F60F5275861D65B.quest_desc: [
		"Step through the portal into the &6Eternal Starlight&r — a perpetual twilight world of glowing crystals, drifting starfall, dense thickets, and biomes that range from frozen tundra to thermal springs to nightmare gardens."
		""
		"This is your second Renaissance dimension after the Aether. Where the Aether is bright and serene, the Starlight is dim and predatory. Light sources help, but most of the danger is at eye level."
		""
		"&cThe ambient light is low everywhere — bring torches or night vision.&r"
	]
	quest.3F60F5275861D65B.title: "Walk the Twilight"
	quest.3F77375A5E0F0FFA.quest_desc: [
		"Reach a &6colony population of 75&r — major settlement size."
		""
		"Approaching capital-city scale."
	]
	quest.3F960130E5BD7D54.quest_desc: [
		"&6Red Starlight Crystal Shard&r — the warm-toned half of the Starlight crystal pair. Found in different biomes than the blue variant, so expect to hike."
		""
		"You need both colors. Don't skimp on either."
	]
	quest.3F960130E5BD7D54.title: "Red Starlight Crystal Shard"
	quest.3FA84E00524FDB65.quest_desc: [
		"&6Diamond Crafter&r — Extra Storage's top-tier crafter. The most pattern density per block in the chapter."
		""
		"&aBy the time you have one of these, your autocrafting setup is genuinely industrial. A single Diamond Crafter can replace a wall of Autocrafters.&r"
	]
	quest.3FA84E00524FDB65.quest_subtitle: "Renaissance-tier crafter cap."
	quest.3FA84E00524FDB65.title: "Diamond Crafter"
	quest.3FBCD9ABB889DC43.quest_desc: [
		"Three Malum &6Necklaces&r: &6Hidden Blade&r (stealth crit), &6Blissful Harmony&r (passive regen), &6Mystic Mirror&r (reflect). Curio slot accessories."
		""
		"&aPick by playstyle&r — assassin, support, or counter-attack."
	]
	quest.40459B8B537D420E.quest_desc: [
		"&5Kill the Valkyrie Queen.&r The Aether's mid-tier boss in the silver dungeon. Drops the Victory Medal and unlocks the lance line."
		""
		"&cDodge her aerial sweeps&r and don't fall off the platform."
	]
	quest.40459B8B537D420E.quest_subtitle: "Ten medals, not eleven"
	quest.40459B8B537D420E.title: "Valkyrie Troopers Felled"
	quest.405561EFC0286990.quest_desc: ["&6Skyjade Moa Armor&r — barding for your moa mount, lets it tank hits in combat."]
	quest.4066BDA88DF29832.quest_desc: [
		"The &6Gnome Shovel&r — a quick, low-durability spade dropped by gnomes. Faster than a stone shovel, with a bonus when digging in mushroom or grove biomes."
		""
		"&aTrophy item.&r Useful, but you'll outclass it the moment you craft an iron shovel."
	]
	quest.4066BDA88DF29832.quest_subtitle: "&oDig like a gnome."
	quest.4066BDA88DF29832.title: "&6Gnome Shovel"
	quest.4069CFC8D4924D87.quest_desc: [
		"&5The Night Lich&r is a Bosses of Mass Destruction summon — a robed, magic-flinging arcanist with phase-changing combat patterns."
		""
		"One of three bestiary refugee bosses living in this chapter (Lich, Frostmaw, Underworld Knight). The Lich's vanilla drops are Ancient Anima, bones, diamonds, and an enchanted book; the &6Black Eye&r below is a quest reward (End Remastered's vanilla black_eye chest spawns are stripped via KubeJS, so eyes are quest-gated)."
		""
		"&cThe Lich teleports and rains projectiles — bring shielding, ranged answer, and don't fight on flat open terrain.&r"
	]
	quest.4069CFC8D4924D87.quest_subtitle: "Altar summon. Stay mobile."
	quest.4069CFC8D4924D87.title: "Night Lich"
	quest.40BA962891CC9395.quest_desc: [
		"&6Blazing Starcore Block&r — a dense, glowing block of compressed star material. The hot half of the Starcore equation."
		""
		"Holds an absurd amount of crystal energy in solid form. Makes a great late-game decoration if you have spares."
	]
	quest.40BA962891CC9395.title: "Block of Blazing Starcore"
	quest.4102FADE9DAC15F9.quest_desc: ["The &6Sun Clock&r — Deep Aether timepiece that tracks Aether's day cycle (different from Overworld)."]
	quest.4102FADE9DAC15F9.title: "Sun Clock"
	quest.4142BBE884632664.quest_desc: ["&6Enchanted Antidote&r — Deep Aether's anti-poison cure. Drink to remove all toxic effects."]
	quest.4142BBE884632664.title: "Enchanted Antidote"
	quest.4145010000010001.quest_desc: [
		"&6Certus Quartz Crystal Clusters&r grow on Crystal Growth Accelerators or naturally in geode-flavored cave deposits. Mine for shards."
		""
		"&aClusters drop more shards than direct ore mining — this is the recommended certus farm method.&r"
	]
	quest.4145010000010001.quest_subtitle: "Storage, automation, intelligence."
	quest.4145010000010001.title: "The Network"
	quest.4145010000010002.quest_desc: [
		"&6Certus Quartz Crystals&r are AE2's signature crystal. The substrate of every printed processor and the heart of the ME network."
		""
		"Mine certus quartz ore (or grow crystals) for these."
	]
	quest.4145010000010002.title: "Certus Quartz Crystal"
	quest.4145010000010003.quest_desc: [
		"&6Charged Certus Quartz Crystals&r are certus crystals exposed to high voltage in a Charger. The charged form is required for advanced AE2 recipes (fluix dust, processors)."
		""
		"&aCharge in the AE2 Charger using FE/Joules supplied to the network.&r"
	]
	quest.4145010000010003.quest_subtitle: "Now it carries a charge."
	quest.4145010000010003.title: "Charged Certus Quartz"
	quest.4145010000010004.quest_desc: [
		"&6Certus Quartz Dust&r is the powdered form — macerate certus crystals or process via any compatible crusher."
		""
		"Reagent in fluix recipes and several processor steps."
	]
	quest.4145010000010004.title: "Certus Quartz Dust"
	quest.4145010000010005.quest_desc: [
		"&6Sky Stone Block&r is found in fallen meteorites in the Overworld. Distinctive black-grey stone, AE2's signature meteorite material."
		""
		"&aMeteorites also contain AE2's processor presses — the loot is more valuable than the stone.&r"
	]
	quest.4145010000010005.quest_subtitle: "From orbit, with regrets."
	quest.4145010000010005.title: "Sky Stone Block"
	quest.4145010000010006.quest_desc: [
		"&6Sky Dust&r is the powdered form of sky stone. Used in inscribed press creation and several AE2 recipes."
		""
		"Macerate sky stone blocks."
	]
	quest.4145010000010006.title: "Sky Stone Dust"
	quest.4145010000010007.quest_desc: [
		"The &6Meteorite Compass&r points to the nearest unexplored meteorite. Essential for finding AE2's required loot."
		""
		"&aWithout meteorites, no presses; without presses, no processors. The compass is mandatory early-game AE2 gear.&r"
	]
	quest.4145010000010007.quest_subtitle: "Find the presses."
	quest.4145010000010007.title: "Meteorite Compass"
	quest.4145010000010008.quest_desc: [
		"&6Fluix Crystals&r are AE2's blue lattice-form crystal. Made by combining nether quartz + redstone + charged certus quartz in water."
		""
		"&aFluix is AE2's transmission medium — cables and connectors are built around it.&r"
	]
	quest.4145010000010008.quest_subtitle: "AE2's signature material."
	quest.4145010000010008.title: "Fluix Crystal"
	quest.4145010000010009.quest_desc: [
		"&6Fluix Dust&r is the powdered form of fluix crystal. Reagent in cable and processor recipes."
		""
		"Macerate fluix crystals."
	]
	quest.4145010000010009.title: "Fluix Dust"
	quest.414501000001000A.quest_desc: [
		"The &6Fluix Pearl&r is a compressed fluix material — the ME network's high-density storage component."
		""
		"Used in dense cables, energy acceptor, and several core network recipes."
	]
	quest.414501000001000A.title: "Fluix Pearl"
	quest.414501000001000B.quest_desc: [
		"&6AE2 Silicon&r is AE2's semiconductor — required for processor printing."
		""
		"Made from quartz dust + sand in a furnace, or compatibly tagged with other mods' silicon."
	]
	quest.414501000001000B.quest_subtitle: "Substrate of every chip."
	quest.414501000001000B.title: "Silicon"
	quest.414501000001000C.quest_desc: [
		"The &6Quartz Fixture&r is a small certus-quartz light source. Decorative + functional — emits light, mounts on walls or ceilings."
		""
		"Pure aesthetic AE2 lighting block."
	]
	quest.414501000001000C.title: "Charged Quartz Fixture"
	quest.414501000001000D.quest_desc: [
		"The &6Certus Quartz Wrench&r is AE2's configuration tool. Right-click cables to color them; sneak-right-click to remove blocks."
		""
		"Carry one alongside your engineer's hammer and IE wirecutter."
	]
	quest.414501000001000D.title: "Certus Quartz Wrench"
	quest.4145010000010010.quest_desc: [
		"The &6Crystal Resonance Generator&r is a passive FE generator that produces small amounts of energy continuously."
		""
		"Niche — not enough output for serious networks, but nice flavor."
	]
	quest.4145010000010010.title: "Crystal Resonance Generator"
	quest.4145010000010011.quest_desc: [
		"The &6Vibration Chamber&r burns solid fuel to power the ME network directly."
		""
		"Useful as a backup or starter generator before you have proper FE infrastructure plumbed into the network."
	]
	quest.4145010000010011.title: "Vibration Chamber"
	quest.4145010000010012.quest_desc: [
		"The &6Logic Processor Press&r is one of AE2's three press loots. Looted from sky stone meteorite chests."
		""
		"&aRequired to print Logic Processors — the cheap-tier AE2 processor used in most basic ME components.&r Without this press, you can't build an ME network."
	]
	quest.4145010000010012.quest_subtitle: "Meteorite loot."
	quest.4145010000010012.title: "Logic Processor Press"
	quest.4145010000010013.quest_desc: [
		"The &6Calculation Processor Press&r is the second AE2 press — also looted from meteorites."
		""
		"&aPrints Calculation Processors used in storage cells, terminals, and pattern providers.&r The mid-tier AE2 processor."
	]
	quest.4145010000010013.quest_subtitle: "Meteorite loot."
	quest.4145010000010013.title: "Calculation Processor Press"
	quest.4145010000010014.quest_desc: [
		"The &6Engineering Processor Press&r is the third (and rarest) AE2 press. Top-tier processor."
		""
		"&aRequired for the controller, dense cables, and the highest-tier AE2 components.&r"
	]
	quest.4145010000010014.quest_subtitle: "Meteorite loot."
	quest.4145010000010014.title: "Engineering Processor Press"
	quest.4145010000010015.quest_desc: [
		"The &6Silicon Press&r is the fourth meteorite press. Prints raw silicon wafers used in processor recipes."
		""
		"All four presses (Logic, Calculation, Engineering, Silicon) are needed for the full processor chain."
	]
	quest.4145010000010015.quest_subtitle: "Meteorite loot."
	quest.4145010000010015.title: "Silicon Press"
	quest.4145010000010016.quest_desc: [
		"The &6Inscriber&r is AE2's processor-printing machine. Slot a press top + bottom, feed a substrate (silicon or processor blank), and produce printed processors."
		""
		"&aThree inscribers running in parallel saves enormous time.&r One per processor type is ideal."
	]
	quest.4145010000010016.quest_subtitle: "All four presses collected."
	quest.4145010000010016.title: "Inscriber"
	quest.4145010000010017.quest_desc: [
		"&6Printed Silicon&r is the silicon wafer output of the Silicon Press. Substrate for processor printing."
		""
		"Combines with redstone (logic), pure certus (calculation), or pure fluix (engineering) in subsequent inscriber steps."
	]
	quest.4145010000010017.quest_subtitle: "Processor base."
	quest.4145010000010017.title: "Printed Silicon"
	quest.4145010000010018.quest_desc: [
		"&6Printed Logic Processor&r is the redstone-imprinted half of a Logic Processor."
		""
		"Combines with printed silicon in a third inscriber pass to produce the finished processor."
	]
	quest.4145010000010018.title: "Printed Logic Circuit"
	quest.4145010000010019.quest_desc: [
		"&6Printed Calculation Processor&r is the certus-imprinted half. Combines with printed silicon to make the finished processor."
		""
		"Mid-tier processor stage."
	]
	quest.4145010000010019.title: "Printed Calculation Circuit"
	quest.414501000001001A.quest_desc: [
		"&6Printed Engineering Processor&r is the fluix-imprinted half — top-tier processor stage."
		""
		"The most valuable processor; controller and dense cables can't be made without it."
	]
	quest.414501000001001A.title: "Printed Engineering Circuit"
	quest.414501000001001B.quest_desc: [
		"The &6Logic Processor&r is AE2's basic processor. Used in storage cells, basic terminals, IO components."
		""
		"&aMass-produce these — almost every AE2 component recipe uses logic processors.&r"
	]
	quest.414501000001001B.title: "Logic Processor"
	quest.414501000001001C.quest_desc: [
		"The &6Calculation Processor&r is AE2's mid-tier processor. Used in mid-capacity storage cells, smart cables, and several network components."
		""
		"Output of the inscriber printing chain."
	]
	quest.414501000001001C.title: "Calculation Processor"
	quest.414501000001001D.quest_desc: [
		"The &6Engineering Processor&r is AE2's top-tier processor. Required for the controller, dense cables, P2P tunnels, and the largest storage cells."
		""
		"&aThe gating processor for the rest of AE2's content.&r"
	]
	quest.414501000001001D.quest_subtitle: "AE2's advanced chip."
	quest.414501000001001D.title: "Engineering Processor"
	quest.414501000001001E.quest_desc: [
		"&6Quartz Fiber&r is a non-conducting cable element — carries energy across a network without affecting channels."
		""
		"Useful for cross-network energy bridging without merging channel groups."
	]
	quest.414501000001001E.quest_subtitle: "Network foundation."
	quest.414501000001001E.title: "Quartz Fiber"
	quest.414501000001001F.quest_desc: [
		"The &6Fluix Glass Cable&r is AE2's basic transmission line. Carries up to 8 channels of network traffic."
		""
		"&aAE2's channel system gates network bandwidth.&r Each device counts as one channel; cables limit how many channels can pass through."
	]
	quest.414501000001001F.quest_subtitle: "8-channel backbone."
	quest.414501000001001F.title: "ME Glass Cable"
	quest.4145010000010020.quest_desc: [
		"The &6Fluix Covered Cable&r is the insulated variant of the glass cable. Same channel capacity, opaque."
		""
		"Aesthetic alternative when you don't want to see the wire."
	]
	quest.4145010000010020.title: "ME Covered Cable"
	quest.4145010000010021.quest_desc: [
		"The &6Fluix Smart Cable&r shows live channel utilization — colored stripes light up as channels pass through."
		""
		"&aIndispensable for debugging busy ME networks.&r If a device isn't getting power or data, smart cables show exactly where the channel count maxes out."
	]
	quest.4145010000010021.title: "ME Smart Cable"
	quest.4145010000010022.quest_desc: [
		"The &6Fluix Covered Dense Cable&r is the high-bandwidth cable variant — carries up to 32 channels."
		""
		"&aUse dense cables for backbone runs in larger networks.&r Standard cables for branches."
	]
	quest.4145010000010022.title: "ME Dense Covered Cable"
	quest.4145010000010023.quest_desc: [
		"The &6Fluix Smart Dense Cable&r is the dense cable with channel monitoring. 32 channels with live utilization display."
		""
		"Top-tier debugging cable."
	]
	quest.4145010000010023.title: "ME Dense Smart Cable"
	quest.4145010000010024.quest_desc: [
		"The &6Energy Acceptor&r is AE2's FE-to-network bridge. FE flows in; the network's internal AE energy comes out."
		""
		"&aThe entry point for power into your ME network.&r Without this, your processors and drives go offline."
	]
	quest.4145010000010024.quest_subtitle: "FE → AE2 energy."
	quest.4145010000010024.title: "Energy Acceptor"
	quest.4145010000010025.quest_desc: [
		"The &6Energy Cell&r is AE2's network energy buffer. Stores AE2 internal energy."
		""
		"Pair with energy acceptors and dense cells to build a buffer that smooths over generator dropouts."
	]
	quest.4145010000010025.title: "Energy Cell"
	quest.4145010000010026.quest_desc: [
		"The &6Dense Energy Cell&r is the high-capacity energy buffer — 8x the capacity of a standard energy cell."
		""
		"Required when running a large network with high-bandwidth crafting."
	]
	quest.4145010000010026.title: "Dense Energy Cell"
	quest.4145010000010027.quest_desc: [
		"The &6ME Controller&r is the brain of an ME network. Provides channels, regulates traffic, and enforces network identity."
		""
		"&aMandatory for any network larger than the 8-channel ad-hoc limit.&r Multiple controller blocks form a multiblock for higher channel capacity."
		""
		"&cWithout a controller, your network is limited to 8 channels total.&r With one, you scale to dozens or hundreds."
	]
	quest.4145010000010027.quest_subtitle: "Network brain."
	quest.4145010000010027.title: "ME Controller"
	quest.4145010000010028.quest_desc: [
		"The &6Drive&r holds up to 10 storage cells. The cells inside form the network's storage pool."
		""
		"&aOne drive can hold a starter base; ten drives can hold a full progression run.&r"
	]
	quest.4145010000010028.quest_subtitle: "Digital storage hub."
	quest.4145010000010028.title: "ME Drive"
	quest.4145010000010029.quest_desc: [
		"The &61k Item Storage Cell&r is AE2's smallest item storage cell. Holds up to 1024 bytes of items."
		""
		"Entry-level storage; you'll graduate to larger cells fast."
	]
	quest.4145010000010029.quest_subtitle: "Digital storage begins."
	quest.4145010000010029.title: "1k ME Storage Cell"
	quest.414501000001002A.quest_desc: [
		"The &6Terminal&r is AE2's network access point. Right-click to view the network's full inventory and pull/push items."
		""
		"&aThis is how you interact with the ME network as a player.&r Place several around your base for convenient access."
	]
	quest.414501000001002A.quest_subtitle: "Your network lives."
	quest.414501000001002A.title: "ME Terminal"
	quest.414501000001002B.quest_desc: [
		"The &64k Item Storage Cell&r is the next storage tier — 4096 bytes capacity."
		""
		"Sweet-spot for early-mid game; stores enough variety to consolidate your starter chests."
	]
	quest.414501000001002B.quest_subtitle: "Scaling up."
	quest.414501000001002B.title: "4k Storage Cell"
	quest.414501000001002C.quest_desc: [
		"The &616k Item Storage Cell&r holds 16384 bytes. The mid-game standard."
		""
		"Cheap to expand; pair multiples in one drive for serious bulk storage."
	]
	quest.414501000001002C.title: "16k Storage Cell"
	quest.414501000001002D.quest_desc: [
		"The &664k Item Storage Cell&r is large-capacity storage. Holds most of a serious base's inventory in a single cell."
		""
		"&aUpgrading drives to 64k cells is the late-IR storage milestone.&r"
	]
	quest.414501000001002D.title: "64k Storage Cell"
	quest.414501000001002E.quest_desc: [
		"The &6256k Item Storage Cell&r is AE2's high-tier item cell. 262,144 bytes — effectively unlimited for a single base."
		""
		"Top-tier IR-era item storage."
	]
	quest.414501000001002E.quest_subtitle: "Maximum density."
	quest.414501000001002E.title: "256k Storage Cell"
	quest.414501000001002F.quest_desc: [
		"The &6Item Cell Housing&r is the empty shell for an item storage cell. Combines with a storage component to make a full cell."
		""
		"Recyclable: dump a cell's contents and reclaim the housing for re-use."
	]
	quest.414501000001002F.title: "Item Cell Housing"
	quest.4145010000010030.quest_desc: [
		"The &61k Fluid Storage Cell&r is AE2's smallest fluid cell. Holds fluids in the network — water, lava, biodiesel, anything."
		""
		"Mirror of the item cell, but for fluids."
	]
	quest.4145010000010030.title: "1k Fluid Cell"
	quest.4145010000010031.quest_desc: [
		"The &64k Fluid Storage Cell&r is the next fluid tier."
		""
		"Useful for buffering oil refinery output in-network rather than in physical tanks."
	]
	quest.4145010000010031.title: "4k Fluid Cell"
	quest.4145010000010032.quest_desc: [
		"The &616k Fluid Storage Cell&r holds 16k bytes of fluid. Standard mid-game fluid storage."
		""
		"Pair with fluid I/O ports for refinery-output management."
	]
	quest.4145010000010032.title: "16k Fluid Cell"
	quest.4145010000010033.quest_desc: [
		"The &664k Fluid Storage Cell&r is large-capacity fluid storage. Holds most fluid types your base will produce."
		""
		"Late-IR fluid storage milestone."
	]
	quest.4145010000010033.title: "64k Fluid Cell"
	quest.4145010000010034.quest_desc: [
		"The &6256k Fluid Storage Cell&r is AE2's top-tier fluid cell."
		""
		"Effectively unlimited fluid storage in one slot."
	]
	quest.4145010000010034.title: "256k Fluid Cell"
	quest.4145010000010035.quest_desc: [
		"The &6Fluid Cell Housing&r is the empty fluid-cell shell. Same logic as item housing — recyclable."
		""
		"Reuse housings to save on AE2 base components."
	]
	quest.4145010000010035.title: "Fluid Cell Housing"
	quest.4145010000010036.quest_desc: [
		"The &6ME Chest&r is AE2's all-in-one storage cell access. Slot in a single cell; access its contents without a drive."
		""
		"&aGreat for pocket networks and starter bases — a single cell + chest = working ME storage.&r"
	]
	quest.4145010000010036.title: "ME Chest"
	quest.4145010000010037.quest_desc: [
		"The &6IO Port&r processes cells in bulk — pull contents into the network from cells, or push network contents back into cells."
		""
		"Indispensable for migrating storage between drives or backing up a network's contents."
	]
	quest.4145010000010037.title: "ME IO Port"
	quest.4145010000010038.quest_desc: [
		"The &6Storage Bus&r presents an external inventory to the ME network as if it were a storage cell. Network sees the chest contents directly."
		""
		"&aHook external storage chests, IE/IF/Mek tanks, even drawers into your network without manually piping.&r"
	]
	quest.4145010000010038.quest_subtitle: "External storage bridge."
	quest.4145010000010038.title: "Storage Bus"
	quest.4145010000010039.quest_desc: [
		"The &6Import Bus&r pulls items from an external inventory into the ME network."
		""
		"Pair with machine outputs to auto-vacuum products into ME storage."
	]
	quest.4145010000010039.title: "Import Bus"
	quest.414501000001003A.quest_desc: [
		"The &6Export Bus&r pushes items from the ME network into an external inventory. Configurable filters, redstone control."
		""
		"&aAutomate machine input feeding from network storage.&r"
	]
	quest.414501000001003A.title: "Export Bus"
	quest.414501000001003B.quest_desc: [
		"The &6Formation Plane&r places blocks from the network into the world along a configurable plane area."
		""
		"Useful for cobblegen automation, quarry-style block placement, and several creative-flavored builds."
	]
	quest.414501000001003B.quest_subtitle: "Network → world."
	quest.414501000001003B.title: "Formation Plane"
	quest.414501000001003C.quest_desc: [
		"The &6Annihilation Plane&r breaks blocks in front of it and pulls the drops into the network."
		""
		"Pair with a Formation Plane for full automated quarry-flavored block cycling."
	]
	quest.414501000001003C.quest_subtitle: "World → network."
	quest.414501000001003C.title: "Annihilation Plane"
	quest.414501000001003D.quest_desc: [
		"The &6Cell Workbench&r partitions storage cells. Configure a cell to only accept specific item types."
		""
		"&aPartitioning is how you keep ore and product types organized in dedicated cells.&r"
	]
	quest.414501000001003D.title: "Cell Workbench"
	quest.414501000001003E.quest_desc: [
		"The &6Storage Monitor&r displays a network's stock of one specific item, on a wall-mounted face."
		""
		"Glance-information for important resource counts."
	]
	quest.414501000001003E.title: "Storage Monitor"
	quest.414501000001003F.quest_desc: [
		"The &6Conversion Monitor&r is a storage monitor + dispense interface — right-click the monitor to deposit/withdraw the configured item directly."
		""
		"&aFastest way to access a specific item without opening a terminal.&r"
	]
	quest.414501000001003F.title: "Conversion Monitor"
	quest.4145010000010040.quest_desc: [
		"The &6Level Emitter&r outputs a redstone signal when the network's quantity of a configured item crosses a threshold."
		""
		"&aThe core of AE2 redstone-driven automation.&r Trigger machines on/off based on network stock."
	]
	quest.4145010000010040.title: "Level Emitter"
	quest.4145010000010041.quest_desc: [
		"The &6Energy Level Emitter&r outputs redstone based on stored energy levels in the network."
		""
		"Useful for automating backup generators that fire only when energy buffer dips below a threshold."
	]
	quest.4145010000010041.title: "Energy Level Emitter"
	quest.4145010000010042.quest_desc: [
		"The &6Basic Card&r is an AE2 upgrade card — slots into machines and terminals to alter behavior."
		""
		"Different cards do different things: capacity, speed, fuzzy matching, etc."
	]
	quest.4145010000010042.title: "Basic Card"
	quest.4145010000010043.quest_desc: [
		"The &6Advanced Card&r is the upgraded card variant — required for higher-tier upgrades like the Quantum Bridge card."
		""
		"Crafted from advanced processors."
	]
	quest.4145010000010043.title: "Advanced Card"
	quest.4145010000010044.quest_desc: [
		"The &6Speed Card&r boosts the operation rate of buses, monitors, and several other AE2 components."
		""
		"Stack multiple cards (up to four) per slot for cumulative speedup."
	]
	quest.4145010000010044.quest_subtitle: "Card catalog representative."
	quest.4145010000010044.title: "Acceleration Card"
	quest.4145010000010045.quest_desc: [
		"The &6Pastel Fluix Cluster&r is Pastel addon's accelerated fluix-growth result. Faster than vanilla AE2 fluix recipes."
		""
		"&aPastel addon adds simplified ME logistics flavored as quality-of-life enhancements.&r"
	]
	quest.4145010000010045.quest_subtitle: "Alternative crystal growing."
	quest.4145010000010045.title: "Fluix Cluster (Pastel)"
	quest.4145010000010046.quest_desc: [
		"The &6Molecular Assembler&r is AE2's autocrafting machine. Combined with patterns, it executes one crafting recipe per pattern slot per tick."
		""
		"&aThe core of AE2 autocrafting — this is what executes the recipes you've encoded.&r"
	]
	quest.4145010000010046.quest_subtitle: "Autocrafting begins."
	quest.4145010000010046.title: "Molecular Assembler"
	quest.4145010000010047.quest_desc: [
		"The &6Blank Pattern&r is the substrate for AE2 patterns. Encode a recipe into it via the Pattern Encoding Terminal."
		""
		"Mass-produce these; you'll have hundreds of patterns in a serious autocrafting setup."
	]
	quest.4145010000010047.title: "Blank Pattern"
	quest.4145010000010048.quest_desc: [
		"The &6Crafting Pattern&r is an encoded blank pattern with a vanilla recipe inside."
		""
		"Slot into a Pattern Provider; molecular assemblers execute the recipe automatically when ingredients are available."
	]
	quest.4145010000010048.title: "Crafting Pattern"
	quest.4145010000010049.quest_desc: [
		"The &6Processing Pattern&r encodes a non-shaped machine recipe — ore → ingot in a furnace, or component → output in a custom machine."
		""
		"&aProcessing patterns route through external machines, not the molecular assembler.&r"
	]
	quest.4145010000010049.title: "Processing Pattern"
	quest.414501000001004A.quest_desc: [
		"The &6Smithing Table Pattern&r encodes a vanilla smithing-table recipe (netherite upgrades, trim applications)."
		""
		"Slot into a Pattern Provider for smithing-line autocrafting."
	]
	quest.414501000001004A.title: "Smithing Table Pattern"
	quest.414501000001004B.quest_desc: [
		"The &6Stonecutting Pattern&r encodes a vanilla stonecutter recipe (slabs, stairs, polished variants)."
		""
		"Pair with a Pattern Provider near a stonecutter for stone-product autocrafting."
	]
	quest.414501000001004B.title: "Stonecutting Pattern"
	quest.414501000001004C.quest_desc: [
		"The &6Pattern Encoding Terminal&r is where blank patterns are encoded with recipes."
		""
		"&aThe primary pattern-authoring interface.&r Place near your terminal for convenient recipe encoding."
	]
	quest.414501000001004C.quest_subtitle: "Recipe encoder."
	quest.414501000001004C.title: "Pattern Encoding Terminal"
	quest.414501000001004D.quest_desc: [
		"The &6Pattern Access Terminal&r is a network-wide pattern viewer and modifier. Edit patterns from anywhere in the base."
		""
		"Saves runs to specific machines when patterns need updating."
	]
	quest.414501000001004D.title: "Pattern Access Terminal"
	quest.414501000001004E.quest_desc: [
		"The &6Interface&r is AE2's bidirectional network port for external machines. Items in the interface inventory mirror to the network and vice versa."
		""
		"Older AE2 design; mostly replaced by Pattern Provider for modern autocrafting."
	]
	quest.414501000001004E.title: "ME Interface"
	quest.414501000001004F.quest_desc: [
		"The &6Pattern Provider&r is AE2's autocrafting brain. Holds patterns; pushes recipes to the machines connected to its faces."
		""
		"&aThe successor to the Interface for autocrafting.&r Each face can talk to a different machine for parallel processing."
	]
	quest.414501000001004F.quest_subtitle: "Recipe dispatcher."
	quest.414501000001004F.title: "ME Pattern Provider"
	quest.4145010000010050.quest_desc: [
		"The &6Crafting Unit&r is the structural element of an autocrafting CPU multiblock. Combines with crafting storage and accelerators to form the multiblock."
		""
		"More units = larger CPU footprint (cosmetic)."
	]
	quest.4145010000010050.title: "Crafting Unit"
	quest.4145010000010051.quest_desc: [
		"The &61k Crafting Storage&r is the smallest CPU memory tier. Limits how complex a single crafting job can be."
		""
		"&aFor a serious autocrafting setup, you'll want 64k or 256k storage in your CPU.&r"
	]
	quest.4145010000010051.title: "1k Crafting Storage"
	quest.4145010000010052.quest_desc: [
		"The &64k Crafting Storage&r is the next memory tier. Handles mid-size crafting jobs."
		""
		"Stack multiple in one CPU for cumulative capacity."
	]
	quest.4145010000010052.title: "4k Crafting Storage"
	quest.4145010000010053.quest_desc: [
		"The &616k Crafting Storage&r is the standard mid-game CPU memory."
		""
		"Enough for most multi-step automated crafts."
	]
	quest.4145010000010053.title: "16k Crafting Storage"
	quest.4145010000010054.quest_desc: [
		"The &664k Crafting Storage&r is large-capacity CPU memory. Handles complex multi-machine crafts."
		""
		"Required for pattern chains involving many intermediate steps."
	]
	quest.4145010000010054.title: "64k Crafting Storage"
	quest.4145010000010055.quest_desc: [
		"The &6256k Crafting Storage&r is AE2's top-tier CPU memory. Effectively unbounded for any reasonable crafting job."
		""
		"Late-IR autocrafting milestone."
	]
	quest.4145010000010055.title: "256k Crafting Storage"
	quest.4145010000010056.quest_desc: [
		"The &6Crafting Co-Processor&r adds parallel-recipe execution to a CPU multiblock. More accelerators = more recipes running simultaneously."
		""
		"&aMassive throughput jump for big autocrafting jobs.&r"
	]
	quest.4145010000010056.title: "Crafting Co-Processing Unit"
	quest.4145010000010057.quest_desc: [
		"The &6Crafting Monitor&r displays the CPU's currently-executing job on a wall-mounted face."
		""
		"Glance-information for autocrafting status."
	]
	quest.4145010000010057.quest_subtitle: "Autocrafting hub complete."
	quest.4145010000010057.title: "Crafting Monitor"
	quest.4145010000010058.quest_desc: [
		"The &6Crystal Apothecary&r is Pastel addon's automated crystal harvester. Place near growth accelerators; auto-collects mature crystals."
		""
		"&aZero-attention crystal farming. Plug into your network and forget.&r"
	]
	quest.4145010000010058.quest_subtitle: "Pastel hook — passive gem harvester."
	quest.4145010000010058.title: "Crystal Apothecary (Pastel)"
	quest.4145010000010059.quest_desc: [
		"The &6Wireless Receiver&r is the wireless-terminal pickup component — required to craft wireless terminal items."
		""
		"Range-limited; pair with boosters for further reach."
	]
	quest.4145010000010059.quest_subtitle: "Cut the cables."
	quest.4145010000010059.title: "Wireless Receiver"
	quest.414501000001005A.quest_desc: [
		"The &6Wireless Booster&r extends wireless terminal range. Slot into wireless devices for further pickup distance."
		""
		"Stack multiple for additive range."
	]
	quest.414501000001005A.title: "Wireless Booster"
	quest.414501000001005B.quest_desc: [
		"The &6Wireless Access Point&r is the network-side block for wireless terminals. Place near your controller for full network coverage."
		""
		"&aMust be powered and within range of the holder for wireless terminals to function.&r"
	]
	quest.414501000001005B.quest_subtitle: "Network antenna."
	quest.414501000001005B.title: "Wireless Access Point"
	quest.414501000001005C.quest_desc: [
		"The &6Wireless Terminal&r is a portable handheld terminal. Access the network from anywhere within wireless range."
		""
		"Indispensable for big bases; carry one and never visit a wall terminal again."
	]
	quest.414501000001005C.title: "Wireless Terminal"
	quest.414501000001005D.quest_desc: [
		"The &6Wireless Crafting Terminal&r is the wireless terminal upgrade with autocrafting access. Trigger crafts from the field."
		""
		"Combine with patterns and a CPU for fully remote autocrafting."
	]
	quest.414501000001005D.title: "Wireless Crafting Terminal"
	quest.414501000001005E.quest_desc: [
		"The &6Wireless Pattern Encoding Terminal&r (AE2WTLib) lets you encode patterns from anywhere in the field."
		""
		"&aAuthor patterns without returning to your encoding bench.&r"
	]
	quest.414501000001005E.title: "Wireless Pattern Encoding Terminal"
	quest.414501000001005F.quest_desc: [
		"The &6Wireless Pattern Access Terminal&r (AE2WTLib) is the wireless variant of the pattern access terminal."
		""
		"Edit your network's patterns remotely."
	]
	quest.414501000001005F.title: "Wireless Pattern Access Terminal"
	quest.4145010000010060.quest_desc: [
		"The &6Magnet Card&r (AE2WTLib) auto-pulls dropped items into the network when slotted into a wireless terminal."
		""
		"&aFantastic for mob farms — drops vacuum directly into ME storage.&r"
	]
	quest.4145010000010060.title: "Magnet Card"
	quest.4145010000010061.quest_desc: [
		"The &6Quantum Bridge Card&r (AE2WTLib) extends wireless terminal range across an AE2 quantum bridge link."
		""
		"Effectively unlimited range when paired with a properly built quantum network."
	]
	quest.4145010000010061.title: "Quantum Bridge Card"
	quest.4145010000010062.quest_desc: [
		"The &6Wireless Universal Terminal&r combines all wireless terminal types into one handheld device."
		""
		"&aLate-IR wireless capstone — one item replaces a hotbar of specialized terminals.&r"
	]
	quest.4145010000010062.quest_subtitle: "One terminal to rule them all."
	quest.4145010000010062.title: "Wireless Universal Terminal"
	quest.4145010000010063.quest_desc: [
		"&6IE ME Wirecoil&r is Immersive Engineering's ME-network compatible wire coil. Carries ME channel data over IE-wire-style runs."
		""
		"&aBridges AE2 networks across long IE-wire spans.&r Cleaner than running fluix cable everywhere."
	]
	quest.4145010000010063.quest_subtitle: "IE-style ME cabling."
	quest.4145010000010063.title: "ME Wire Coil"
	quest.4145010000010064.quest_desc: [
		"&6IE ME Dense Wirecoil&r is the high-channel IE/ME bridge wire variant. Carries dense-cable-equivalent channel counts."
		""
		"For backbone runs across IE infrastructure."
	]
	quest.4145010000010064.title: "Dense ME Wire Coil"
	quest.4145010000010065.quest_desc: [
		"The &6IE ME Connector&r is the IE-style connector that interfaces with an ME wirecoil run."
		""
		"Place at endpoints; route to AE2 network components on the inside."
	]
	quest.4145010000010065.title: "ME Connector"
	quest.4145010000010066.quest_desc: [
		"The &6IE ME Connector Relay&r is the mid-run repeater for ME wirecoil runs. Extends usable range without channel loss."
		""
		"Place along long IE-style ME runs to maintain signal."
	]
	quest.4145010000010066.quest_subtitle: "Wireless ME repeater."
	quest.4145010000010066.title: "ME Relay"
	quest.4145010000010067.quest_desc: [
		"The &6ME P2P Tunnel&r is AE2's general point-to-point bridge — the base form. Configure with frequencies for any tunnel type."
		""
		"&aP2P tunnels carry one signal type across a single cable.&r Bundle many P2P tunnels into one cable run."
	]
	quest.4145010000010067.quest_subtitle: "Point-to-point."
	quest.4145010000010067.title: "ME P2P Tunnel"
	quest.4145010000010068.quest_desc: [
		"The &6Item P2P Tunnel&r carries item flow point-to-point across the ME network."
		""
		"&aMove a chest's contents from one base to another via a single fluix cable.&r"
	]
	quest.4145010000010068.title: "Item P2P Tunnel"
	quest.4145010000010069.quest_desc: [
		"The &6Fluid P2P Tunnel&r is the fluid-flow version of the P2P tunnel."
		""
		"Carry refinery output from a remote pumping site to your main base on a single cable."
	]
	quest.4145010000010069.title: "Fluid P2P Tunnel"
	quest.414501000001006A.quest_desc: [
		"The &6FE P2P Tunnel&r carries FE energy point-to-point."
		""
		"Bridge FE generation across long distances without running heavy cable."
	]
	quest.414501000001006A.title: "Energy P2P Tunnel"
	quest.414501000001006B.quest_desc: [
		"The &6Redstone P2P Tunnel&r carries redstone signal point-to-point. Bypass the 15-block redstone-wire decay."
		""
		"&aUseful for long-range mechanical control circuits in big bases.&r"
	]
	quest.414501000001006B.title: "Redstone P2P Tunnel"
	quest.414501000001006C.quest_desc: [
		"The &6Light P2P Tunnel&r carries light values point-to-point. Pipe sunlight from outdoor receivers to indoor emitters."
		""
		"Useful for indoor crop farms and atmospheric lighting."
	]
	quest.414501000001006C.title: "Light P2P Tunnel"
	quest.414501000001006D.quest_desc: [
		"The &6Spatial Pylon&r is a corner element of AE2's spatial IO multiblock. Forms a 3D bounding box for spatial storage."
		""
		"&aThe spatial system stores entire 3D regions in cells — pocket bases.&r"
	]
	quest.414501000001006D.quest_subtitle: "Dimensional storage."
	quest.414501000001006D.title: "Spatial Pylon"
	quest.414501000001006E.quest_desc: [
		"The &6Spatial IO Port&r is the I/O for spatial cells. Capture or restore the bounded region defined by spatial pylons."
		""
		"Mirror of the standard IO port for spatial-storage cells."
	]
	quest.414501000001006E.quest_subtitle: "Spatial controller."
	quest.414501000001006E.title: "Spatial IO Port"
	quest.414501000001006F.quest_desc: [
		"The &6Spatial Anchor&r forces chunkloading on the chunk it occupies. Power it; the chunk stays loaded."
		""
		"&aEssential for remote ore-processing outposts where you need machines to keep running while you're away.&r"
	]
	quest.414501000001006F.title: "Spatial Anchor"
	quest.4145010000010070.quest_desc: [
		"The &6Spatial Storage Cell (2³)&r is the small-region spatial cell. Stores a 2x2x2 region."
		""
		"Mostly a curiosity; the larger cells are where spatial storage shines."
	]
	quest.4145010000010070.title: "2-Cubed Spatial Cell"
	quest.4145010000010071.quest_desc: [
		"The &6Spatial Storage Cell (16³)&r holds a 16-cube region. Store a small base or workshop in one cell."
		""
		"Mid-tier spatial cell."
	]
	quest.4145010000010071.title: "16-Cubed Spatial Cell"
	quest.4145010000010072.quest_desc: [
		"The &6Spatial Storage Cell (128³)&r holds a 128-cube region. Effectively a full base in one cell."
		""
		"&aTop-tier spatial cell — physically store entire dimensions in one slot.&r"
	]
	quest.4145010000010072.title: "128-Cubed Spatial Cell"
	quest.4145010000010073.quest_desc: [
		"The &6Condenser&r destroys items into matter balls or singularities. Useful for safely deleting overflow items."
		""
		"Required input for the singularity chain — you can't make singularities any other way."
	]
	quest.4145010000010073.title: "Matter Condenser"
	quest.4145010000010074.quest_desc: [
		"The &6Singularity&r is a condensed matter ball — the input to entangled singularities for quantum bridges."
		""
		"Made by feeding 256,000 items into a Condenser. A serious commitment."
	]
	quest.4145010000010074.title: "Singularity"
	quest.4145010000010075.quest_desc: [
		"The &6Quantum Entangled Singularity&r is two paired singularities that share state across distance. The core of AE2's quantum bridge."
		""
		"&aPlace one half in each location; the bridge ports the network across the link.&r Two halves crafted from the same recipe pair are entangled with each other — they're the only ones that pair."
	]
	quest.4145010000010075.quest_subtitle: "Entangled pair."
	quest.4145010000010075.title: "Quantum Entangled Singularity"
	quest.4145010000010076.quest_desc: [
		"The &6Quantum Ring&r is the structural element of the quantum bridge multiblock. Forms a frame around the entangled singularity."
		""
		"Eight rings + one link = a complete quantum bridge end."
	]
	quest.4145010000010076.quest_subtitle: "Cross-dimensional link."
	quest.4145010000010076.title: "Quantum Ring"
	quest.4145010000010077.quest_desc: [
		"The &6Quantum Link&r is the central block of the quantum bridge — holds the entangled singularity."
		""
		"&aOne link per bridge end. Pair the singularity with its match on the other side.&r"
	]
	quest.4145010000010077.quest_subtitle: "Instant cross-world ME."
	quest.4145010000010077.title: "Quantum Link Chamber"
	quest.4145010000010078.quest_desc: [
		"The &664k Item Storage Cell&r confirms your large-capacity storage tier is reached."
		""
		"&aThe ME network is now serious bulk storage.&r From here, you scale into 256k cells and beyond."
	]
	quest.4145010000010078.quest_subtitle: "Digital infrastructure mastered."
	quest.4145010000010078.title: "&6The Network Complete&r"
	quest.4145010000010079.quest_desc: [
		"The &6Comparator Gate&r (ProjectRed integration) is the analog-comparison logic gate — emits redstone signal based on relative input strengths."
		""
		"Single-block replacement for the vanilla comparator block."
	]
	quest.4145010000010079.quest_subtitle: "&7Optional: stock-aware autocrafting triggers.&r"
	quest.4145010000010079.title: "Network Awareness"
	quest.414501000001007A.quest_desc: [
		"The &6Bus Transceiver Gate&r (ProjectRed integration) splits or merges bundled redstone signals into individual lines."
		""
		"&aThe interface between bundled wire and discrete signals.&r Required when mixing bundled networks with non-bundled gates."
	]
	quest.414501000001007A.quest_subtitle: "&7Optional: 16-channel signal multiplexing.&r"
	quest.414501000001007A.title: "16-Channel Control"
	quest.414501000001007B.title: "Region: Storage"
	quest.414501000001007C.title: "Region: Automation"
	quest.414C010000010001.quest_desc: [
		"The &6Autocrafter&r is AssemblyLine's automated crafting block. Place a recipe in the slot; pipe in materials; finished items come out."
		""
		"&aSimpler than AE2 autocrafting — one block per recipe, no patterns or networks needed.&r Useful for high-frequency single-recipe automation alongside your ME network."
	]
	quest.414C010000010001.quest_subtitle: "Automation begins."
	quest.414C010000010001.title: "The Assembly Line"
	quest.414C0100000100A1.quest_desc: [
		"&6Modern Dynamics Fluid Pipe&r is a unified fluid-transport pipe. Connects to MI, Mekanism, Oritech, IE, and most other mods' fluid blocks."
		""
		"&aThe \"one pipe to rule them all\" philosophy.&r Reduces the cable/pipe sprawl by handling cross-mod fluid logistics in one network type."
	]
	quest.414C0100000100A1.quest_subtitle: "Liquid logistics."
	quest.414C0100000100A1.title: "Fluid Pipe"
	quest.414C0100000100A2.quest_desc: [
		"&6LV Cable&r (Modern Dynamics) is the low-voltage variant of the unified power cable. Carries small amounts of FE."
		""
		"&aMD's voltage system parallels IE's: LV → MV → HV → EV → Superconductor.&r Each tier carries higher current and unlocks more machine types."
	]
	quest.414C0100000100A2.title: "LV Cable"
	quest.414C0100000100A3.quest_desc: [
		"&6MV EU Cable&r (Modern Dynamics) is the medium-tier MI EU cable. Higher EU/tick throughput than LV. &cFeeding higher-tier EU into a lower-tier MI machine will damage it — match tiers carefully.&r"
		""
		"Used for backbone runs in mid-game bases."
	]
	quest.414C0100000100A3.title: "MV Cable"
	quest.414C0100000100A4.quest_desc: [
		"&6HV EU Cable&r (Modern Dynamics) is the high-tier MI EU cable. Required for high-draw MI machines that demand HV input."
		""
		"Pair with HV transformers when stepping up from MV networks."
	]
	quest.414C0100000100A4.title: "HV Cable"
	quest.414C0100000100A5.quest_desc: [
		"&6EV EU Cable&r (Modern Dynamics) is the extreme-tier MI EU cable. Top of the standard MI cable ladder before the lossless Superconductor."
		""
		"Required for the most demanding late-IR machines."
	]
	quest.414C0100000100A5.quest_subtitle: "Near-maximum throughput."
	quest.414C0100000100A5.title: "EV Cable"
	quest.414C0100000100A7.quest_desc: [
		"The &6Attractor&r is a Modern Dynamics pipe attachment. Pulls items into the pipe network from the world (item entities)."
		""
		"&aPlace at mob farm exits or quarry pickup points to vacuum drops directly into your pipes.&r"
	]
	quest.414C0100000100A7.quest_subtitle: "Pulls items into the pipe."
	quest.414C0100000100A7.title: "Attractor"
	quest.414C0100000100A8.quest_desc: [
		"The &6Inhibitor&r is the inverse of the Attractor — blocks items from passing through a specific pipe segment."
		""
		"Useful for routing logic in branching pipe networks."
	]
	quest.414C0100000100A8.quest_subtitle: "Blocks items at a junction."
	quest.414C0100000100A8.title: "Inhibitor"
	quest.414C0100000100A9.quest_desc: [
		"The &6MD Wrench&r is Modern Dynamics' configuration tool. Right-click pipes/cables to cycle modes; sneak-right-click to detach."
		""
		"Carry one alongside the IE hammer and AE2 wrench."
	]
	quest.414C0100000100A9.title: "Wrench"
	quest.414C0100000100AA.quest_desc: [
		"The &6MD Debug Tool&r displays live network statistics — throughput, pressure, channel utilization, network identity."
		""
		"&aIndispensable for debugging busy MD networks.&r If something's not flowing, the debug tool shows where."
	]
	quest.414C0100000100AA.quest_subtitle: "Pipe diagnostics."
	quest.414C0100000100AA.title: "Debug Tool"
	quest.414C0100000100AB.quest_desc: [
		"The &6MD Machine Extender&r adds capacity, slots, or speed to compatible Modern Dynamics blocks."
		""
		"Slot adjacent to a machine for in-place upgrades."
	]
	quest.414C0100000100AB.quest_subtitle: "Remote I/O."
	quest.414C0100000100AB.title: "Machine Extender"
	quest.414C0100000100B5.quest_desc: [
		"The &6Ore Extractor&r (Create Ore Excavation) is the surface-mounted ore-collection block. Place over a known vein; feed it power; ores flow out."
		""
		"&aChunk-based ore mining — consume the vein, build above ground.&r Pairs with sample drills to find the veins first."
	]
	quest.414C0100000100B5.quest_subtitle: "Liquid extraction."
	quest.414C0100000100B5.title: "Fluid Well Extractor"
	quest.414C0100000100B6.quest_desc: [
		"The &6Sample Drill&r (Create Ore Excavation) drills a small-radius surface-test sample. Tells you what veins are present in the chunk below."
		""
		"&aFirst step in COE prospecting: sample, then build extractor, then mine.&r"
	]
	quest.414C0100000100B6.quest_subtitle: "One-shot vein survey."
	quest.414C0100000100B6.title: "Sample Drill"
	quest.414C0100000100B7.quest_desc: [
		"The &6Drill&r (Create Ore Excavation) is the iron-tier handheld drill. Mines blocks faster than a pickaxe; consumes durability slower."
		""
		"Powered by Create rotational mechanics or a hand crank."
	]
	quest.414C0100000100B7.title: "Iron Drill"
	quest.414C0100000100B8.quest_desc: [
		"The &6Diamond Drill&r is the diamond-tier upgrade. Faster mining, better durability."
		""
		"Mid-game handheld mining tool."
	]
	quest.414C0100000100B8.title: "Diamond Drill"
	quest.414C0100000100B9.quest_desc: [
		"The &6Netherite Drill&r is the top-tier handheld drill. Highest mining speed and durability."
		""
		"Late-IR handheld mining capstone."
	]
	quest.414C0100000100B9.quest_subtitle: "Maximum depth."
	quest.414C0100000100B9.title: "Netherite Drill"
	quest.414C0100000100BA.quest_desc: [
		"The &6Vein Finder&r is COE's prospecting handheld tool. Detects underground veins from the surface."
		""
		"&aFaster than placing sample drills if you're roaming.&r"
	]
	quest.414C0100000100BA.quest_subtitle: "Locate the next vein."
	quest.414C0100000100BA.title: "Vein Finder"
	quest.414C0100000100BB.quest_desc: [
		"The &6Vein Atlas&r is the catalog of all veins you've discovered. Tracks vein locations and remaining ore counts."
		""
		"&aIndispensable for organized COE-driven mining.&r"
	]
	quest.414C0100000100BB.quest_subtitle: "Know where everything is."
	quest.414C0100000100BB.title: "Ore Vein Atlas"
	quest.414C0100000100BC.quest_desc: [
		"The &6Tunnel Digger&r (Immersive Machinery) is a multiblock automated tunneler. Drills a 3x3 tunnel forward as long as it has fuel and direction."
		""
		"Pair with rail track placement for automated minecart-tunnel construction."
	]
	quest.414C0100000100BC.quest_subtitle: "Autonomous tunnel boring."
	quest.414C0100000100BC.title: "Tunnel Digger"
	quest.414C0100000100BD.quest_desc: [
		"The &6Iron Drill&r (Immersive Machinery) is the iron-tier handheld drill in the Immersive Machinery line."
		""
		"Distinct from COE's drill — same idea, different mod."
	]
	quest.414C0100000100BD.title: "IM Iron Drill"
	quest.414C0100000100BE.quest_desc: [
		"The &6Diamond Drill&r (Immersive Machinery) is the diamond-tier IM drill."
		""
		"Mid-tier IM handheld."
	]
	quest.414C0100000100BE.title: "IM Diamond Drill"
	quest.414C0100000100BF.quest_desc: [
		"The &6Netherite Drill&r (Immersive Machinery) is the top-tier IM drill."
		""
		"Late-game handheld; choose between IM and COE drills based on your preferred ecosystem."
	]
	quest.414C0100000100BF.quest_subtitle: "Peak excavation."
	quest.414C0100000100BF.title: "IM Netherite Drill"
	quest.414C0100000100C1.quest_desc: [
		"The &6Molten Iron Bucket&r holds liquid iron. Create Metalwork's foundry chain produces molten metals from ingot or raw input."
		""
		"Cast back into ingots, plates, or shaped parts via Create Metalwork molds."
	]
	quest.414C0100000100C1.quest_subtitle: "Liquid metal."
	quest.414C0100000100C1.title: "Molten Iron"
	quest.414C0100000100C2.quest_desc: [
		"The &6Molten Copper Bucket&r holds liquid copper."
		""
		"Same foundry chain — pour into molds for shaped output."
	]
	quest.414C0100000100C2.title: "Molten Copper"
	quest.414C0100000100C3.quest_desc: [
		"The &6Molten Zinc Bucket&r holds liquid zinc — one half of brass."
		""
		"Combines with copper in a Create Metalwork mixer to produce brass."
	]
	quest.414C0100000100C3.title: "Molten Zinc"
	quest.414C0100000100C4.quest_desc: [
		"The &6Molten Tin Bucket&r holds liquid tin — one half of bronze."
		""
		"Combines with copper for bronze, or with other metals in specialty alloys."
	]
	quest.414C0100000100C4.title: "Molten Tin"
	quest.414C0100000100C5.quest_desc: [
		"The &6Molten Brass Bucket&r holds liquid brass. Output of mixing copper + zinc in the foundry."
		""
		"Cast for brass plates, ingots, or Create Metalwork shaped components."
	]
	quest.414C0100000100C5.quest_subtitle: "Cu + Zn."
	quest.414C0100000100C5.title: "Molten Brass"
	quest.414C0100000100C6.quest_desc: [
		"The &6Molten Bronze Bucket&r holds liquid bronze. Output of mixing copper + tin in the foundry."
		""
		"Cross-tag compatible with MI bronze."
	]
	quest.414C0100000100C6.quest_subtitle: "Cu + Sn."
	quest.414C0100000100C6.title: "Molten Bronze"
	quest.414C0100000100C7.quest_desc: [
		"The &6Molten Andesite Bucket&r holds liquid andesite. Used in advanced Create Metalwork casting recipes."
		""
		"Pour and cool for andesite-based shaped parts."
	]
	quest.414C0100000100C7.title: "Molten Andesite"
	quest.414C0100000100C8.quest_desc: [
		"The &6Molten Andesite Alloy Bucket&r is the alloyed variant — Create's rotational-friendly andesite alloy in liquid form."
		""
		"Faster casting than the classic andesite alloy crafting recipe."
	]
	quest.414C0100000100C8.quest_subtitle: "Bulk alloy production."
	quest.414C0100000100C8.title: "Molten Andesite Alloy"
	quest.414C0100000100C9.quest_desc: [
		"The &6Molten Gold Bucket&r holds liquid gold."
		""
		"Cast for gold ingots/plates or use as a reagent in specialty alloy recipes."
	]
	quest.414C0100000100C9.title: "Molten Gold"
	quest.414C0100000100CA.quest_desc: [
		"The &6Molten Steel Bucket&r holds liquid steel."
		""
		"Cross-tag compatible with MI/Oritech steel; cast for shaped steel parts."
	]
	quest.414C0100000100CA.quest_subtitle: "Industrial-grade alloy."
	quest.414C0100000100CA.title: "Molten Steel"
	quest.414C0100000100CB.quest_desc: [
		"The &6Molten Netherite Bucket&r holds liquid netherite — the highest-tier vanilla metal in liquid form."
		""
		"&aCast netherite components without the smithing-table singleton bottleneck.&r"
	]
	quest.414C0100000100CB.quest_subtitle: "Liquid endgame."
	quest.414C0100000100CB.title: "Molten Netherite"
	quest.414C0100000100CC.quest_desc: [
		"&6Crushed Andesite&r is the powdered andesite intermediate. Output of pulverizing andesite blocks; smelts back to andesite alloy or processed further."
		""
		"Used in Create Metalwork advanced recipes."
	]
	quest.414C0100000100CC.title: "Crushed Andesite"
	quest.414C0100000100CD.quest_desc: [
		"&6Crushed Netherite Scrap&r is the powdered scrap form. Used in Create Metalwork's netherite-flavored recipes."
		""
		"Saves smelt-then-grind cycles by going straight from raw to dust."
	]
	quest.414C0100000100CD.quest_subtitle: "The full pipeline."
	quest.414C0100000100CD.title: "Crushed Netherite Scrap"
	quest.414C010000010101.quest_desc: [
		"The &6Redstone Mechanism&r is Immersive Machinery's signature reactive component. Used in nearly every IM machine recipe."
		""
		"Mass-produce these — you'll burn through them."
	]
	quest.414C010000010101.quest_subtitle: "Drone logistics."
	quest.414C010000010101.title: "Redstone Mechanism"
	quest.414C010000010102.quest_desc: [
		"The &6Bamboo Bee&r (Immersive Machinery) is a mechanical bee — produces honey via a pollination mechanic."
		""
		"Niche utility creature; produces mechanical-flavored bee products."
	]
	quest.414C010000010102.quest_subtitle: "Item courier."
	quest.414C010000010102.title: "Bamboo Bee"
	quest.414C010000010103.quest_desc: [
		"The &6Redstone Sheep&r is Immersive Machinery's mechanical sheep variant. Produces redstone-themed wool/byproducts."
		""
		"Decorative + niche utility creature."
	]
	quest.414C010000010103.quest_subtitle: "Automated harvester."
	quest.414C010000010103.title: "Redstone Sheep"
	quest.414C010000010104.quest_desc: [
		"The &6Copperfin&r is Immersive Machinery's mechanical fish. Used for ambient detail and a couple of specialty recipes."
		""
		"Decorative aquatic mechanical fauna."
	]
	quest.414C010000010104.quest_subtitle: "Aquatic operations."
	quest.414C010000010104.title: "Copperfin"
	quest.414C010000010140.quest_desc: [
		"&6Obsidian Steel Ingots&r are Forbidden Arcanus' early-tier reinforced metal. Made by hammering obsidian into steel-grade material via the Hephaestus Forge."
		""
		"&aThe Hephaestus Forge progresses through tiers (T1-T5) gated by stage; obsidian steel is one of its first products.&r"
	]
	quest.414C010000010140.quest_subtitle: "Four traditions, one corner of the factory."
	quest.414C010000010140.title: "The Magic Workshop"
	quest.414C010000010141.quest_desc: [
		"The &6CAD Assembler&r is Psi's spell-tool crafting bench. Combines CAD assembly + core + battery + socket parts to build a complete CAD (Casting Assistant Device)."
		""
		"&aThe CAD is your wand — this is where you build it.&r"
	]
	quest.414C010000010141.quest_subtitle: "The wand-maker's bench."
	quest.414C010000010141.title: "CAD Assembler"
	quest.414C010000010142.quest_desc: [
		"The &6Iron CAD Assembly&r is Psi's first-tier CAD body. The frame around which you assemble core, battery, and sockets."
		""
		"Entry-level CAD; you'll upgrade to Psimetal later."
	]
	quest.414C010000010142.title: "Iron CAD Assembly"
	quest.414C010000010143.quest_desc: [
		"The &6Basic CAD Core&r is the first-tier internal component — defines spell power and complexity."
		""
		"Higher-tier cores let you cast more powerful spells. Iron-tier core for starter CAD."
	]
	quest.414C010000010143.title: "Basic Components"
	quest.414C010000010144.quest_desc: [
		"The &6Programmer&r is Psi's spell-authoring block. Place blank spell pieces on a 9x9 grid; arrange logic; output a complete spell."
		""
		"&aThis is where Psi's signature \"programming-in-Minecraft\" lives.&r Spells are visual code — arrange tiles and connections, save to a bullet, fire from your CAD."
	]
	quest.414C010000010144.quest_subtitle: "Where spells are written."
	quest.414C010000010144.title: "Spell Programmer"
	quest.414C010000010145.quest_desc: [
		"&6Psi Dust&r is Psi's particulate magic substrate. Drops from killing certain mobs and from completing CAD recipes."
		""
		"Reagent in higher-tier Psi recipes — psimetal, advanced cores, the Psi gem chain."
	]
	quest.414C010000010145.quest_subtitle: "Hello, Psi."
	quest.414C010000010145.title: "Psidust"
	quest.414C010000010146.quest_desc: [
		"The &6Spell Bullet&r holds a Psi spell. Place an empty bullet in the Programmer; copy a spell into it; load into your CAD; cast."
		""
		"&aOne bullet = one spell. Carry several bullets to swap spells in the field.&r"
	]
	quest.414C010000010146.title: "Spell Bullet"
	quest.414C010000010147.quest_desc: [
		"The &6Projectile Spell Bullet&r is the bullet type optimized for projectile-flavored spells (e.g., raycast, beam)."
		""
		"Different bullet types are optimized for different spell categories — check Psi documentation for the full list."
	]
	quest.414C010000010147.title: "Bullet Variety"
	quest.414C010000010148.quest_desc: [
		"The &6Vector Ruler&r is Psi's spatial-targeting tool. Right-click two points to define a vector; use the result in vector-flavored spell pieces."
		""
		"&aRequired for any spell that targets a location relative to the caster.&r"
	]
	quest.414C010000010148.title: "Vector Ruler"
	quest.414C010000010149.quest_desc: [
		"&6Psimetal&r is Psi's signature alloy — iron infused with Psi dust in the CAD Assembler. The mid-tier CAD body material."
		""
		"&aPsimetal CAD is the standard mid-game upgrade over the iron-tier starter CAD.&r"
	]
	quest.414C010000010149.quest_subtitle: "Gold, refined."
	quest.414C010000010149.title: "Psimetal"
	quest.414C01000001014A.quest_desc: [
		"The &6Psimetal CAD Assembly&r is the mid-tier CAD body. Holds higher-tier cores, batteries, and sockets."
		""
		"Required step on the path to Psi gem-tier CADs."
	]
	quest.414C01000001014A.title: "Psimetal CAD Assembly"
	quest.414C01000001014B.quest_desc: [
		"The &6Spell Drive&r holds multiple spells in one item — load multiple spells into one drive, swap between them in your CAD."
		""
		"&aEliminates the bullet-per-spell sprawl.&r"
	]
	quest.414C01000001014B.title: "Spell Drive"
	quest.414C01000001014C.quest_desc: [
		"&6Psi Gem&r is Psi's high-tier crystal — refined Psi dust crystallized into a solid. Used in top-tier CAD components."
		""
		"Top-tier CAD body and core material."
	]
	quest.414C01000001014C.quest_subtitle: "Diamond, transmuted."
	quest.414C01000001014C.title: "Psigem"
	quest.414C010000010151.quest_desc: [
		"&6Deorum Ingots&r are Forbidden Arcanus' golden alloy. Made in the Hephaestus Forge from gold + arcanum dust."
		""
		"&aMid-tier FA material.&r Used in advanced wands, tomes, and the elementarium chain."
	]
	quest.414C010000010151.quest_subtitle: "The mid-tier alloy."
	quest.414C010000010151.title: "Deorum Ingot"
	quest.414C010000010152.quest_desc: [
		"The &6Magic Wand&r (Forbidden Arcanus) is a basic spellcasting tool. Channels Aureal mana into projectile or beam attacks."
		""
		"First-tier FA wand."
	]
	quest.414C010000010152.quest_subtitle: "Strikes pedestals; finishes rituals."
	quest.414C010000010152.title: "Magic Wand"
	quest.414C010000010153.quest_desc: [
		"The &6Diamond Blacksmith Gavel&r is the FA diamond-tier hammer. Used in Hephaestus Forge T2-T3 ritual recipes."
		""
		"&aDifferent gavel tiers gate Forge tier — carry the right gavel for the recipe.&r"
	]
	quest.414C010000010153.title: "Diamond Blacksmith Gavel"
	quest.414C010000010154.quest_desc: [
		"The &6Reinforced Deorum Blacksmith Gavel&r is the FA late-tier hammer. Used in Hephaestus Forge T4-T5 rituals."
		""
		"Top-tier IR-era FA gavel."
	]
	quest.414C010000010154.title: "Reinforced Deorum Gavel"
	quest.414C010000010155.quest_desc: [
		"The &6Aureal Wardstone&r blocks negative ambient effects in a radius. Place at a base for protection against magical hazards."
		""
		"&aFA's defensive ward block.&r Useful in basement labs where Aureal manipulation can have side effects."
	]
	quest.414C010000010155.title: "Aureal Wardstone"
	quest.414C010000010156.quest_desc: [
		"The &6Tyr Helmet&r is FA's defensive helmet — reduces magical damage and provides ambient protection."
		""
		"Mid-tier FA combat gear."
	]
	quest.414C010000010156.title: "Tyr Armor"
	quest.414C010000010157.quest_desc: [
		"&6Elementarium&r is FA's elemental-fusion material. Combines fire, water, air, earth essences via the Hephaestus Forge."
		""
		"&aRequired for the highest-tier FA artifacts and the Spectral Eye Amulet.&r"
	]
	quest.414C010000010157.title: "Forge Enhancers I"
	quest.414C010000010158.quest_desc: [
		"The &6Spectral Eye Amulet&r is FA's vision-augment necklace. Reveals invisible structures and entities; required for several late-game encounters."
		""
		"&aFA capstone amulet for the IR era.&r"
	]
	quest.414C010000010158.quest_subtitle: "The capstone curio."
	quest.414C010000010158.title: "Spectral Eye Amulet"
	quest.414C010000010160.quest_desc: [
		"The &6Mahou Tsukai Guidebook&r is the introduction to Mahou's spell system. Read for the basics: mahoujin, mystic codes, scrolls, and the Caliburn line."
		""
		"&aMahou is the most lore-driven of the magic mods — the guidebook is mandatory reading.&r"
	]
	quest.414C010000010160.quest_subtitle: "A parallel magic."
	quest.414C010000010160.title: "Mahou Tsukai Knowledge Compendium"
	quest.414C010000010161.quest_desc: [
		"The &6Mahoujin&r is Mahou Tsukai's magic-circle item. Place on the ground to draw a spell circle; cast or sustain magic effects through it."
		""
		"&aMahoujin are the visible spell circles characteristic of Mahou's anime-flavored magic.&r"
	]
	quest.414C010000010161.title: "Mahoujin"
	quest.414C010000010162.quest_desc: [
		"The &6Mahoujin Projector&r places a mahoujin in the air, projected from the device."
		""
		"Useful for elevated or aerial spell-circle placement."
	]
	quest.414C010000010162.title: "Mahoujin Projector"
	quest.414C010000010163.quest_desc: [
		"The &6Magitech Mana Circuit&r is Mahou's mana-routing component. Used in advanced spell automation."
		""
		"Pairs with circuits and projectors for sustained spell effects."
	]
	quest.414C010000010163.quest_subtitle: "Mana storage, the easy way."
	quest.414C010000010163.title: "Magitech Mana Circuit"
	quest.414C010000010164.quest_desc: [
		"The &6Mystic Code&r is Mahou's primary spellcasting tool. Different mystic codes channel different spell families."
		""
		"&aThe \"wand\" of Mahou Tsukai — carry the right code for the spell you want to cast.&r"
	]
	quest.414C010000010164.title: "Mystic Code"
	quest.414C010000010165.quest_desc: [
		"The &6Mystic Code: First Sorcery&r is the entry-tier mystic code. Casts beginner-level Mahou spells."
		""
		"First in the Mystic Code progression line."
	]
	quest.414C010000010165.quest_subtitle: "Reusable scroll storage."
	quest.414C010000010165.title: "Mystic Code: First Sorcery"
	quest.414C010000010166.quest_desc: [
		"The &6Scroll of Projection&r teaches the Projection spell — create a temporary illusion of yourself."
		""
		"Mahou scrolls are read once to learn the spell, then consumed."
	]
	quest.414C010000010166.title: "Spell Scrolls"
	quest.414C010000010167.quest_desc: [
		"The &6Scroll of Probability Alteration&r teaches Mahou's reality-alteration spell — subtle nudges to dice rolls and random events."
		""
		"&aSubtle but powerful.&r Mahou spells lean toward indirect effects rather than raw damage."
	]
	quest.414C010000010167.title: "Scroll of Probability Alter"
	quest.414C010000010168.quest_desc: [
		"&6Rule Breaker&r is Mahou's signature artifact — breaks magic effects in a radius."
		""
		"&aThe \"counter-spell\" item.&r Breaks any active magical effect within reach."
	]
	quest.414C010000010168.title: "Rule Breaker"
	quest.414C010000010169.quest_desc: [
		"The &6Scroll of Strengthening&r teaches the Strengthening spell — temporary buff to weapon damage."
		""
		"Combat utility scroll."
	]
	quest.414C010000010169.title: "Scroll of Strengthening"
	quest.414C01000001016A.quest_desc: [
		"&6Caliburn&r is Mahou's first legendary sword — the sword in the stone, drawn by the worthy."
		""
		"&aRequires you to defeat a powerful enemy to acquire.&r The starter legendary in the Caliburn → Clarent → Excalibur line."
	]
	quest.414C01000001016A.quest_subtitle: "The holy sword."
	quest.414C01000001016A.title: "Caliburn"
	quest.414C01000001016B.quest_desc: [
		"&6Clarent&r is the rebellious sword — brother to Caliburn, used by traitors. Mahou's mid-tier legendary."
		""
		"Different combat profile than Caliburn; choose your sword based on play style."
	]
	quest.414C01000001016B.title: "Clarent"
	quest.414C01000001016C.quest_desc: [
		"The &6Scroll of Gandr&r teaches Mahou's curse-arrow spell. Fires a magical projectile that ignores armor."
		""
		"&aHigh-impact ranged spell.&r"
	]
	quest.414C01000001016C.title: "Scroll of Gandr"
	quest.414C01000001016D.quest_desc: [
		"The &6Scroll of Reality Marble&r teaches Mahou's most powerful spell — project an alternate reality bubble around the caster."
		""
		"&aMahou's signature endgame spell.&r Requires deep mana investment to learn and cast."
	]
	quest.414C01000001016D.title: "Scroll of Reality Marble"
	quest.414C01000001016E.quest_desc: [
		"&6Staff Emrys&r is Mahou's high-tier staff. Channels powerful sustained spells."
		""
		"Late-IR Mahou casting tool."
	]
	quest.414C01000001016E.title: "Staff Emrys"
	quest.414C01000001016F.quest_desc: [
		"The &6Scroll of Summon Familiar&r teaches the familiar-summoning spell. Bind a creature as a permanent companion."
		""
		"Familiars persist between sessions; choose well."
	]
	quest.414C01000001016F.title: "Scroll of Summon Familiar"
	quest.414C010000010170.quest_desc: [
		"&6Kodoku&r is Mahou's poison-jar artifact — trap creatures inside, the surviving creature gains accumulated power."
		""
		"&aRitual-flavored item from Japanese folklore.&r"
	]
	quest.414C010000010170.title: "Kodoku"
	quest.414C010000010171.quest_desc: [
		"The &6Scroll of Ascension&r teaches Mahou's flight/ascension spell."
		""
		"Late-IR mobility scroll."
	]
	quest.414C010000010171.title: "Scroll of Ascension"
	quest.414C010000010174.quest_desc: [
		"The &6Hellshelf&r is Apothic Enchanting's nether-flavored bookshelf. Provides higher enchantment-table levels than vanilla bookshelves."
		""
		"&aApothic Enchanting overhauls vanilla enchanting with tier-flavored shelves.&r Different shelves grant different enchantment biases."
	]
	quest.414C010000010174.quest_subtitle: "Pick your first shelf."
	quest.414C010000010174.title: "The Library Stirs"
	quest.414C010000010175.quest_desc: [
		"The &6Stoneshelf&r is the basic Apothic shelf upgrade. Uses stone substrate for higher table tier than vanilla."
		""
		"Entry-tier Apothic shelf."
	]
	quest.414C010000010175.title: "Books in Stone"
	quest.414C010000010176.quest_desc: [
		"The &6Infused Hellshelf&r is the upgraded hellshelf variant — further-boosted enchantment levels."
		""
		"Pair multiple infused shelves for high-tier enchant access."
	]
	quest.414C010000010176.title: "The Three Statures"
	quest.414C010000010177.quest_desc: [
		"The &6Helmet Tome&r applies an enchantment specifically to a helmet via Apothic's tome system."
		""
		"&aTomes target single armor pieces — cleaner than relying on RNG enchant rolls.&r"
	]
	quest.414C010000010177.title: "Tomes of the Trade"
	quest.414C010000010178.quest_desc: [
		"The &6Library&r is Apothic Enchanting's bookshelf-storage block. Hold many enchanted books in one block."
		""
		"Replaces a wall of chests for enchanted-book storage."
	]
	quest.414C010000010178.quest_subtitle: "Enchant rolls, saved."
	quest.414C010000010178.title: "Enchantment Library"
	quest.414C010000010179.quest_desc: [
		"The &6Echoing Sculkshelf&r is Apothic's deepslate-themed shelf, drops from the Deep Dark. Provides high enchantment tiers and sculk-themed bias."
		""
		"&aRare and powerful — worth a Warden detour to acquire.&r"
	]
	quest.414C010000010179.title: "Sculk Resonance"
	quest.414C01000001017A.quest_desc: [
		"The &6Ender Library&r is Apothic's end-flavored bookshelf storage. Higher capacity than the standard library."
		""
		"Late-IR Apothic storage tier."
	]
	quest.414C01000001017A.quest_subtitle: "The enchanting capstone."
	quest.414C01000001017A.title: "Library of Alexandria"
	quest.414C010000010180.quest_desc: [
		"The &6Blazing Diode&r is Malum's heat-channel component. Routes blazing soul fire through Malum's machine networks."
		""
		"&aMalum is the soul-magic mod — everything routes through soul-based intermediates.&r"
	]
	quest.414C010000010180.quest_subtitle: "Spirit, industrialized."
	quest.414C010000010180.title: "Spirit Diodes"
	quest.414C010000010181.quest_desc: [
		"The &6Prismatic Focus Lens&r is Malum's spell-focusing optic. Used in advanced runic recipes."
		""
		"Refracts soul energy through prismatic crystals for fine spell control."
	]
	quest.414C010000010181.title: "The Lensmaker"
	quest.414C010000010182.quest_desc: [
		"The &6Mimicry Relay&r is Malum's signal-mirroring component. Copies one block's behavior onto another."
		""
		"Niche utility for ritual-flavored Malum builds."
	]
	quest.414C010000010182.title: "Mimicry Relay"
	quest.414C010000010183.quest_desc: [
		"The &6Rune of Burning Fervor&r is one of Malum's runic upgrades. Apply to gear for fire-themed combat bonuses."
		""
		"&aMalum runes attach to weapons/armor for permanent enchantment-flavored bonuses.&r"
	]
	quest.414C010000010183.title: "Rune Loremaster"
	quest.414C010000010184.quest_desc: [
		"The &6Belt of the Magebane&r is Malum's anti-magic belt — reduces incoming magic damage."
		""
		"Useful in PvE encounters with magical bosses."
	]
	quest.414C010000010184.title: "Belt of the Magebane"
	quest.414C010000010185.quest_desc: [
		"The &6Mnemonic Hex Staff&r is Malum's spell-storage staff. Hold multiple spells; cast on demand."
		""
		"Late-IR Malum casting tool — holds the spell library you've collected."
	]
	quest.414C010000010185.quest_subtitle: "Programmable spellcasting."
	quest.414C010000010185.title: "Mnemonic Hex Staff"
	quest.414C010000010190.quest_desc: [
		"The &6Frame Motor&r (ProjectRed Expansion) is the moving-frame contraption block. Builds movable structures from PR frame elements."
		""
		"&aProjectRed's answer to flying-machine-style automation.&r Frames + motor = automated movable platforms."
	]
	quest.414C010000010190.title: "Moving Walls"
	quest.414C010000010191.quest_desc: [
		"The &6Project Bench&r is ProjectRed's enhanced crafting table. Has built-in storage for crafting components and recipe planning."
		""
		"&aQuality-of-life replacement for the vanilla crafting table.&r Ingredients are kept for the next craft instead of returning to your inventory."
	]
	quest.414C010000010191.title: "The Workbench Upgrade"
	quest.421E3F3C25B9F2D1.quest_desc: ["The full &6Zanite Armor Set&r — helmet, chestplate, leggings, boots. Aether's iron-tier armor with low-durability damage scaling."]
	quest.421E3F3C25B9F2D1.quest_subtitle: "Full kit, cloud-ready"
	quest.421E3F3C25B9F2D1.title: "Zanite Panoply"
	quest.423550078AAB3986.quest_desc: [
		"&6Autocrafting Upgrade&r — slot it into an Importer or Exporter to enable autocrafting requests through that node."
		""
		"&aWithout this upgrade, an Exporter can only send things the system already has, not request the system make them on demand.&r"
	]
	quest.423550078AAB3986.title: "Autocrafting Upgrade"
	quest.4256010000001002.quest_desc: [
		"The &6Eternal Crystal&r — BetterEnd's ritual-crafted endgame gem. Combines with aeternium to forge tools and armor that exceed netherite."
		""
		"Slow to make, but the alchemy is required for everything downstream on the aeternium ladder."
	]
	quest.4256010000001002.title: "Eternal Crystal"
	quest.4256010000001003.quest_desc: [
		"&6Aeternium&r — BetterEnd's signature endgame metal. Stronger than netherite, with a faint blue glow that makes it visually unmistakable."
		""
		"Smelting requires special handling. Check JEI for the chain — it's not a simple furnace recipe."
	]
	quest.4256010000001003.title: "Aeternium Ingot"
	quest.4256010000001004.quest_desc: ["The &6Aeternium Forged Plate&r — refined plate stock used to assemble the full aeternium armor set. The penultimate tier on BetterEnd's gear ladder."]
	quest.4256010000001004.title: "Aeternium Forged Plate"
	quest.4256010000001005.quest_desc: [
		"The full &6Aeternium armor set&r — helmet, chestplate, leggings, boots — plus the &6Aeternium Sword&r. The pinnacle of BetterEnd combat gear."
		""
		"Stronger and more visually striking than netherite. The sword in particular punches above what its tier suggests."
		""
		"&aThis is your OW combat upgrade.&r Wear it before you start the convergence run."
	]
	quest.4256010000001005.title: "Aeternium Armor Set"
	quest.4256010000010100.quest_desc: [
		"The &6Enderic Lens&r — Oritech's portal-tier optical component, machined from End-fused materials. The gateway item to Oritech's OW-tier content."
		""
		"This branch of OW6 is dedicated to Oritech machines pushed beyond their Atomic-age ceiling. Strange matter, drone networks, particle physics — everything escalates."
		""
		"&aOritech's OW-tier is clinical engineering at its most grandiose.&r If you loved the Atomic Oritech chapter, you're about to love this more."
	]
	quest.4256010000010100.title: "Enderic Lens"
	quest.4256010000010101.quest_desc: [
		"&6Endstone Platinum Ore&r — Oritech's rare-element node, found embedded in End stone. Needed for several OW-tier Oritech recipes."
		""
		"&aCheck the End for platinum-rich biomes.&r Standard overworld platinum tools won't cut it here."
	]
	quest.4256010000010101.title: "Endstone Platinum Ore"
	quest.4256010000010102.quest_desc: [
		"&6Strange Matter&r — Oritech's exotic fluid output, captured in a bucket. Behaves like nothing classical physics describes."
		""
		"Required for the Shrinker, the Unholy Intelligence, and several apex Oritech recipes. The pack treats it as the enabling material for OW-tier Oritech entirely."
	]
	quest.4256010000010102.title: "Strange Matter Bucket"
	quest.4256010000010103.quest_desc: [
		"The &6Shrinker&r — Oritech's spatial compression machine. Reduces target objects to subatomic scale for storage or as recipe inputs."
		""
		"&cRespects no laws of conservation you've ever read.&r The mechanic is a black box; treat it as recipe machinery."
	]
	quest.4256010000010103.title: "Matter Shrinker"
	quest.4256010000010105.quest_desc: [
		"The &6Cross-Dimensional Addon Block&r from Oritech Things — extends Oritech's drone and routing networks across dimensions."
		""
		"&aLets you bridge factory operations between Overworld, End, and elsewhere.&r"
	]
	quest.4256010000010105.title: "Cross Dimensional Addon"
	quest.4256010000010106.quest_desc: [
		"The &6Drone Port&r — Oritech's network nexus for autonomous drone routing. Place these as waypoints; configure routes; let drones handle inter-base logistics."
		""
		"&aPair with the cross-dimensional addon for inter-dimensional drone networks.&r"
	]
	quest.4256010000010106.title: "Drone Port"
	quest.425601000001010A.quest_desc: [
		"The &6Low-Yield Nuke&r — Oritech's compact strategic ordnance. Smaller blast radius than the full nuke, but more than enough to ruin your day if you mishandle it."
		""
		"&cTest it in a designated dimension or remote area.&r Do not arm one near your factory."
	]
	quest.425601000001010A.title: "Low-Yield Nuclear Device"
	quest.425601000001010B.quest_desc: [
		"The &6Nuke&r — Oritech's full-yield strategic ordnance. Catastrophic blast, structure-leveling, no second chances."
		""
		"&cThe quest only asks you to craft one. It does not ask you to detonate it.&r Please do not detonate it inside your base."
	]
	quest.425601000001010B.title: "Manhattan Module"
	quest.425601000001010C.quest_desc: [
		"The &6Wither Crop Block&r — an Oritech farmable that yields wither-flavored harvests. Decorative, reagent, or feed for downstream automation."
		""
		"&7Niche but useful if you've got recipes that want wither dust without farming the boss.&r"
	]
	quest.425601000001010C.title: "Soul Flowers"
	quest.425601000001010D.quest_desc: [
		"The &6Lapis Resource Node&r — Oritech's renewable lapis source. Place, power, harvest. Bypasses the need to constantly mine more."
		""
		"&aOne of the backbone recipes for sustained Oritech automation.&r"
	]
	quest.425601000001010D.title: "Lapis Lazuli Resource Node"
	quest.425601000001010E.quest_desc: [
		"The &6Emerald Resource Node&r — Oritech's renewable emerald source. Same idea as the lapis node, different output."
		""
		"&aTrade-fuel for villagers, recipe component for several OW-tier crafts.&r"
	]
	quest.425601000001010E.title: "Emerald Resource Node"
	quest.4256010000010111.quest_desc: [
		"The &6Exo Chestplate&r — Oritech's late-armor torso piece, slot-aware for augments. The body of the exoskeleton system."
		""
		"&aDifferent design from MI's exo armor — Oritech's exo runs on RF, not Joules.&r"
	]
	quest.4256010000010111.title: "Exo Chestplate"
	quest.4256010000010114.quest_desc: [
		"The &6Heavy Core&r — vanilla 1.21 component, harvested from end-game vanilla content. Required as an input for several Oritech recipes that want a high-density base."
		""
		"&aThis one's vanilla, not Oritech.&r Check the trial chambers."
	]
	quest.4256010000010114.title: "Dark Heart Gloomsherd"
	quest.4256010000010117.quest_desc: [
		"&5The Oritech OW capstone.&r Hold the &6Unholy Intelligence&r, the &6Cross-Dimensional Addon&r, and the &6Arcane Augment Station&r — three artifacts representing the mod's most exotic, most cross-dimensional, and most modification-ready outputs."
		""
		"Together, these three stack into Oritech's Otherworldly identity: AI cores wired into multidimensional logistics networks, with player gear upgraded by alien augments."
		""
		"&5Engineering at the limits of physics.&r"
	]
	quest.4256010000010117.title: "Unholy Intelligence Capstone"
	quest.4256010000010200.quest_desc: [
		"The &6Rubber Sapling&r and &6Rubber Log&r — Industrial Foregoing Evolved Upgrades' renewable feedstock. Plant the sapling, harvest the logs, process for latex and downstream rubber goods."
		""
		"This is OW6's IFEU entrypoint. IFEU pushes Industrial Foregoing's tools and upgrades to their absolute limit — apex addons, dragon generators, end-tier dissolution."
		""
		"&aRubber is the foundational input for almost every IFEU recipe.&r Get a tree farm running early."
	]
	quest.4256010000010200.title: "&aThe Rubber Tree&r"
	quest.4256010000010201.quest_desc: [
		"The &6Sacred Rubber Sapling&r — IFEU's premium tree variant. Drops more, grows differently, signals deeper engagement with the mod."
		""
		"&7Optional.&r Standard rubber works for almost everything."
	]
	quest.4256010000010201.title: "Sacred Rubber Sapling"
	quest.4256010000010202.quest_desc: [
		"The &6Precision Crafting Table&r and &6Fluid Crafting Table&r — IFEU's recipe-specific assembly stations. The Precision handles tight-tolerance solid recipes; the Fluid handles liquid-input recipes."
		""
		"Together, they're IFEU's recipe gateway — the rest of the chapter cooks against these two stations."
	]
	quest.4256010000010202.title: "Precision + Fluid Crafting"
	quest.4256010000010203.quest_desc: [
		"The &6Big Dissolution Chamber&r — IFEU's larger-scale dissolution tank. Breaks materials down into their constituent fluids and salts; doubles the throughput of the standard chamber."
		""
		"&aRequired for several apex recipes.&r If you're scaling, you want the big version."
	]
	quest.4256010000010203.title: "Big Dissolution Chamber"
	quest.4256010000010204.quest_desc: ["The &6Fermenter&r — IFEU's biological-process machine. Takes organic inputs and outputs alcohol-class fluids and biogases for downstream recipes."]
	quest.4256010000010204.title: "Fermenter"
	quest.4256010000010205.quest_desc: [
		"The &6Infuser&r — IFEU's irradiation-tier processing machine. Charges items and fluids with concentrated energy fields, yielding apex-tier outputs."
		""
		"&aThe heart of IFEU's late-game progression.&r Feeds the dragon-breath, sculk, and malic-acid recipe chains."
	]
	quest.4256010000010205.title: "&5Infuser&r"
	quest.4256010000010206.quest_desc: [
		"Three apex IFEU fluids — &6Liquid Dragon Breath&r, &6Liquid Sculk Matter&r, and &6Liquid Malic Acid&r. Each is a stable-fluid form of an exotic Minecraft material."
		""
		"Dragon Breath is harvested post-Ender Dragon. Sculk Matter is processed from sculk veins. Malic Acid is IFEU's signature aggressive-chemistry fluid."
		""
		"&aAll three feed the dragon-generator and apex-addon recipes.&r"
	]
	quest.4256010000010206.title: "Infuser Fluids"
	quest.4256010000010207.quest_desc: [
		"&6Laser Lens (Sculk)&r and &6Laser Lens (Dragon)&r — IFEU's exotic laser-drill optics. Each lens shifts the laser drill's output toward different rare materials."
		""
		"&aEnd-tier lens variants.&r The drill is much more useful with these in rotation."
	]
	quest.4256010000010207.title: "Sculk + Dragon Laser Lenses"
	quest.4256010000010208.quest_desc: ["&6Netherite Gear&r and &6Sculk Gear&r — IFEU's mechanical components, used in apex machine recipes. Higher-tier than steel or copper gears, cheaper than full-block alternatives."]
	quest.4256010000010208.title: "Late-Tier Gears"
	quest.4256010000010209.quest_desc: [
		"The full set of &6Tier 3 IFEU Addons&r — Apple, Chance, Energy, Heal, Thread, Silk. Per IFEU's in-JAR tooltips: &6Apple&r boosts hydroponic-bed apple yield; &6Chance&r raises the success rate of the Precision Crafting Table; &6Energy&r multiplies a capacitor/machine's storage capacity; &6Heal&r is used in the Stasis Chamber to restore a captured mob's health each pulse; &6Thread&r adds parallel-processing slots to big machines (NOT looting); &6Silk&r is a Platform Builder addon (NOT silk-touch)."
		""
		"Tier 3 is mid-tier. Apex recipes want Tier 6 versions, but Tier 3 covers most quality-of-life gains."
	]
	quest.4256010000010209.title: "Addons: Tier 1-3"
	quest.425601000001020A.quest_desc: [
		"The full set of &6Tier 6 IFEU Addons&r — Apple, Chance, Energy, Heal, Thread. The apex tier of IF machine modifications. Same per-addon roles as Tier 3 (Apple = hydroponic yield, Chance = Precision Crafting success, Energy = storage multiplier, Heal = Stasis Chamber health pulse, Thread = parallel-processing slots) but with the magnitudes scaled to T6."
		""
		"&aTier 6 is the ceiling.&r Yield/throughput is brutal, capacity multiplier is generous. The chapter's signature reward."
	]
	quest.425601000001020A.title: "Addons: Tier 4-6"
	quest.425601000001020B.quest_desc: [
		"The &6Dragon Generator&r — IFEU's apex power source, fueled by liquid dragon breath. Outputs in the megajoules-per-tick range."
		""
		"&aPair with a sustainable dragon-breath production loop&r — bottling raw dragon breath manually does not scale."
	]
	quest.425601000001020B.title: "&5Dragon Generator&r"
	quest.425601000001020C.quest_desc: [
		"The full IFEU toolkit — &6Platform Builder&r, &6Saucepan&r, &6Wrench&r, &6Configuration Tool&r, &6Connect Tool&r, &6Empty Nether Star&r."
		""
		"&7Optional convenience set.&r Each tool removes a friction point: building scaffolds, configuring machines, wiring connections, fabricating nether stars from scratch."
	]
	quest.425601000001020C.title: "IFEU Utilities"
	quest.425601000001020D.quest_desc: [
		"&5The IFEU capstone.&r Hold the &6Infuser&r, the &6Dragon Generator&r, and the &6Big Dissolution Chamber&r — the three apex machines that define IFEU's identity."
		""
		"Together, they represent the full apex Industrial Foregoing experience: irradiation processing, dragon-tier energy, and large-scale dissolution. Anything you can imagine automating, you can now automate."
		""
		"&aIndustrial automation pushed to its theoretical ceiling.&r"
	]
	quest.425601000001020D.title: "&5IFEU Online&r"
	quest.42A905649E3D66A0.quest_desc: [
		"Sample the End's cuisine — &6Shadow Berry Jelly&r, &6Blossom Berry Jelly&r, and &6Cooked End Fish&r. Three of BetterEnd's signature consumables, each restoring hunger plus minor effects."
		""
		"Slightly off-the-path but worth it for the saturation bonuses."
	]
	quest.42A905649E3D66A0.title: "End Pantry"
	quest.42BFA7916F2CD4FC.quest_desc: ["&5Region: Mowzie's Hunt&r. Here's how it works: progress through the questlines, and then at the end, you'll kill 3 of 4 minibosses to unlock the next age. The choice are Bonesculler, Dire Hound Leader, Corrupted Hero, and Ferrous Wroughtnought. They won't be hard, but its a preview of whats coming next. However, for these to count, you still have to get to the kill quests. I won't tell you what way to follow, but explore and have fun!"]
	quest.42BFA7916F2CD4FC.title: "Region: Mowzie's Hunt"
	quest.430475E11D259B74.quest_desc: [
		"Build a &6Stone Smeltery&r — the citizen who smelts stone-tier materials (smooth stone, smelted ore variants)."
		""
		"Higher-tier smelteries unlock more recipes."
	]
	quest.430B4618A0BFF120.quest_desc: [
		"The &6Icebox&r refrigerates food and water. Items inside stay cold, which is useful for cooling waterskins or storing perishable food (some Cold Sweat addons add spoilage)."
		""
		"Place it in your base; it works as a passive cooler — no fuel needed."
	]
	quest.430B4618A0BFF120.quest_subtitle: "Cools a room down"
	quest.4348010000010100.quest_desc: [
		"&6Echo Shards&r drop only from Ancient Cities in the Deep Dark — the same fortified ruins that house the Warden. Four of them is more than enough to seed the chain reaction that follows."
		""
		"This is the first proof that you've been somewhere very dangerous and survived. Everything in this chapter assumes you have working Deep Dark infrastructure — silent boots, a tunneling plan, a way out."
		""
		"&aWool muffles sculk sensors and skulk shriekers. Bring lots.&r"
	]
	quest.4348010000010100.title: "&3The Soul Branch&r"
	quest.4348010000010101.quest_desc: [
		"&6Sculk Catalysts&r and &6Sculk Shriekers&r are vanilla blocks but they don't drop — you have to silk-touch them out of an Ancient City. The catalyst spreads sculk over xp drops; the shrieker summons the Warden when triggered four times in a short window."
		""
		"Both blocks are recipe components for the &6Soul Laser Base&r in the next quest. There is no mod-side substitute — IF Souls deliberately gates its laser tier behind real Deep Dark infrastructure."
		""
		"&cAvoid breaking shriekers anywhere near where you live. They keep their warning timer even after being placed and re-placed.&r"
	]
	quest.4348010000010101.title: "Sculk Infrastructure"
	quest.4348010000010102.quest_desc: [
		"The &6Soul Laser Base&r is Industrial Foregoing Souls' answer to the standard &6Ore Laser Base&r — same drilling concept, but rebuilt around sculk-economy infrastructure. Fire it at the sky and it generates resources tied to the soul/sculk family rather than vanilla ores."
		""
		"This is the engine behind every other quest in this chapter. Without a working Soul Laser Base, the network pipes have nothing to feed and the surge upgrade has nothing to surge."
		""
		"&cExpect heavy power draw.&r The Soul Laser eats FE faster than the standard variant — pair it with a real generator stack, not a single coal generator."
	]
	quest.4348010000010102.title: "&3Soul Laser Base&r"
	quest.4348010000010103.quest_desc: [
		"&6Soul Network Pipes&r are the IF Souls equivalent of laser-network pipes — they route soul-laser output from the base to wherever you want the drops to land."
		""
		"Every multi-laser setup needs these. One laser base in the open air, pipes routed back to a sealed processing room, and you've turned an exposed drilling rig into a contained factory."
	]
	quest.4348010000010103.title: "Soul Pipes"
	quest.4348010000010104.quest_desc: [
		"&6Soul Surge&r is the IF Souls augment that pushes the laser harder — more output per cycle in exchange for more power and more wear on whatever's standing under the beam."
		""
		"You don't strictly need it, but it's the difference between a Soul Laser that pays for its own power bill and one that's racing to keep up with downstream demand. Slot it in once you have a stable Atomic-tier energy stack."
	]
	quest.4348010000010104.title: "Soul Surge"
	quest.4348010000010105.quest_desc: [
		"Hold a complete &6Soul Laser&r setup — base plus network pipe — to confirm the chain reaction is online. Both pieces need to be in your inventory at the same time."
		""
		"This is a convergence gate. Below it the chapter is a tutorial on how to build the soul-laser stack; above it the chapter is over and you can fold this infrastructure into whatever you're doing in the rest of the Atomic Age."
		""
		"&7Optional reward: bragging rights. The Deep Dark didn't kill you.&r"
	]
	quest.4348010000010105.title: "&3Soul Network Online&r"
	quest.4352010000010001.quest_desc: [
		"The &6Silver Dungeon Key&r unlocks Aether's silver dungeons — cloud-bordered structures floating in the Aether dimension."
		""
		"&aSilver dungeons drop the Valkyrie Queen encounter loot.&r Required progression for Aether's combat tier."
	]
	quest.4352010000010001.quest_subtitle: "Boss gauntlet. Industrial gear, mythic foes."
	quest.4352010000010001.title: "The Crucible"
	quest.4352010000010002.quest_desc: [
		"&5Kill the Valkyrie Queen.&r The Valkyrie Queen is the silver-dungeon boss — floating warrior with lightning-imbued sword and high-mobility combat."
		""
		"&aDrops the Valkyrie set: lance, axe, helmet.&r The first Aether boss in IR9."
		""
		"&cFlying combat — bring an Aether-flavored mobility item or you'll spend the fight chasing her.&r"
	]
	quest.4352010000010002.quest_subtitle: "Silver Dungeon throne fight."
	quest.4352010000010002.title: "The Valkyrie Queen"
	quest.4352010000010007.quest_desc: [
		"The &6Poison Dart Shooter&r is an Aether ranged weapon. Fires poisoned darts that apply poison-damage-over-time."
		""
		"Useful as an opening attack against high-HP Aether enemies."
	]
	quest.4352010000010007.title: "Poison Dart Shooter"
	quest.4352010000010008.quest_desc: [
		"The &6Regeneration Stone&r is an Aether utility item — passive HP regeneration while held."
		""
		"Drops from Aether dungeons; carry through extended encounters."
	]
	quest.4352010000010008.quest_subtitle: "Pocket regen field."
	quest.4352010000010008.title: "Regeneration Stone"
	quest.4352010000010009.quest_desc: [
		"The &6Valkyrie Helmet&r is the head piece of the Valkyrie set — dropped by the Valkyrie Queen."
		""
		"Mid-tier IR9 head armor with magical resistance."
	]
	quest.4352010000010009.quest_subtitle: "Helm + chest + legs + boots + gloves + cape."
	quest.4352010000010009.title: "Valkyrie Armor"
	quest.435201000001000A.quest_desc: [
		"The &6Valkyrie Axe&r is the Valkyrie set's axe weapon. High damage; unique attack animation."
		""
		"Drops from the Valkyrie Queen; sometimes from elite silver-dungeon enemies."
	]
	quest.435201000001000A.title: "Valkyrie Tools"
	quest.435201000001000D.quest_desc: [
		"&5Kill the Sun Spirit.&r The Sun Spirit is Aether's gold-dungeon boss — sun-themed entity that progresses Aether to its endgame."
		""
		"&aDrops golden loot and the Sun Altar pieces.&r The second major Aether boss."
	]
	quest.435201000001000D.quest_subtitle: "Gold Dungeon throne fight."
	quest.435201000001000D.title: "The Sun Spirit"
	quest.435201000001000E.quest_desc: [
		"The &6Gold Dungeon Key&r unlocks Aether's gold dungeons. Drops from silver-dungeon completion."
		""
		"Required to reach the Sun Spirit encounter."
	]
	quest.435201000001000E.title: "Gold Dungeon Key"
	quest.435201000001000F.quest_desc: [
		"The &6Sun Altar&r is dropped by the Sun Spirit. Used in late-Aether ritual recipes."
		""
		"&aMid-IR Aether capstone item.&r"
	]
	quest.435201000001000F.quest_subtitle: "Aether weapon upgrades."
	quest.435201000001000F.title: "Sun Altar"
	quest.4352010000010011.quest_desc: [
		"The &6Vampire Blade&r is an Aether weapon — on hit, the wielder regains HP equal to a fraction of damage dealt."
		""
		"&aLifesteal-flavored melee.&r Strong in extended fights."
	]
	quest.4352010000010011.quest_subtitle: "Lifesteal on hit."
	quest.4352010000010011.title: "Vampire Blade"
	quest.4352010000010012.quest_desc: [
		"The &6Pig Slayer&r is an Aether weapon — bonus damage to pigs (pure flavor mostly, but it's funny)."
		""
		"Drops from Aether dungeons."
	]
	quest.4352010000010012.quest_subtitle: "Bonus damage to pigs."
	quest.4352010000010012.title: "Pig Slayer"
	quest.4352010000010013.quest_desc: [
		"The &6Life Shard&r is an Aether artifact — raises maximum HP when consumed."
		""
		"&aHP-pool upgrade item.&r Stack multiple to push your max HP further."
	]
	quest.4352010000010013.quest_subtitle: "Permanent +2 max HP."
	quest.4352010000010013.title: "Life Shard"
	quest.4352010000010014.quest_desc: [
		"The &6Iron Bubble&r is an Aether breathing artifact. Provides extended underwater breathing while held."
		""
		"Useful for ocean/aquatic exploration."
	]
	quest.4352010000010014.quest_subtitle: "Held: prevents knockback."
	quest.4352010000010014.title: "Iron Bubble"
	quest.4352010000010015.quest_desc: [
		"The &6Ice Pendant&r grants frost resistance and minor cold-damage immunity."
		""
		"Useful for cold-biome exploration; defensive utility."
	]
	quest.4352010000010015.quest_subtitle: "Freezes water under your feet."
	quest.4352010000010015.title: "Ice Pendant"
	quest.4352010000010016.quest_desc: [
		"The &6Ice Ring&r is the matching ring artifact — stacks with the Ice Pendant for stronger frost resistance."
		""
		"Aether ring slot accessory."
	]
	quest.4352010000010016.quest_subtitle: "Freezes lava on contact."
	quest.4352010000010016.title: "Ice Ring"
	quest.435201000001001A.quest_desc: [
		"&5Kill the Ender Guardian.&r The Ender Guardian is Cataclysm's End-themed boss — teleporting massive entity guarding ancient remnant ruins."
		""
		"&aDrops the Gauntlet of Guard.&r Strong defensive loot capstone."
	]
	quest.435201000001001A.quest_subtitle: "Cataclysm boss — End-adjacent."
	quest.435201000001001A.title: "The Ender Guardian"
	quest.435201000001001B.quest_desc: [
		"The &6Gauntlet of Guard&r is the Ender Guardian boss-drop. Equip for active blocking and counter-attack."
		""
		"&aShield-replacement weapon — trade direct damage for guarded counter-strikes.&r"
	]
	quest.435201000001001B.quest_subtitle: "Block + counter."
	quest.435201000001001B.title: "Gauntlet of Guard"
	quest.435201000001001C.quest_desc: [
		"&5Kill the Netherite Monstrosity.&r The Netherite Monstrosity is Cataclysm's nether-tier boss — hulking armored beast in deep nether ruins."
		""
		"&aDrops the Infernal Forge and high-tier nether loot.&r"
	]
	quest.435201000001001C.quest_subtitle: "Cataclysm boss — Nether."
	quest.435201000001001C.title: "The Netherite Monstrosity"
	quest.435201000001001D.quest_desc: [
		"The &6Infernal Forge&r is dropped by the Netherite Monstrosity. Functions as a nether-themed crafting/upgrade station."
		""
		"&aSpecialty Cataclysm loot block.&r"
	]
	quest.435201000001001D.quest_subtitle: "Cataclysm crafting station."
	quest.435201000001001D.title: "Infernal Forge"
	quest.435201000001001E.quest_desc: [
		"The &6Monstrous Horn&r is a Cataclysm consumable item — blow for an area-of-effect knockback."
		""
		"Useful for crowd control in dense mob fights."
	]
	quest.435201000001001E.quest_subtitle: "AOE blast on use."
	quest.435201000001001E.title: "Monstrous Horn"
	quest.435201000001001F.quest_desc: [
		"The &6Lava Power Cell&r is a Cataclysm-themed energy container. Used in Infernal Forge rituals and a couple of advanced recipes."
		""
		"Drops from nether-flavored Cataclysm encounters."
	]
	quest.435201000001001F.title: "Lava Power Cell"
	quest.4352010000010020.quest_desc: [
		"&5Kill the Ancient Remnant.&r The Ancient Remnant is Cataclysm's desert-themed boss — pyramid-guarding entity with sandstorm and desert-flavored attacks."
		""
		"&aDrops the Sandstorm in a Bottle and the Remnant Skull.&r"
	]
	quest.4352010000010020.quest_subtitle: "Cataclysm boss — desert."
	quest.4352010000010020.title: "The Ancient Remnant"
	quest.4352010000010021.quest_desc: [
		"The &6Sandstorm in a Bottle&r is a Cataclysm consumable. Throw to spawn a temporary sandstorm AoE."
		""
		"&aOffensive utility item from the Ancient Remnant fight.&r"
	]
	quest.4352010000010021.title: "Sandstorm in a Bottle"
	quest.4352010000010022.quest_desc: [
		"The &6Remnant Skull&r is an Ancient Remnant trophy drop. Decorative + reagent in advanced Cataclysm recipes."
		""
		"Display alongside other Cataclysm trophies."
	]
	quest.4352010000010022.title: "Remnant Skull"
	quest.4352010000010023.quest_desc: [
		"The &6Ancient Metal Block&r is a desert-themed Cataclysm storage block. Made from ancient metal ingots."
		""
		"Cosmetic + bulk storage."
	]
	quest.4352010000010023.quest_subtitle: "Endgame Cataclysm crafting block."
	quest.4352010000010023.title: "Ancient Metal Block"
	quest.4352010000010024.quest_desc: [
		"Hold the &6Ender Guardian Music Disc&r — Cataclysm's boss-themed jukebox track."
		""
		"Pure flavor; play in your boss-trophy room for atmosphere."
	]
	quest.4352010000010024.quest_subtitle: "Three trophies of the Crucible."
	quest.4352010000010024.title: "Cataclysm Discs"
	quest.4352010000010025.quest_desc: [
		"&5Kill the Spirit of Chaos.&r Born in Chaos' signature entity — chaotic spectral boss with random-flavored attacks."
		""
		"&aDrops chaos-themed loot and progression materials.&r"
	]
	quest.4352010000010025.quest_subtitle: "Born in Chaos final boss."
	quest.4352010000010025.title: "The Spirit of Chaos"
	quest.4352010000010026.quest_desc: [
		"&5Kill Lord Pumpkinhead.&r Born in Chaos' Halloween-flavored boss — pumpkin-headed entity with autumn theme."
		""
		"Drops seasonal loot and rare materials. Encounter spawns under specific conditions."
	]
	quest.4352010000010026.quest_subtitle: "The orange tyrant."
	quest.4352010000010026.title: "Lord Pumpkinhead"
	quest.4352010000010028.quest_desc: [
		"&5Kill the Hullbreaker.&r The Hullbreaker is Alex's Caves' deep-sea boss — massive aquatic entity in the abyssal-themed cave biome."
		""
		"&aDrops sea glass and the Enigmatic Engine.&r"
		""
		"&cAquatic combat — bring underwater breathing and a melee-focused build.&r"
	]
	quest.4352010000010028.quest_subtitle: "Alex's Caves boss — deep ocean."
	quest.4352010000010028.title: "The Hullbreaker"
	quest.4352010000010029.quest_desc: [
		"The &6Enigmatic Engine&r is the Hullbreaker's signature drop — a working underwater engine block. Provides power to advanced Alex's Caves machines."
		""
		"&aLate-IR Alex's Caves capstone item.&r"
	]
	quest.4352010000010029.title: "Enigmatic Engine"
	quest.435201000001002B.quest_desc: [
		"&6Sea Glass Shards&r are crystallized seawater fragments — drop from Hullbreaker fights and aquatic Alex's Caves enemies."
		""
		"Used in the Enigmatic Engine recipe and several aquatic gear pieces."
	]
	quest.435201000001002B.title: "Sea Glass Shards"
	quest.435201000001002C.quest_desc: [
		"&5Kill the Magnetron.&r The Magnetron is Alex's Caves' magnetic-cave boss — pulls and repels entities and metal items in combat."
		""
		"&aDrops magnetic-themed advanced gear.&r"
		""
		"&cBe careful with metal armor — the Magnetron's pull can yank you into hazards.&r"
	]
	quest.435201000001002C.quest_subtitle: "The magnet on legs."
	quest.435201000001002C.title: "The Magnetron"
	quest.43B9CF03D8E8755F.quest_desc: [
		"&6Eclipse Core&r — a black-purple sphere of compressed Starlight energy. Sister to the Blazing Starcore on the late-game crafting tree."
		""
		"Both cores converge on the &6Starcore&r recipe — feeding ultimately into Unrealium."
	]
	quest.43B9CF03D8E8755F.title: "Eclipse Core"
	quest.43E8EE182A1F6864.quest_desc: ["The &6Storm Sword&r — Deep Aether weapon that strikes with chained lightning damage."]
	quest.43E8EE182A1F6864.title: "Storm Sword"
	quest.43EB13F2C3D91789.quest_desc: [
		"The &6Black Foundry Controller&r is the brain of the PMW black foundry multiblock. The block that contains the GUI and processes recipes."
		""
		"&aThe heart of Productive Metalworks — smelt many metals at once with shared heat.&r Build the multiblock around the controller per the in-game guide."
	]
	quest.43EB13F2C3D91789.quest_subtitle: "Heart of the foundry"
	quest.43EB13F2C3D91789.title: "&6The Foundry Controller&r"
	quest.442C27F2E00B325C.quest_desc: [
		"&5Abyssologer&r — Monster Plus's deep-cave caster boss. Conjures dark magic from the depths."
		""
		"&aMid-tier boss; drops feed the ancient scroll + dark armor chain.&r"
	]
	quest.4450010000010001.quest_desc: [
		"You're building a rocket. The &6Nose Cone&r, &6Fin&r, and &6Engine&r are the three structural pieces every Stellaris rocket needs — assembled together with launch infrastructure, they get you off the planet."
		""
		"Each piece is its own crafting chain, with materials dragged forward from late-Atomic and earlier ages. Don't expect Vanilla recipe simplicity — Stellaris asks for serious feedstock."
		""
		"&aSmash all three out before worrying about life support and fuel.&r The pieces can be made in any order, but you can't launch without all three."
	]
	quest.4450010000010001.title: "&aRocket Frame&r"
	quest.4450010000010002.quest_desc: [
		"&6Water Separator&r splits water into oxygen and hydrogen. The &6Oxygen Distributor&r broadcasts breathable atmosphere to a small radius. The &6Big Oxygen Tank&r is what you wear on your back so you don't suffocate the moment you step off the launch pad."
		""
		"Stellaris planets don't all have breathable air — Venus is hostile, Mercury and Mars are airless, and the Moon will kill you fast. Life support gear is non-negotiable."
		""
		"&cWear the tank.&r Forgetting your oxygen on a barren planet is the most embarrassing way to die in OW."
	]
	quest.4450010000010002.title: "Oxygen System"
	quest.4450010000010003.quest_desc: [
		"The &6Pumpjack&r extracts crude oil from underground deposits. The &6Fuel Refinery&r processes that oil into rocket-grade fuel. Without both, your rocket sits on the pad as a very expensive lawn ornament."
		""
		"&aStellaris's pumpjack/fuel_refinery is its own &eisolated&r oil chain&r — there is no `c:crude_oil` tag in Stellaris's data (JAR only registers `c:fluid/hydrogen` and `c:fluid/oxygen`). Your IR-era Oil Scanner won't help here; prospect fresh."
	]
	quest.4450010000010003.title: "Fuel Chain"
	quest.4450010000010004.quest_desc: [
		"The &6Rocket Launch Pad&r is where the rocket sits before launch. The &6Rocket Station&r is the control terminal that handles destinations, fueling, and cargo manifests."
		""
		"Place these together with enough open sky above them. Stellaris will not launch a rocket through your roof — it has very strong opinions about ceilings."
	]
	quest.4450010000010004.title: "Launchpad and Station"
	quest.4450010000010005.quest_desc: [
		"The &6Rocket&r itself — the assembled vehicle, fueled and ready. Right-click the launch pad with this in your inventory and you've reached space."
		""
		"This is the moment OW genuinely begins. From here you pick destinations: Mercury for solar furnaces, Venus for acid chemistry, the Moon for desh, Mars for tharsite. Each planet wants different prep, different gear, different patience."
		""
		"&aBring spare oxygen, food, and a way home.&r The rocket consumes fuel both ways."
	]
	quest.4450010000010005.title: "&6First Launch&r"
	quest.4450010000010010.quest_desc: [
		"The Moon's surface yields three primary resources: &6Raw Desh&r (the signature lunar metal), &6Raw Steel&r (yes, naturally occurring on the Moon — Stellaris's reading of the regolith is generous), and &6Ice Shards&r from frozen lunar craters."
		""
		"Desh is the headline material — strong, heat-resistant, used in advanced Stellaris recipes and beyond. Steel is convenient backup; ice is your local water source for life support and atmospheric chemistry."
		""
		"&aPack a quarry or laser drill if you've got one.&r Manual moon mining is exactly as tedious as it sounds."
	]
	quest.4450010000010010.title: "Lunar Native Ore"
	quest.4450010000010011.quest_desc: [
		"The &6Electrodynamics Quarry&r is your shortcut. Place it on the Moon, point it at desh-bearing strata, and let voltage do the digging."
		""
		"&7Optional but strongly recommended.&r Hand-mining a moon's worth of desh ore is a punishment, not a quest."
	]
	quest.4450010000010011.title: "Low-Gravity Quarry"
	quest.4450010000010012.quest_desc: [
		"&6Desh Ingot&r — smelted from raw desh into the canonical lunar ingot. The thing every advanced Stellaris recipe asks for."
		""
		"You'll burn through stacks of these before OW is done. Build your smelting capacity accordingly — a single furnace will not keep up."
	]
	quest.4450010000010012.title: "&dMoon Core&r"
	quest.4450010000010014.quest_desc: [
		"Plant the &6Flag&r on the Moon. Symbolic, satisfying, and per Stellaris's planet-signature rules: the flag is part of how the pack tracks which planets you've actually been to."
		""
		"&aOne flag per planet.&r They're not just decoration — they tag chapter progression and gate the Beam Package convergence quest later in this chapter."
	]
	quest.4450010000010014.title: "&6First Footprint&r"
	quest.4450010000010020.quest_desc: [
		"Mars's surface yields &6Raw Tharsite&r (the signature Martian metal), &6Plutonium Pieces&r (from natural surface deposits), &6Ice Shards&r from polar caps, and a Martian surface ore block."
		""
		"Tharsite is Mars's headline material — used in mid-OW recipes and the Dyson Cube's beam-construction stack. Plutonium is the dangerous sweetener that connects Mars's ore haul into nuclear chains."
		""
		"&cMars is harsh.&r Bring oxygen, bring water, bring a way to escape if a sandstorm catches you with your back turned."
	]
	quest.4450010000010020.title: "Mars Native Ore"
	quest.4450010000010021.quest_desc: [
		"The &6Vacuumator&r is Stellaris's vacuum-rated mining helper. Place it on Mars and it'll do the dust-eating for you."
		""
		"&7Optional.&r Manual Mars mining works, this just hurts less."
	]
	quest.4450010000010021.title: "CO₂ Atmospheric Harvester"
	quest.4450010000010022.quest_desc: [
		"&6Tharsite Ingot&r — Mars's signature ingot, smelted from raw tharsite. Required for late-OW recipes including the Dyson Cube's beam-construction stack."
		""
		"Hoard these. The Beam Package wants three at minimum, plus more for downstream recipes you haven't seen yet."
	]
	quest.4450010000010022.title: "&6Tharsite Forge&r"
	quest.4450010000010025.quest_desc: [
		"Plant the &6Flag&r on Mars. Second of the four planet flags — half the planetary tour is now logged."
		""
		"&aMars flag also feeds the Beam Package gate&r — the Dyson capstone wants ingots from all four planets, but the flags ensure you actually visited."
	]
	quest.4450010000010025.title: "&6Olympus Mons&r"
	quest.4450010000010030.quest_desc: [
		"The &6Bulletproof Vest&r from Chemical Science — armor reinforced with kevlar layers. Standard military issue, but here it's the best lightweight protection you can carry to Venus's hostile surface."
		""
		"&aHold one before stepping onto Venus.&r The planet is the most hostile in the rocket-accessible set; lighter armor will suffer."
	]
	quest.4450010000010030.title: "Acid-Suit Prep"
	quest.4450010000010031.quest_desc: [
		"Venus's hellish surface yields &6Raw Corronium&r (the signature Venusian metal that gives the planet its character in this pack), &6Neptunium Pieces&r (rare actinide content from native deposits), and the smelted ingots of both."
		""
		"Neptunium is the science star — heavy, radioactive, fed back into Nuclear Science recipes for advanced fuel cycles. Corronium is the structural backbone of Venus's late-OW recipes."
		""
		"&cVenus's atmosphere will eat unprotected armor.&r Don't go in light."
	]
	quest.4450010000010031.title: "Venus Native Ore"
	quest.4450010000010032.quest_desc: [
		"&7Optional.&r Place a &6Water Separator&r on Venus. The atmosphere has trace water you can extract — slow, but it's there."
		""
		"More of a flavor quest than a necessity. You're proving the chemistry works on a planet that, by every classical measure, shouldn't have water at all."
	]
	quest.4450010000010032.title: "Sulfuric Acid Harvester"
	quest.4450010000010036.quest_desc: [
		"Plant the &6Flag&r on Venus. Three planet flags down."
		""
		"&aThe atmospheric chemistry of Venus matters&r — per pack design, Venus's resources gate certain Nuclear Science endgame upgrades."
	]
	quest.4450010000010036.title: "&6Through the Acid Veil&r"
	quest.4450010000010040.quest_desc: [
		"Mercury's sun-blasted surface yields &6Raw Solerium&r (the signature Mercurian metal — heat-fused, photonically charged) and &6Raw Uranium&r in concentrated surface seams the Sun's stripped clean of lighter elements."
		""
		"Solerium is Mercury's headline material; uranium is bonus fuel feedstock that connects the planet to your existing reactor stack."
		""
		"&cMercury bakes everything.&r Without heat-rated armor or insulation, you cook."
	]
	quest.4450010000010040.title: "Mercury Native Ore"
	quest.4450010000010041.quest_desc: [
		"&7Optional.&r Place a &6Solar Panel&r on Mercury. The Sun is closer here than it has ever been, and a single panel produces eye-watering power."
		""
		"Pure flavor, but the planet rewards the gesture."
	]
	quest.4450010000010041.title: "Solar Concentrator"
	quest.4450010000010042.quest_desc: [
		"&6Solerium Ingot&r — Mercury's signature ingot, smelted from raw solerium. The fourth and final planet metal."
		""
		"Required for the Beam Package and the rest of the Dyson Cube stack. You've now got all four planet metals — Desh, Tharsite, Corronium, Solerium."
	]
	quest.4450010000010042.title: "&dMercury Core&r"
	quest.4450010000010045.quest_desc: [
		"Plant the &6Flag&r on Mercury. Four planets, four flags. The planetary tour is complete."
		""
		"&aThis is the last of the four planet-signature gates&r — with all four flags planted, the Dyson Cube's beam-array build can begin."
	]
	quest.4450010000010045.title: "&6Hot Side / Cold Side&r"
	quest.4450010000010050.quest_desc: [
		"The &6EM Rail Ejector Controller&r is the heart of the orbital-payload launcher. It's how you fling beam packages and solar sails into orbit without paying for a rocket each time."
		""
		"This is where the &6Dyson Cube Project&r — a separate mod — enters the chapter. Its job: build a stellar-scale energy collector around the Sun by repeatedly mass-launching components into orbit and assembling them up there."
		""
		"&aSet up the rail near a wide open area.&r The launcher needs unobstructed sky above it."
	]
	quest.4450010000010050.title: "Cube Frame"
	quest.4450010000010051.quest_desc: [
		"Hold three ingots from each of the four planets — &6Desh&r (Moon), &6Tharsite&r (Mars), &6Neptunium&r (Venus), &6Solerium&r (Mercury)."
		""
		"This is the four-planet convergence quest. The Dyson Cube cannot be built without proof that you've worked every world. It's the locked Stellaris-OW design — Option 1: per-planet signatures gate the chapter."
		""
		"&cNo skipping planets.&r You can't fake your way to a Dyson sphere."
	]
	quest.4450010000010051.title: "&5Quad-Tribute Convergence&r"
	quest.4450010000010052.quest_desc: [
		"The &6Beam&r — one of two payloads the EM Rail Ejector launches into orbit. Beams form the structural lattice of the Dyson Cube."
		""
		"&aYou'll craft hundreds of these&r before the Cube is complete. Automate the recipe early."
	]
	quest.4450010000010052.title: "Beam Production"
	quest.4450010000010053.quest_desc: [
		"The &6Solar Sail&r — the second orbital payload. Sails capture stellar energy and convert it into transmittable power."
		""
		"&aLike beams, you'll want hundreds.&r Set up parallel automation if you can; serial production is misery."
	]
	quest.4450010000010053.title: "Solar Sail Production"
	quest.4450010000010054.quest_desc: [
		"&7Optional research log.&r Hold one raw ore from each of the four planets at the same time."
		""
		"The &6Tablet&r icon is Stellaris's in-world reference book — this quest is the player's signed receipt that they've physically touched every planet's regolith, not just the ingots."
	]
	quest.4450010000010054.title: "Periodic Wealth -- All Planets Mined"
	quest.4450010000010055.quest_desc: [
		"The &6Ray Receiver Controller&r is the ground station that catches the energy beam from your Dyson collector and delivers it as usable power on the surface."
		""
		"Place it where you want stellar-scale power output. The Cube above will rain joules down on it."
		""
		"&aBuild the receiver before launching all your sails&r — collected energy needs somewhere to go."
	]
	quest.4450010000010055.title: "Ray Receiver"
	quest.4450010000010056.quest_desc: [
		"&5The Dyson Cube Project capstone.&r Submit one fully-loaded &6Beam Package&r and one &6Solar Sail Package&r — the orbital-launch units that, once aloft and assembled, complete the Cube around your Sun."
		""
		"This is one of OW4's signature accomplishments. Building a Dyson sphere — even an abstracted, modded one — is the kind of project Kardashev defined his civilizational scale around. You are now a Type II in miniature."
		""
		"&5Stellar-scale engineering.&r The Sun answers to your power grid."
	]
	quest.4450010000010056.title: "&5THE DYSON CUBE&r"
	quest.451E7BC527C955B7.quest_desc: [
		"The first half of Alchemists Garden's botanical roster: &6Blood Rose&r, &6Bubblis&r, &6Cloudelion&r, &6Glow Fungus&r, and &6Toxic Cap&r."
		""
		"&aEach plant has a unique reagent use&r — blood for healing brews, glow fungus for light rings, toxic cap for damage potions. Find them growing in their themed biomes."
	]
	quest.451E7BC527C955B7.quest_subtitle: "&oRose, bubble, cloud, glow, cap."
	quest.451E7BC527C955B7.title: "&aGarden Bundle A"
	quest.45387B31E6D5738B.quest_desc: ["&6Goldenleaf Berries&r — Deep Aether's high-tier food crop."]
	quest.45D993DE9EF291FF.quest_desc: ["&6Golden Amber&r — fossilized resin found in Aether trees. Reagent for golden-themed Aether gear."]
	quest.45D993DE9EF291FF.title: "Golden Amber"
	quest.46115E2AF01B6866.quest_desc: [
		"The &6Crystal Greatsword&r is the balanced Starlight melee weapon — heavy enough to feel solid, fast enough to chain hits."
		""
		"Sits between the Starfire Hammer's slow brutality and the Dagger of Hunger's quick stabs. The default melee pick if you can't decide."
	]
	quest.46115E2AF01B6866.title: "Crystal Greatsword"
	quest.4650010000010001.quest_desc: [
		"The &6Air Compressor&r is PneumaticCraft's heart. It burns fuel to compress air, and that compressed air drives every PNC machine downstream."
		""
		"&aPNC isn't electrical — it's pneumatic.&r Pressurized air moves through tubes the same way RF moves through cables, but the math is different: pressure builds slowly and excess pressure leaks. Don't expect MI/Oritech intuitions to carry over."
		""
		"&cOver-pressurize and the compressor can rupture.&r Watch the pressure gauge."
	]
	quest.4650010000010001.quest_subtitle: "Every mod, every wire, every fuel."
	quest.4650010000010001.title: "Fuel  Power"
	quest.4650010000010003.quest_desc: [
		"&6Reinforced Stone Slabs&r are the half-block variant. Pure decorative + structural use."
		""
		"Compatible with vanilla slab placement; pairs aesthetically with reinforced stone walls."
	]
	quest.4650010000010003.title: "Reinforced Stone Slab"
	quest.4650010000010006.quest_desc: [
		"The &6Pressure Chamber Interface&r is the I/O port for the Pressure Chamber multiblock. Items go in here, pressurized products come out."
		""
		"&aOne interface per chamber face is enough.&r Place input on one side, output on the other; logistics flows naturally."
	]
	quest.4650010000010006.title: "Pressure Chamber Interface"
	quest.4650010000010008.quest_desc: [
		"The &6Seismic Sensor&r reads underground fluid deposits. Right-click to scan; it reports oil, lava, or other liquids in the chunk below."
		""
		"&aThis is how PNC traditionally finds oil.&r In this pack, oil worldgen is disabled — oil chunks come from Create Diesel Generators' system instead. The sensor still works for surface fluid detection."
	]
	quest.4650010000010008.quest_subtitle: "Find underground oil."
	quest.4650010000010008.title: "Seismic Sensor"
	quest.4650010000010009.quest_desc: [
		"The &6Liquid Hopper&r is a fluid-aware hopper. Pulls fluids out of adjacent containers and pushes them into a tank or machine below."
		""
		"Pneumatic equivalent of a vanilla hopper, scaled for fluids."
	]
	quest.4650010000010009.quest_subtitle: "Hopper that moves fluids instead of items."
	quest.4650010000010009.title: "Liquid Hopper"
	quest.465001000001000A.quest_desc: [
		"&6Air Canisters&r are portable pressure storage. Charge one at a Charging Station; carry it to power handheld pneumatic tools."
		""
		"Drone-style automation depends on canisters in the field."
	]
	quest.465001000001000A.quest_subtitle: "Portable pressure storage."
	quest.465001000001000A.title: "Air Canister"
	quest.465001000001000B.quest_desc: [
		"The &6Refinery&r is PNC's oil-cracker multiblock. Crude oil in, refined products out: diesel, gasoline, kerosene, LPG."
		""
		"&aRequires heat to operate.&r Place a heat source (lava, vortex tube, fired heater) under the base layer. The refinery cracks one product per tier of stack height."
		""
		"&cWith oil worldgen disabled in this pack, source crude from Create Diesel Generators' chunk deposits.&r"
	]
	quest.465001000001000B.quest_subtitle: "Crude oil processing."
	quest.465001000001000B.title: "Refinery"
	quest.465001000001000C.quest_desc: [
		"The &6Refinery Output&r is the additional stack-tier block. Each output adds one fractionation level — more outputs, more product variety per cycle."
		""
		"Stack to taste: 2 outputs splits oil into 2 products, 4 outputs splits into 4."
	]
	quest.465001000001000C.quest_subtitle: "Tap separate fuel fractions from one stack."
	quest.465001000001000C.title: "Refinery Output"
	quest.465001000001000D.quest_desc: [
		"The &6Thermopneumatic Processing Plant&r combines heat + pressure + a fluid input to produce specialty outputs."
		""
		"&aThis is where Plastic, etching acid, and several advanced PNC fluids are produced.&r Heat and pressure both must be in spec for the recipe to run."
	]
	quest.465001000001000D.quest_subtitle: "Advanced cracking."
	quest.465001000001000D.title: "Thermopneumatic Processing Plant"
	quest.465001000001000E.quest_desc: [
		"The &6Liquid Compressor&r burns liquid fuel for compressed air output. Diesel, kerosene, biodiesel — any combustible liquid works."
		""
		"Higher output than the solid-fuel Air Compressor; cleaner once you have an oil refinery online."
	]
	quest.465001000001000E.quest_subtitle: "Burn fuel for air."
	quest.465001000001000E.title: "Liquid Compressor"
	quest.465001000001000F.quest_desc: [
		"The &6Advanced Liquid Compressor&r is the next-tier liquid compressor — higher max pressure, higher throughput."
		""
		"Required for the highest-tier PNC machines that need pressure ceilings beyond 5 bar."
	]
	quest.465001000001000F.quest_subtitle: "Faster, hotter, fussier."
	quest.465001000001000F.title: "Advanced Liquid Compressor"
	quest.4650010000010010.quest_desc: [
		"The &6Small Tank&r is PNC's fluid storage block. Holds a couple thousand mB."
		""
		"Connect via Liquid Hopper or pressure-tube to fill/drain. PNC tanks have configurable I/O sides."
	]
	quest.4650010000010010.quest_subtitle: "Holds pressure and fluid."
	quest.4650010000010010.title: "Small Tank"
	quest.4650010000010011.quest_desc: [
		"The &6Oil Bucket&r holds crude oil — the input to the Refinery and to several other oil-cracking chains in this pack."
		""
		"&aCanonical source: Create Diesel Generators chunk deposits + pumpjack.&r PNC accepts CDG oil via the &7c:crude_oil&r tag."
	]
	quest.4650010000010011.quest_subtitle: "Black gold."
	quest.4650010000010011.title: "First Crude Oil"
	quest.4650010000010012.quest_desc: [
		"The &6Diesel Bucket&r holds refined diesel fuel. Burnable in liquid compressors, generators, and combustion engines across multiple mods."
		""
		"Output of the Refinery's diesel slot."
	]
	quest.4650010000010012.quest_subtitle: "Refinery output proven."
	quest.4650010000010012.title: "First Diesel"
	quest.4650010000010013.quest_desc: [
		"The &6Air Canister Array&r is a high-capacity portable air store — multiple canisters bundled into one item."
		""
		"Fuels long-runtime drones and pneumatic tool sessions away from base."
	]
	quest.4650010000010013.quest_subtitle: "4× canister storage and transfer."
	quest.4650010000010013.title: "Air Canister Array"
	quest.4650010000010014.quest_desc: [
		"The &6Heat Frame&r is PNC's heat-routing component. Place around a block to capture or apply heat as needed by recipes."
		""
		"Heat management is PNC's other dimension — alongside pressure, every advanced recipe needs the right temperature too."
	]
	quest.4650010000010014.quest_subtitle: "Plastic crafting prerequisite."
	quest.4650010000010014.title: "Heat Frame"
	quest.4650010000010015.quest_desc: [
		"The &6Plastic Bucket&r holds liquid plastic — the molten precursor before it cools into &6Plastic Sheets&r."
		""
		"&aOutput of the Thermopneumatic Processing Plant from oil-refinery products.&r This is the IR4 plastic chain in fluid form."
	]
	quest.4650010000010015.quest_subtitle: "Oil becomes parts."
	quest.4650010000010015.title: "Plastic Feedstock"
	quest.4650010000010016.quest_desc: [
		"The &6Gasoline Bucket&r holds refined gasoline. Higher volatility than diesel; some specialty engines require it."
		""
		"Fractionation output of the Refinery."
	]
	quest.4650010000010016.quest_subtitle: "High-octane fraction."
	quest.4650010000010016.title: "Gasoline"
	quest.4650010000010017.quest_desc: [
		"The &6Kerosene Bucket&r holds refined kerosene. Mid-distillate — common refinery output, jet-fuel-flavored in real life."
		""
		"Several PNC engines accept kerosene as a primary fuel."
	]
	quest.4650010000010017.title: "Kerosene"
	quest.4650010000010018.quest_desc: [
		"The &6LPG Bucket&r holds liquefied petroleum gas. The lightest distillate from the refinery."
		""
		"High burn rate, smaller energy per bucket. Specialty fuel for niche generators."
	]
	quest.4650010000010018.quest_subtitle: "High energy density."
	quest.4650010000010018.title: "LPG"
	quest.4650010000010019.quest_desc: [
		"The &6Lubricant Bucket&r holds refinery-derived lubricant. Used by some advanced machines as a recipe input."
		""
		"PNC processing intermediate — not a primary fuel, more of a reagent."
	]
	quest.4650010000010019.quest_subtitle: "Speed-upgrade ingredient."
	quest.4650010000010019.title: "Lubricant"
	quest.465001000001001A.quest_desc: [
		"The &6Vegetable Oil Bucket&r holds plant-derived oil. Pressed from seeds in the PNC press; precursor to biodiesel."
		""
		"&aThis is the renewable counterpart to crude oil.&r If you can't find oil yet, vegetable oil + ethanol → biodiesel works."
	]
	quest.465001000001001A.quest_subtitle: "Renewable plant-derived oil."
	quest.465001000001001A.title: "Vegetable Oil"
	quest.465001000001001B.quest_desc: [
		"The &6Ethanol Bucket&r holds distilled ethanol. Made by fermenting sugar/grain in the Thermopneumatic Plant."
		""
		"Combines with vegetable oil to make biodiesel."
	]
	quest.465001000001001B.quest_subtitle: "Fermentation product."
	quest.465001000001001B.title: "Ethanol"
	quest.465001000001001C.quest_desc: [
		"The &6Biodiesel Bucket&r holds renewable diesel fuel — the bio-route alternative to petroleum diesel."
		""
		"&aCleanly burns in any liquid compressor or diesel-fueled generator.&r Crops + ethanol → biodiesel; no oil chunks needed."
	]
	quest.465001000001001C.quest_subtitle: "Renewable fuel."
	quest.465001000001001C.title: "Biodiesel"
	quest.465001000001001D.quest_desc: [
		"&6Glycerol&r is the byproduct of biodiesel production. It can be processed into other useful chemicals or burned as low-tier fuel."
		""
		"Don't waste it — several recipes downstream want glycerol."
	]
	quest.465001000001001D.quest_subtitle: "Drop, not bucket."
	quest.465001000001001D.title: "Glycerol"
	quest.465001000001001E.quest_desc: [
		"The &6Unassembled PCB&r is PneumaticCraft's circuit precursor. Etch in acid (etching acid bucket) inside the Thermopneumatic Plant to produce printable circuits."
		""
		"Required for the PNC drone and several advanced upgrade recipes."
	]
	quest.465001000001001E.quest_subtitle: "Electronics start here."
	quest.465001000001001E.title: "Unassembled PCB"
	quest.465001000001001F.quest_desc: [
		"The &6Engineer's Workbench&r is Immersive Engineering's blueprint-driven crafting station. Many IE recipes require an Engineer's Hammer, a blueprint, and the workbench."
		""
		"&aReplaces the vanilla crafting table for IE-specific recipes.&r"
	]
	quest.465001000001001F.quest_subtitle: "IE begins here."
	quest.465001000001001F.title: "Engineer's Workbench"
	quest.4650010000010020.quest_desc: [
		"The &6Engineer's Hammer&r is IE's universal tool. Right-click to rotate IE blocks, sneak-right-click to disconnect wires, and use as a crafting reagent in many IE recipes."
		""
		"Wears out with use — carry a spare."
	]
	quest.4650010000010020.quest_subtitle: "Three tools, three jobs."
	quest.4650010000010020.title: "IE Tools"
	quest.4650010000010021.quest_desc: [
		"The &6Iron Mechanical Component&r is the iron-tier IE chassis part. Mid-tier IE machines (revolver, garden cloche, fluid pump) want it."
		""
		"Crafted at the Engineer's Workbench from iron plates and rods."
	]
	quest.4650010000010021.quest_subtitle: "Iron + hammer = mechanical component."
	quest.4650010000010021.title: "Iron Component"
	quest.4650010000010022.quest_desc: [
		"The &6Steel Mechanical Component&r is the steel upgrade. Required for higher-tier IE multiblocks — the Blast Furnace, Coke Oven, Crusher."
		""
		"&aImmersive Engineering's tier ladder runs iron → steel → electron tubes/circuit. Steel components mark the mid-tier.&r"
	]
	quest.4650010000010022.quest_subtitle: "Steel upgrade — for stronger machines."
	quest.4650010000010022.title: "Steel Component"
	quest.4650010000010024.quest_desc: [
		"The &6IE Fluid Pipe&r is Immersive Engineering's industrial fluid line. Reinforced steel, runs along walls in straight pipe-network style."
		""
		"Higher throughput than vanilla bucket-pumping; IE's pipe network is lossless."
	]
	quest.4650010000010024.title: "Fluid Pipe"
	quest.4650010000010025.quest_desc: [
		"The &6IE Fluid Pump&r pushes liquids through an IE pipe network. Provide redstone signal and the pump runs."
		""
		"Without a pump, fluid sits stationary in pipes. Place a pump near your fluid source."
	]
	quest.4650010000010025.quest_subtitle: "Powered fluid transport."
	quest.4650010000010025.title: "Fluid Pump"
	quest.4650010000010026.quest_desc: [
		"The &6Fluid Sorter&r filters fluid types in an IE pipe network. Whitelist diesel out one side, biodiesel out another."
		""
		"Useful for routing refinery outputs to specific tanks."
	]
	quest.4650010000010026.quest_subtitle: "Routes fluids by type."
	quest.4650010000010026.title: "Fluid Sorter"
	quest.4650010000010027.quest_desc: [
		"Open the IE engineer's manual to read up on Immersive Engineering basics. The book is your tutorial; it explains every machine and recipe with diagrams."
		""
		"&aIE is wire-and-multiblock heavy. Reading the manual saves dozens of failed builds.&r"
	]
	quest.4650010000010027.quest_subtitle: "Compact bulk fluid storage."
	quest.4650010000010027.title: "Tank"
	quest.4650010000010028.quest_desc: [
		"The &6Wooden Barrel&r is IE's small fluid storage. Right-click with bucket to fill/drain."
		""
		"Cheap, early-game; useful as a refinery output buffer."
	]
	quest.4650010000010028.quest_subtitle: "Stackable, decorative."
	quest.4650010000010028.title: "Wooden Barrel"
	quest.4650010000010029.quest_desc: [
		"The &6Plant Oil Bucket&r holds IE's pressed seed oil. IE's renewable oil source — press seeds in the Squeezer."
		""
		"Combines with ethanol in the Refinery for IE biodiesel."
	]
	quest.4650010000010029.quest_subtitle: "Squeezer output."
	quest.4650010000010029.title: "Plant Oil"
	quest.465001000001002A.quest_desc: [
		"The &6Creosote Bucket&r holds creosote oil — the byproduct of coal coking in the Coke Oven."
		""
		"Used in railway tie production and several IE recipes. Don't dump it; it's a useful intermediate."
	]
	quest.465001000001002A.quest_subtitle: "Wood-gasification byproduct."
	quest.465001000001002A.title: "Creosote Oil"
	quest.465001000001002B.quest_desc: [
		"&6Copper Wire Coils&r are IE's bare LV transmission line. String them between connectors to carry electricity."
		""
		"&aIE wires are real-world overhead lines — uninsulated copper sags between poles.&r Touching a live LV wire damages you."
	]
	quest.465001000001002B.quest_subtitle: "First wire."
	quest.465001000001002B.title: "Copper Wire Coil"
	quest.465001000001002C.quest_desc: [
		"&6Insulated Copper Wire Coils&r are the safer LV variant. Insulation prevents touch-damage and reduces a small amount of loss."
		""
		"Use insulated for runs near walkways or pets."
	]
	quest.465001000001002C.quest_subtitle: "MV tier — insulated copper."
	quest.465001000001002C.title: "Insulated Copper Wire Coil"
	quest.465001000001002D.quest_desc: [
		"&6Steel Wire Coils&r are IE's MV transmission line. Higher voltage, longer runs, more capacity."
		""
		"Pair with MV connectors and an MV transformer to step up from LV."
	]
	quest.465001000001002D.quest_subtitle: "HV tier — steel for serious power."
	quest.465001000001002D.title: "Steel Wire Coil"
	quest.465001000001002E.quest_desc: [
		"The &6LV Coil&r is the wound copper component used in dynamos, capacitors, and motors at LV tier."
		""
		"Recipe involves copper wire wound around an iron core."
	]
	quest.465001000001002E.title: "LV Coil"
	quest.465001000001002F.quest_desc: [
		"The &6MV Coil&r is the medium-voltage version — thicker windings, higher current rating."
		""
		"Required for MV dynamos and HV capacitor cores."
	]
	quest.465001000001002F.title: "MV Coil"
	quest.4650010000010030.quest_desc: [
		"The &6HV Coil&r is the heavy-current variant. Top-tier IE coil for the IR-era; advanced generators use it."
		""
		"&aHV is IE's top voltage tier.&r Past HV, you're routing through transformers to other mods."
	]
	quest.4650010000010030.title: "HV Coil"
	quest.4650010000010031.quest_desc: [
		"The &6LV Connector&r is the wire-attachment point on machines and capacitors. Right-click with a wire coil to start a run; right-click another connector to finish it."
		""
		"&aLV is the entry-level IE voltage — safe to touch, lowest capacity.&r"
	]
	quest.4650010000010031.quest_subtitle: "Wire terminal."
	quest.4650010000010031.title: "LV Connector"
	quest.4650010000010033.quest_desc: [
		"The &6HV Connector&r is the heavy-current attachment point. Use for HV wires running between transformers and high-draw machines."
		""
		"&cTouching a live HV wire is fatal. Insulate runs near walkways.&r"
	]
	quest.4650010000010033.title: "HV Connector"
	quest.4650010000010034.quest_desc: [
		"The &6LV Capacitor&r is IE's first energy buffer. Stores small amounts of FE; bridges generation and demand."
		""
		"Pair with a Dynamo and an LV connector to bootstrap an IE power network."
	]
	quest.4650010000010034.quest_subtitle: "IE energy storage."
	quest.4650010000010034.title: "LV Capacitor"
	quest.4650010000010036.quest_desc: [
		"The &6HV Capacitor&r is IE's high-tier energy buffer. Stores serious FE; pair with HV transformer for major networks."
		""
		"Top-tier IE capacitor for the IR era."
	]
	quest.4650010000010036.title: "HV Capacitor"
	quest.4650010000010037.quest_desc: [
		"The &6Transformer&r steps voltage up or down between LV/MV. Place it as the bridge between two IE wire networks of different tiers."
		""
		"&aIE machines have voltage rating; feeding the wrong voltage can damage them.&r The transformer is mandatory for cross-tier networks."
	]
	quest.4650010000010037.quest_subtitle: "LV/MV bridge."
	quest.4650010000010037.title: "Transformer"
	quest.4650010000010038.quest_desc: [
		"The &6HV Transformer&r is the heavy-tier voltage bridge — MV ↔ HV."
		""
		"Required when running IE-fed machines at the HV tier."
	]
	quest.4650010000010038.quest_subtitle: "High-voltage step-up."
	quest.4650010000010038.title: "HV Transformer"
	quest.4650010000010039.quest_desc: [
		"The &6Dynamo&r is IE's mechanical-to-electrical converter. Spin it with rotational power (windmill, watermill, or external rotation source) and it outputs FE."
		""
		"&aLow output but completely renewable.&r Pair with a windmill on an open coast for reliable trickle power."
	]
	quest.4650010000010039.quest_subtitle: "Kinetic to FE."
	quest.4650010000010039.title: "Dynamo"
	quest.465001000001003A.quest_desc: [
		"Open the IE engineer's manual to read up on advanced energy multiblocks — refinery, garden cloche, fermenter."
		""
		"These are the IE recipes that build out a self-sufficient biodiesel chain."
	]
	quest.465001000001003A.quest_subtitle: "Multiblock powerhouse."
	quest.465001000001003A.title: "IE Diesel Generator"
	quest.465001000001003B.quest_desc: [
		"The &6IE Biodiesel Bucket&r holds Immersive Engineering's biodiesel output. The Refinery multiblock combines plant oil + ethanol → biodiesel."
		""
		"&aIE biodiesel and PNC biodiesel cross-tag — either source feeds either ecosystem.&r"
	]
	quest.465001000001003B.quest_subtitle: "IE renewable diesel."
	quest.465001000001003B.title: "IE Biodiesel"
	quest.465001000001003C.quest_desc: [
		"The &6High-Power Biodiesel Bucket&r is the densified biodiesel from IE's advanced refining steps."
		""
		"Higher energy density than standard biodiesel; preferred fuel for IE's premium generators."
	]
	quest.465001000001003C.quest_subtitle: "Region E apex."
	quest.465001000001003C.title: "High-Power Biodiesel"
	quest.465001000001003F.quest_desc: [
		"&6Iron Wire&r is the iron-tier output of the Rolling Mill. Used in Create Addition's electric motor recipe and the modular accumulator."
		""
		"Stronger than copper wire; higher energy capacity."
	]
	quest.465001000001003F.title: "Iron Wire"
	quest.4650010000010040.quest_desc: [
		"&6Gold Wire&r is the high-conductivity premium wire variant. Used in Create Addition's high-tier capacitor and tesla coil recipes."
		""
		"Worth the gold spend; gold wire is half the recipe size of copper for the same effect."
	]
	quest.4650010000010040.quest_subtitle: "High-current conductor."
	quest.4650010000010040.title: "Gold Wire"
	quest.4650010000010042.quest_desc: [
		"&6Gold Spool&r is the gold-wire storage form. Used in advanced Create Addition recipes (high-tier capacitors, tesla coil emitter)."
		""
		"Higher cost, higher density."
	]
	quest.4650010000010042.quest_subtitle: "High-current spool."
	quest.4650010000010042.title: "Gold Spool"
	quest.4650010000010043.quest_desc: [
		"&6Copper Rods&r are Create Addition's metal-rod intermediate. Made from copper wire processed in the Rolling Mill."
		""
		"Used in motor and alternator assembly."
	]
	quest.4650010000010043.quest_subtitle: "Rolling Mill output — crafting catalog."
	quest.4650010000010043.title: "Copper Rod"
	quest.4650010000010046.quest_desc: [
		"The &6Alternator&r is Create Addition's rotation-to-FE converter. Drive it with Create rotational power; output is FE."
		""
		"&aThe canonical Create→FE bridge in this pack.&r Pair with a windmill, watermill, or steam engine to bootstrap your factory's electricity."
	]
	quest.4650010000010046.quest_subtitle: "SU → FE."
	quest.4650010000010046.title: "Alternator"
	quest.4650010000010047.quest_desc: [
		"The &6Electric Motor&r is the inverse of the Alternator — it consumes FE and outputs Create rotational power."
		""
		"&aEssential for hybrid bases that have both Create and electric machines but want to drive Create kinetics from electrical power.&r"
	]
	quest.4650010000010047.quest_subtitle: "FE → SU."
	quest.4650010000010047.title: "Electric Motor"
	quest.4650010000010048.quest_desc: [
		"The &6Modular Accumulator&r is Create Addition's expandable battery. Place multiple accumulators adjacent to each other; the network capacity grows."
		""
		"Mid-tier FE buffer; cheap to expand."
	]
	quest.4650010000010048.quest_subtitle: "Modular FE battery."
	quest.4650010000010048.title: "Modular Accumulator"
	quest.465001000001004A.quest_desc: [
		"The &6Tesla Coil&r is Create Addition's wireless power transmitter and a player-zapper. Feed it FE; nearby creatures take damage; nearby chargers receive power wirelessly."
		""
		"&aPair with a tesla-coil-rated battery on your character for combat zaps.&r &cThe coil shocks the player too if you stand too close while charged.&r"
	]
	quest.465001000001004A.quest_subtitle: "Wireless FE."
	quest.465001000001004A.title: "Tesla Coil"
	quest.465001000001004C.quest_desc: [
		"&6Create New Age Copper Wire&r is this addon's wire variant. Distinct item from CA copper wire; used only in CNA recipes."
		""
		"Don't confuse with Create Addition's wire — they're not interchangeable in recipes."
	]
	quest.465001000001004C.quest_subtitle: "CNA's distinct copper wire."
	quest.465001000001004C.title: "CNA Copper Wire"
	quest.465001000001004D.quest_desc: [
		"The &6Basic Motor&r is Create New Age's electric motor variant. Distinct from CA's Electric Motor."
		""
		"Used to drive CNA-specific machine recipes."
	]
	quest.465001000001004D.quest_subtitle: "Alt motor path."
	quest.465001000001004D.title: "CNA Basic Motor"
	quest.465001000001004E.quest_desc: [
		"&6Generator Coils&r are CNA's wound-wire components. Used in their generator and accumulator chain."
		""
		"CNA's coil is a different recipe from CA's, even though they look similar — pay attention to the namespace in JEI."
	]
	quest.465001000001004E.quest_subtitle: "Spinning coil generates FE."
	quest.465001000001004E.title: "Generator Coil"
	quest.465001000001004F.quest_desc: [
		"&6Carbon Brushes&r are CNA's commutator wear parts — the carbon contacts that ride on a motor's spinning collar."
		""
		"Used in motor and generator recipes; consumable in some."
	]
	quest.465001000001004F.quest_subtitle: "Collects from rotating coil."
	quest.465001000001004F.title: "Carbon Brushes"
	quest.4650010000010051.quest_desc: [
		"&6Overcharged Iron&r is CNA's signature exotic metal. Process iron in the CNA accumulator at full charge to produce it."
		""
		"&aThe CNA tier ladder is overcharged-metal-driven.&r Iron → gold → diamond."
	]
	quest.4650010000010051.quest_subtitle: "Energised iron."
	quest.4650010000010051.title: "Overcharged Iron"
	quest.4650010000010052.quest_desc: [
		"&6Overcharged Gold&r is the next tier above overcharged iron. Higher-energy capacity components — advanced motor cores and high-tier circuits."
		""
		"Top-tier IR-era CNA exotic."
	]
	quest.4650010000010052.quest_subtitle: "Advanced energised material."
	quest.4650010000010052.title: "Overcharged Gold"
	quest.4650010000010053.quest_desc: [
		"The &6Conductive Casing&r is PowerGrid's machine chassis. Forms the structural element of generators, motors, and large electrical assemblies."
		""
		"&aPowerGrid is the entry to the &65Science Spine&r in this pack.&r Voltage and circuit tiers run through PowerGrid → Electrodynamics → Chemical Science → Nuclear Science → Ballistix. PowerGrid is where it begins."
	]
	quest.4650010000010053.quest_subtitle: "A third Create power path."
	quest.4650010000010053.title: "Conductive Casing"
	quest.4650010000010054.quest_desc: [
		"The &6Wire Cutter&r is PowerGrid's installation tool. Right-click on PowerGrid wires to cut, splice, or remove them."
		""
		"Carry one alongside your IE Engineer's Hammer; PowerGrid wires don't respond to other mod tools."
	]
	quest.4650010000010054.quest_subtitle: "Tool — cuts wire and crafts circuits."
	quest.4650010000010054.title: "Wire Cutter"
	quest.4650010000010055.quest_desc: [
		"&6Copper Coils&r are PowerGrid's wound-conductor components. Used in motors, generators, and induction-rotor assemblies."
		""
		"Same logic as CA/CNA coils, separate ecosystem."
	]
	quest.4650010000010055.quest_subtitle: "Wound-wire core."
	quest.4650010000010055.title: "Copper Coil"
	quest.4650010000010057.quest_desc: [
		"The &6Electromagnet&r is PowerGrid's magnetic-force component. Coils + iron + redstone, assembled."
		""
		"Used in PowerGrid generators and the induction rotor recipe."
	]
	quest.4650010000010057.quest_subtitle: "Powered electromagnet."
	quest.4650010000010057.title: "Electromagnet"
	quest.4650010000010058.quest_desc: [
		"The &6Generator Housing&r is the chassis for PowerGrid's electricity-producing machines. Combines with rotor + commutator to form a complete generator."
		""
		"&aMid-tier PowerGrid — this is the centerpiece block of the chain.&r"
	]
	quest.4650010000010058.quest_subtitle: "Generator multiblock body."
	quest.4650010000010058.title: "Generator Housing"
	quest.4650010000010059.quest_desc: [
		"The &6Generator Induction Rotor&r is the spinning element inside a PowerGrid generator. Magnetic field × spin = electricity."
		""
		"&aReal-world physics: this is exactly how a power-station alternator works.&r Build the generator and you've assembled an industrial-scale dynamo."
	]
	quest.4650010000010059.quest_subtitle: "Spinning core."
	quest.4650010000010059.title: "Induction Rotor"
	quest.465001000001005A.quest_desc: [
		"The &6Generator Commutator&r is the rotating contact assembly in a PowerGrid DC generator. It rectifies the alternating current produced by the rotor."
		""
		"Required in the generator multiblock recipe."
	]
	quest.465001000001005A.quest_subtitle: "Build a generator."
	quest.465001000001005A.title: "Generator Commutator"
	quest.465001000001005B.quest_desc: [
		"The &6PowerGrid Electric Motor&r is the inverse of the generator — consume electricity, produce rotation."
		""
		"Drives the rotational input for several Create-cross-mod recipes when paired through the right adapters."
	]
	quest.465001000001005B.quest_subtitle: "FE → rotation."
	quest.465001000001005B.title: "PG Electric Motor"
	quest.465001000001005C.quest_desc: [
		"The &6Battery&r is PowerGrid's primary energy storage. Holds the chain's voltage-current product over time."
		""
		"Pair with a wire network for buffered electrical capacity."
	]
	quest.465001000001005C.quest_subtitle: "Mid-tier FE storage."
	quest.465001000001005C.title: "Grid Battery"
	quest.465001000001005D.quest_desc: [
		"The &6Portable Battery&r is the handheld variant. Carry one to power PowerGrid handheld tools; recharge at any battery box."
		""
		"Essential field gear for surveying and remote installation."
	]
	quest.465001000001005D.quest_subtitle: "Pocket FE."
	quest.465001000001005D.title: "Portable Battery"
	quest.465001000001005E.quest_desc: [
		"The &6Potato Battery&r is PowerGrid's joke-but-real entry battery. Tiny output, runs on a literal potato (and zinc/copper electrodes)."
		""
		"&aPure science-class chemistry trope.&r Useful as a cheap demo battery; not enough output for real machines."
	]
	quest.465001000001005E.quest_subtitle: "Natural green energy."
	quest.465001000001005E.title: "Potato Battery"
	quest.465001000001005F.quest_desc: [
		"&6Wire&r is PowerGrid's standard transmission line."
		""
		"Cuts and splices with the Wire Cutter. Carries voltage between connectors and machines in a PowerGrid network."
	]
	quest.465001000001005F.title: "PG Wire"
	quest.4650010000010060.quest_desc: [
		"&6Golden Wire&r is the higher-conductivity wire variant. Lower resistance, longer runs."
		""
		"Use for high-current PowerGrid transmission lines."
	]
	quest.4650010000010060.title: "Golden Wire"
	quest.4650010000010061.quest_desc: [
		"The &6Multimeter&r reads voltage and current on PowerGrid wires and connectors. Right-click any node to see the live values."
		""
		"&aIndispensable for PowerGrid debugging.&r Mismatched voltage burns out machines; the multimeter catches it before installation."
	]
	quest.4650010000010061.quest_subtitle: "Diagnostic — voltage, current, power."
	quest.4650010000010061.title: "Multimeter"
	quest.4650010000010062.quest_desc: [
		"The &6Voltage Gauge&r is a placed always-on voltmeter. Displays the local network's voltage at all times."
		""
		"Stick one on every panel you build — you'll thank yourself when something stops working."
	]
	quest.4650010000010062.quest_subtitle: "Full readout suite."
	quest.4650010000010062.title: "Diagnostic Gauges"
	quest.4650010000010063.quest_desc: [
		"&6Oak Track&r is Create Railways' wood-tied rail. Place it like a vanilla rail; trains run on it via Create's contraption system."
		""
		"&aRailways extends Create's train mod with proper switching, signaling, and headstocks.&r"
	]
	quest.4650010000010063.quest_subtitle: "Rails laid."
	quest.4650010000010063.title: "Train Track"
	quest.4650010000010064.quest_desc: [
		"The &6Knuckle Coupler&r is one of three coupler types for joining train cars. Knuckle is the modern auto-locking style."
		""
		"Pair with matching couplers on adjacent cars to chain them."
	]
	quest.4650010000010064.quest_subtitle: "Standard auto-coupling."
	quest.4650010000010064.title: "Knuckle Coupler"
	quest.4650010000010065.quest_desc: [
		"The &6Link-and-Pin Coupler&r is the oldest coupler style — manual, dangerous (historically, still safe in-game)."
		""
		"Aesthetic for old-timey trains. Functions identically to other couplers."
	]
	quest.4650010000010065.quest_subtitle: "Older — manual uncouple."
	quest.4650010000010065.title: "Link and Pin"
	quest.4650010000010066.quest_desc: [
		"The &6Screwlink Coupler&r is the European-style threaded coupler. Manual but reliable."
		""
		"Pure aesthetic choice between the three coupler styles."
	]
	quest.4650010000010066.quest_subtitle: "Tight — never uncouples on collision."
	quest.4650010000010066.title: "Screwlink Coupler"
	quest.4650010000010067.quest_desc: [
		"The &6Wooden Headstock&r is the railway car's nose-piece. Mounts couplers and provides visual front-end aesthetics."
		""
		"Required for assembling proper Railways train cars."
	]
	quest.4650010000010067.quest_subtitle: "Locomotive front."
	quest.4650010000010067.title: "Wooden Headstock"
	quest.4650010000010068.quest_desc: [
		"The &6Copycat Headstock&r is the camouflaged headstock variant — assigns any block's appearance."
		""
		"Match your train's aesthetic across customized car designs."
	]
	quest.4650010000010068.quest_subtitle: "Configurable headstock."
	quest.4650010000010068.title: "Copycat Headstock"
	quest.4650010000010069.quest_desc: [
		"The &6Coal-Burner Smokestack&r is one of three smokestack types for steam locomotives. Black smoke, traditional shape."
		""
		"Pure aesthetic choice; functionality identical across smokestack types."
	]
	quest.4650010000010069.quest_subtitle: "Coal-fired stack — vanilla aesthetic."
	quest.4650010000010069.title: "Coal Smokestack"
	quest.465001000001006A.quest_desc: [
		"The &6Oil-Burner Smokestack&r emits a different smoke pattern, fitting oil-fired diesel-locomotive aesthetics."
		""
		"Decorative variant."
	]
	quest.465001000001006A.quest_subtitle: "Diesel locomotion."
	quest.465001000001006A.title: "Oil Smokestack"
	quest.465001000001006B.quest_desc: [
		"The &6Wood-Burner Smokestack&r emits the wood-fire characteristic puffing pattern."
		""
		"The third aesthetic smokestack option."
	]
	quest.465001000001006B.title: "Wood Smokestack"
	quest.465001000001006C.quest_desc: [
		"The &6Bench Cart&r is a passenger train car — place benches inside, players ride seated."
		""
		"Comfort upgrade for long Railways transit."
	]
	quest.465001000001006C.quest_subtitle: "Cart with a workbench."
	quest.465001000001006C.title: "Bench Cart"
	quest.465001000001006D.quest_desc: [
		"The &6Jukebox Cart&r plays music while the train moves. Load a disc; it loops as you ride."
		""
		"Pure flavor; does no logistical work, but it makes the trip pleasant."
	]
	quest.465001000001006D.quest_subtitle: "Music while you ride."
	quest.465001000001006D.title: "Jukebox Cart"
	quest.465001000001006E.quest_desc: [
		"The &6Big Buffer&r is the wall-end stopper for a railway track — large yellow-and-black buffer at the end of a line."
		""
		"Place at terminal stations to prevent runaway-train spillover."
	]
	quest.465001000001006E.quest_subtitle: "Track terminator — stops runaway trains."
	quest.465001000001006E.title: "Big Buffer"
	quest.465001000001006F.quest_desc: [
		"The &6Fuel Tank&r is a rail-car fuel reservoir. Allows long-haul trains to carry their own fuel supply."
		""
		"Required for diesel-fired Create trains running long distances."
	]
	quest.465001000001006F.quest_subtitle: "Fluid hauling."
	quest.465001000001006F.title: "Fuel Tank"
	quest.4650010000010070.quest_desc: [
		"The &6Portable Fuel Interface&r lets you bunker fuel into a moving train without stopping."
		""
		"Place along a track; the train auto-refuels as it passes."
	]
	quest.4650010000010070.quest_subtitle: "Train↔fluid loading."
	quest.4650010000010070.title: "Portable Fuel Interface"
	quest.4650010000010071.quest_desc: [
		"The &6Solar Panel I&r is Solar Flux's entry-tier solar generator. Slow trickle of FE during daytime."
		""
		"&aSolar Flux's tier ladder runs panel I → VIII, each tier multiplying output.&r Tier I is starter-flavored; you'll upgrade fast."
	]
	quest.4650010000010071.quest_subtitle: "Free power."
	quest.4650010000010071.title: "Solar Panel Tier 1"
	quest.4650010000010072.quest_desc: [
		"The &6Photovoltaic Cell I&r is the tier-1 solar component. Recipe input for Solar Panel I."
		""
		"Made from quartz-based materials; the actual energy-converting element."
	]
	quest.4650010000010072.quest_subtitle: "Tier 1 cell — crafting input."
	quest.4650010000010072.title: "Photovoltaic Cell 1"
	quest.4650010000010073.quest_desc: [
		"The &6Photovoltaic Cell II&r is the tier-2 solar cell — higher output, better efficiency."
		""
		"Required for Solar Panel II."
	]
	quest.4650010000010073.quest_subtitle: "Tier 2 cell."
	quest.4650010000010073.title: "Photovoltaic Cell 2"
	quest.4650010000010074.quest_desc: [
		"The &6Mirror&r is Solar Flux's optical concentrator component. Used in mid-tier solar panel recipes."
		""
		"Scales output further when integrated into the panel design."
	]
	quest.4650010000010074.quest_subtitle: "Reflective component."
	quest.4650010000010074.title: "Mirror"
	quest.4650010000010075.quest_desc: [
		"The &6Solar Panel II&r is the tier-2 panel — doubles tier I's output."
		""
		"Mass-deploy in arrays; one panel is small, but a roof of them is significant."
	]
	quest.4650010000010075.quest_subtitle: "IR apex passive power."
	quest.4650010000010075.title: "Solar Panel Tier 2"
	quest.4650010000010076.quest_desc: [
		"The &6Basic Machine Frame&r is Energized Power's chassis. Required for every Energized Power machine."
		""
		"Energized Power is the &7teaching mod&r — a small-scale Mekanism-flavored chain that introduces electrical machine concepts in IR3."
	]
	quest.4650010000010076.quest_subtitle: "EP foundation."
	quest.4650010000010076.title: "Basic Machine Frame"
	quest.4650010000010077.quest_desc: [
		"&6Silicon&r (Energized Power variant) is the EP semiconductor. Required for circuits."
		""
		"Same logical role as MI silicon — separate item, separate ecosystem."
	]
	quest.4650010000010077.quest_subtitle: "Electronics substrate."
	quest.4650010000010077.title: "Silicon"
	quest.4650010000010078.quest_desc: [
		"The &6Basic Circuit&r is Energized Power's first circuit tier."
		""
		"&aThe EP tier ladder is circuit-driven. Basic → Advanced → Elite.&r Each tier opens a wave of EP recipes."
	]
	quest.4650010000010078.quest_subtitle: "EP electronics — basic tier."
	quest.4650010000010078.title: "Basic Circuit"
	quest.4650010000010079.quest_desc: [
		"The &6Basic Solar Cell&r is Energized Power's solar option. Mid-output FE per daytime tick."
		""
		"Cheap and cheerful; pairs with EP's small battery box for an off-grid build."
	]
	quest.4650010000010079.quest_subtitle: "EP solar — alt to SolarFlux."
	quest.4650010000010079.title: "Basic Solar Cell"
	quest.465001000001007A.quest_desc: [
		"The &6Battery Box&r is Energized Power's RF buffer block. Stores and outputs FE on demand within the Energized Power and other RF/FE-compatible mod ecosystem."
		""
		"Place on the wall, wire in your generators, draw out for your machines."
		""
		"&7Note: This is part of the RF/FE energy system. Mekanism Joules, Create SU, and Electrodynamics V/J use separate energy systems and are not directly interoperable.&r"
	]
	quest.465001000001007A.quest_subtitle: "EP FE storage."
	quest.465001000001007A.title: "Battery Box"
	quest.465001000001007B.quest_desc: [
		"The &6Charger&r is Energized Power's portable-battery recharge station."
		""
		"Slot in batteries or charged tools; pull out fully topped up."
	]
	quest.465001000001007B.quest_subtitle: "Item charger."
	quest.465001000001007B.title: "Charger"
	quest.465001000001007C.quest_desc: [
		"The &6Cable Insulator&r is Energized Power's cable-coating component."
		""
		"Required for insulated wire variants in EP's network."
	]
	quest.465001000001007C.quest_subtitle: "Cable insulation."
	quest.465001000001007C.title: "Cable Insulator"
	quest.465001000001007D.quest_desc: [
		"The &6Crystal Matrix&r is Energized Power's late-tier energy-storage component. Dense FE per cubic meter."
		""
		"Used in EP's elite battery box and high-tier machine recipes."
	]
	quest.465001000001007D.quest_subtitle: "EP capstone."
	quest.465001000001007D.title: "Crystal Matrix"
	quest.465001000001007E.quest_desc: [
		"The &6Copper Generator&r is Generator Galore's first-tier generator. Burns coal-equivalent fuels for FE."
		""
		"&aGenerator Galore is a generator-buffet mod — pick the generator that fits your fuel availability.&r Copper is the entry tier."
	]
	quest.465001000001007E.quest_subtitle: "Simple FE."
	quest.465001000001007E.title: "Copper Generator"
	quest.465001000001007F.quest_desc: [
		"The &6Iron Generator&r is the next tier — higher output, accepts a wider fuel range."
		""
		"Standard pick for early-IR power supplementation."
	]
	quest.465001000001007F.quest_subtitle: "Mid-tier solid fuel."
	quest.465001000001007F.title: "Iron Generator"
	quest.4650010000010080.quest_desc: [
		"The &6Magmatic Generator&r burns lava for FE. Massive output per bucket; runs indefinitely if you pump from the Nether."
		""
		"&aOne of the best lava-to-FE rates in the pack.&r Pair with an Oritech Pump in nether lava for endless trickle power."
	]
	quest.4650010000010080.quest_subtitle: "Lava-burning."
	quest.4650010000010080.title: "Magmatic Generator"
	quest.4650010000010081.quest_desc: [
		"The &6Culinary Generator&r burns food items for FE. Higher-tier food = higher FE per unit."
		""
		"&aMore for fun than for serious power, but if you're running a MineColonies base with surplus food, this turns leftovers into electricity.&r"
	]
	quest.4650010000010081.quest_subtitle: "Food-burning."
	quest.4650010000010081.title: "Culinary Generator"
	quest.4650010000010082.quest_desc: [
		"The &6Honey Generator&r burns honey bottles for FE. Niche generator for bee-keepers."
		""
		"Steady output if you maintain a productive apiary."
	]
	quest.4650010000010082.quest_subtitle: "Honey fuel."
	quest.4650010000010082.title: "Honey Generator"
	quest.4650010000010083.quest_desc: [
		"The &6Ender Generator&r runs on ender pearls or end-flavored fuel. End-tier output."
		""
		"&aBest paired with an enderman farm in the End for sustained high-tier FE.&r"
	]
	quest.4650010000010083.quest_subtitle: "Post-End power."
	quest.4650010000010083.title: "Ender Generator"
	quest.4650010000010085.quest_desc: [
		"The &6Etching Acid Bucket&r holds the corrosive bath for PCB etching. Output of the Thermopneumatic Plant from a specific recipe."
		""
		"Required for printable PCBs and the drone hardware chain."
	]
	quest.4650010000010085.quest_subtitle: "Circuit chemistry proven."
	quest.4650010000010085.title: "Etching Acid"
	quest.4650010000010089.quest_desc: [
		"The &6Assembly Platform&r is PNC's drone-construction multiblock. Builds drones from drone parts in an automated sequence."
		""
		"&aAdvanced PNC content — gates the drone-driven automation that PNC is famous for.&r"
	]
	quest.4650010000010089.quest_subtitle: "Every mod, every wire, every build line."
	quest.4650010000010089.title: "&6The Competing Grids - Complete&r"
	quest.4650010000010090.quest_desc: [
		"Open the IE engineer's manual to read up on the energy-network setup chain — capacitor, transformer, dynamo, multiblocks."
		""
		"&aThe manual's diagrams are the fastest way to internalize IE's wire-network rules.&r"
	]
	quest.4650010000010090.quest_subtitle: "Oil refining begins."
	quest.4650010000010090.title: "Black Gold"
	quest.4650010000010091.quest_desc: [
		"The &6Still Oil Bucket&r holds Oritech's distilled crude oil. Output of the refinery's first fractionation step."
		""
		"Cracks further into diesel, heavy oil, and lighter fractions in subsequent processing."
	]
	quest.4650010000010091.quest_subtitle: "Liquid gold."
	quest.4650010000010091.title: "Crude Oil Bucket"
	quest.4650010000010092.quest_desc: [
		"The &6Refinery Block&r is Oritech's oil-cracking machine. Pipe in crude oil, pipe out refined products by tier."
		""
		"&aOritech's parallel oil chain to PNC.&r Both ecosystems source crude from CDG and produce overlapping fuels via shared tags."
	]
	quest.4650010000010092.quest_subtitle: "Crude oil processing."
	quest.4650010000010092.title: "Refinery"
	quest.4650010000010093.quest_desc: [
		"The &6Refinery Module Block&r is the stack-on extender for Oritech's Refinery. Each module adds one fractionation tier — more modules, more product variety."
		""
		"Stack vertically; the refinery height determines output complexity."
	]
	quest.4650010000010093.title: "Refinery Module"
	quest.4650010000010095.quest_desc: [
		"The &6Still Heavy Oil Bucket&r holds Oritech's heavy-fraction distillate. The denser, slower-burning end of crude refining."
		""
		"Used in the Oritech fuel generator and several lubrication-flavored recipes."
	]
	quest.4650010000010095.title: "Heavy Oil"
	quest.4650010000010096.quest_desc: [
		"The &6Fuel Generator Block&r is Oritech's liquid-fuel-burning generator. Pipes in diesel, biodiesel, or heavy oil; outputs FE."
		""
		"&aThe primary load-bearing generator once your oil chain is online.&r Higher output than the basic and bio generators."
	]
	quest.4650010000010096.quest_subtitle: "Diesel-powered RF."
	quest.4650010000010096.title: "Fuel Generator"
	quest.4650010000010097.quest_desc: [
		"The &6Red Alloy Wire&r is ProjectRed's signature redstone-replacement wire. Carries redstone signal in a thin trace; runs cleanly along walls and floors without taking up half a block per segment."
		""
		"&aProjectRed is the redstone-overhaul mod.&r Wires, gates, and bundled signals all live in this ecosystem."
	]
	quest.4650010000010097.quest_subtitle: "Redstone dust, but better."
	quest.4650010000010097.title: "Better Wiring"
	quest.4650010000010098.quest_desc: [
		"The &6Neutral Bundled Wire&r carries 16 colored signals on one cable. Replaces a sprawl of separate redstone lines with a single tidy bundle."
		""
		"Pair with bundled connectors and a signal-generator bench to build complex logic compactly."
	]
	quest.4650010000010098.quest_subtitle: "16 channels, one wire."
	quest.4650010000010098.title: "Signal Bundling"
	quest.4650010000010100.quest_desc: [
		"The &6Pity Machine Frame&r is Industrial Foregoing's first-tier chassis. Cheap, accessible, the entry to IF's machine progression."
		""
		"&aIF tiers progress: Pity → Simple → Advanced → Supreme.&r Each chassis tier unlocks better machine versions of the same logic."
	]
	quest.4650010000010100.title: "Pity Machine Frame"
	quest.4650010000010101.quest_desc: [
		"The &6Latex Bucket&r holds liquid latex — tapped from rubber trees with the IF Tree Fluid Extractor."
		""
		"Combine with redstone in the IF Latex Processing Unit to produce raw plastic."
	]
	quest.4650010000010101.title: "Latex Bucket"
	quest.4650010000010102.quest_desc: [
		"&6Plastic&r (Industrial Foregoing variant) is the IF plastic item — output of the Latex Processing Unit. Used as IF's machine recipe staple."
		""
		"&aTagged as &7c:plastic&r&7 with MI/Oritech plastic for cross-mod compatibility.&r"
	]
	quest.4650010000010102.title: "Plastic"
	quest.4650010000010103.quest_desc: [
		"The &6Dissolution Chamber&r is Industrial Foregoing's chemical-reactor machine. Combines fluid + items for advanced product synthesis."
		""
		"&aWhere IF's biofuel, ether gas, and other specialty fluids are produced.&r Most of IF's high-tier recipes route through this machine."
	]
	quest.4650010000010103.title: "&6Dissolution Chamber&r"
	quest.4650010000010104.title: "Region: Pneumatic Components"
	quest.4651A4663CCFF1E8.quest_desc: ["Hold an &6Eternal Pedestal&r — entry to the BetterEnd progression's eastern branch. Same item as the western entry, different node in the dependency graph."]
	quest.4651A4663CCFF1E8.quest_subtitle: "BetterEnd ritual altar."
	quest.4651A4663CCFF1E8.title: "Infusion Pedestal"
	quest.466E09BB4BE910E9.quest_desc: ["&6Ambrosium Torch&r — Aether's brighter torch, fueled by ambrosium shards."]
	quest.466E09BB4BE910E9.title: "Ambrosium Torch"
	quest.46BC26894174159C.quest_desc: [
		"&6Mixed Soil&r and the &6Mixed Soil Pot&r — special growing media for the more delicate Alchemists Garden plants."
		""
		"&aSome AG plants won't grow on dirt or grass.&r Plant them in mixed soil pots to keep them alive and producing."
	]
	quest.46BC26894174159C.quest_subtitle: "&oDirt that accepts strangeness."
	quest.46BC26894174159C.title: "&2Growing Medium"
	quest.4757010000010001.quest_desc: [
		"Welcome to the &6Gilded Age&r. The Obsidilith is dead, the Industrial Revolution is yours, and now the workshop opens onto something larger — refineries, deep machines, advanced electronics, and the first whispers of true science."
		""
		"From here the pack splits into two parallel spines. The &6Engineering Spine&r continues through Mekanism, AE2, and Oritech's deep machines. The &6Science Spine&r begins with PowerGrid and Electrodynamics, ending in real nuclear physics. You don't have to pick one — most players walk both."
		""
		"&7This is a transition quest. Look around the new chapters and decide where you want to start.&r"
	]
	quest.4757010000010001.quest_subtitle: "Steel and steam are behind you."
	quest.4757010000010001.title: "&6The Gilded Gate"
	quest.47938E3F04FABE17.quest_desc: [
		"The &6Relay&r connects two RS networks selectively — pass items between them, or use it to compartmentalize a single huge network into manageable subnets."
		""
		"&aAdvanced topology block. Most players won't need it; those who do will know exactly why they wanted it.&r"
	]
	quest.47938E3F04FABE17.title: "Relay"
	quest.48234EA7CE77AD02.quest_desc: ["The &6Flaming Sword&r — Aether dungeon weapon that ignites targets with each hit."]
	quest.48234EA7CE77AD02.title: "Flaming Sword"
	quest.4833833D8E1C4ACE.quest_desc: [
		"The &6Soul Elytra&r is Deeper Darker's flight upgrade — a soul-bound elytra crafted from a vanilla elytra plus Otherside materials."
		""
		"&aThis is the chapter's quiet flex prize. You no longer need to wait until the End to unlock flight — the Deep Dark gives you wings first.&r"
	]
	quest.4833833D8E1C4ACE.quest_subtitle: "Elytra with a boost"
	quest.4833833D8E1C4ACE.title: "Soul Elytra"
	quest.486EFE363116610B.quest_desc: [
		"&6Butterfly Wings Amulet&r — a Curios trinket that grants slow-fall or glide flavor (the wings imply themselves)."
		""
		"&7Optional collectible. Slot it in if you're sick of taking fall damage in the Starlight's vertical biomes.&r"
	]
	quest.486EFE363116610B.title: "Butterfly Wings Amulet"
	quest.48AC8545D66B71B7.quest_desc: [
		"Upgrade your &6Builder's Hut to level 2&r — a higher-level Builder constructs higher-level structures."
		""
		"&aHut levels gate hut-tier progression.&r Builder must out-rank the structure they're building."
	]
	quest.490628CE108A833A.quest_desc: [
		"Build a &6Delivery Person's Hut&r — the citizen who carries items between buildings."
		""
		"Pair with a Warehouse for active inter-hut delivery."
	]
	quest.493B9FC17C3CF3CA.quest_desc: [
		"Build a &6Rabbit Hutch&r — the rabbit-keeper hut. Rabbit hide and meat supply."
		""
		"Niche but completes the herder set."
	]
	quest.494D8A05749382A6.quest_desc: ["&6Darkstone&r — basaltic stone variant of Forbidden Arcanus. Building block and reagent for darker magical recipes."]
	quest.49793060345FB28C.quest_desc: [
		"Build a &6Cowboy's Hut&r — the citizen who tends cattle for milk and meat."
		""
		"Pair with a Farmer for grain-fed herds."
	]
	quest.49BBE54BCF735A82.quest_desc: [
		"The &6Ingot Cast&r from Productive Metalworks is the entry point for the foundry tier — cast molten metal into shaped ingots."
		""
		"This chapter is the &6Medieval crossroads&r: archeology relics, herbalist gardens, gnome burrows, and a gigantic medieval quality-of-life bundle. None of it gates progression, but it makes the era richer."
	]
	quest.49BBE54BCF735A82.quest_subtitle: "Iron-tier metalworks open."
	quest.49BBE54BCF735A82.title: "Ingot Cast"
	quest.4A4DC14116619424.quest_desc: ["The &6Astral Splintered World&r — a Gaze relic that fragments reality around the user. High-tier ritual item with a mind-bending effect."]
	quest.4A8BE1C3770D9F16.quest_desc: [
		"&6Basic Processor&r — RS's tier-1 chip. Used in early RS recipes (cables, casings, basic disks)."
		""
		"&aBuild a Crafter setup with patterns for basic/improved/advanced processors so they auto-craft when you need them.&r"
	]
	quest.4A8BE1C3770D9F16.quest_subtitle: "First chip in the stack."
	quest.4A8BE1C3770D9F16.title: "Basic Processor"
	quest.4A8F54B9ED085393.quest_desc: [
		"&6Underworld Arena Key&r — a Block Factory's Bosses item that opens the arena where the &5Underworld Knight&r awaits."
		""
		"&cWithout the key, no fight. Loot one from the relevant structure or craft per JEI.&r"
	]
	quest.4A8F54B9ED085393.quest_subtitle: "Opens the arena door"
	quest.4A8F54B9ED085393.title: "Underworld Arena Key"
	quest.4AD7AA49319E4073.quest_desc: [
		"&6Pattern&r — the blank stationery the Pattern Grid writes recipes onto. Inserted into an Autocrafter to teach it a recipe."
		""
		"&aOne pattern per recipe. Stockpile a stack — autocrafter setups burn through them as you industrialize new components.&r"
	]
	quest.4AD7AA49319E4073.title: "Pattern"
	quest.4B2D3C5E8F7A7B10.quest_desc: [
		"The &6Medieval Quality-of-Life Bundle&r — every farming, cooking, fishing, and storage item that defines comfortable medieval living. Aquaculture rods, Farmer's Delight knives and stoves, Cooking for Blockheads kitchen, Sophisticated Backpacks, Botany Pots, and more."
		""
		"&aThis is the catch-all medieval QOL quest.&r You'll naturally collect most of these as you build a real base. Don't grind for it — let it complete passively."
		""
		"&7Optional. Touches a lot of mods at once and rewards a player who actually furnishes their base.&r"
	]
	quest.4B9B3391F1502560.quest_desc: [
		"&6Storage Housing&r — the empty shell into which storage parts are inserted to make 1k/4k/16k/64k disks (and storage blocks)."
		""
		"One housing per disk. Mass-produce them in your autocrafter chain."
	]
	quest.4B9B3391F1502560.title: "Storage Housing"
	quest.4BBEF1E5FB3D1AA3.quest_desc: ["&6Stratus Gloves&r and &6Stratus Ring&r — endgame Deep Aether curio set. The aviator's loadout."]
	quest.4BBEF1E5FB3D1AA3.title: "Stratus Gloves + Ring"
	quest.4C0AA9CD5745A341.quest_desc: ["The &6Bowl Upgrade Smithing Template&r — applies a bowl-tier upgrade to compatible armor at the smithing table."]
	quest.4C0AA9CD5745A341.title: "Bowl Upgrade Template"
	quest.4C1BA38F43EFF4BE.quest_desc: [
		"&5Kill The Harbinger.&r Cataclysm's wraith boss — fast, teleporting, hits hard. Drops witherite-related loot."
		""
		"&cWear the eternal obsidian skull&r if you can; her attacks combine fire and shadow."
	]
	quest.4C1BA38F43EFF4BE.title: "The Harbinger"
	quest.4C25269A99740791.quest_desc: [
		"The &6Sonorous Staff&r is Deeper Darker's magical ranged weapon — fires sonic-themed projectiles that resonate with the Deep Dark's themes."
		""
		"&aIf you'd rather kite the Warden than melee it, this is the weapon to bring into the fight.&r"
	]
	quest.4C25269A99740791.quest_subtitle: "Sonic blast weapon"
	quest.4C25269A99740791.title: "Sonorous Staff"
	quest.4C41010000010001.quest_desc: [
		"The &6Metallurgic Infuser&r is Mekanism's entry machine. Combine an item (iron, redstone, etc.) with a &6chemical infusion&r (carbon, redstone, diamond) to produce alloyed outputs."
		""
		"&aThis is the gateway to all of Mekanism.&r Steel from infusing iron with carbon dust; redstone alloy from infusing iron with redstone. Almost every later Mekanism recipe traces back to a Metallurgic Infuser product."
	]
	quest.4C41010000010001.quest_subtitle: "First chair of the lab."
	quest.4C41010000010001.title: "Industrial Chemistry"
	quest.4C41010000010002.quest_desc: [
		"&6Steel Casing&r is Mekanism's universal machine chassis. Every basic Mekanism machine wraps around one."
		""
		"Made from osmium dust + steel ingots in the right configuration. Stockpile these — you'll burn through them."
	]
	quest.4C41010000010002.quest_subtitle: "The chassis."
	quest.4C41010000010002.title: "Steel Casing"
	quest.4C41010000010003.quest_desc: [
		"The &6Basic Control Circuit&r is Mekanism's first circuit tier. Required by basic-tier machines."
		""
		"&aMekanism circuits ladder: Basic → Advanced → Elite → Ultimate.&r Each tier opens a new wave of machines and lets the existing ones run faster."
	]
	quest.4C41010000010003.quest_subtitle: "Tier key for basic machines."
	quest.4C41010000010003.title: "Basic Control Circuit"
	quest.4C41010000010004.quest_desc: [
		"&6Infused Alloy&r is Mekanism's first alloyed material. Iron + redstone in the Metallurgic Infuser produces it."
		""
		"Used in the Basic Control Circuit recipe and several entry-tier machine builds."
	]
	quest.4C41010000010004.quest_subtitle: "First Mek alloy. Chains into reinforced and atomic later."
	quest.4C41010000010004.title: "Infused Alloy"
	quest.4C41010000010005.quest_desc: [
		"The &6Enrichment Chamber&r is Mekanism's first ore-doubler. Crush ore (or other items) for 2x output."
		""
		"&aSimplest 2x ore processing in the pack — just power and a single machine.&r Higher-tier Mekanism factories layer on top of this base recipe."
	]
	quest.4C41010000010005.quest_subtitle: "Ore in, dust out, 2× yield."
	quest.4C41010000010005.title: "Enrichment Chamber"
	quest.4C41010000010006.quest_desc: [
		"The &6Crusher&r grinds items into their dust form — ingots → dust, bones → bonemeal in a hopper-shaped pipeline."
		""
		"Pairs with the Enrichment Chamber for full ore-doubling cycles."
	]
	quest.4C41010000010006.title: "Crusher"
	quest.4C41010000010007.quest_desc: [
		"The &6Energized Smelter&r is Mekanism's electric furnace — smelts items at higher speed, runs on Joules."
		""
		"Plug-in replacement for the vanilla furnace once you have Mekanism power online."
	]
	quest.4C41010000010007.title: "Energized Smelter"
	quest.4C41010000010008.quest_desc: [
		"The &6Osmium Compressor&r turns dust into compressed alloyed forms with help of an osmium chemical infusion."
		""
		"Used to produce refined obsidian dust and several other advanced Mekanism intermediates."
	]
	quest.4C41010000010008.quest_subtitle: "Refined-obsidian path opens here."
	quest.4C41010000010008.title: "Osmium Compressor"
	quest.4C41010000010009.quest_desc: [
		"The &6Basic Energy Cube&r is Mekanism's first energy buffer. Stores Joules; auto-converts to/from FE on adjacent connections."
		""
		"&aMekanism Joules ↔ FE conversion is automatic.&r You can wire a Mekanism cube into an FE network and it'll bridge them seamlessly."
	]
	quest.4C41010000010009.quest_subtitle: "Mek's first FE buffer."
	quest.4C41010000010009.title: "Basic Energy Cube"
	quest.4C4101000001000A.quest_desc: [
		"&6Basic Universal Cables&r are Mekanism's first power-transmission line. Tier 1 of the cable ladder."
		""
		"Carries Joules between Mekanism machines and energy cubes."
		""
		"&7Note: Mekanism Joules is a separate energy system. While Mekanism cubes can output Joules as FE on a face, machines from Create (SU), Electrodynamics (V/J), and Oritech (RF/FE) do NOT interchange power directly. Plan power infrastructure within each system.&r"
	]
	quest.4C4101000001000A.title: "Universal Cable"
	quest.4C4101000001000B.quest_desc: [
		"The &6Basic Fluid Tank&r is Mekanism's first fluid storage block. Holds water, lava, refined fuels — whatever you pump in."
		""
		"Tier 1 of the tank ladder; capacity scales tier-by-tier."
	]
	quest.4C4101000001000B.title: "Basic Fluid Tank"
	quest.4C4101000001000C.quest_desc: [
		"&6Basic Mechanical Pipes&r are Mekanism's fluid-transport line."
		""
		"Pair with tanks and machines to plumb fluids through your factory. Tier 1 throughput."
	]
	quest.4C4101000001000C.title: "Mechanical Pipe"
	quest.4C4101000001000D.quest_desc: [
		"The &6Basic Smelting Factory&r is the multi-slot upgrade of the Energized Smelter. Smelt 3, 5, or 7 items in parallel depending on factory size."
		""
		"&aFactories are how Mekanism scales.&r The same recipe runs on multiple slots simultaneously; output multiplies."
	]
	quest.4C4101000001000D.quest_subtitle: "3-slot batch smelter."
	quest.4C4101000001000D.title: "Smelting Factory"
	quest.4C4101000001000E.quest_desc: [
		"The &6Basic Crushing Factory&r is the multi-slot Crusher. Same idea: parallel crushing."
		""
		"Useful when ore-doubling is the bottleneck."
	]
	quest.4C4101000001000E.title: "Crushing Factory"
	quest.4C4101000001000F.quest_desc: [
		"The &6Basic Enriching Factory&r is the multi-slot Enrichment Chamber."
		""
		"Stack this with a Crushing Factory and an Energized Smelter for parallel triple-recipe ore processing."
	]
	quest.4C4101000001000F.title: "Enriching Factory"
	quest.4C41010000010010.quest_desc: [
		"The &6Basic Logistical Transporter&r is Mekanism's item pipe. Moves items between inventories, with whitelist/blacklist filtering and color-coded sorting."
		""
		"Tier 1 of the transporter ladder; faster tiers move more items per tick."
	]
	quest.4C41010000010010.title: "Logistical Transporter"
	quest.4C41010000010011.quest_desc: [
		"&6Iron Dust&r (Mekanism variant) is the ore-doubled iron intermediate — output of crushing iron ore in the Enrichment Chamber."
		""
		"Smelt for an iron ingot. Tagged with other mods' iron dust for cross-pack compatibility."
	]
	quest.4C41010000010011.quest_subtitle: "Tier 1 ore line proven."
	quest.4C41010000010011.title: "T1 Mastery"
	quest.4C41010000010012.quest_desc: [
		"The &6Basic Chemical Tank&r is Mekanism's first gas/chemical storage. Holds hydrogen, oxygen, chlorine, brine, and other gaseous/dissolved materials."
		""
		"Mekanism distinguishes fluid tanks from chemical tanks — gases need their own buffer block."
	]
	quest.4C41010000010012.quest_subtitle: "Gas, not fluid. Different network."
	quest.4C41010000010012.title: "Basic Chemical Tank"
	quest.4C41010000010013.quest_desc: [
		"&6Basic Pressurized Tubes&r are Mekanism's chemical/gas transport line."
		""
		"Carries hydrogen, oxygen, and other chemicals between machines. Tier 1."
	]
	quest.4C41010000010013.title: "Pressurized Tube"
	quest.4C41010000010014.quest_desc: [
		"The &6Electrolytic Separator&r splits fluids into their constituent gases via electrolysis. Water → hydrogen + oxygen; brine → sodium + chlorine."
		""
		"&aThe gateway to Mekanism's gas chain.&r Without electrolysis, no hydrogen, no oxygen, no chlorine, no purification."
	]
	quest.4C41010000010014.quest_subtitle: "Water → H₂ + O₂."
	quest.4C41010000010014.title: "Electrolytic Separator"
	quest.4C41010000010015.quest_desc: [
		"The &6Hydrogen Bucket&r holds hydrogen gas (in compressed bucket form). Output of water electrolysis."
		""
		"Burnable in the Hydrogen Generator; reactant in HCl synthesis."
	]
	quest.4C41010000010015.quest_subtitle: "First gas in a bucket."
	quest.4C41010000010015.title: "Hydrogen"
	quest.4C41010000010016.quest_desc: [
		"The &6Oxygen Bucket&r holds oxygen gas. Output of water electrolysis (the other half)."
		""
		"Required for the 4x and 5x ore-processing tiers (ore + oxygen → oxide → reduced ingot pathway)."
	]
	quest.4C41010000010016.quest_subtitle: "Second gas. Feeds the 3× ore line."
	quest.4C41010000010016.title: "Oxygen"
	quest.4C41010000010017.quest_desc: [
		"The &6Chemical Oxidizer&r turns solid materials into gaseous form. Sulfur dust → sulfur dioxide gas, etc."
		""
		"Required step in the higher-tier ore-processing chains."
	]
	quest.4C41010000010017.title: "Chemical Oxidizer"
	quest.4C41010000010018.quest_desc: [
		"The &6Thermal Evaporation Plant Controller&r is the brain of Mekanism's evaporation multiblock — a tower that boils brine to extract concentrated brine, lithium, and salt."
		""
		"&aFar more efficient than running brine through smaller machines.&r Build it tall in a high-temperature biome (desert/nether-flavored) for fastest output."
	]
	quest.4C41010000010018.quest_subtitle: "Water in, brine out. Solar-powered."
	quest.4C41010000010018.title: "Thermal Evaporation"
	quest.4C41010000010019.quest_desc: [
		"The &6Brine Bucket&r holds brine — salty water, the input to Mekanism's salt and sodium chains."
		""
		"Pump from ocean biomes or produce it in the Thermal Evaporation Plant."
	]
	quest.4C41010000010019.title: "Brine"
	quest.4C4101000001001A.quest_desc: [
		"The &6Sodium Bucket&r holds liquid sodium — output of brine electrolysis."
		""
		"Reagent in higher-tier Mekanism recipes; component in some advanced alloys."
	]
	quest.4C4101000001001A.quest_subtitle: "Brine electrolysis: sodium leg."
	quest.4C4101000001001A.title: "Sodium"
	quest.4C4101000001001B.quest_desc: [
		"The &6Chlorine Bucket&r holds chlorine gas. Output of brine electrolysis."
		""
		"Combines with hydrogen to make HCl, the input to Mekanism's purification (3x) ore-processing tier."
	]
	quest.4C4101000001001B.quest_subtitle: "Brine electrolysis: chlorine leg."
	quest.4C4101000001001B.title: "Chlorine"
	quest.4C4101000001001C.quest_desc: [
		"The &6Chemical Infuser&r combines two gases into a third. HCl from H + Cl, and several other gas-merging recipes."
		""
		"Required for the gas-blending steps in the high-tier ore chain."
	]
	quest.4C4101000001001C.quest_subtitle: "Two gases enter. One leaves."
	quest.4C4101000001001C.title: "Chemical Infuser"
	quest.4C4101000001001D.quest_desc: [
		"The &6Hydrogen Chloride Bucket&r holds HCl — the gas used by the Purification Chamber for 3x ore processing."
		""
		"Made from H + Cl in the Chemical Infuser."
	]
	quest.4C4101000001001D.quest_subtitle: "Synthesised acid."
	quest.4C4101000001001D.title: "Hydrogen Chloride"
	quest.4C4101000001001E.quest_desc: [
		"The &6Purification Chamber&r is Mekanism's 3x ore-processing tier. Takes HCl + ore, outputs purified ore clumps that smelt to 3 ingots."
		""
		"&aThis is the start of Mekanism's high-tier ore chain.&r Higher tiers (4x, 5x) layer on additional gas reactions for even more output per ore."
	]
	quest.4C4101000001001E.quest_subtitle: "Tier 2 ore line gated by gas."
	quest.4C4101000001001E.title: "Gas Mastery"
	quest.4C41010000010020.quest_desc: [
		"The &6PNC Capacitor&r is PneumaticCraft's local energy storage component — used in tools and several mid-tier upgrades."
		""
		"Pneumatic and electric, depending on context."
	]
	quest.4C41010000010020.title: "Capacitor"
	quest.4C41010000010021.quest_desc: [
		"The &6Charging Station&r recharges pneumatic tools and air canisters via compressed air supplied through pressure tubes."
		""
		"Place near your compressor; drop tools on top to recharge."
	]
	quest.4C41010000010021.quest_subtitle: "Pressure → tool charge."
	quest.4C41010000010021.title: "Charging Station"
	quest.4C41010000010022.quest_desc: [
		"The &6Charging Upgrade&r is the slot-in module that lets a Charging Station charge faster or hold more inventory."
		""
		"Stack multiple for serious tool-charge throughput."
	]
	quest.4C41010000010022.title: "Charging Upgrade"
	quest.4C41010000010023.quest_desc: [
		"The &6Pneumatic Wrench&r is PNC's pressurized-air-powered wrench. Right-click to rotate, sneak-right-click to disassemble."
		""
		"Eats a small amount of air per use. Carry one alongside an engineer's hammer."
	]
	quest.4C41010000010023.title: "Pneumatic Wrench"
	quest.4C41010000010024.quest_desc: [
		"&6Compressed Iron Gear&r is a high-pressure-treated iron gear. Used in many advanced PNC machine recipes."
		""
		"Made by exposing iron gears to high-pressure compression."
	]
	quest.4C41010000010024.title: "Compressed Iron Gear"
	quest.4C41010000010025.quest_desc: [
		"The &6Vortex Tube&r is a passive heat-cold splitter. Pressurized air in one end; one side outputs hot air, the other cold."
		""
		"&aPNC heat management is bizarre but elegant: this single block handles both heating and cooling needs in opposite directions.&r"
	]
	quest.4C41010000010025.quest_subtitle: "Hot in. Hot + cold out."
	quest.4C41010000010025.title: "Vortex Tube"
	quest.4C41010000010026.quest_desc: [
		"The &6Heat Sink&r dissipates heat into the environment. Place adjacent to a hot block to bleed off thermal energy."
		""
		"Works in reverse too — cooling cold blocks if the surroundings are warmer."
	]
	quest.4C41010000010026.title: "Heat Sink"
	quest.4C41010000010027.quest_desc: [
		"&6Heat Pipes&r are PNC's heat-transport line. Move thermal energy across distance the way pressure tubes move air."
		""
		"Required for advanced PNC builds where the heat source isn't adjacent to the consumer."
	]
	quest.4C41010000010027.title: "Heat Pipe"
	quest.4C41010000010028.quest_desc: [
		"The &6Aerial Interface&r is PNC's player-inventory bridge. Bound to a player; remote inventories can deposit/withdraw items as if interacting with that player's main inventory."
		""
		"&aAdvanced automation: feed crafted gear directly to the player; pull mob drops out of their hotbar.&r"
	]
	quest.4C41010000010028.quest_subtitle: "Remote inventory bridge."
	quest.4C41010000010028.title: "Aerial Interface"
	quest.4C41010000010029.quest_desc: [
		"The &6Fluid Mixer&r combines two fluid inputs into a single output fluid via PNC pressure recipes."
		""
		"Required for some advanced PNC fluid recipes (lubricant blending, biodiesel synthesis)."
	]
	quest.4C41010000010029.quest_subtitle: "Two fluids in. One out."
	quest.4C41010000010029.title: "Fluid Mixer"
	quest.4C4101000001002A.quest_desc: [
		"The &6Smart Chest&r is PNC's logistics-aware storage block. Auto-detects items and organizes them; integrates with the PNC drone logistics network."
		""
		"&aThe foundation of a PNC drone-driven base.&r Drones read smart chest contents and act accordingly."
	]
	quest.4C4101000001002A.quest_subtitle: "Filtered storage with sided IO."
	quest.4C4101000001002A.title: "Smart Chest"
	quest.4C4101000001002B.quest_desc: [
		"The &6Logistics Frame: Default Storage&r is one of several logistics frame types. Marks the chest it's attached to as a destination for unsorted items."
		""
		"Drones see the frame and route accordingly."
	]
	quest.4C4101000001002B.title: "Logistics Frame"
	quest.4C4101000001002C.quest_desc: [
		"The &6Elevator Base&r is PNC's pneumatic vertical-transport block. Stacks vertically; players ride up and down on the elevator face."
		""
		"&aFar smoother than ladders or scaffolding for tall multiblock interiors.&r"
	]
	quest.4C4101000001002C.quest_subtitle: "Pneumatic vertical travel."
	quest.4C4101000001002C.title: "Elevator"
	quest.4C4101000001002D.quest_desc: [
		"The &6Thermal Compressor&r combines heat + pressure for advanced PNC recipes. Acts as a hot version of the standard compressor."
		""
		"Required for high-tier processing in the PNC chain."
	]
	quest.4C4101000001002D.quest_subtitle: "Heat → pressure, no compressor needed."
	quest.4C4101000001002D.title: "Pressurized Mastery"
	quest.4C4101000001002E.quest_desc: [
		"&6Polished Prismarine&r is NauTec's signature stone. Decorative + chassis material for NauTec multiblocks."
		""
		"Made from prismarine cleaned in NauTec's Mixer."
	]
	quest.4C4101000001002E.quest_subtitle: "Nautec foundation block."
	quest.4C4101000001002E.title: "Polished Prismarine"
	quest.4C4101000001002F.quest_desc: [
		"The &6Aquatic Catalyst&r is NauTec's reaction-driver. Required for many NauTec advanced processing steps."
		""
		"Made from prismarine + ocean materials."
	]
	quest.4C4101000001002F.quest_subtitle: "AP generator. Sealed from FE."
	quest.4C4101000001002F.title: "Aquatic Catalyst"
	quest.4C41010000010030.quest_desc: [
		"The &6Saltwater Bucket&r holds NauTec's saltwater fluid. Distinct from Mekanism brine; this is NauTec's specific saltwater intermediate."
		""
		"Used in salt extraction and the bio-reactor chain."
	]
	quest.4C41010000010030.title: "Saltwater"
	quest.4C41010000010031.quest_desc: [
		"&6Salt&r is NauTec's salt item. Output of saltwater evaporation in the Deep Sea Drain."
		""
		"Reagent in NauTec recipes; also edible (sad, but real)."
	]
	quest.4C41010000010031.title: "Salt"
	quest.4C41010000010032.quest_desc: [
		"The &6Deep Sea Drain&r evaporates saltwater to produce salt and other dissolved materials."
		""
		"Place in a coastal/ocean biome for ambient saltwater intake."
	]
	quest.4C41010000010032.quest_subtitle: "Underwater saltwater pump."
	quest.4C41010000010032.title: "Deep Sea Drain"
	quest.4C41010000010033.quest_desc: [
		"&6Cast Iron Ingots&r are NauTec's marine-grade iron variant. Corrosion-resistant for use in NauTec's underwater machines."
		""
		"Required for the NauTec gear and machine recipes."
	]
	quest.4C41010000010033.quest_subtitle: "Coaled iron."
	quest.4C41010000010033.title: "Cast Iron Ingot"
	quest.4C41010000010034.quest_desc: [
		"&6Cast Iron Rods&r are the rod form of NauTec's marine iron. Used in mixer and machine recipes."
		""
		"Made by cutting cast iron ingots in any compatible cutter."
	]
	quest.4C41010000010034.title: "Cast Iron Rod"
	quest.4C41010000010035.quest_desc: [
		"The &6NauTec Mixer&r combines fluids and items in NauTec's processing chain."
		""
		"Where polished prismarine, aquarine compounds, and bio-reactor inputs are prepared."
	]
	quest.4C41010000010035.quest_subtitle: "Fluid + items → fluid output."
	quest.4C41010000010035.title: "Mixer"
	quest.4C41010000010036.quest_desc: [
		"The &6NauTec Etching Acid Bucket&r holds NauTec's variant of etching acid. Used to etch aquatic chips for NauTec circuits."
		""
		"Distinct from PNC's etching acid — same idea, separate ecosystem."
	]
	quest.4C41010000010036.title: "Etching Acid"
	quest.4C41010000010037.quest_desc: [
		"The &6NauTec Gear&r is the rotational component for NauTec's machines. Cast iron + reinforcement."
		""
		"Required throughout the NauTec machine recipes."
	]
	quest.4C41010000010037.quest_subtitle: "Etched from rust."
	quest.4C41010000010037.title: "Etched Gear"
	quest.4C41010000010038.quest_desc: [
		"The &6Aquarine Steel Compound&r is the precursor to aquarine steel — NauTec's signature corrosion-resistant alloy."
		""
		"Mixed in the NauTec Mixer; smelted to the finished ingot."
	]
	quest.4C41010000010038.title: "Aquarine Steel Compound"
	quest.4C41010000010039.quest_desc: [
		"&6Aquarine Steel Ingots&r are NauTec's premium underwater alloy. Saltwater-resistant; used in advanced NauTec machines and dive gear."
		""
		"&aThe NauTec equivalent of Mekanism's refined obsidian — a specialized mid-late alloy that gates the rest of the mod's content.&r"
	]
	quest.4C41010000010039.quest_subtitle: "First laser-transmuted metal."
	quest.4C41010000010039.title: "Aquarine Steel Ingot"
	quest.4C4101000001003A.quest_desc: [
		"The &6Prism Monocle&r is NauTec's vision-augment headgear. Reveals hidden details about prismarine deposits and aquatic structures."
		""
		"Wear it while exploring for clear ocean visibility and resource highlighting."
	]
	quest.4C4101000001003A.quest_subtitle: "AP-purity goggles."
	quest.4C4101000001003A.title: "Prism Monocle"
	quest.4C4101000001003B.quest_desc: [
		"The &6Diving Chestplate&r is NauTec's underwater chestpiece. Provides air supply via integrated pneumatic lung and mobility under water."
		""
		"Pair with the rest of the NauTec dive set for full ocean-diving capability."
	]
	quest.4C4101000001003B.quest_subtitle: "For long drain runs."
	quest.4C4101000001003B.title: "Diving Chestplate"
	quest.4C4101000001003C.quest_desc: [
		"The &6Aquatic Chip&r is NauTec's signature circuit. Etched on a coral substrate with NauTec etching acid."
		""
		"&aRequired for advanced NauTec recipes.&r The mod's circuit-tier gating component."
	]
	quest.4C4101000001003C.quest_subtitle: "Restored from a crate find."
	quest.4C4101000001003C.title: "Aquatic Chip"
	quest.4C4101000001003D.quest_desc: [
		"&6Burnt Coils&r are NauTec's heat-degraded coil variant — the consumed product of running coils too hot."
		""
		"Recyclable input for some NauTec recipes; intentional output of certain processing steps."
	]
	quest.4C4101000001003D.quest_subtitle: "Useful failure."
	quest.4C4101000001003D.title: "Burnt Coil"
	quest.4C4101000001003E.quest_desc: [
		"The &6Laser Channeling Coil&r is NauTec's laser-emitter base component. Generates the focused beam used in advanced NauTec processing."
		""
		"&aThe NauTec laser system is the centerpiece of this mod's late-tier content.&r Mostly Gilded-era; this is the entry component."
	]
	quest.4C4101000001003E.quest_subtitle: "R1→R2 in one item."
	quest.4C4101000001003E.title: "Laser Channeling Coil"
	quest.4C4101000001003F.quest_desc: [
		"The &6Prismarine Lens&r is the optical focusing element for NauTec lasers. Concentrates the beam into a useful work-energy form."
		""
		"Required alongside the laser channeling coil."
	]
	quest.4C4101000001003F.title: "Prismarine Lens"
	quest.4C41010000010040.quest_desc: [
		"The &6Long Distance Laser&r is NauTec's beam-emitter block — transmits the laser across long ranges for remote processing."
		""
		"&aThe core block of NauTec's laser-distribution network.&r Early form; full laser content unlocks in Gilded."
	]
	quest.4C41010000010040.quest_subtitle: "Wireless AP transmitter."
	quest.4C41010000010040.title: "Long Distance Laser"
	quest.4C41010000010041.quest_desc: [
		"The &6Prismatic Battery&r is NauTec's high-tier energy storage. Built around prismarine and the aquatic chip chain."
		""
		"Premium energy storage option for NauTec installations."
	]
	quest.4C41010000010041.quest_subtitle: "Portable AP buffer."
	quest.4C41010000010041.title: "Prismatic Battery"
	quest.4C41010000010042.quest_desc: [
		"The &6Laser Junction&r is the NauTec laser-network routing block. Splits or redirects laser paths between emitters and receivers."
		""
		"Place at intersections in your laser network."
	]
	quest.4C41010000010042.quest_subtitle: "AP receiver hub."
	quest.4C41010000010042.title: "Laser Mastery"
	quest.4C41010000010043.quest_desc: [
		"The &6Pressurized Reaction Chamber&r is Mekanism's three-way reactor — combines a solid + a fluid + a gas to produce a fourth output."
		""
		"&aThe machine where substrate, ethene, and HDPE production all happens.&r Mekanism's plastic chain runs through this block."
	]
	quest.4C41010000010043.quest_subtitle: "PRC. Mek's reaction multiblock."
	quest.4C41010000010043.title: "Pressurized Reaction Chamber"
	quest.4C41010000010044.quest_desc: [
		"&6Substrate&r is Mekanism's bio-precursor — a biological material made from sawdust + water + ethene in the Pressurized Reaction Chamber."
		""
		"Combines with later reactions for the HDPE chain."
	]
	quest.4C41010000010044.title: "Substrate"
	quest.4C41010000010045.quest_desc: [
		"The &6Ethene Bucket&r holds ethene gas — an output of the Pressurized Reaction Chamber from substrate + hydrogen."
		""
		"Reagent in the HDPE pellet chain."
	]
	quest.4C41010000010045.quest_subtitle: "Mek's gas fuel scaling."
	quest.4C41010000010045.title: "Ethene"
	quest.4C41010000010046.quest_desc: [
		"&6HDPE Pellets&r are Mekanism's plastic. Made from ethene + oxygen + (other inputs) in the Pressurized Reaction Chamber."
		""
		"&aThis is Mekanism's plastic-tier crafting material.&r Used in advanced Mekanism circuit recipes and several mid-tier components."
	]
	quest.4C41010000010046.quest_subtitle: "Mek's plastic."
	quest.4C41010000010046.title: "HDPE Sheet"
	quest.4C41010000010047.quest_desc: [
		"The &6Petri Dish&r is NauTec's bacterial-culture container. Required for bio-reactor recipes."
		""
		"Made from glass + agar substrate."
	]
	quest.4C41010000010047.title: "Petri Dish"
	quest.4C41010000010048.quest_desc: [
		"The &6Grafting Tool&r is NauTec's biological-sampling tool. Use on coral, kelp, or other sealife to harvest culturable samples."
		""
		"Required for kicking off the bacterial-culture chain."
	]
	quest.4C41010000010048.quest_subtitle: "Bacteria-from-blocks tool."
	quest.4C41010000010048.title: "Grafting Tool"
	quest.4C41010000010049.quest_desc: [
		"The &6Bacterial Analyzer&r identifies the species present in a NauTec petri-dish sample."
		""
		"Required for selective bacteria culturing — you need to know what you have before you grow more."
	]
	quest.4C41010000010049.quest_subtitle: "Reads bacteria stats."
	quest.4C41010000010049.title: "Bacterial Analyzer"
	quest.4C4101000001004A.quest_desc: [
		"The &6Bio Reactor&r is NauTec's bacterial-culture growth chamber. Feed it nutrients and a starter culture; harvest bulk biological material."
		""
		"&aProduces biofuel-grade material and several specialty NauTec recipe inputs.&r"
	]
	quest.4C4101000001004A.quest_subtitle: "Bacteria → resources."
	quest.4C4101000001004A.title: "Bio Reactor"
	quest.4C4101000001004B.quest_desc: [
		"The &6Incubator&r maintains optimal temperature and pressure for NauTec bacterial cultures."
		""
		"Pair with the Bio Reactor for higher yields."
	]
	quest.4C4101000001004B.quest_subtitle: "Bacteria growth chamber."
	quest.4C4101000001004B.title: "Incubator"
	quest.4C4101000001004C.quest_desc: [
		"The &6Mutator&r is NauTec's gene-modification machine. Mutate a bacterial culture to produce variants with different recipe outputs."
		""
		"&aLate-tier NauTec content — specialty bacterial strains drive specific recipes.&r"
	]
	quest.4C4101000001004C.quest_subtitle: "Bio + chemistry, fully crossed."
	quest.4C4101000001004C.title: "Synthesis Mastery"
	quest.4C4101000001004E.quest_desc: [
		"The &6Eldritch Heart&r is NauTec's elder-guardian-derived high-tier component. Made from elder guardian drops + advanced NauTec processing."
		""
		"&aRequired for the laser-tier and bio-tier capstones.&r The gate between IR4 NauTec and Gilded NauTec."
	]
	quest.4C4101000001004E.quest_subtitle: "Boss drop."
	quest.4C4101000001004E.title: "Eldritch Heart"
	quest.4C4101000001004F.quest_desc: [
		"The &6Augmentation Station&r is NauTec's player-modification bench. Slot in augments to gain underwater or biological capabilities."
		""
		"Pair with claw arms, eye implants, and other NauTec augments."
	]
	quest.4C4101000001004F.quest_subtitle: "Player surgery multiblock."
	quest.4C4101000001004F.title: "Augmentation Station"
	quest.4C41010000010050.quest_desc: [
		"The &6Claw Robot Arm&r is a NauTec player-augment — equipped via the Augmentation Station, gives the wearer reach and pickup-range bonuses."
		""
		"Pure mechanical bionic enhancement."
	]
	quest.4C41010000010050.title: "Claw Robot Arm"
	quest.4C41010000010051.quest_desc: [
		"The &6Guardian Eye&r is a NauTec augment derived from elder guardian drops. Wearer gains underwater vision and other ocean-flavored bonuses."
		""
		"Slots into the Augmentation Station."
	]
	quest.4C41010000010051.quest_subtitle: "Surgery complete. Third eye online."
	quest.4C41010000010051.title: "First Augmentation"
	quest.4C41010000010052.quest_desc: [
		"&6Atomic Alloy&r is Mekanism's top-tier alloy — refined obsidian + advanced infusion. Used in Ultimate-tier circuit recipes."
		""
		"&aThis is the late-IR Mekanism material proof.&r Beyond this, you're entering the Atomic-era Mekanism content (Polonium, Plutonium, Antimatter)."
	]
	quest.4C41010000010052.quest_subtitle: "Three sciences, one synthesis."
	quest.4C41010000010052.title: "The Lab"
	quest.4C41010000010053.quest_desc: [
		"The &6Timer Gate&r is ProjectRed's clock element. Outputs a redstone pulse on a configurable interval."
		""
		"&aReplace bulky redstone-clock contraptions with a single tile.&r ProjectRed integration gates compress entire vanilla redstone constructions into one block each."
	]
	quest.4C41010000010053.quest_subtitle: "&7Optional: a clock for your machines.&r"
	quest.4C41010000010053.title: "Timed Pulses"
	quest.4C41010000010054.quest_desc: [
		"The &6AND Gate&r is ProjectRed's logic gate — outputs redstone signal only when both inputs are powered."
		""
		"Same logic as a vanilla redstone AND, but in a single tile with cleaner inputs/outputs."
	]
	quest.4C41010000010054.quest_subtitle: "&7Optional: conditional control for lab gear.&r"
	quest.4C41010000010054.title: "Conditional Logic"
	quest.4C57010000010001.quest_desc: [
		"You did it. You killed &5Lady Luna&r and the &6Otherworldly&r stage flipped. The factories you built across the Atomic age — the reactors, the chemical plants, the railguns — all of it was preparation for what comes next."
		""
		"This is the &6Launch Window&r. &6Stellaris&r is now live. Ahead lie the planets — Mercury's solar furnace, Venus's acid clouds, the Moon's low-gravity desh seams, Mars's tharsite ridges. Each one wants something specific from you, and each one gives you something nothing else can."
		""
		"&aPace yourself.&r OW has seven chapters and most of them can be tackled in parallel. The age ends with a triple gate: convergence chapters, the &5Black Hole Convergence&r, and the &5Leviathan&r. You're not climbing a ladder anymore — you're conducting an orchestra."
	]
	quest.4C57010000010001.quest_subtitle: "Leave this world behind."
	quest.4C57010000010001.title: "&5Launch Window"
	quest.4C7AC08710454C2B.quest_desc: [
		"&6Starlit Diamond armor set&r — the Starlight's upgraded diamond gear, infused with crystal energy. A clean step up from any of the four base mid-tier sets."
		""
		"Think of this as the consolidated Starlight diamond tier — better than mid, not yet endgame. A solid choice before you commit to the Unrealium climb."
	]
	quest.4C7AC08710454C2B.title: "Starlit Diamond Set"
	quest.4C7BDBC427365332.quest_desc: ["The full &6Cincinnasite Armor Set&r — helmet, chestplate, leggings, boots. Better Nether's iron-tier replacement with fire resistance trim."]
	quest.4C7BDBC427365332.title: "Cincinnasite Armor"
	quest.4CB3F3E52FF14B02.quest_desc: [
		"&6Thermal Springstone armor set&r — heat-tempered plate for the Starlight's volcanic biomes. Looks like cooled magma and behaves like it too."
		""
		"The natural pick for hot-biome work. The four mid-tier sets (Aethersent, Deepsilver, Glacite, Springstone) each cover different terrain — pick the one matching your travel plans."
	]
	quest.4CB3F3E52FF14B02.title: "Thermal Springstone Set"
	quest.4D252AEDF9ED968E.quest_desc: ["The Luminous Nether &6Pedestal&r — base block for the LN ritual chain."]
	quest.4D252AEDF9ED968E.title: "Pedestal"
	quest.4D49010000010002.quest_desc: [
		"&6Bronze Plates&r are flat hammered bronze. Almost every bronze-tier machine wants two or four of these in its recipe."
		""
		"Hammer a bronze ingot to make one. When you build a Bronze Compressor you'll never hammer plates by hand again."
	]
	quest.4D49010000010002.quest_subtitle: "The basic building plate."
	quest.4D49010000010002.title: "Bronze Plate"
	quest.4D49010000010003.quest_desc: [
		"The &6Bronze Machine Casing&r is the universal shell for every bronze-tier MI machine. Furnace, boiler, macerator, compressor, mixer — they all start with one of these."
		""
		"Recipe is a ring of bronze plates around a central frame. &aOnce you have a stockpile of casings, machine progression speeds up dramatically.&r"
	]
	quest.4D49010000010003.quest_subtitle: "Steam tier opens here."
	quest.4D49010000010003.title: "Bronze Machine Casing"
	quest.4D49010000010004.quest_desc: [
		"&6Fire Clay Bricks&r are heat-rated bricks. They're what the Steam Blast Furnace and Coke Oven are built from."
		""
		"Smelt fire clay (mixed clay + brick dust) and stack the bricks. Without these, no steel."
	]
	quest.4D49010000010004.quest_subtitle: "Refractory brick for hot multiblocks."
	quest.4D49010000010004.title: "Fire Clay Brick"
	quest.4D49010000010005.quest_desc: [
		"The &6Bronze Furnace&r is a steam-powered smelter. Pump steam into one side, feed ore in the other, and watch ingots cook faster than vanilla."
		""
		"Output speed scales with steam pressure. &aPair it with a Bronze Boiler and a small water pump — that's a complete steam smelting line.&r"
	]
	quest.4D49010000010005.quest_subtitle: "First MI machine. Smelts faster than vanilla."
	quest.4D49010000010005.title: "Bronze Furnace"
	quest.4D49010000010006.quest_desc: [
		"The &6Bronze Boiler&r turns water + fuel into steam. Steam is MI's first power currency — it's pre-electric, pre-cable, just hot pressurized water moving through pipes."
		""
		"Feed it coal, wood, or anything flammable. Output steam through a fluid pipe to whatever steam machine you want to run. &cWatch the water level — running dry damages the boiler.&r"
	]
	quest.4D49010000010006.quest_subtitle: "Steam pressure online."
	quest.4D49010000010006.title: "Bronze Boiler"
	quest.4D49010000010007.quest_desc: [
		"The &6Bronze Macerator&r grinds ores into 2x dust per ore block. This is your first ore-doubler in MI — smelt the dust afterward for full doubling."
		""
		"Steam-powered, like the rest of bronze tier. Connect a steam line and walk away."
	]
	quest.4D49010000010007.quest_subtitle: "2× ore yield."
	quest.4D49010000010007.title: "Bronze Macerator"
	quest.4D49010000010008.quest_desc: [
		"The &6Coke Oven&r is a multiblock that turns coal into &6Coke&r and creosote oil. Coke burns hotter than coal — that extra heat is what lets the Steam Blast Furnace make steel."
		""
		"&aBuild the multiblock from fire clay bricks.&r The multiblock structure is shown in JEI; line it up exactly or it won't form."
	]
	quest.4D49010000010008.quest_subtitle: "First MI multiblock."
	quest.4D49010000010008.title: "Coke Oven"
	quest.4D49010000010009.quest_desc: [
		"&6Coke&r is super-coal. It burns hotter and longer than regular coal, which is exactly what the Steam Blast Furnace needs to fuse iron and coke into steel."
		""
		"It's also a respectable furnace fuel on its own — one coke smelts a stack of items."
	]
	quest.4D49010000010009.quest_subtitle: "Steel fuel + creosote."
	quest.4D49010000010009.title: "Coke Oven Output"
	quest.4D4901000001000A.quest_desc: [
		"The &6Steam Blast Furnace&r is MI's gateway to steel. Iron + coke goes in, &6Steel Ingots&r come out, but only if you've built the multiblock correctly and you're feeding it steam."
		""
		"&aSteel unlocks the LV electric tier.&r This is the single most important machine in IR1; everything past bronze depends on what comes out of this furnace. &cBuild it from fire clay bricks — regular bricks won't form the structure.&r"
	]
	quest.4D4901000001000A.quest_subtitle: "Iron → steel."
	quest.4D4901000001000A.title: "Steam Blast Furnace"
	quest.4D4901000001000B.quest_desc: [
		"&6Steel Ingots&r are iron-with-coke, the strongest pre-electric metal. Steel machine casings, steel plates, steel rods — everything in the LV tier wants steel somewhere."
		""
		"&aThe difficulty curve flattens once you have a steady steel supply.&r Set up a steel-production line early and let it run while you build other things."
	]
	quest.4D4901000001000B.quest_subtitle: "The electric tier opens."
	quest.4D4901000001000B.title: "Steel Ingot"
	quest.4D4901000001000C.quest_desc: [
		"The &6Steel Machine Casing&r is the chassis for every LV electric machine. Same role as the bronze casing, one tier up."
		""
		"Once these come off the assembly line you can start building the electric-tier processors that replace your bronze setup."
	]
	quest.4D4901000001000C.quest_subtitle: "The electric chassis."
	quest.4D4901000001000C.title: "Steel Machine Casing"
	quest.4D4901000001000D.quest_desc: [
		"&6Tin Ingots&r are the other half of bronze. Tin ore is rare on the surface but generates in deeper layers; an Ore Doubler trip will pay for itself fast."
		""
		"Combine 3 copper + 1 tin in a Mixer (or by hand) for bronze."
	]
	quest.4D4901000001000D.quest_subtitle: "Smelted from cassiterite."
	quest.4D4901000001000D.title: "Tin Ingot"
	quest.4D4901000001000E.quest_desc: [
		"&6Cupronickel Coils&r are the heating elements for LV-tier electric processing. The Electric Blast Furnace and similar machines slot these in to control their internal temperature."
		""
		"Coil tier caps your max smelting temperature; Cupronickel is the floor."
	]
	quest.4D4901000001000E.quest_subtitle: "EBF tier 1 coil."
	quest.4D4901000001000E.title: "Cupronickel Coil"
	quest.4D4901000001000F.quest_desc: [
		"&6Aluminum Cable&r is the standard MV power line. Carries MV current with low resistive loss; insulated in rubber so you don't short it on the floor."
		""
		"Run them in straight lines from your turbines to your machines."
	]
	quest.4D4901000001000F.quest_subtitle: "MV power transfer."
	quest.4D4901000001000F.title: "Aluminum Cable"
	quest.4D49010000010010.quest_desc: [
		"&6Battery Alloy Ingots&r are a lead-antimony mix used inside MI's batteries. Mixed in the &6Bronze Mixer&r from antimony + lead."
		""
		"If you can't find antimony, look in stibnite ore deposits and process the dust."
	]
	quest.4D49010000010010.quest_subtitle: "Battery feedstock."
	quest.4D49010000010010.title: "Battery Alloy"
	quest.4D49010000010011.quest_desc: [
		"&6Redstone Batteries&r are MI's first portable energy storage. Hold one in inventory and it powers handheld electric tools (drills, jetpacks)."
		""
		"Recharge by feeding it back into a charger or Energy Hatch."
	]
	quest.4D49010000010011.quest_subtitle: "Portable EU."
	quest.4D49010000010011.title: "Redstone Battery"
	quest.4D49010000010012.quest_desc: [
		"The &6Basic Machine Hull&r is the universal core of every LV electric MI machine. Casing + hatches + a tiny bit of cable, all packaged into one component."
		""
		"&aStockpile these.&r Every electric machine recipe wants one. They're the LV equivalent of the bronze machine casing — mass-produce and never run out."
	]
	quest.4D49010000010012.quest_subtitle: "LV machine internal."
	quest.4D49010000010012.title: "Basic Machine Hull"
	quest.4D49010000010013.quest_desc: [
		"&6Motors&r are the moving heart of every powered MI machine. Conveyors, macerators, mixers, drills — if it spins, it has a motor inside."
		""
		"Recipe involves cables, magnets, and steel. Once you can mass-produce these, machine assembly stops being the bottleneck."
	]
	quest.4D49010000010013.quest_subtitle: "Rotational power."
	quest.4D49010000010013.title: "Motor"
	quest.4D49010000010014.quest_desc: [
		"&6Pumps&r move fluids inside machine recipes — not as a placed block, but as an internal component. Many advanced machines need a Pump baked into their hull."
		""
		"Made from a motor and a couple of rotors."
	]
	quest.4D49010000010014.quest_subtitle: "Fluid I/O for machines."
	quest.4D49010000010014.title: "Pump"
	quest.4D49010000010015.quest_desc: [
		"&6Conveyors&r are MI's belt component. Internal recipes use them; placed conveyors auto-eject items from a machine's output side."
		""
		"&aSlap a conveyor on the back of any MI machine to auto-feed the next stage.&r"
	]
	quest.4D49010000010015.quest_subtitle: "Item I/O for machines."
	quest.4D49010000010015.title: "Conveyor"
	quest.4D49010000010016.quest_desc: [
		"The &6Electric Macerator&r is the LV upgrade over the Bronze Macerator. Faster, more energy-efficient, accepts upgrades."
		""
		"Same job: ore in, dust out, doubled. Now powered by LV cable instead of steam."
	]
	quest.4D49010000010016.quest_subtitle: "Electric-tier ore-doubler."
	quest.4D49010000010016.title: "Electric Macerator"
	quest.4D49010000010017.quest_desc: [
		"The &6Electric Compressor&r is the LV plate-presser. Replaces the Bronze Compressor for everything you'll do from here on."
		""
		"Combine with a Wiremill and a Cutting Machine for a complete electric metalworking line."
	]
	quest.4D49010000010017.quest_subtitle: "Plates and rods at scale."
	quest.4D49010000010017.title: "Electric Compressor"
	quest.4D49010000010018.quest_desc: [
		"The &6Electric Wiremill&r turns ingots directly into cable, skipping the plate intermediate."
		""
		"&aMassively faster cable production than the hammer-and-cutter route.&r Once you start running aluminum or copper cable in volume, this is mandatory."
	]
	quest.4D49010000010018.quest_subtitle: "Wire production."
	quest.4D49010000010018.title: "Electric Wiremill"
	quest.4D49010000010019.quest_desc: [
		"The &6Assembler&r combines components into finished parts. Almost every MI recipe with three or more inputs ends up in the Assembler — circuits, motors, machine hulls."
		""
		"&aThis is the central machine of the LV tier.&r Build it early; you'll route practically everything through it."
	]
	quest.4D49010000010019.quest_subtitle: "Automated crafting."
	quest.4D49010000010019.title: "Assembler"
	quest.4D4901000001001A.quest_desc: [
		"&6Electronic Circuits&r are MI's first circuit tier. Almost every LV-and-above machine recipe wants a circuit slotted in."
		""
		"&aMass-produce these early.&r The MI tier ladder is essentially a circuit-tier ladder — Electronic → Digital → Processing Unit. Each new tier opens a wave of recipes."
	]
	quest.4D4901000001001A.quest_subtitle: "First electronic circuit."
	quest.4D4901000001001A.title: "Electronic Circuit"
	quest.4D4901000001001B.quest_desc: [
		"The &6Steel Pipe Casing&r is the LV-tier upgrade to the bronze pipe casing. Used by fluid-handling steel-tier machines and most fluid hatches."
		""
		"Stockpile alongside steel machine casings."
	]
	quest.4D4901000001001B.quest_subtitle: "Higher capacity. Required for scaled plumbing."
	quest.4D4901000001001B.title: "Steel Pipe Casing"
	quest.4D4901000001001C.quest_desc: [
		"The &6Steel Barrel&r is a bulk item-storage drum. Holds many stacks of a single item type."
		""
		"Useful for buffering machine outputs that you don't want to spill into your network."
	]
	quest.4D4901000001001C.quest_subtitle: "Portable fluid storage."
	quest.4D4901000001001C.title: "Steel Barrel"
	quest.4D4901000001001D.quest_desc: [
		"The &6Centrifuge&r separates mixed materials by spinning them at high speed. It's how you get individual byproducts out of crushed ore dust, slurries, and gas mixes."
		""
		"&aThis machine is byproduct-central — rare metals fall out of common ores once you centrifuge their dusts.&r"
	]
	quest.4D4901000001001D.quest_subtitle: "Byproduct extraction."
	quest.4D4901000001001D.title: "Centrifuge"
	quest.4D4901000001001E.quest_desc: [
		"The &6Electrolyzer&r splits compounds with electricity. It's how MI produces aluminum, sodium, and several other elements that don't smelt out of an ore."
		""
		"Bauxite dust → aluminum; salt → sodium hydroxide; the recipe list grows as you discover new compounds."
	]
	quest.4D4901000001001E.quest_subtitle: "Chemistry gate."
	quest.4D4901000001001E.title: "Electrolyzer"
	quest.4D4901000001001F.quest_desc: [
		"The &6Electric Blast Furnace&r is MI's high-temperature multiblock smelter. It's the bridge from LV-tier alloys to MV-tier exotics — stainless steel, titanium, tungsten all come out of here."
		""
		"&aHeating coils set the temperature ceiling.&r Cupronickel coils handle the basics; Kanthal coils unlock high-temp recipes; later you'll swap to Nichrome and beyond. &cMatch coil tier to recipe temperature or the EBF won't process.&r"
	]
	quest.4D4901000001001F.quest_subtitle: "Tier-coil alloy gate."
	quest.4D4901000001001F.title: "Electric Blast Furnace"
	quest.4D49010000010020.quest_desc: [
		"The &6Advanced Machine Hull&r is the chassis for MV-tier electric machines — a step above the Basic Machine Hull."
		""
		"&aHaving these in stock means you've finished IR1's bronze→steel→electric arc and are ready to move into IR2's Mekanism + advanced MI content.&r"
	]
	quest.4D49010000010020.quest_subtitle: "Advanced-tier internal."
	quest.4D49010000010020.title: "Advanced Machine Hull"
	quest.4D49010000010021.quest_desc: [
		"The &6Steel Cutting Machine&r is the upgrade above the Bronze Cutting Machine. Faster cuts; more power-efficient at MV throughput."
		""
		"Add it to your factory line once you're routing volumes the bronze unit can't handle."
	]
	quest.4D49010000010021.quest_subtitle: "Precision plate and rod cutting."
	quest.4D49010000010021.title: "Steel Cutting Machine"
	quest.4D49010000010022.quest_desc: [
		"The &6Steel Packer&r packs items into shulker boxes, bundles, or other compact storage according to recipe."
		""
		"&aGreat for compressing harvested loot before shipping it through pipes.&r"
	]
	quest.4D49010000010022.quest_subtitle: "Automated assembly."
	quest.4D49010000010022.title: "Steel Packer"
	quest.4D49010000010024.quest_desc: [
		"The &6Bronze Compressor&r flattens ingots into plates without you needing to swing the Forge Hammer."
		""
		"&aHuge quality-of-life jump.&r Once a compressor is online, your MI progression accelerates because plate-gated recipes stop being a bottleneck."
	]
	quest.4D49010000010024.quest_subtitle: "Plates without the hammer."
	quest.4D49010000010024.title: "Bronze Compressor"
	quest.4D49010000010025.quest_desc: [
		"The &6Bronze Mixer&r combines materials. Bronze (copper+tin), battery alloy, kanthal mix — anything alloy-shaped goes through this machine."
		""
		"Add fluid or item inputs as the recipe demands. JEI shows the exact ratios."
	]
	quest.4D49010000010025.quest_subtitle: "Alloys and liquid mixing."
	quest.4D49010000010025.title: "Bronze Mixer"
	quest.4D49010000010026.quest_desc: [
		"The &6Bronze Water Pump&r pulls water from any adjacent water source and pushes it out as fluid."
		""
		"Keep your Boilers fed without manually bucketing — this and a single infinite water source are all you need for steady steam."
	]
	quest.4D49010000010026.quest_subtitle: "Auto-feeds the boiler."
	quest.4D49010000010026.title: "Bronze Water Pump"
	quest.4D49010000010027.quest_desc: [
		"The &6LV Steam Turbine&r converts steam pressure into Low Voltage electricity. This is the moment MI stops being a steam pack and starts being an electrical one."
		""
		"&aFeed it from a Large Steam Boiler.&r LV cable goes out the back; everything from here forward runs on volts, not steam. &cMixing voltages will burn out machines — check tier requirements before you wire anything.&r"
	]
	quest.4D49010000010027.quest_subtitle: "Steam → EU."
	quest.4D49010000010027.title: "LV Steam Turbine"
	quest.4D49010000010028.quest_desc: [
		"&6Annealed Copper Cable&r is the upgraded LV power line. Higher amperage, lower loss than plain copper cable."
		""
		"&aSwap your early copper runs for these once you have Annealed Copper.&r The voltage stays the same; the throughput jumps."
	]
	quest.4D49010000010028.quest_subtitle: "HV-grade cabling."
	quest.4D49010000010028.title: "Annealed Copper Cable"
	quest.4D49010000010029.quest_desc: [
		"&6Kanthal Coils&r are the next-tier heating element above Cupronickel. They handle higher temperatures, which is what you need to process advanced alloys like Stainless Steel and Titanium."
		""
		"Made from Kanthal ingots (iron + chromium + aluminum). &aSwapping coils in your EBF unlocks the next batch of recipes — it's a whole-system upgrade for one item.&r"
	]
	quest.4D49010000010029.quest_subtitle: "EBF tier 2 coil."
	quest.4D49010000010029.title: "Kanthal Coil"
	quest.4D4901000001002A.quest_desc: [
		"The &6Electric Furnace&r smelts items on LV power — faster than vanilla, no fuel needed, no steam line."
		""
		"Once it's running, your bronze furnace becomes obsolete; this is the everyday smelter from now on."
	]
	quest.4D4901000001002A.quest_subtitle: "Vanilla furnace, EU-powered."
	quest.4D4901000001002A.title: "Electric Furnace"
	quest.4D4901000001002B.quest_desc: [
		"&6Silicon Ingots&r are MI's semiconductor. Required for circuit boards, advanced electronics, and several high-tier machine recipes."
		""
		"Made from silicon dust (quartz-derived) processed in the Electric Blast Furnace."
	]
	quest.4D4901000001002B.quest_subtitle: "Semiconductor feedstock."
	quest.4D4901000001002B.title: "Silicon Production"
	quest.4D4901000001002C.quest_desc: [
		"&6Rubber Sheets&r are the insulator for every cable in MI. No rubber, no insulated wire; no insulated wire, no power network."
		""
		"Get rubber from rubber tree saps or synthesize it (see &6Synthetic Rubber&r). Compress raw rubber into sheets."
	]
	quest.4D4901000001002C.quest_subtitle: "Cable insulation."
	quest.4D4901000001002C.title: "Rubber Sheet"
	quest.4D4901000001002D.quest_desc: [
		"The &6Synthetic Rubber Bucket&r holds liquid synthetic rubber, produced from oil distillation later on."
		""
		"&aFor IR1 you'll mostly use sheet rubber from rubber trees.&r Synthetic rubber comes online once you have an oil chain in IR3."
	]
	quest.4D4901000001002D.quest_subtitle: "Insulation feedstock."
	quest.4D4901000001002D.title: "Synthetic Rubber"
	quest.4D4901000001002E.quest_desc: [
		"&6Copper Cables&r are the entry-level LV power line. Carries low currents over short distances."
		""
		"Upgrade to Annealed Copper or Aluminum once you have them — copper is fine for a starter wire, not for a factory."
	]
	quest.4D4901000001002E.quest_subtitle: "First insulated cable."
	quest.4D4901000001002E.title: "Insulated Copper Cable"
	quest.4D4901000001002F.quest_desc: [
		"&6Electronic Circuit Boards&r are the substrate of every circuit. Etched copper on plastic; it's the base layer before resistors and silicon get assembled on top."
		""
		"Made in the Assembler. You'll need stacks of these once circuits become the gating ingredient."
	]
	quest.4D4901000001002F.quest_subtitle: "PCB substrate."
	quest.4D4901000001002F.title: "Electronic Circuit Board"
	quest.4D49010000010030.quest_desc: [
		"&6Analog Circuit Boards&r are a precursor variant to electronic circuits, used in some specific recipes."
		""
		"Less common than Electronic Circuit Boards but worth keeping a small stockpile."
	]
	quest.4D49010000010030.quest_subtitle: "MV-tier circuit."
	quest.4D49010000010030.title: "Analog Circuit"
	quest.4D49010000010031.quest_desc: [
		"&6Resistors&r are passive components. They go onto circuit boards alongside diodes and inductors."
		""
		"&aThe Assembler welds them onto boards in batches.&r Make sure you have a steady supply when scaling circuit production."
	]
	quest.4D49010000010031.quest_subtitle: "RLC trio."
	quest.4D49010000010031.title: "RLC Components"
	quest.4D49010000010032.quest_desc: [
		"The &6Bronze Pipe Casing&r is the chassis for fluid-handling bronze machines (boiler hatches, pumps, etc)."
		""
		"Same role as a regular bronze casing, but pipe-flavored."
	]
	quest.4D49010000010032.quest_subtitle: "Bronze-tier plumbing."
	quest.4D49010000010032.title: "Bronze Pipe Casing"
	quest.4D49010000010033.quest_desc: [
		"The &6Bronze Tank&r is your first dedicated fluid-storage block. Holds steam, water, fuel — whatever you pump into it."
		""
		"Right-click with an empty bucket to drain; pipe in to fill."
	]
	quest.4D49010000010033.quest_subtitle: "Bronze fluid storage."
	quest.4D49010000010033.title: "Bronze Tank"
	quest.4D49010000010034.quest_desc: [
		"The &6Large Tank&r is a multiblock fluid storage tank. Capacity scales with how big you build it."
		""
		"&aBuild it the size of your bulk fluid needs.&r For an oil distillation chain or a steel-tier reactor, this is your buffer."
	]
	quest.4D49010000010034.quest_subtitle: "Bulk-fluid multiblock."
	quest.4D49010000010034.title: "Large Tank"
	quest.4D49010000010035.quest_desc: [
		"The &6Bronze Item Input Hatch&r is an inventory port for bronze-tier multiblocks. Items piped in here feed the multiblock's recipe slots."
		""
		"Coke Oven and Steam Blast Furnace want one of these."
	]
	quest.4D49010000010035.quest_subtitle: "Bronze multiblock I/O."
	quest.4D49010000010035.title: "Bronze I/O Hatches"
	quest.4D49010000010036.quest_desc: [
		"The &6Steel Item Input Hatch&r is the LV-tier upgrade to the bronze input hatch. Higher item throughput."
		""
		"Used in steel-tier multiblocks like the Electric Blast Furnace."
	]
	quest.4D49010000010036.quest_subtitle: "Steel multiblock I/O."
	quest.4D49010000010036.title: "Steel I/O Hatches"
	quest.4D49010000010037.quest_desc: [
		"The &6Advanced Item Input Hatch&r is the next-tier hatch above steel. Faster item insertion, higher buffer."
		""
		"Required for MV-tier and above multiblocks."
	]
	quest.4D49010000010037.quest_subtitle: "Advanced multiblock I/O."
	quest.4D49010000010037.title: "Advanced I/O Hatches"
	quest.4D49010000010038.quest_desc: [
		"&6Stainless Steel Ingots&r are the MV-tier alloy. Iron + chromium + nickel + manganese, fused in the Electric Blast Furnace at high temperature."
		""
		"Stainless is the chassis material for the next tier of machines — centrifuges, distillation columns, advanced casings."
	]
	quest.4D49010000010038.quest_subtitle: "Advanced-tier alloy."
	quest.4D49010000010038.title: "Stainless Steel"
	quest.4D49010000010039.quest_desc: [
		"The &6Clean Stainless Steel Machine Casing&r is the MV-tier machine chassis. Replaces the steel casing for the next wave of machines."
		""
		"Polished and corrosion-resistant — this is what tools and chemical handling equipment are built from."
	]
	quest.4D49010000010039.quest_subtitle: "Advanced multiblock chassis."
	quest.4D49010000010039.title: "Stainless Steel Machine Casing"
	quest.4D4901000001003A.quest_desc: [
		"&6Tungsten Ingots&r are an extreme-high-melting-point metal. Tungsten plates and rods are needed for HV-and-above machines."
		""
		"&aReal-world tungsten is the highest-melting elemental metal — MI keeps it gated behind Kanthal coils for that reason.&r"
	]
	quest.4D4901000001003A.quest_subtitle: "Kanthal-tier alloy."
	quest.4D4901000001003A.title: "Tungsten Ingot"
	quest.4D4901000001003C.quest_desc: [
		"&6Titanium Ingots&r are corrosion-resistant high-strength metal. Titanium plates are the chassis material for several aerospace-flavored late-IR recipes."
		""
		"Process from rutile dust in the EBF at Kanthal-coil temperature."
	]
	quest.4D4901000001003C.quest_subtitle: "Lightweight high-strength alloy."
	quest.4D4901000001003C.title: "Titanium Ingot"
	quest.4D4901000001003D.quest_desc: [
		"&6Chromium Ingots&r are the alloying element that turns steel into stainless steel. Pulled from chromite dust through the EBF."
		""
		"Also goes into nichrome and similar high-temperature alloys further up the tier ladder."
	]
	quest.4D4901000001003D.quest_subtitle: "Stainless-steel feedstock."
	quest.4D4901000001003D.title: "Stainless Alloying"
	quest.4D4901000001003E.quest_desc: [
		"The &6Bronze Drill&r is your first powered mining tool. Faster than a pickaxe, holds a charge in its internal battery."
		""
		"&aMines a 1x3 area — a noticeable speedup for tunneling.&r"
	]
	quest.4D4901000001003E.quest_subtitle: "Bronze-tier toolkit."
	quest.4D4901000001003E.title: "Bronze Tools"
	quest.4D4901000001003F.quest_desc: [
		"The &6Steel Drill&r is the LV upgrade to the Bronze Drill. Faster, larger battery, higher mining speed."
		""
		"Eats Redstone Battery charge; recharge at any Energy Hatch or charger."
	]
	quest.4D4901000001003F.quest_subtitle: "Steel-tier toolkit."
	quest.4D4901000001003F.title: "Steel Tools"
	quest.4D49010000010040.quest_desc: [
		"&6Basic Upgrades&r are speed/efficiency modifiers for MI machines. Slot one or more into a machine to boost its throughput."
		""
		"There are higher-tier upgrades later (advanced, turbo); basic upgrades are the entry point to the upgrade system."
	]
	quest.4D49010000010040.quest_subtitle: "Throughput multipliers."
	quest.4D49010000010040.title: "Speed Upgrades"
	quest.4D49010000010041.quest_desc: [
		"&6Bronze Ingots&r are a copper-tin alloy — the first proper alloy on the path to the Industrial Revolution. They're produced in a Bronze Mixer or by mixing molten copper and tin in a smeltery."
		""
		"&aHistorically: bronze comes before iron because tin is rare and copper is everywhere. MI rewards you for following the same path.&r"
	]
	quest.4D49010000010041.quest_subtitle: "Copper + tin = bronze."
	quest.4D49010000010041.title: "Bronze Ingot"
	quest.4D49010000010042.quest_desc: [
		"&6Copper Plates&r are hammered copper, identical in role to bronze plates but used wherever the recipe calls for soft, conductive metal."
		""
		"You'll need them for boilers, hatches, and most cabling work later in the tier."
	]
	quest.4D49010000010042.quest_subtitle: "Copper, hammered flat."
	quest.4D49010000010042.title: "Copper Plate"
	quest.4D49010000010043.quest_desc: [
		"&6Bronze Rods&r are hammered bronze pinched into a stick. Used in motors, drills, and a dozen low-tier MI parts."
		""
		"&aOnce you have a Cutting Machine, rods come out of plates two-at-a-time.&r"
	]
	quest.4D49010000010043.quest_subtitle: "Bronze toolkit."
	quest.4D49010000010043.title: "Bronze Components"
	quest.4D49010000010044.quest_desc: [
		"The &6Bronze Cutting Machine&r slices plates and ingots into rods, gears, and bolts. Two rods per plate, no Forge Hammer required."
		""
		"Eats steam like every bronze machine. Add it to your steam line and forget about hand-crafting rods."
	]
	quest.4D49010000010044.quest_subtitle: "Plates and rods, cleaner cuts."
	quest.4D49010000010044.title: "Bronze Cutting Machine"
	quest.4D49010000010045.quest_desc: [
		"The &6Large Steam Boiler&r is the big-brother boiler. It produces vastly more steam than the small one, enough to feed an entire factory."
		""
		"Multiblock construction — check JEI for the layout. Once running, pair it with high-pressure steam pipes and a turbine to start producing electricity."
	]
	quest.4D49010000010045.quest_subtitle: "Scaled steam supply."
	quest.4D49010000010045.title: "Large Steam Boiler"
	quest.4D49010000010046.quest_desc: [
		"The &6MV Steam Turbine&r is the LV turbine's bigger sibling, producing Medium Voltage current."
		""
		"MV is what the steel-tier machines want. You'll route MV to electric blast furnaces, advanced macerators, and any IR2-flagged equipment."
	]
	quest.4D49010000010046.quest_subtitle: "Higher voltage. More EU per tick."
	quest.4D49010000010046.title: "MV Steam Turbine"
	quest.4D49010000010047.quest_desc: [
		"&6Steel Plates&r are flattened steel. Plates feed into casings, hatches, and most LV recipes."
		""
		"&aPipe them through a Compressor — never hammer steel by hand if you can avoid it.&r"
	]
	quest.4D49010000010047.quest_subtitle: "Electric-tier toolkit."
	quest.4D49010000010047.title: "Steel Components"
	quest.4D49010000010048.quest_desc: [
		"&6Cupronickel Ingots&r are a copper-nickel alloy used for low-temperature heating coils. They're the first heating element in MI's coil ladder."
		""
		"Mix copper + nickel in the Mixer. Cupronickel is enough for early electric heat; you'll graduate to Kanthal soon."
	]
	quest.4D49010000010048.quest_subtitle: "Copper + nickel."
	quest.4D49010000010048.title: "Cupronickel Ingot"
	quest.4D49010000010049.quest_desc: [
		"&6Nickel Ingots&r come from nickel ore (or as a byproduct of platinum ore processing). Nickel + copper makes &6Cupronickel&r, the LV-tier heating coil alloy."
		""
		"Without nickel, no cupronickel coils — without coils, no Electric Blast Furnace."
	]
	quest.4D49010000010049.quest_subtitle: "Smelted from nickeliferous ore."
	quest.4D49010000010049.title: "Nickel Ingot"
	quest.4D4901000001004A.quest_desc: [
		"&6Aluminum Ingots&r are MI's lightweight conductor. Aluminum cable is the standard for medium-voltage power transmission — cheaper than copper, lower losses than tin."
		""
		"Aluminum is produced in the Electrolyzer from bauxite dust."
	]
	quest.4D4901000001004A.quest_subtitle: "Bauxite → ingot → plate."
	quest.4D4901000001004A.title: "Aluminum Production"
	quest.4D4901000001004B.quest_desc: [
		"&6Annealed Copper&r is heat-treated copper, a notch above raw copper for electrical work. It's processed in the Electric Furnace at higher temperature than vanilla smelting."
		""
		"Annealed copper cable carries current with less loss than plain copper — the standard for serious LV wiring."
	]
	quest.4D4901000001004B.quest_subtitle: "Heat-treated copper."
	quest.4D4901000001004B.title: "Annealed Copper Ingot"
	quest.4D4901000001004C.quest_desc: [
		"&6Bronze Blocks&r are 9-ingot storage blocks — mass storage and compact decoration in one."
		""
		"Useful for building boiler rooms with proper steampunk aesthetic, and for compressing your bronze stockpile when chests get full."
	]
	quest.4D4901000001004C.quest_subtitle: "Compact ingot storage."
	quest.4D4901000001004C.title: "Block Storage"
	quest.4D4901000001004D.quest_desc: [
		"The &6Large Pump&r is the upgraded fluid-mover. Higher throughput; needed by the bigger multiblock recipes that move serious volumes of liquid."
		""
		"Most relevant for steel-tier and stainless-tier machines."
	]
	quest.4D4901000001004D.quest_subtitle: "Higher-tier fluid extraction."
	quest.4D4901000001004D.title: "Pump Tiers"
	quest.4D4901000001004E.quest_desc: [
		"The &6Electric Mixer&r is the LV upgrade for alloying. Faster than the Bronze Mixer, runs on cables, accepts upgrade slots."
		""
		"Your alloy line scales with this machine — moving up to MV-tier processing depends on having an electric mixer in place."
	]
	quest.4D4901000001004E.quest_subtitle: "Electric alloy mixing."
	quest.4D4901000001004E.title: "Electric Mixer"
	quest.4D4901000001004F.quest_desc: [
		"The &6Electric Cutting Machine&r turns plates into rods and gears at LV speed. Eight rods per plate, no waiting."
		""
		"Pair with a Wiremill and a Compressor to make every shaped metal part you'll ever need."
	]
	quest.4D4901000001004F.quest_subtitle: "Plate cuts at speed."
	quest.4D4901000001004F.title: "Electric Cutting Machine"
	quest.4D49010000010050.quest_desc: [
		"&6Copper Wire&r is the raw conductor before it's insulated. Two wires + rubber sheet in an Assembler makes an insulated cable."
		""
		"The Wiremill produces these from copper ingots two-at-a-time."
	]
	quest.4D49010000010050.quest_subtitle: "Drawn from copper rod."
	quest.4D49010000010050.title: "Copper Wire"
	quest.4D49010000010051.quest_desc: [
		"The &6Iron Tank&r is a sturdier fluid storage option, intermediate between bronze and aluminum."
		""
		"Slightly higher capacity than the bronze tank; works as a buffer for medium-volume fluid networks."
	]
	quest.4D49010000010051.quest_subtitle: "Iron-grade fluid storage."
	quest.4D49010000010051.title: "Iron Tank"
	quest.4D49010000010052.quest_desc: [
		"The &6Aluminum Tank&r is the LV-tier fluid storage block. Higher capacity than iron or bronze tanks."
		""
		"Aluminum's corrosion resistance is why it's the standard tank metal in real-world chemical plants — MI follows the same logic."
	]
	quest.4D49010000010052.quest_subtitle: "Lightweight, larger capacity."
	quest.4D49010000010052.title: "Aluminum Tank"
	quest.4D49010000010053.quest_desc: [
		"The &6Configurable Tank&r is a portable handheld tank with adjustable capacity and filter modes."
		""
		"Useful for ferrying fluids between machines without running pipe everywhere."
	]
	quest.4D49010000010053.quest_subtitle: "Resizable storage volume."
	quest.4D49010000010053.title: "Configurable Tank"
	quest.4D49010000010054.quest_desc: [
		"The &6Bronze Barrel&r is the bronze-tier item barrel — smaller capacity than steel, but available earlier."
		""
		"Stash early-game ingot stockpiles inside; saves chest sprawl."
	]
	quest.4D49010000010054.quest_subtitle: "Tier-flavored item buffers."
	quest.4D49010000010054.title: "Barrel Tiers"
	quest.4D49010000010055.quest_desc: [
		"&6Tungsten Plates&r are flattened tungsten. Goes into HV machine hulls, advanced cables, and high-temperature tooling."
		""
		"Compress tungsten ingots; the regular hammer struggles with the metal so don't bother by hand."
	]
	quest.4D49010000010055.quest_subtitle: "Plate and rod for advanced builds."
	quest.4D49010000010055.title: "Tungsten Forms"
	quest.4D49010000010056.quest_desc: [
		"&6Titanium Plates&r flatten titanium ingots into plate stock."
		""
		"Used in HV machine hulls and several IR2-gated recipes."
	]
	quest.4D49010000010056.quest_subtitle: "Plate and rod for aerospace-tier parts."
	quest.4D49010000010056.title: "Titanium Forms"
	quest.4D49010000010057.quest_desc: [
		"The &6Steel Unpacker&r is the inverse of the Packer — opens compressed bundles back into their stack of items."
		""
		"Useful when receiving packed shipments from another base or autocrafted assembly."
	]
	quest.4D49010000010057.quest_subtitle: "Storage compaction toolkit."
	quest.4D49010000010057.title: "Packer Family"
	quest.4D49010000010058.title: "Region: Bronze Components"
	quest.4D53010000010001.quest_desc: [
		"The &6Supreme Machine Frame&r is Industrial Foregoing's top-tier chassis — every Atomic-tier IF machine, generator, and reactor uses this frame as its core. You won't make one and stop; you'll make a stack of them."
		""
		"This is the entry quest to IF's endgame. Everything beyond this point — the &6Mycelial Reactor&r, the &6Wither Builder&r, the supreme generators — is built on top of this frame."
		""
		"&aBatch-craft these. Industrial Foregoing's Mycelial Reactor alone wants several.&r"
	]
	quest.4D53010000010001.title: "&5The Machine Soul&r"
	quest.4D53010000010002.quest_desc: [
		"&6Ether Gas&r is Industrial Foregoing's premium gaseous fuel — produced from ether mushrooms via the right combination of growth, processing, and luck. The bucket is the canonical proof that your ether-gas pipeline works."
		""
		"This is the fluid backbone of Industrial Foregoing's Mycelial Reactor in the next quest. Without ether gas the Mycelial Reactor sits cold; with a steady supply it runs the supreme tier of IF for as long as you want."
		""
		"&aSet up automation early. Manual ether-gas production is a special kind of misery.&r"
	]
	quest.4D53010000010002.title: "Ether Gas"
	quest.4D53010000010003.quest_desc: [
		"The &6Mycelial Reactor&r is Industrial Foregoing's endgame power generator — a multiblock controller. Surround the controller with up to 13 specialty &6Mycelial Generator blocks&r (Furnace, Culinary, Frosty, Death, Ender, Explosive, Halitosis, Magma, Meatallurgic, Netherstar, Pink, Potion, Rocket, Slimey, Crimed, Disenchantment); each generator block contributes its own input → FE recipe to the reactor's repertoire."
		""
		"It is the centerpiece of this entire chapter. The generator blocks in the next three quests &eare&r the structural faces of the reactor — each one you wall in adds its recipe. A fully-walled reactor is one of the highest sustained FE outputs in the pack short of nuclear."
		""
		"&cFeed each generator face the input it requests&r and pipe FE out of the controller. Automate the inputs, not the structure."
	]
	quest.4D53010000010003.title: "&5Mycelial Reactor&r"
	quest.4D53010000010004.quest_desc: [
		"The first set of &6Mycelial Generator blocks&r — &6Furnace&r, &6Culinary&r, and &6Frosty&r. Each is a standalone IF generator block that becomes part of the Mycelial Reactor multiblock when placed adjacent to the controller; each exchanges a specific input theme (heat, food, ice) for FE."
		""
		"Most early reactor builds run two or three of these in parallel for steady output. They're the &aapproachable&r tier — easy to feed, no exotic ingredients."
	]
	quest.4D53010000010004.title: "Mycelial: Tier 1"
	quest.4D53010000010005.quest_desc: [
		"The mid-tier &6Mycelial Cores&r — &6Crimed&r (nether), &6Death&r, &6Disenchantment&r, &6Ender&r, and &6Explosive&r. These start to ask for harder ingredients (rotten flesh, ender pearls, gunpowder, nether warts) but pay back more aggressively."
		""
		"This is where Industrial Foregoing's Mycelial Reactor stops being a curiosity and becomes real infrastructure. Five cores running in parallel is enough to power a sizable IF/Oritech base by itself."
	]
	quest.4D53010000010005.title: "Mycelial: Tier 2"
	quest.4D53010000010006.quest_desc: [
		"The high-tier &6Mycelial Cores&r — &6Halitosis&r, &6Magma&r, &6Meatallurgic&r, &6Netherstar&r, &6Pink&r, &6Potion&r, &6Rocket&r, and &6Slimey&r. These ask for the hardest ingredients in the catalog (nether stars, lingering potions, firework rockets) and pay the highest FE in return."
		""
		"The Netherstar core in particular pairs with the &6Wither Builder&r in the same chapter — automate Withers, feed the cores, and Industrial Foregoing's Mycelial Reactor never starves. Halitosis and Pink are the silliest cores in the game and exactly as effective as the serious ones."
		""
		"&cDon't try to feed all eight at once on day one.&r Pick the cores whose inputs you already produce, and add the rest as automation matures."
	]
	quest.4D53010000010006.title: "Mycelial: Tier 3"
	quest.4D53010000010007.quest_desc: [
		"The &6Wither Builder&r automates Wither summoning. Feed it soul sand and wither skulls and it places the T, lights it, and lets the resulting Wither either rampage or get processed by an adjacent &6Mob Crusher&r."
		""
		"Pair it with a Mob Crusher in a sealed reinforced box and you have a sustainable nether-star pipeline. Pair the resulting nether stars with the &6Mycelial Netherstar Core&r and the Atomic-tier IF stack pays for itself."
		""
		"&cPlace it carefully.&r The Wither will spawn exactly where the builder says it will, and an unsealed room means a Wither in your living quarters."
	]
	quest.4D53010000010007.title: "&8Wither Builder&r"
	quest.4D53010000010008.quest_desc: [
		"Three Industrial Foregoing power generators that don't run on Mycelial Cores — the &6Protein Reactor&r and &6Protein Generator&r run on automated meat/protein, and the &6Petrified Fuel Generator&r runs on coal-family fuels."
		""
		"These are the side-spine to the Mycelial Reactor. They're simpler to set up and useful for redundancy or for early-Atomic bases where the full mycelial stack isn't online yet."
		""
		"&7Optional. Skip if you're committed to Mycelial.&r"
	]
	quest.4D53010000010008.title: "Alt-Fuel Generators"
	quest.4D53010000010009.quest_desc: [
		"The &6Infinity Charger&r is IF's wireless charging block — drop charged items in, and any Infinity-tier IF tool in your inventory or held by a nearby player gets topped up automatically."
		""
		"It's a quality-of-life unlock. If you've been using IF tools (Infinity Drill, Infinity Trident, Infinity Saw) the charger removes the most annoying part of carrying them around."
		""
		"&7Optional QOL.&r"
	]
	quest.4D53010000010009.title: "Infinity Charger (Atomic-side)"
	quest.4D5301000001000A.quest_desc: [
		"Hold a complete &6Mycelial Reactor&r setup at once — the reactor block, a &6Supreme Machine Frame&r, and a &6Wither Builder&r — to confirm Industrial Foregoing's Atomic tier is fully online."
		""
		"This is the chapter capstone. By the time you can clear it, you have the IF endgame stack: supreme machines, automated Withers, and a self-sustaining Mycelial Reactor power core."
		""
		"&5Industrial Foregoing's machine soul is awake.&r"
	]
	quest.4D5301000001000A.title: "&5Atomic IF Complete&r"
	quest.4D61009737D94BDA.quest_desc: [
		"Reach a &6colony population of 25&r — town-scale population."
		""
		"Now you have real economic momentum."
	]
	quest.4D7AB52A71728AB3.quest_desc: [
		"&6Behemoth Steak&r — cooked Behemoth Meat. One of the best food items in the chapter, restoring lots of hunger and saturation."
		""
		"&aCarry stacks. Behemoth Steak feeds you through long End expeditions.&r"
	]
	quest.4D7AB52A71728AB3.title: "Behemoth Steak"
	quest.4D9DC4973FD340E5.quest_desc: [
		"Build a &6Combat Academy&r — trains melee guards."
		""
		"Higher-level guards spawn from higher-level academies."
	]
	quest.4DD7E2BD8508A117.quest_desc: [
		"Build all four &6Herder huts&r — Cowboy, Swineherder, Chickenherder, Shepherd, and Rabbit Hutch."
		""
		"&aFull animal-husbandry chain — meat, eggs, leather, wool, all auto-produced.&r"
	]
	quest.4DD7E2BD8508A117.quest_subtitle: "Craft All 5 Farming Utilities"
	quest.4DFDC6D359F02D1E.quest_desc: [
		"The &6Iron Brush&r from Better Archeology upgrades the vanilla brush — durable enough to clear suspicious sand and gravel without breaking constantly."
		""
		"&aBrush slowly across suspicious blocks&r in archeology sites, ocean ruins, and trail ruins to extract artifacts."
	]
	quest.4DFDC6D359F02D1E.quest_subtitle: "&oStart brushing."
	quest.4DFDC6D359F02D1E.title: "&fThe Archaeologist's Path"
	quest.4E28960E37EAD541.quest_desc: [
		"The &6Autocrafter Manager&r aggregates many autocrafters into a single block, letting you organize fleets of them."
		""
		"&aOnce you have dozens of autocrafters, this organizes them so the network handles routing automatically.&r"
	]
	quest.4E28960E37EAD541.quest_subtitle: "Manage patterns across many crafters."
	quest.4E28960E37EAD541.title: "Autocrafter Manager"
	quest.4E44010000010001.quest_desc: [
		"&5Lady Luna&r is dead. The &6Atomic&r stage is now active and the rest of the pack — particle accelerators, nuclear reactors, supreme machines — is waiting."
		""
		"This is the science spine's apex. &6Nuclear Science&r runs the show with three reactor types, ray-cast radiation, and a working particle accelerator. &6Mekanism Generators&r still has its fission/fusion stack, &6Industrial Foregoing&r unlocks its supreme tier, and Oritech's atomic convergence brings the engineering spine to its final form."
		""
		"&7Pick a chapter and start building. Whatever you pick first, you'll probably end up doing all of it.&r"
	]
	quest.4E44010000010001.quest_subtitle: "Split the atom."
	quest.4E44010000010001.title: "&cNuclear Dawn"
	quest.4E8775F66BAA23B6.quest_desc: ["The full &6Gravitite Armor Set&r — Aether's diamond-tier armor with reduced fall damage and minor levitation flavor."]
	quest.4E8775F66BAA23B6.quest_subtitle: "Jump higher, fall harder"
	quest.4E8775F66BAA23B6.title: "Gravitite Panoply"
	quest.4EC863BFE8B04EEF.quest_desc: [
		"The &6Tyrving&r is a Malum sword that scales damage based on the wielder's recent kills. The more you kill, the harder it hits."
		""
		"&aBuilt-in killstreak weapon.&r Save it for mob-farming sessions or boss runs where the streak counter actually fills."
	]
	quest.4EEF0962CC249F30.quest_desc: [
		"Build a &6Cook&r — the citizen who prepares meals from raw ingredients."
		""
		"Required for high-tier food crafts."
	]
	quest.4EF947EA6DF07A5C.quest_desc: ["The &6Stratus Sword&r — Deep Aether's pinnacle blade. Crit-chance bonus that scales with altitude."]
	quest.4EF947EA6DF07A5C.quest_subtitle: "Netherite for the Aether"
	quest.4EF947EA6DF07A5C.title: "Stratus Sword"
	quest.4F1787685B57BB4A.quest_desc: [
		"&5Region: Born in Chaos&r — the banner that opens the BIC sidebar. Hold a &6Piece of Dark Metal&r to cross the threshold (drops from most BIC humanoids: door knights, zombie bruisers, fallen chaos knights)."
		""
		"This is a pure-flavor entry. The actual BIC chain branches off the &6Elokosa Paw — Crescent&r quest higher in the chart, but this banner sits next to the chapter entry so the dark-fantasy half of the chapter has its own front door. Bonescallers, dread hounds, Sir Pumpkinhead, the death totem, the orb of the summoner, the staff of magic arrows, the dark-metal sub-tree — all down this branch."
		""
		"&7Banner only. The dark metal isn't consumed.&r"
	]
	quest.4F2AA98F732218B8.quest_desc: [
		"&5The Starlight Golem&r is the first of the dimension's four major bosses — a colossal stone construct animated by crystal energy. It hits slow but very, very hard."
		""
		"Killing it drops &6Oxidized Golem Steel Ingots&r and unlocks the Energy Sword tree. One of four kills required for the &6Soul Dew&r convergence."
		""
		"&cWatch its slam attack — the shockwave covers more ground than the visible animation suggests.&r"
	]
	quest.4F2AA98F732218B8.title: "Starlight Golem"
	quest.4F4201000001000A.quest_desc: [
		"Reach &6The End&r — the dimension where the Obsidilith encounter takes place. Travel through the standard End portal with eyes of ender."
		""
		"&aThe End is the staging ground for the IR→Gilded gate fight.&r The Obsidilith arena is a natural End worldgen structure — explore the End to find it."
	]
	quest.4F4201000001000A.quest_subtitle: "The Obsidilith's domain."
	quest.4F4201000001000A.title: "Return to the End"
	quest.4F4201000001000B.quest_desc: [
		"The &6Distillation Tower&r is MI's late-IR oil-cracking multiblock. Splits crude oil into multiple distillate fractions in one operation."
		""
		"&aMI's answer to PNC's Refinery and Oritech's Refinery Block.&r Higher throughput than the smaller machines; required for industrial-scale fuel production."
	]
	quest.4F4201000001000B.quest_subtitle: "MI's first Gilded multiblock."
	quest.4F4201000001000B.title: "Advanced Machine Hull"
	quest.4F4201000001000C.quest_desc: [
		"The &6Large Advanced Motor&r is MI's HV-tier motor. Required for top-tier MI machines and the Distillation Tower's main drive."
		""
		"&aMassive recipe — multiple advanced components.&r Late-IR MI capstone material."
	]
	quest.4F4201000001000C.quest_subtitle: "Raw rotational power."
	quest.4F4201000001000C.title: "Large Advanced Motor"
	quest.4F4201000001000D.quest_desc: [
		"The &6Large Steam Turbine&r is MI's HV turbine for industrial-scale steam-to-electric conversion. Output dwarfs LV/MV turbines."
		""
		"Pair with a Large Steam Boiler for serious power output."
	]
	quest.4F4201000001000D.quest_subtitle: "Industrial-scale energy generation."
	quest.4F4201000001000D.title: "Large Steam Turbine"
	quest.4F4201000001000F.quest_desc: [
		"&6Duratium Ingots&r are Oritech's late-IR exotic alloy. Mixed in the Foundry from energite + biosteel + advanced reagents."
		""
		"&aOritech's IR_final-tier capstone alloy.&r Beyond this, you're into Gilded Oritech expansion content."
	]
	quest.4F4201000001000F.quest_subtitle: "An alloy beyond adamant."
	quest.4F4201000001000F.title: "Duratium Ingot"
	quest.4F4201000001001B.quest_desc: [
		"The &6Machine Core 4&r is Oritech's first Gilded-tier core, but it's accessible at IR_final to bridge the era."
		""
		"&aThe transition component — built in IR with IR materials, used in Gilded recipes.&r"
	]
	quest.4F4201000001001B.quest_subtitle: "Region A complete — the Advanced Core."
	quest.4F4201000001001B.title: "Factory Sealed"
	quest.4F4201000001001C.quest_desc: [
		"The &6Still Fuel Bucket&r holds Oritech's distilled top-tier fuel. The result of multi-stage distillation in the Refinery + Modules stack."
		""
		"&aHighest energy density in the Oritech fuel ladder.&r"
	]
	quest.4F4201000001001C.quest_subtitle: "Distilled energy."
	quest.4F4201000001001C.title: "Refined Fuel"
	quest.4F4201000001001D.quest_desc: [
		"Open the IR-final summary in your guidebook to read about the Obsidilith fight and the IR→Gilded transition."
		""
		"&aIR_final is the convergence chapter — everything you've built in IR culminates here.&r"
	]
	quest.4F4201000001001D.quest_subtitle: "Industrial smelting at scale."
	quest.4F4201000001001D.title: "HV Transformer"
	quest.4F4201000001001E.quest_desc: [
		"Open the guidebook to read about the Bosses of Mass Destruction fights — Lich, Void Blossom, Gauntlet, and the Obsidilith."
		""
		"&aFour bosses; the Obsidilith is the age gate.&r"
	]
	quest.4F4201000001001E.quest_subtitle: "Strip-mining, automated."
	quest.4F4201000001001E.title: "HV Capacitor"
	quest.4F4201000001001F.quest_desc: [
		"Open the guidebook to read about the Hephaestus Forge tier ladder — T1 through T5, gated by stage."
		""
		"&aT2 unlocks here; T3 unlocks at the end of IR_final; T4-T5 in later ages.&r"
	]
	quest.4F4201000001001F.quest_subtitle: "The oil empire begins."
	quest.4F4201000001001F.title: "Advanced Battery Box"
	quest.4F4201000001002A.quest_desc: [
		"The &6Reinforced Pressure Chamber Valve&r is PNC's higher-tier valve — allows the Reinforced Pressure Chamber multiblock to operate at much higher pressures."
		""
		"&aRequired for advanced PNC recipes that exceed standard chamber pressure limits.&r"
	]
	quest.4F4201000001002A.quest_subtitle: "PneumaticCraft under pressure."
	quest.4F4201000001002A.title: "Reinforced Pressure Valve"
	quest.4F4201000001002B.quest_desc: [
		"The &6Charging Station&r (Energized Power) is the EP equivalent of a charger — recharges EP-themed batteries and tools."
		""
		"Pair with EP solar cells or any FE source."
	]
	quest.4F4201000001002B.quest_subtitle: "Recharge everything."
	quest.4F4201000001002B.title: "Charging Station"
	quest.4F4201000001002C.quest_desc: [
		"The &6Ultimate Energy Cube&r is Mekanism's top-tier energy storage cube. Massive Joule capacity."
		""
		"&aCapstone Mekanism energy block for the IR era.&r Stores enough energy to run a base for hours."
	]
	quest.4F4201000001002C.quest_subtitle: "Region B complete — the grid holds."
	quest.4F4201000001002C.title: "Power Grid Stabilized"
	quest.4F4201000001002D.quest_desc: [
		"The &6Energy Tablet&r is Mekanism's portable battery. Carry one to power Mekanism handheld tools, the Atomic Disassembler, the MekaSuit (later), and similar."
		""
		"Tier-laddered like all Mekanism gear — basic up to ultimate."
	]
	quest.4F4201000001002D.quest_subtitle: "Carry power between machines."
	quest.4F4201000001002D.title: "Energy Tablet"
	quest.4F4201000001002E.quest_desc: [
		"The &6Logistical Sorter&r is Mekanism's filtering item-mover. Pulls items from one inventory and routes them to a transporter network with whitelist/blacklist filters."
		""
		"&aMekanism's answer to AE2's import bus.&r Use anywhere you need precise sorting on a transporter line."
	]
	quest.4F4201000001002E.quest_subtitle: "Filtered item routing."
	quest.4F4201000001002E.title: "Logistical Sorter"
	quest.4F4201000001002F.quest_desc: [
		"&6Osmium Ingots&r are Mekanism's signature metal. Mined as osmium ore (mid-depth ranges) or processed from raw osmium."
		""
		"&aOsmium is in nearly every Mekanism advanced recipe.&r Reinforced obsidian, control circuits, machine cores — all use osmium."
	]
	quest.4F4201000001002F.quest_subtitle: "Mekanism's signature ore."
	quest.4F4201000001002F.title: "Osmium Ingot"
	quest.4F4201000001003A.quest_desc: [
		"The &6QIO Drive Array&r is Mekanism's quantum item ordering system — a parallel storage network to AE2."
		""
		"&aQIO is Mekanism's network storage block.&r Houses QIO drives; players access via QIO dashboards."
	]
	quest.4F4201000001003A.quest_subtitle: "Quantum item storage."
	quest.4F4201000001003A.title: "Purification Chamber"
	quest.4F4201000001003C.quest_desc: [
		"&6PneumaticCraft Plastic&r is the PNC plastic sheet item. Output of the Thermopneumatic Plant via plastic-flavored recipes."
		""
		"Used in PCB and drone assemblies."
	]
	quest.4F4201000001003C.quest_subtitle: "PneumaticCraft polymers."
	quest.4F4201000001003C.title: "Plastic Sheet"
	quest.4F4201000001003D.quest_desc: [
		"The &6Printed Circuit Board&r is PNC's circuit. Etched in acid in the Thermopneumatic Plant."
		""
		"&aRequired for PNC drones and the PNC capstone components.&r"
	]
	quest.4F4201000001003D.quest_subtitle: "PNC's logic layer."
	quest.4F4201000001003D.title: "Printed Circuit Board"
	quest.4F4201000001003E.quest_desc: [
		"The &6Drone&r (PneumaticCraft) is PNC's signature autonomous flying robot. Programmable via the drone widget interface."
		""
		"&aPNC drones can perform complex tasks — harvesting, mining, fighting, building.&r The capstone of PNC's automation chain."
	]
	quest.4F4201000001003E.quest_subtitle: "Autonomous pneumatic logistics."
	quest.4F4201000001003E.title: "Aquatic Catalyst"
	quest.4F4201000001003F.quest_desc: [
		"The &6Electric Pump&r (Mekanism) is the FE-powered fluid pump. Pulls source-block fluids from the world into the network."
		""
		"Higher throughput than vanilla buckets; integrates with Mekanism's pipe network."
	]
	quest.4F4201000001003F.quest_subtitle: "Region C complete - powered fluids."
	quest.4F4201000001003F.title: "Lab Online"
	quest.4F4201000001004A.quest_desc: [
		"&5Kill the Lich.&r The Lich is BMD's first major boss — spectral undead in a tower in cold/snowy biomes."
		""
		"&aDrops the Ancient Anima.&r The first BMD encounter en route to the Obsidilith."
		""
		"&cThe Lich teleports and summons skeleton minions.&r Bring AoE damage and projectile defense."
	]
	quest.4F4201000001004A.quest_subtitle: "The undead king of the tower."
	quest.4F4201000001004A.title: "Slay the Lich"
	quest.4F4201000001004B.quest_desc: [
		"&6Ancient Anima&r is the Lich boss-drop. Reagent for late-IR BMD recipes."
		""
		"Used in the Mob Ward and the Obsidian Heart chain."
	]
	quest.4F4201000001004B.quest_subtitle: "The Lich's essence."
	quest.4F4201000001004B.title: "Ancient Anima"
	quest.4F4201000001004C.quest_desc: [
		"Open the BMD chapter to read about the Void Blossom — the second boss in the BMD progression."
		""
		"&aFound in jungle/swamp variants.&r Fight in dense vegetation."
	]
	quest.4F4201000001004C.quest_subtitle: "Loot from the Lich's tower."
	quest.4F4201000001004C.title: "Sealed Blackstone"
	quest.4F4201000001004D.quest_desc: [
		"&6Void Lily&r is BMD's Void Blossom locator flower (extends FlowerBlock). Place on dirt or grass and it emits particles that point toward the nearest underground Void Blossom cavern (an amethyst-spike-walled cave structure). It does NOT summon the boss — the boss is encountered by entering the structure itself."
		""
		"&aHolding it proves you've engaged with the BMD Overworld track en route to the Obsidilith.&r"
	]
	quest.4F4201000001004D.quest_subtitle: "A flower from the End."
	quest.4F4201000001004D.title: "Void Lily"
	quest.4F4201000001004E.quest_desc: [
		"Open the BMD chapter to read about the Void Blossom's combat mechanics."
		""
		"&aSummons void thorn projectiles and roots that grow from the ground.&r"
	]
	quest.4F4201000001004E.quest_subtitle: "The arena takes shape."
	quest.4F4201000001004E.title: "Void Blossom Block"
	quest.4F4201000001004F.quest_desc: [
		"&5Kill the Void Blossom.&r The Void Blossom is BMD's second major boss — massive flower entity with thorn-projectile and root attacks."
		""
		"&aDrops the Void Thorn.&r"
	]
	quest.4F4201000001004F.quest_subtitle: "A predatory flower of immense power."
	quest.4F4201000001004F.title: "Slay the Void Blossom"
	quest.4F4201000001005A.quest_desc: [
		"The &6Void Thorn&r is the Void Blossom's signature drop. Used in the Obsidian Heart chain."
		""
		"Reagent in late-IR BMD recipes."
	]
	quest.4F4201000001005A.quest_subtitle: "The Blossom's legacy."
	quest.4F4201000001005A.title: "Void Thorn"
	quest.4F4201000001005B.quest_desc: [
		"&5Kill the Gauntlet.&r The Gauntlet is BMD's third major boss — a colossal floating fist with crushing melee attacks."
		""
		"&aDrops the Blazing Eye.&r"
		""
		"&cThe Gauntlet's slam attacks have a wide AoE — don't stand in front of it.&r"
	]
	quest.4F4201000001005B.quest_subtitle: "A Nether-forged colossus."
	quest.4F4201000001005B.title: "Slay the Gauntlet"
	quest.4F4201000001005C.quest_desc: [
		"The &6Blazing Eye&r is the Gauntlet's signature drop — a glowing eye carved from the boss's core."
		""
		"&aThe trophy that proves the Gauntlet is dead.&r"
	]
	quest.4F4201000001005C.quest_subtitle: "The Gauntlet's core."
	quest.4F4201000001005C.title: "Blazing Eye"
	quest.4F4201000001005D.quest_desc: [
		"&6Ancient Carved Blackstone&r (`gauntlet_blackstone`) is the signature structural block of the &cNether Gauntlet arena&r, not the Obsidilith arena. Found alongside Sealed Blackstone Bricks in the underground Nether Gauntlet structure where the Nether Gauntlet boss spawns."
		""
		"&aHolding it proves you've explored the BMD Nether structure en route to the Obsidilith.&r The Obsidilith fight itself gates the IR→Gilded transition."
	]
	quest.4F4201000001005D.quest_subtitle: "Spoils of the arena."
	quest.4F4201000001005D.title: "Gauntlet Blackstone"
	quest.4F4201000001005E.quest_desc: [
		"The &6Charged Ender Pearl&r is BMD's reusable teleport tool — throw it like a regular pearl, but it returns to your inventory and grants brief resistance after teleport (per its own tooltip)."
		""
		"&aA mobility upgrade for the Obsidilith fight — close distance fast and survive the recoil.&r"
	]
	quest.4F4201000001005E.quest_subtitle: "Boss drops converge."
	quest.4F4201000001005E.title: "Charged Ender Pearl"
	quest.4F4201000001005F.quest_desc: [
		"&6Brimstone Nectar&r is BMD's hellfire-flavored consumable. Crafted shapeless from a netherite scrap, dragon breath, and a ghast tear."
		""
		"&aUse on the Obsidilith arena to reset the boss structure for retries (per its own tooltip: \"Resets nearby boss structures on use\").&r"
	]
	quest.4F4201000001005F.quest_subtitle: "Liquid fire, distilled."
	quest.4F4201000001005F.title: "Brimstone Nectar"
	quest.4F420100000100A1.quest_desc: [
		"The &6Crystal Fruit&r is a BMD ambient consumable — restores HP and provides minor regeneration."
		""
		"Useful pre-fight buff before the Obsidilith encounter."
	]
	quest.4F420100000100A1.quest_subtitle: "End-grown sustenance."
	quest.4F420100000100A1.title: "Crystal Fruit"
	quest.4F420100000100A3.quest_desc: [
		"The &6Obsidilith Rune&r is one of the structural blocks of the Obsidilith arena — part of the natural End worldgen, not normally crafted."
		""
		"In the worldgen Obsidilith arena, the Rune links to the boss and powers its boss-bar / audio cues during the fight."
	]
	quest.4F420100000100A3.quest_subtitle: "Etched in void-stone."
	quest.4F420100000100A3.title: "Obsidilith Rune"
	quest.4F420100000100A4.quest_desc: [
		"&5Kill the Obsidilith.&r &cThis is the IR age gate.&r The Obsidilith is the Bosses of Mass Destruction capstone — a colossal obsidian monolith that floats above its End-spawning frame."
		""
		"&aKilling the Obsidilith flips the &6Gilded Age&r&a stage, unlocking the next age's content.&r Everything you've built in IR — the factories, the magic workshops, the dimensional gear — was preparation for this moment."
		""
		"&cHigh HP, ranged attacks, summons mob waves during phases.&r Bring your best gear, plenty of healing, and a strategy. The Obsidilith doesn't go down easy."
	]
	quest.4F420100000100A4.quest_subtitle: "The battle that ends an era."
	quest.4F420100000100A4.title: "Slay the Obsidilith"
	quest.4F420100000100A6.quest_desc: [
		"The &6Obsidian Heart&r is the Obsidilith's signature drop — the boss's core, condensed into a usable artifact."
		""
		"&aThe trophy that proves you've cleared IR.&r Used in early-Gilded recipes and as a mantelpiece."
	]
	quest.4F420100000100A6.quest_subtitle: "The Obsidilith's core."
	quest.4F420100000100A6.title: "Obsidian Heart"
	quest.4F420100000100A7.quest_desc: [
		"The &6Mob Ward&r is a BMD utility item — placed in the world, it repels hostile mobs in a radius."
		""
		"Useful for protecting outposts and farms without walls."
	]
	quest.4F420100000100A7.quest_subtitle: "Silence around the forge."
	quest.4F420100000100A7.title: "Mob Ward"
	quest.4F420100000100A8.quest_desc: [
		"The &6Monolith Block&r is a BMD-themed decorative block — obsidian-flavored, used in monumental builds."
		""
		"Cosmetic; pairs with Obsidilith trophy displays."
	]
	quest.4F420100000100A8.quest_subtitle: "Obsidian, perfected."
	quest.4F420100000100A8.title: "Monolith Block"
	quest.4F420100000100A9.quest_desc: [
		"The &6Earthdive Spear&r is BMD's high-mobility weapon — throw to launch yourself across distance."
		""
		"&aCombat + traversal in one item.&r Drops from BMD encounters."
	]
	quest.4F420100000100A9.quest_subtitle: "A weapon from the deep."
	quest.4F420100000100A9.title: "Earthdive Spear"
	quest.4F420100000100AA.quest_desc: [
		"The &6Levitation Block&r is a BMD utility — place to create temporary floating platforms."
		""
		"Useful in vertical builds and aerial combat staging."
	]
	quest.4F420100000100AA.quest_subtitle: "Defy gravity."
	quest.4F420100000100AA.title: "Levitation Block"
	quest.4F420100000100B1.quest_desc: [
		"The &6Hephaestus Forge T2&r is the second-tier upgrade of FA's signature multiblock forge. Unlocks T2 ritual recipes (deorum, advanced wands)."
		""
		"&aFA progression is forge-tier-driven.&r Each tier opens new artifacts and components."
	]
	quest.4F420100000100B1.quest_subtitle: "T2 — the foundation of ascension."
	quest.4F420100000100B1.title: "The Second Forge"
	quest.4F420100000100B2.quest_desc: [
		"The &6Darkstone Pedestal&r is FA's ritual pedestal — place reagents on top during Hephaestus Forge rituals."
		""
		"Required for most T2+ forge recipes."
	]
	quest.4F420100000100B2.quest_subtitle: "Ritual infrastructure."
	quest.4F420100000100B2.title: "Darkstone Pedestal"
	quest.4F420100000100B3.quest_desc: [
		"&6Chiseled Polished Darkstone&r is FA's decorative polished darkstone. Used in temple-aesthetic builds and a couple of forge recipes."
		""
		"Cosmetic + reagent."
	]
	quest.4F420100000100B3.quest_subtitle: "The ritual's main ingredient."
	quest.4F420100000100B3.title: "Chiseled Polished Darkstone"
	quest.4F420100000100B4.quest_desc: [
		"The &6Xpetrified Orb&r is FA's mid-tier ritual material — a petrified XP-essence orb."
		""
		"Used in rituals that require player-experience reagents."
	]
	quest.4F420100000100B4.quest_subtitle: "Crystallized experience."
	quest.4F420100000100B4.title: "Xpetrified Orb"
	quest.4F420100000100B6.quest_desc: [
		"The &6Aureal Tank&r is FA's bulk mana storage block. Stores far more Aureal than individual bottles."
		""
		"Pair with Aureal Wardstones and the Hephaestus Forge for serious mana economy."
	]
	quest.4F420100000100B6.quest_subtitle: "Store the impossible."
	quest.4F420100000100B6.title: "Aureal Tank"
	quest.4F420100000100B7.quest_desc: [
		"The &6Netherite Blacksmith Gavel&r is FA's top-IR-tier hammer. Required for T3+ forge rituals."
		""
		"&aThe gating gavel for advanced forge recipes.&r"
	]
	quest.4F420100000100B7.quest_subtitle: "The final strike."
	quest.4F420100000100B7.title: "Netherite Blacksmith Gavel"
	quest.4F420100000100BA.quest_desc: [
		"The &6Hephaestus Forge T3&r is the third-tier upgrade of the forge multiblock. Unlocks T3 rituals (elementarium, spectral eye amulet, advanced gavels)."
		""
		"&aTop-tier FA multiblock for the IR era.&r T4-T5 unlock in later ages."
	]
	quest.4F420100000100BA.quest_subtitle: "Region F complete — the forge ascends."
	quest.4F420100000100BA.title: "The Third Forge Lit"
	quest.4F420100000100C0.quest_desc: [
		"&6Vibrant Alloy Ingots&r are EnderIO's high-tier alloy. Made by infusing energetic alloy with ender pearls in the EIO Alloy Smelter."
		""
		"&aTop-tier EnderIO IR alloy.&r Used in HV cables, advanced capacitors, and the late-IR EIO machines."
	]
	quest.4F420100000100C0.quest_subtitle: "Ender IO's vibrant alloy bridges the gap."
	quest.4F420100000100C0.title: "Industrial Convergence"
	quest.4F420100000100E1.quest_desc: [
		"The &6Entro Cluster&r is Extended AE2's exotic crystal cluster — an addon's signature growth-flavored crystal."
		""
		"&aExtended AE2 adds Mega-tier components beyond vanilla AE2's 256k cap.&r The Entro chain feeds into mega-tier storage."
	]
	quest.4F420100000100E1.quest_subtitle: "ExtendedAE's exotic crystal."
	quest.4F420100000100E1.title: "64k Storage Cell"
	quest.4F420100000100E2.quest_desc: [
		"&6Electron Tubes&r are IE's vacuum-tube electrical components. Used in mid-tier IE circuit and capacitor recipes."
		""
		"Made via specific IE Arc Furnace recipes."
	]
	quest.4F420100000100E2.quest_subtitle: "Vacuum-era electronics."
	quest.4F420100000100E2.title: "Electron Tube"
	quest.4F420100000100E3.quest_desc: [
		"The &6Crystal Assembler&r (Extended AE2) is the addon's automated crystal-growth machine. Faster than vanilla AE2's growth accelerators."
		""
		"&aIndispensable for mass crystal production at the IR_final scale.&r"
	]
	quest.4F420100000100E3.quest_subtitle: "Automated crystal growth."
	quest.4F420100000100E3.title: "Wireless Terminal"
	quest.4F420100000100E4.quest_desc: [
		"The &6IE Circuit Board&r is Immersive Engineering's circuit substrate. Used in the IE Logic Circuit and several mid-tier multiblock recipes."
		""
		"Made at the Engineer's Workbench."
	]
	quest.4F420100000100E4.quest_subtitle: "Blank control substrate."
	quest.4F420100000100E4.title: "Circuit Board"
	quest.4F420100000100E5.quest_desc: [
		"The &6IE Logic Circuit&r is Immersive Engineering's processor analog. Required for HV multiblocks (Excavator, Mixer, Arc Furnace)."
		""
		"&aThe gating component for IE's late-IR machines.&r"
	]
	quest.4F420100000100E5.quest_subtitle: "Completed control logic."
	quest.4F420100000100E5.title: "Logic Circuit"
	quest.4F420100000100E6.quest_desc: [
		"The &6Mega Crafting Accelerator&r (MegaCells) is the addon's high-throughput AE2 crafting accelerator. Vastly more recipes per tick than vanilla AE2 accelerators."
		""
		"&aRequired for serious autocrafting at the late-IR scale.&r"
	]
	quest.4F420100000100E6.quest_subtitle: "Region D complete — MEGA scale."
	quest.4F420100000100E6.title: "Network Crystallized"
	quest.4F420100000100E7.title: "Region: Industrial Trials"
	quest.4F420100000100E8.title: "Region: Obsidilith Convergence"
	quest.4F43010000010001.quest_desc: [
		"Hold the &6Accelerator Controller&r, then place it to anchor the Atomic-tier &6Particle Accelerator&r build."
		""
		"This chapter folds Oritech together with Mekanism, Modern Dynamics, EnderIO, and Create — borrowing components from each to build the engineering spine's apex hardware: the accelerator, the Oritech reactor, and Prometheum-tier devices."
		""
		"&5Atomic Oritech is where the engineering spine touches the science spine. Both the Time Tyrant's death and the Gilded Oritech capstone gate this chapter.&r"
	]
	quest.4F43010000010001.title: "Atomic Convergence"
	quest.4F43010000010003.quest_desc: [
		"Right-click the Particle Accelerator three times to cycle through recipes."
		""
		""
	]
	quest.4F43010000010003.title: "Cycle the Accelerator"
	quest.4F43010000010005.quest_desc: [
		"&6Fluxite&r is Oritech's flux-bearing crystal — produced by processing enderic and energite materials. The signature input to the Particle Accelerator's Overcharged Crystal recipe."
		""
		"Without fluxite there's no overcharged crystal; without overcharged crystal there's no Prometheum. This is the chapter's first hard ingredient gate."
	]
	quest.4F43010000010006.quest_desc: ["The &6Fluxite Block&r — nine fluxite packed for storage. Useful once your accelerator pipeline is consuming fluxite by the stack."]
	quest.4F4301000001000A.quest_desc: ["Place an &6Accelerator Magnetic Field&r block to extend the accelerator's particle-bending capability. Required for the high-energy recipes that demand a tighter or stronger magnetic confinement than the base ring provides."]
	quest.4F4301000001000A.title: "Magnetic Containment"
	quest.4F4301000001000B.quest_desc: ["&6Platinum Dust&r — the powder form of platinum, used in centrifuge processing and as a precursor to platinum-bearing alloys. The dust form is what you need for several Atomic-tier accelerator recipes."]
	quest.4F43010000010011.quest_desc: [
		"The &6Plutonium Pellet&r is Oritech's reactor fuel — synthesized from uranium pellets in a working accelerator setup. Required input for Oritech's reactor's high-energy fuel rods."
		""
		"This is the bridge between the accelerator chain and Oritech's reactor chain. The accelerator makes fuel; the reactor burns it; the cycle keeps the convergence chapter humming."
	]
	quest.4F43010000010015.quest_desc: [
		"Use the &6Atomic Forge&r at Atomic-tier — the same forge from Gilded, but now you're feeding it overcharged crystals and prometheum precursors instead of basic chips and ingots."
		""
		"Most apex Oritech recipes funnel through the Atomic Forge. By this point in the convergence chapter the forge is one of your highest-throughput machines."
	]
	quest.4F43010000010015.title: "Atomic Forge (Advanced)"
	quest.4F43010000010016.quest_desc: [
		"&6Prometheum Ingot&r is the apex Oritech ingot — synthesized in the Atomic Forge from a Heisenberg Compensator and two Overcharged Crystals. The single hardest recipe in AoA's engineering spine (MI → Oritech → Mekanism → AE2)."
		""
		"This ingot is what gates the Machine Core 7 and the chapter capstone. By the time you're producing prometheum, you have working accelerator + working chip ladder + working chip-to-ingot pipeline all running together."
		""
		"&aThe science spine (PowerGrid → Electrodynamics → Chemical Science → Nuclear Science → Ballistix) runs in parallel from Gilded onward; prometheum is the engineering-spine apex, not the only Atomic milestone.&r"
	]
	quest.4F43010000010017.quest_desc: [
		"&6Machine Core 7&r is Oritech's apex machine core — the seventh-tier core, gated behind Prometheum. Anything that wants Core 7 in its recipe is convergence-tier hardware."
		""
		"This is the Atomic-tier upgrade to the Core 6 stack from the deep-machine chapter. Core 7 unlocks the &6Reactor Controller&r, the apex augments and addons, and several of the highest devices in the specialty chapter."
		""
		"&5The Atomic-tier structural capstone.&r"
	]
	quest.4F43010000010019.quest_desc: ["The &6Mekanism Advanced Control Circuit&r — second tier of Mekanism's circuit ladder. Shows up in the apex Mekanism machines and as a recipe ingredient in some Atomic Oritech crossovers."]
	quest.4F4301000001001A.quest_desc: ["The &6Mekanism Elite Control Circuit&r — third tier of Mekanism's circuit ladder. Gated behind Mekanism's Atomic Disassembler / fission tech."]
	quest.4F4301000001001B.quest_desc: [
		"The &6Mekanism Ultimate Control Circuit&r — apex of the Mekanism circuit ladder. The Atomic-tier crossover ingredient and a proof that Mekanism's fusion-era tech is online."
		""
		"&5Mekanism's full circuit chain run end-to-end. With this in hand, the engineering spine has reached cross-mod parity at the very top.&r"
	]
	quest.4F4301000001001D.quest_desc: [
		"&6Refined Obsidian Dust&r is Mekanism's Atomic-tier obsidian variant — produced via Mekanism's Atomic Disassembler / chemical infuser pipeline. Hold one to confirm your Mekanism stack has progressed to its high-tier processing."
		""
		"Used as a recipe ingredient in several Atomic Oritech crossover recipes."
	]
	quest.4F4301000001001D.title: "Refined Obsidian Dust"
	quest.4F43010000010020.quest_desc: [
		"The &6EnderIO Energetic Alloy Ingot&r is EnderIO's signature mid-tier alloy — high conductivity, used in Energy Conduits and several apex devices. Some Atomic Oritech recipes accept Energetic Alloy as a substitute for similar-tier Oritech alloys."
		""
		"&aThe convergence chapter rewards multi-mod players. Each cross-mod ingredient confirms a parallel tech tree is online.&r"
	]
	quest.4F43010000010020.title: "Energetic Alloy"
	quest.4F43010000010023.quest_desc: ["&6Heisenberg Compensator&r reappears as a held proof at Atomic tier — the chapter consumes them in Prometheum synthesis. Held copies confirm the compensator pipeline is feeding the Atomic Forge directly."]
	quest.4F43010000010025.quest_desc: [
		"Use a &6Drone Port&r at Atomic tier — by now drones should be hauling materials between the accelerator, Oritech's reactor, and the rest of your base autonomously."
		""
		"&aDrone delivery is the cleanest substitute for laying physical pipes through a sprawling Atomic-tier base.&r"
	]
	quest.4F43010000010025.title: "Atomic Drone Port"
	quest.4F43010000010026.quest_desc: [
		"The &6Reactor Wall&r is the structural block of Oritech's &6Reactor&r multiblock — fissionable-fuel-burning, FE-output, the engineering spine's Atomic-tier reactor."
		""
		"This is the entry to Oritech's reactor branch. Walls form the chamber; fuel rods, control rods, and the controller go inside; ports route fuel in and energy out."
		""
		"&aOritech's reactor coexists with Mekanism's, Nuclear Science's, and Create Nuclear's — they're all valid, none replaces the others.&r"
	]
	quest.4F43010000010027.quest_desc: [
		"The &6Reactor Rod&r is the basic fuel rod for Oritech's reactor — holds a uranium or plutonium pellet, places into the reactor's core, sustains the fission reaction."
		""
		"Single-rod outputs are modest. Stack rods (double, quad) for higher output at the cost of more cooling demand."
	]
	quest.4F43010000010028.quest_desc: ["The &6Reactor Double Rod&r is two fuel rods bundled — twice the output, twice the heat to manage. Sit between basic rods and the apex Quad."]
	quest.4F4301000001002A.quest_desc: ["The &6Reactor Reflector&r bounces neutrons back into the fuel rods — increases reaction rate without adding more fuel. Used as inner-wall blocks in optimized reactor designs."]
	quest.4F4301000001002C.quest_desc: ["The &6Reactor Fuel Port&r is the input face of Oritech's reactor — pipe fuel rods in here, the reactor consumes them automatically as the existing rods deplete."]
	quest.4F4301000001002F.quest_desc: [
		"The &6Reactor Condenser&r turns reactor heat into a cooling fluid back into a workable thermal cycle. Sit between heat pipes (input) and vents (output)."
		""
		"Combined with steam_boiler_addon, condensers turn reactor heat into useful power. Pure cooling without conversion is wasted heat."
	]
	quest.4F43010000010031.quest_desc: [
		"The &6Reactor Absorber Port&r is the control-rod insertion face — drop neutron-absorbing rods in to throttle or shut down the reaction."
		""
		"Critical for safe shutdowns and for tuning reactor output to current demand."
	]
	quest.4F43010000010032.quest_desc: ["The &6Reactor Redstone Port&r exposes reactor state as a redstone signal — temperature, fuel level, output rate. Lets you tie reactor behavior into broader base automation (auto-shutoff on overheat, fuel resupply on depletion)."]
	quest.4F43010000010033.quest_desc: [
		"The &6Steam Boiler Addon&r converts the Oritech reactor's heat directly into steam for downstream turbines — turning a bare-FE reactor into a steam-cycle reactor with higher overall efficiency."
		""
		"&aThe steam path is the high-efficiency option. Slightly more complicated to set up, considerably better lifetime FE per fuel rod.&r"
	]
	quest.4F43010000010034.quest_desc: [
		"Place a complete &6Reactor Controller&r — adjacent to a sealed Oritech reactor chamber containing fuel rods, reflector blocks, condenser/heat-pipe cooling, and an absorber port for shutdown control. Requires all the structural quests above to be cleared."
		""
		"This is Oritech's reactor commissioning quest. Once placed and validated, Oritech's reactor goes online and starts converting nuclear fuel into FE."
		""
		"&5The Oritech reactor capstone. The engineering spine's Atomic-tier reactor is now live; Mekanism's fission/fusion reactor, Nuclear Science's reactors, and Create Nuclear's reactor remain as parallel paths.&r"
	]
	quest.4F43010000010034.title: "Reactor Online"
	quest.4F43010000010035.quest_desc: [
		"&6Deepslate Uranium Ore&r — Oritech's worldgen uranium ore. Found at deepslate depths, drops raw uranium when mined."
		""
		"This branch of the chapter walks the uranium chain from raw ore to small pellet, full pellet, and ultimately small plutonium pellets that feed Oritech's reactor."
	]
	quest.4F43010000010036.quest_desc: ["&6Raw Uranium&r — what the deepslate uranium ore drops. Smelt or process it into uranium dust, then into pellets."]
	quest.4F43010000010037.quest_desc: ["&6Uranium Dust&r — the powder form of uranium, ready for pellet pressing. Centrifuge or pulverizer output depending on which mod processes it."]
	quest.4F43010000010038.quest_desc: ["The &6Small Uranium Pellet&r — first pellet form. Pressed from uranium dust. Combine multiple smalls to make a full Uranium Pellet."]
	quest.4F43010000010039.quest_desc: [
		"The &6Uranium Pellet&r is a full-size fissile pellet — fits into a Reactor Rod and feeds a working reactor."
		""
		"This is the standard reactor fuel. Plutonium pellets are the next tier; mixed-oxide loadouts use both."
	]
	quest.4F4301000001003A.quest_desc: ["The &6Small Plutonium Pellet&r — produced by transmuting uranium pellets in a working accelerator. The transition from uranium-fueled reactor to plutonium-fueled reactor."]
	quest.4F4301000001003C.quest_desc: [
		"The &6Mekanism Plutonium Pellet&r is the equivalent fuel for Mekanism's reactor stack — produced via the Mekanism plutonium pipeline rather than the Oritech accelerator."
		""
		"Cross-mod note: both pellets exist. Each reactor stack uses its own. They're not interchangeable, but having both means redundancy across two parallel nuclear systems."
	]
	quest.4F43010000010060.quest_desc: [
		"The convergence capstone — place a working &6Particle Accelerator&r and a working &6Reactor&r, hold a &6Prometheum Ingot&r. All three together prove you've integrated the full Atomic Oritech stack."
		""
		"This is the chapter's exit gate. Atomic Oritech is now complete: accelerator producing crystals, reactor producing power, Prometheum bridging both into the apex tier of the engineering spine."
		""
		"&5The engineering spine has reached its convergence. Mekanism, EnderIO, Modern Dynamics, Create — all hooked in. Specialty Oritech is next.&r"
	]
	quest.4F43010000010060.title: "Convergence Achieved"
	quest.4F44010000010002.quest_desc: [
		"&6Enderic Compound&r is Oritech's mid-tier dimensional material — synthesized in the Atomic Forge from ender-pearl-tier inputs. The precursor to the Enderic Lens and the Flux Gate."
		""
		"This block of the chapter handles end-tier composites. Compound here, lens and gate next, then the Dubios Container that holds them together."
	]
	quest.4F44010000010004.quest_desc: [
		"The &6Flux Gate&r is Oritech's high-throughput power valve — built from Enderic Compound, Processing Unit, fluxite, and platinum. Sits between high-power generators and high-draw machines as a regulated pass-through."
		""
		"Several apex Oritech recipes (Unstable Container, Particle Accelerator components, the apex generator stack) consume Flux Gates by the handful. Worth automating."
	]
	quest.4F44010000010005.quest_desc: [
		"The &6Dubios Container&r is Oritech's tongue-in-cheek named storage for &6unstable&r materials — a reinforced reservoir for items that don't behave well sitting in normal inventories."
		""
		"Used as a recipe ingredient in the Augment Application Block and the high-tier storage line. The name is a joke; the item is genuinely necessary."
	]
	quest.4F4401000001000D.quest_desc: [
		"Right-click an &6Atomic Forge&r once to confirm the GUI is wired up and you understand the recipe interface. The forge's UI shows current job, queued recipes, and energy state."
		""
		"&aOnce you've poked around the GUI, set up auto-feed inputs for your two highest-volume recipes (silicon wafers and Processing Units, typically) and let it run.&r"
	]
	quest.4F4401000001000D.title: "Atomic Forge Online"
	quest.4F44010000010012.quest_desc: [
		"&6Machine Core 5&r — built from adamant ingot and an Advanced Computing Engine. The fifth-tier core in Oritech's gating ladder, used in Advanced-tier specialty machines."
		""
		"Sit between Core 4 (mid-tier) and Core 6 (apex). Once you can produce these reliably, the rest of the chapter unfolds smoothly."
	]
	quest.4F44010000010013.quest_desc: ["The &6Large Storage Block&r is the apex storage frame in the chapter — the bigger sibling of the Small Storage Block, used as a structural component in the Unstable Container and similar high-tier reservoir blocks."]
	quest.4F44010000010014.quest_desc: [
		"&6Machine Core 6&r is Oritech's apex core — the top of the numbered ladder. Anything that wants Core 6 in its recipe is endgame-tier hardware."
		""
		"This unlocks the Machine Extender line, Atomic-tier addons, and the chapter's Ultimate Addon recipe. By the time you're stamping these out, your Atomic Forge stack is humming."
		""
		"&5The chapter's structural capstone. Beyond this lies the Particle Accelerator and the Atomic-tier convergence chapter.&r"
	]
	quest.4F44010000010016.quest_desc: [
		"The &6Capacitor Addon Extender&r is the Machine-Extender variant that specifically expands capacitor capacity — for machines that need a deeper energy buffer than a standard Capacitor Addon provides."
		""
		"Niche but useful when running burst-load Atomic-tier recipes."
	]
	quest.4F44010000010018.quest_desc: [
		"&6Raw Platinum&r is Oritech's mid-game ore — found at deepslate depths in worldgen. The entry point to the platinum and duratium chains."
		""
		"Several apex Oritech recipes (the Flux Gate, Duratium Ingot synthesis) want platinum somewhere in the chain. Mine a stockpile."
	]
	quest.4F44010000010019.quest_desc: ["The &6Platinum Ingot&r — the smelted/refined form of raw platinum. Used directly in the Flux Gate recipe and as a precursor in the Duratium synthesis chain."]
	quest.4F4401000001001C.quest_desc: ["The &6Duratium Block&r — nine duratium ingots packed for storage. Worth automating once you start consuming duratium by the stack."]
	quest.4F4401000001001D.quest_desc: [
		"The &6Superconductor&r is Oritech's lossless electrical conductor — built from Flux Gate and Dubios Container precursors. The signature material of the &6Particle Accelerator&r ring."
		""
		"Every accelerator ring segment, every collector block, and several apex Atomic-tier devices sit on top of superconductor. By the time you've made one, you're committed to the accelerator build."
		""
		"&aBatch-craft these. The accelerator's ring alone wants several.&r"
	]
	quest.4F4401000001001E.quest_desc: ["The &6Framed Superconductor&r is the encased version of the bare superconductor — what gets used in the accelerator's structural sections to keep the magnetic field stable."]
	quest.4F4401000001001F.quest_desc: ["The &6Superconductor Duct Block&r is Oritech's apex power conduit — moves FE without loss across long distances. The infrastructure pipe for high-power Atomic-tier setups."]
	quest.4F44010000010020.quest_desc: [
		"The &6Accelerator Ring&r is the curved track that particles travel along inside the multiblock &6Particle Accelerator&r. Each ring segment is one quarter of the loop; you'll need several to close the circuit."
		""
		"This is the structural core of the accelerator multiblock. Pair with the Motor (drive), Sensor (instrumentation), and Controller (logic) to assemble a working accelerator."
	]
	quest.4F44010000010021.quest_desc: [
		"The &6Accelerator Motor&r is the drive segment of the Particle Accelerator — provides the kick that pushes particles around the ring."
		""
		"One of the four named accelerator components. Without it the ring is geometry; with it the ring is a working physics experiment."
	]
	quest.4F44010000010023.quest_desc: [
		"The &6Accelerator Sensor&r reads the particle stream's state — speed, energy, position. Required for the Controller to know what's happening inside the ring."
		""
		"&aWithout a sensor, the Controller is blind. Don't skip this one.&r"
	]
	quest.4F44010000010024.quest_desc: [
		"The &6Particle Collector Block&r catches particles after collision and turns the impact into recipe outputs — Overcharged Crystals, exotic dusts, and similar accelerator-only materials."
		""
		"This is the output face of the Particle Accelerator multiblock. Recipes from the Controller's UI deposit their products through this block."
		""
		"&5The accelerator multiblock is one of Oritech's most spectacular setups — a real working physics experiment that justifies the engineering spine's reputation.&r"
	]
	quest.4F44010000010026.quest_desc: [
		"The &6Magnetic Field&r block (from Oritech Things, the Atomic-tier expansion) extends the accelerator's particle-bending capabilities — used in advanced collider configurations."
		""
		"&7Niche but useful for high-energy accelerator builds in the convergence chapter.&r"
	]
	quest.4F44010000010027.quest_desc: ["The &6Particle Accelerator Speed Sensor&r (Oritech Things) is a precision instrument that reports the current speed of particles in the accelerator ring — used in the more advanced collider recipes that gate on minimum particle velocity."]
	quest.4F44010000010029.quest_desc: [
		"Place an &6Advanced Augment Station&r to confirm it's wired up. The Atomic Oritech specialty chapter wants you to actually deploy one in the world, not just hold a crafted copy."
		""
		"This station handles tier-2 augments and feeds the Atomic-tier addon recipes in the next batch of quests."
	]
	quest.4F44010000010029.title: "Advanced Augmentation"
	quest.4F44010000010034.quest_desc: [
		"Place a &6Drone Port Block&r to confirm Oritech's drone system is online — drones launch from this block, fly to a target designator, and execute their loaded job (delivery, mining, attack)."
		""
		"This is Oritech's autonomous-agent system. Drones extend automation beyond the bounds of fixed conveyors and pipes."
		""
		"&aPair with the Advanced Target Designator in the next quest for the most precise drone job-routing.&r"
	]
	quest.4F44010000010034.title: "Drone Logistics"
	quest.4F44010000010035.quest_desc: [
		"The &6Advanced Target Designator&r (Oritech Things) is the precision-tier of the standard Target Designator — paint a position with sub-block accuracy for drone delivery or laser strike."
		""
		"&aCombines beautifully with the Drone Port for a closed-loop autonomous logistics network.&r"
	]
	quest.4F44010000010036.quest_desc: [
		"The &6Frame Placer&r (Oritech Things) is a quality-of-life device for placing machine-frame structures in bulk — useful when building large multiblock setups or replicating a layout."
		""
		"&7Optional QOL.&r"
	]
	quest.4F44010000010037.quest_desc: ["The &6Speed Tier 2 Addon Block&r (Oritech Things) is the apex form of the Speed Addon — block-shaped for higher throughput, slotted into machines that already have basic speed augments and need more."]
	quest.4F44010000010038.quest_desc: ["The &6Efficiency Tier 2 Addon Block&r (Oritech Things) is the apex Efficiency variant — pairs with the Speed Tier 2 to get fast, sustainable throughput at Atomic levels."]
	quest.4F44010000010039.quest_desc: ["The &6Capacitor Tier 2 Addon Block&r (Oritech Things) — the apex form of the Capacitor Addon. Larger internal energy buffer for machines that need to absorb burst loads."]
	quest.4F4401000001003A.quest_desc: ["The &6Acceptor Tier 2 Addon Block&r (Oritech Things) — apex Acceptor variant. Higher max input rate for high-throughput machines plugged into apex generators."]
	quest.4F4401000001003B.quest_desc: ["The &6Processing Tier 2 Addon Block&r (Oritech Things) — apex Processing variant. Bigger batches per cycle for production machines."]
	quest.4F4401000001003C.quest_desc: [
		"The &6Efficient Speed Tier 2 Addon Block&r (Oritech Things) is the bundled Speed + Efficiency apex augment — one block instead of two slots, freeing up augment capacity for specialty addons."
		""
		"This is the apex of the bundled-augment line. Slot it into your highest-throughput machine and stop tuning."
	]
	quest.4F44010000010050.quest_desc: [
		"Hold &6Machine Core 6&r to clear the deep-machine chapter — proof that you've integrated the chip ladder, the platinum/duratium chain, the superconductor line, and Atomic-tier addons all at once."
		""
		"This is the chapter capstone. Beyond it lies &6Atomic Oritech Convergence&r and &6Atomic Oritech Specialty&r — the Atomic-tier expansion of the engineering spine."
		""
		"&5Gilded Oritech is complete. The engineering spine has built every base machine, every augment, every chip the rest of the pack will demand.&r"
	]
	quest.4F44010000010050.title: "Deep Machine Mastery"
	quest.4F47010000010001.quest_desc: [
		"&6Raw Silicon&r is the entry point to Oritech's electronics chain. You'll find it in worldgen as a stone-tier ore, smelt or refine it to get usable silicon, then push it through wafer and crystal processing to build chips."
		""
		"This is the engineering spine's Gilded-era contribution. Everything in this chapter sits on top of silicon — processors, computing engines, augment hardware, exo armor."
		""
		"&aSilicon ore worldgen is intentionally generous. Stockpile early; the wafer chain wants a lot of it.&r"
	]
	quest.4F47010000010001.quest_subtitle: "The electronics era begins."
	quest.4F47010000010001.title: "Silicon Awakens"
	quest.4F47010000010002.quest_desc: [
		"&6Silicon&r is what you get when raw silicon hits a furnace or the Oritech refinery. It's the workable form — the grade that actually ends up in chips."
		""
		"From here the chain branches: silicon blocks for storage, silicon wafers for the processor recipe."
	]
	quest.4F47010000010002.quest_subtitle: "Refined from raw."
	quest.4F47010000010002.title: "Silicon"
	quest.4F47010000010003.quest_desc: ["The &6Silicon Block&r — nine silicon ingots packed for compact storage. As silicon flows through the electronics chain in larger and larger quantities, blocks become the natural unit of bulk storage."]
	quest.4F47010000010003.title: "Block of Silicon"
	quest.4F47010000010004.quest_desc: [
		"The &6Silicon Wafer&r is processed silicon ready for chip etching — produced by the &6Atomic Forge&r or by &6Centrifuge&r-style fluid processing of silicon."
		""
		"Wafers feed every higher-tier electronic in the chapter. The Processing Unit recipe alone wants two of them, and the Advanced Computing Engine wants two more. Plan for steady throughput."
	]
	quest.4F47010000010004.quest_subtitle: "Substrate for every chip."
	quest.4F47010000010004.title: "Silicon Wafer"
	quest.4F47010000010005.quest_desc: [
		"&6Silicon Wash&r is a fluid byproduct of wafer processing — collected here as a bucket. It feeds back into the silicon-wafer cycle when you start running the centrifuge fluid pipeline at scale."
		""
		"&7One bucket is enough to prove the loop is working. After that, automate the fluid output into a Black Hole Tank or Oritech tank.&r"
	]
	quest.4F47010000010005.quest_subtitle: "Chemical purification step."
	quest.4F47010000010005.title: "Silicon Wash"
	quest.4F47010000010007.quest_desc: [
		"The &6Processing Unit&r is Oritech's first real chip — an Assembler recipe of plastic plate, carbon fibre, electrum, and redstone. Once you have one, the entire automation tree opens."
		""
		"Almost every Oritech machine that does logistics, automation, or augment work uses this chip somewhere. Item Filter Block, Placer Block, Charger, Fertilizer — all of them want a Processing Unit."
		""
		"&aBatch-craft these. Demand only goes up.&r"
	]
	quest.4F47010000010007.quest_subtitle: "Oritech's CPU."
	quest.4F47010000010007.title: "Processing Unit"
	quest.4F47010000010008.quest_desc: [
		"The &6Super AI Chip&r is Oritech's tier-3 processor — the Atomic Forge welds duratium ingot to two Advanced Computing Engines. The chip does the AI/decision-making in higher-tier machines."
		""
		"&7Hold one to prove production. The Heisenberg Compensator above it is your real goal.&r"
	]
	quest.4F47010000010008.quest_subtitle: "Computing core."
	quest.4F47010000010008.title: "Super AI Chip"
	quest.4F47010000010009.quest_desc: [
		"The &6Advanced Computing Engine&r — the Atomic Forge takes a Processing Unit and two Silicon Wafers and produces this. It's the second-tier chip and the precursor to the Super AI Chip."
		""
		"This sits in the middle of Oritech's chip ladder: Processing Unit → Advanced Computing Engine → Super AI Chip → Heisenberg Compensator → Prometheum. Every step demands the previous chip plus exotic ingredients."
	]
	quest.4F47010000010009.title: "Advanced Computing Engine"
	quest.4F4701000001000A.quest_desc: [
		"The &6Heisenberg Compensator&r is Oritech's fourth-tier chip — Atomic Forge of one Super AI Chip plus two adamant ingots. The named-after-physics-jokes tier of the chain."
		""
		"It feeds the Prometheum recipe and gates a handful of the apex augments and devices in Oritech. By the time you can craft these, you're at the top of the engineering spine's electronics chain."
		""
		"&aThe whole chip ladder converges on Prometheum and Unholy Intelligence. This compensator is the second-to-last step.&r"
	]
	quest.4F4701000001000A.quest_subtitle: "Neural processor."
	quest.4F4701000001000A.title: "Heisenberg Compensator"
	quest.4F4701000001000B.quest_desc: [
		"&6Unholy Intelligence&r is the apex of Oritech's chip line — the Heisenberg Compensator pushed through one more synthesis step. The name is a wink: this is the chip that goes into the AI-driven endgame devices."
		""
		"It feeds the &6Ultimate Addon&r recipe, the &6Portal&r device, and the chapter capstone. Anything that needs Oritech to think for itself uses one of these."
		""
		"&5The pinnacle of the engineering spine's processor stack.&r"
	]
	quest.4F4701000001000B.quest_subtitle: "Region A capstone."
	quest.4F4701000001000B.title: "Unholy Intelligence"
	quest.4F4701000001000C.quest_desc: [
		"The &6Speed Addon&r is the gateway to Oritech's machine-augment system — slot it into a machine to make that machine work faster, at the cost of more power per cycle."
		""
		"Augments are how Oritech machines specialize. A base machine is a generic worker; an augmented machine is a tuned tool. Speed is the most universally useful augment, so this is almost always the first one you build."
		""
		"&aMost Oritech machines have multiple augment slots. Mix Speed with Efficiency for sustainable throughput.&r"
	]
	quest.4F4701000001000C.quest_subtitle: "Region B entry."
	quest.4F4701000001000C.title: "Speed Addon"
	quest.4F4701000001000D.quest_desc: [
		"The &6Efficiency Addon&r reduces a machine's power-per-cycle cost — the natural counterweight to Speed. Pair them and you get fast, sustainable processing."
		""
		"This is the second augment most builds adopt. After Speed and Efficiency are slotted, augment choices start being machine-specific."
	]
	quest.4F4701000001000D.quest_subtitle: "Less energy per craft."
	quest.4F4701000001000D.title: "Efficiency Addon"
	quest.4F4701000001000E.quest_desc: [
		"The &6Capacitor Addon&r increases a machine's internal energy buffer — useful when input power is bursty or when you want a machine to ride out short power outages without missing a cycle."
		""
		"Most useful in setups with shared generators or solar-heavy power that drops at night."
	]
	quest.4F4701000001000E.quest_subtitle: "Larger energy buffer."
	quest.4F4701000001000E.title: "Capacitor Addon"
	quest.4F4701000001000F.quest_desc: [
		"The &6Acceptor Addon&r raises a machine's maximum power input rate — useful when you have abundant generation and want to feed a machine harder than its base wiring allows."
		""
		"Most relevant for high-tier machines that can otherwise bottleneck on input throughput when running with Speed addons."
	]
	quest.4F4701000001000F.quest_subtitle: "Higher input rate."
	quest.4F4701000001000F.title: "Acceptor Addon"
	quest.4F47010000010010.quest_desc: [
		"The &6Processing Addon&r boosts the per-cycle output of a machine — bigger batches, more product per recipe. Different from Speed (which makes cycles faster); this one makes cycles richer."
		""
		"Mostly relevant on production machines like the assembler and atomic forge where each cycle has measurable craft cost."
	]
	quest.4F47010000010010.quest_subtitle: "Throughput boost."
	quest.4F47010000010010.title: "Processing Addon"
	quest.4F47010000010011.quest_desc: [
		"The &6Redstone Addon&r adds redstone control to a machine — start/stop on signal, enable conditional automation, and tie machines into broader logistics networks."
		""
		"Indispensable for tightly-controlled factories where you want machines idle until a downstream condition is met."
	]
	quest.4F47010000010011.quest_subtitle: "Smart redstone control."
	quest.4F47010000010011.title: "Control Unit Addon"
	quest.4F47010000010012.quest_desc: [
		"The &6Fluid Addon&r lets a machine pull fluid inputs and push fluid outputs more flexibly — extra ports, larger fluid buffers, or both depending on the host machine."
		""
		"Most useful on processing machines that consume fluids (centrifuges, refineries) and on the laser/atomic-forge tier where fluid handling matters."
	]
	quest.4F47010000010012.quest_subtitle: "Fluid I/O routing."
	quest.4F47010000010012.title: "Fluid Addon"
	quest.4F47010000010013.quest_desc: [
		"Three specialty addons: &6Yield Addon&r boosts output quantity, &6Hunter Addon&r tunes mob-targeting machines, and &6Inventory Proxy Addon&r lets a machine see and use a remote inventory as if it were local."
		""
		"The Inventory Proxy in particular is the bridge between Oritech machines and external storage networks — combine it with AE2 / Mekanism / IF to skip dedicated piping for everything."
	]
	quest.4F47010000010013.quest_subtitle: "Specialty addons (any 3)."
	quest.4F47010000010013.title: "Specialty Addons"
	quest.4F47010000010016.quest_desc: [
		"The &6Combi Addon&r combines several base augments into one slot — Speed + Efficiency + Capacitor or similar combinations bundled together to free up other augment slots."
		""
		"Useful in machines with limited augment slots, or when you want to reserve slots for specialty augments while still getting the basic-tier benefits."
	]
	quest.4F47010000010016.quest_subtitle: "Combo slot."
	quest.4F47010000010016.title: "Heart of the Machine"
	quest.4F47010000010018.quest_desc: [
		"The &6Augment Application Block&r is where you slot augment items into wearable gear — boots, leggings, exo armor, accessories. The standalone counterpart to the Augment Stations below."
		""
		"This is the entry point to Oritech's wearable-augment system. Before this, augments only go into machines; from here on, you can also augment yourself."
	]
	quest.4F47010000010018.quest_subtitle: "Region C entry."
	quest.4F47010000010018.title: "Cybernetic Augmentation Center"
	quest.4F47010000010019.quest_desc: [
		"The &6Simple Augment Station&r is Oritech's tier-1 augment crafter — combine raw augment materials here to build the basic addons used in earlier quests."
		""
		"Built from a brewing stand, electrum, plating, and a redstone block. The cheapest entry point into the augment-crafting line."
	]
	quest.4F47010000010019.quest_subtitle: "Tier 1 research."
	quest.4F47010000010019.title: "Cybernetic Research Station"
	quest.4F4701000001001A.quest_desc: [
		"The &6Advanced Augment Station&r is the tier-2 augment crafter — handles the mid-tier augments that the Simple station can't, including most of the specialty addons."
		""
		"Mid-step on the way to the Arcane station. By the time you have one of these you should have most of the chapter's augment chain online."
	]
	quest.4F4701000001001A.quest_subtitle: "Tier 2 research."
	quest.4F4701000001001A.title: "Quantum Research Station"
	quest.4F4701000001001C.quest_desc: [
		"The &6Exo Helmet&r is the head piece of Oritech's exo-armor set — plating plus an Enderic Lens. The lens is the visual signature of Oritech's high-tech wearables."
		""
		"This is the entry to wearable Oritech tech. Each exo piece adds augment slots that travel with you, letting you wear the same speed/efficiency/yield boosts you've been slotting into machines."
	]
	quest.4F4701000001001C.quest_subtitle: "Head of the suit."
	quest.4F4701000001001C.title: "Exo Helmet"
	quest.4F4701000001001D.quest_desc: ["The &6Exo Chestplate&r is the body piece of Oritech's exo-armor set. The largest of the four pieces — its augment slots are usually where you put the heaviest augments."]
	quest.4F4701000001001D.title: "Exo Chestplate"
	quest.4F4701000001001E.quest_desc: ["The &6Exo Leggings&r are the leg piece of Oritech's exo-armor set. Pair with movement-related augments — speed, jump, step-assist — for the cleanest practical loadout."]
	quest.4F4701000001001E.title: "Exo Leggings"
	quest.4F4701000001001F.quest_desc: ["The &6Exo Boots&r are the foot piece of Oritech's exo-armor set. Completes the four-piece set bonus on top of any individual augments slotted in."]
	quest.4F4701000001001F.title: "Exo Boots"
	quest.4F47010000010020.quest_desc: [
		"The &6Exo Jetpack&r is the chest-slot variant of the exo set that adds jetpack flight. Worn instead of the standard chestplate, it trades some armor coverage for vertical mobility."
		""
		"This is the bridge between the exo armor line and the &6Jetpack Exo Elytra&r capstone — combine an exo jetpack with a regular jetpack-elytra and you get the apex mobility item in the chapter."
	]
	quest.4F47010000010020.quest_subtitle: "Region C capstone."
	quest.4F47010000010020.title: "Exo Jetpack"
	quest.4F47010000010026.quest_desc: [
		"The &6Hand Drill&r is Oritech's portable mining tool — area-effect drilling, rechargeable, gradually replaces your normal pickaxe for everyday mining."
		""
		"Pair it with the Infinity Charger or any FE charging block for permanent uptime. The drill itself is the deliverable; specialty drill heads are an Atomic-tier expansion in the convergence chapter."
	]
	quest.4F47010000010026.title: "Hand Drill"
	quest.4F47010000010027.quest_desc: [
		"The &6Jetpack&r is Oritech's flight item — burns FE for thrust, holds you in the air, and turns vertical builds from chore to easy."
		""
		"Combined with an elytra later, this becomes the &6Jetpack Elytra&r and eventually the &6Jetpack Exo Elytra&r capstone — the chapter's apex mobility item."
		""
		"&aFuel is FE, not coal. Plug in a charger somewhere convenient.&r"
	]
	quest.4F47010000010027.quest_subtitle: "Welcome to the Gilded Age."
	quest.4F47010000010027.title: "Jetpack"
	quest.4F47010000010028.quest_desc: [
		"The &6Ion Thruster&r is a high-precision propulsion component — used in the Portable Laser, advanced Oritech mobility, and the convergence-tier drone-style devices."
		""
		"Cheap individually, but several Oritech tier-3 recipes consume them in bulk. Worth automating early."
	]
	quest.4F47010000010028.title: "Ion Thruster"
	quest.4F47010000010029.quest_desc: [
		"The &6Enderic Lens&r is Oritech's dimensional optic — a focusing element built from ender-pearl-tier materials. Used in Exo Helmet recipes, Portable Laser, target designators, and other line-of-sight devices."
		""
		"Look-twice cost: the lens shows up in a lot of high-tier recipes. Build a stockpile when you can."
	]
	quest.4F47010000010029.title: "Enderic Lens"
	quest.4F4701000001002A.quest_desc: [
		"The &6Electric Mace&r is Oritech's first electrified melee weapon — biosteel-built, uses FE per swing, hits harder than vanilla iron tools."
		""
		"&aRecharge with the Infinity Charger or any standard charger block. Mind the energy bar in long fights.&r"
	]
	quest.4F4701000001002A.title: "Electric Mace"
	quest.4F4701000001002B.quest_desc: [
		"The &6Portable Laser&r is Oritech's ranged tool — combines an Ion Thruster with an Enderic Lens for a focused beam weapon/utility device."
		""
		"It's both a damage-dealer and a mining/cutting tool depending on the mode. Pair with the Target Designator for guided strikes."
	]
	quest.4F4701000001002B.quest_subtitle: "Pew pew."
	quest.4F4701000001002B.title: "Enderic Railgun"
	quest.4F4701000001002C.quest_desc: [
		"The &6Target Designator&r marks a position or entity for follow-up devices — paint a target, then any compatible Oritech weapon or device targets that location."
		""
		"&aMost useful with the Portable Laser. The combo is a precision strike package.&r"
	]
	quest.4F4701000001002C.title: "Target Designator"
	quest.4F4701000001002D.quest_desc: [
		"The &6Jetpack Elytra&r combines an elytra and the standard Jetpack into one chest item — glide-and-thrust mobility, the Oritech answer to creative-mode flight."
		""
		"The mid-tier mobility unlock. Above this, the &6Jetpack Exo Elytra&r adds the exo-armor's augment slots on top."
	]
	quest.4F4701000001002D.title: "Boosted Elytra"
	quest.4F4701000001002E.quest_desc: [
		"The &6Jetpack Exo Elytra&r is the apex mobility item for the chapter — an exo-jetpack and a jetpack-elytra fused into a single chest piece. You get glide, thrust, exo augment slots, and four-piece-set bonuses all at once."
		""
		"This is the personal-mobility milestone for Gilded Oritech. From here, getting around the world is functionally a solved problem."
		""
		"&5The chapter's mobility apex.&r"
	]
	quest.4F4701000001002E.quest_subtitle: "Everything Oritech can strap to your back."
	quest.4F4701000001002E.title: "Boosted Exo Elytra"
	quest.4F52010000010001.quest_desc: [
		"The &6Machine Core 1&r is Oritech's tier-1 gating component. Every basic Oritech machine has one of these baked into its recipe."
		""
		"&aThink of it as the LV-tier circuit equivalent for Oritech.&r You'll mass-produce these for the early machine wave."
	]
	quest.4F52010000010001.quest_subtitle: "Oritech begins with a core."
	quest.4F52010000010001.title: "The Machine Awakens"
	quest.4F52010000010002.quest_desc: [
		"The &6Wrench&r is Oritech's universal configuration tool. Sneak-right-click a machine to pick it up; right-click pipes to cycle modes."
		""
		"Carry one in your hotbar — you'll re-orient and reconfigure machines constantly."
	]
	quest.4F52010000010002.title: "Wrench"
	quest.4F52010000010003.quest_desc: [
		"The &6Machine Frame Block&r is the structural chassis Oritech machines are built around. Dense iron lattice + plating."
		""
		"Used in nearly every machine recipe and as part of multiblock extenders."
	]
	quest.4F52010000010003.quest_subtitle: "Structural base for every machine."
	quest.4F52010000010003.title: "Machine Frame"
	quest.4F52010000010004.quest_desc: [
		"&6Nickel Ore&r is Oritech's signature ore. Generates in mid-depth stone layers."
		""
		"Process the raw nickel into ingots; nickel underpins Oritech's electrum and biosteel alloys."
	]
	quest.4F52010000010004.quest_subtitle: "New ore. Spawns in overworld, common in deepslate layer."
	quest.4F52010000010004.title: "Nickel Ore"
	quest.4F52010000010005.quest_desc: [
		"&6Deepslate Nickel Ore&r is the deeper variant of nickel ore. Drops the same raw nickel; same processing path."
		""
		"Slightly tougher to mine; the deepslate band is where most of Oritech's nickel comes from."
	]
	quest.4F52010000010005.title: "Deepslate Nickel Ore"
	quest.4F52010000010006.quest_desc: [
		"&6Raw Nickel&r is the lump form of nickel ore drop. Smelt it for an ingot, or feed it through a Pulverizer for ore-doubling."
		""
		"&aOritech ore-doubling lives inside the Pulverizer.&r Same idea as MI's Macerator; different mod, same logic."
	]
	quest.4F52010000010006.title: "Raw Nickel"
	quest.4F52010000010007.quest_desc: [
		"&6Nickel Ingots&r are Oritech's primary mid-tier metal. Used in coils, motors, plating, and the electrum alloy."
		""
		"Stockpile these — Oritech's tier ladder (electrum → adamant → biosteel) all roots back to nickel."
	]
	quest.4F52010000010007.quest_subtitle: "Oritech's base metal."
	quest.4F52010000010007.title: "Nickel Ingot"
	quest.4F52010000010008.quest_desc: [
		"The &6Nickel Block&r is 9-ingot storage and decoration. Compact storage for stacks of nickel ingots."
		""
		"Use as plating accent in industrial builds — it's a clean grey-silver that pairs well with Oritech's metal beams."
	]
	quest.4F52010000010008.title: "Block of Nickel"
	quest.4F52010000010009.quest_desc: [
		"&6Magnetic Coils&r are wound nickel wire used in motors and generators. They're how Oritech turns rotation into electricity (and back)."
		""
		"Required for motors, basic generators, and several tier-1 machine recipes."
	]
	quest.4F52010000010009.quest_subtitle: "Copper meets nickel."
	quest.4F52010000010009.title: "Magnetic Coil"
	quest.4F5201000001000A.quest_desc: [
		"The &6Motor&r is Oritech's powered movement component — same role as MI's motor, separate ecosystem. Goes into every machine that has moving parts."
		""
		"Recipe combines coils, plating, and a basic battery."
	]
	quest.4F5201000001000A.quest_subtitle: "The first real milestone."
	quest.4F5201000001000A.title: "Motor"
	quest.4F5201000001000B.quest_desc: [
		"&6Basic Batteries&r are portable RF storage. Carry one to power handheld Oritech tools, or slot into machines as an internal buffer."
		""
		"Small capacity but easy to make — the entry point for Oritech's energy components."
	]
	quest.4F5201000001000B.title: "Basic Battery"
	quest.4F5201000001000C.quest_desc: [
		"The &6Machine Core 2&r is the tier-2 gating component. Mid-tier Oritech machines (Foundry, Centrifuge, Assembler) want one of these."
		""
		"Built from a Core 1 plus electrum and advanced parts. &aProgression here is core-tier-driven — reach the next core, unlock the next wave of machines.&r"
	]
	quest.4F5201000001000C.quest_subtitle: "Mid-tier unlocked."
	quest.4F5201000001000C.title: "Machine Core 2"
	quest.4F5201000001000D.quest_desc: [
		"The &6Machine Core 3&r is Oritech's top-tier core for IR-era machines. Required for the high-end multiblock extenders, deep drill, and large-volume processors."
		""
		"&aThe full Oritech tier ladder is Core 1 → 2 → 3 → (Gilded-tier cores beyond).&r"
	]
	quest.4F5201000001000D.quest_subtitle: "Full machine lineup."
	quest.4F5201000001000D.title: "Machine Core 3"
	quest.4F5201000001000E.quest_desc: [
		"&6Energy Pipes&r move RF/FE between Oritech machines. Right-click with the wrench to set extract/insert sides."
		""
		"Carry power from your generators to your machines. Lossless over short runs."
	]
	quest.4F5201000001000E.title: "Energy Pipe"
	quest.4F5201000001000F.quest_desc: [
		"&6Fluid Pipes&r move liquids between Oritech machines and tanks."
		""
		"Configure with the wrench. Interconnect with tanks for buffered fluid networks."
	]
	quest.4F5201000001000F.title: "Fluid Pipe"
	quest.4F52010000010010.quest_desc: [
		"&6Item Pipes&r move items between inventories — machine output to chest, chest to next machine, etc."
		""
		"&aFor finer control, add a Pipe Booster (speed) or Item Filter (whitelist/blacklist).&r"
	]
	quest.4F52010000010010.title: "Item Pipe"
	quest.4F52010000010011.quest_desc: [
		"The &6Framed Energy Pipe&r is the cosmetic variant of the energy pipe — same function, can be camouflaged with any block."
		""
		"Useful for hiding wiring in finished factory builds."
	]
	quest.4F52010000010011.title: "Framed Energy Pipe"
	quest.4F52010000010012.quest_desc: [
		"The &6Pipe Booster Block&r accelerates flow through any Oritech pipe it's adjacent to. Items, fluids, and energy all move faster."
		""
		"&aSpam these on long pipe runs to cut transit time.&r"
	]
	quest.4F52010000010012.quest_subtitle: "Speeds up pipe throughput."
	quest.4F52010000010012.title: "Pipe Booster"
	quest.4F52010000010013.quest_desc: [
		"The &6Framed Fluid Pipe&r is the cosmetic-camouflage version of the fluid pipe. Same function, hideable."
		""
		"Pair with framed energy and item pipes for clean factory aesthetics."
	]
	quest.4F52010000010013.title: "Framed Fluid Pipe"
	quest.4F52010000010014.quest_desc: [
		"The &6Framed Item Pipe&r is the camouflaged variant of the item pipe."
		""
		"Hide your logistics network behind any block facade."
	]
	quest.4F52010000010014.title: "Framed Item Pipe"
	quest.4F52010000010015.quest_desc: [
		"The &6Pulverizer&r is Oritech's ore-doubler. Raw ore in, doubled dust out."
		""
		"&aThis is your first Oritech machine; it pays for itself in iron alone within an hour.&r Power it with the Steam Engine or a Basic Generator until you have proper power infrastructure."
	]
	quest.4F52010000010015.quest_subtitle: "Machines that transform raw materials."
	quest.4F52010000010015.title: "The Processing Line"
	quest.4F52010000010017.quest_desc: [
		"The &6Foundry&r is Oritech's alloy machine. Combine nickel + iron, copper + nickel, etc., to produce alloy ingots."
		""
		"&aThis is where Oritech's electrum, adamant, biosteel, and energite alloys get made.&r Each alloy unlocks a tier of subsequent recipes."
	]
	quest.4F52010000010017.quest_subtitle: "Alloy smelting."
	quest.4F52010000010017.title: "Foundry"
	quest.4F52010000010018.quest_desc: [
		"The &6Powered Furnace&r is Oritech's electric smelter. Faster than vanilla, no fuel cost, accepts upgrade slots."
		""
		"Replaces the vanilla furnace for everyday smelting once Oritech is online."
	]
	quest.4F52010000010018.title: "Powered Furnace"
	quest.4F52010000010019.quest_desc: [
		"The &6Centrifuge&r separates compounds. Spin dust mixes, biomass, and processed materials into their constituent components."
		""
		"&aCommon use: spinning electrum dust to recover gold and silver separately.&r"
	]
	quest.4F52010000010019.quest_subtitle: "Fluid separation."
	quest.4F52010000010019.title: "Centrifuge"
	quest.4F5201000001001A.quest_desc: [
		"The &6Assembler&r combines components into finished parts. Oritech's equivalent to MI's Assembler, separate energy ecosystem."
		""
		"Most multi-input Oritech recipes (machine cores, batteries, advanced parts) end up here."
	]
	quest.4F5201000001001A.quest_subtitle: "Multi-input crafting."
	quest.4F5201000001001A.title: "Assembler"
	quest.4F5201000001001B.quest_desc: [
		"The &6Charger&r recharges any Oritech battery, tool, or armor placed inside."
		""
		"Park a stack of batteries in the slots; pull them out fully topped up. The Charger itself accepts RF input from any pipe."
	]
	quest.4F5201000001001B.title: "Charger"
	quest.4F5201000001001C.quest_desc: [
		"&6Iron Plating&r is decorative and structural plating sheet. Used as a building block and inside several machine recipes."
		""
		"Aesthetic note: pairs well with industrial glass and metal beams."
	]
	quest.4F5201000001001C.title: "Iron Plating"
	quest.4F5201000001001D.quest_desc: [
		"&6Nickel Plating&r is the upgraded plating variant. Higher resistance; used in mid-tier machine recipes."
		""
		"Crafted from nickel ingots in the Powered Furnace or Foundry."
	]
	quest.4F5201000001001D.title: "Nickel Plating"
	quest.4F5201000001001E.quest_desc: [
		"&6Carbon Plating&r is the high-end plating. Produced from carbon fibre via the Assembler."
		""
		"Required for late-tier Oritech machines and Oritech's reactor wall."
	]
	quest.4F5201000001001E.title: "Carbon Plating"
	quest.4F5201000001001F.quest_desc: [
		"&6Machine Plating&r is the universal plating variant for assembled components. A polished mid-tier sheet used across many Oritech recipes."
		""
		"&aStockpile these in bulk — almost every Oritech machine wants several.&r"
	]
	quest.4F5201000001001F.quest_subtitle: "Factory-grade casing."
	quest.4F5201000001001F.title: "Machine Plating"
	quest.4F52010000010020.quest_desc: [
		"&6Industrial Glass&r is a reinforced glass block. Used in tank walls, machine windows, and as decorative glazing."
		""
		"Slightly stronger than regular glass; doesn't shatter from minor explosions."
	]
	quest.4F52010000010020.title: "Industrial Glass"
	quest.4F52010000010021.quest_desc: [
		"&6Metal Beams&r are structural decorative blocks. Pair with girders, plating, and industrial glass to dress up factory builds."
		""
		"Pure aesthetic, but good aesthetic."
	]
	quest.4F52010000010021.title: "Metal Beam"
	quest.4F52010000010022.quest_desc: [
		"&6Metal Girders&r are heavy-duty structural beams — thicker than standard beams, more imposing."
		""
		"Use them as load-bearing decorative supports for big multiblock builds."
	]
	quest.4F52010000010022.title: "Metal Girder"
	quest.4F52010000010023.quest_desc: [
		"The &6Small Tank&r is a placed fluid storage block. Holds a buffer's worth of liquid."
		""
		"Connect via fluid pipe; right-click with a bucket to drain or fill."
	]
	quest.4F52010000010023.title: "Small Tank"
	quest.4F52010000010024.quest_desc: [
		"The &6Small Storage Block&r is Oritech's basic item buffer — a chest-flavored block that hooks into the item pipe network natively."
		""
		"Use as inline storage between machines for surge buffering."
	]
	quest.4F52010000010024.title: "Small Storage"
	quest.4F52010000010025.quest_desc: [
		"The &6Item Filter Block&r is an inline pipe filter. Configure whitelist or blacklist; only matching items pass through."
		""
		"&aEssential for sorting machine outputs into multiple destinations.&r"
	]
	quest.4F52010000010025.quest_subtitle: "Sort your pipeline."
	quest.4F52010000010025.title: "Item Filter"
	quest.4F52010000010026.quest_desc: [
		"The &6Machine Extender&r adds capacity, speed, or a special slot to an adjacent Oritech machine."
		""
		"&aOritech multiblocks are extender-driven — place an extender on a machine to upgrade it in place.&r Different extenders give different bonuses."
	]
	quest.4F52010000010026.quest_subtitle: "Connect machines to pipes."
	quest.4F52010000010026.title: "Machine Extender"
	quest.4F52010000010027.quest_desc: [
		"The &6Placer&r is an automatic block-placer — pipe blocks in, it places them in the world in front of itself."
		""
		"Pairs with Oritech farms and any automation that wants blocks dropped into the world."
	]
	quest.4F52010000010027.title: "Placer"
	quest.4F52010000010028.quest_desc: [
		"The &6Pump Block&r pulls fluids from world sources (water, lava, oil pools) and pushes them into your fluid network."
		""
		"Note: world-gen oil is disabled in this pack — for oil, use Create Diesel Generators' chunk-deposit pumpjack instead."
	]
	quest.4F52010000010028.title: "Pump"
	quest.4F5201000001002A.quest_desc: [
		"&6Steel Ingots&r (Oritech variant) are produced via the Foundry by alloying iron + coal dust. Same role as MI steel: a mid-tier alloy."
		""
		"&aOritech steel and MI steel are tagged together via &7c:ingots/steel&r — one type covers both ecosystems' steel-needing recipes.&r"
	]
	quest.4F5201000001002A.quest_subtitle: "The alloy tree begins."
	quest.4F5201000001002A.title: "Steel and Beyond"
	quest.4F5201000001002B.quest_desc: [
		"&6Steel Block&r is 9-ingot compact storage for Oritech steel."
		""
		"Stash bulk steel here when chests overflow."
	]
	quest.4F5201000001002B.title: "Block of Steel"
	quest.4F5201000001002C.quest_desc: [
		"&6Steel Dust&r is the powdered intermediate in steel production. Smelt for an ingot, or use directly in some Foundry recipes."
		""
		"Output of the Pulverizer when grinding iron + coal."
	]
	quest.4F5201000001002C.title: "Steel Dust"
	quest.4F5201000001002E.quest_desc: [
		"&6Aluminum Block&r is 9-ingot storage. Same logic as the iron, nickel, and steel blocks."
		""
		"Aluminum's a clean white-silver decorative block."
	]
	quest.4F5201000001002E.title: "Block of Aluminum"
	quest.4F5201000001002F.quest_desc: [
		"&6Electrum Ingots&r are Oritech's gold-silver alloy — medium conductivity, low electrical loss. Used in advanced cabling and machine internals."
		""
		"Made in the Foundry from gold + silver dust."
	]
	quest.4F5201000001002F.quest_subtitle: "Gold meets silver."
	quest.4F5201000001002F.title: "Electrum Ingot"
	quest.4F52010000010030.quest_desc: [
		"&6Electrum Block&r is 9-ingot storage. Storage and decorative use."
		""
		"The block has a warm copper-gold tone; nice as factory accent."
	]
	quest.4F52010000010030.title: "Block of Electrum"
	quest.4F52010000010031.quest_desc: [
		"&6Adamant Ingots&r are a high-strength Oritech alloy. Recipe involves nickel and several supporting materials in the Foundry."
		""
		"&aRequired for the late-IR2 advanced machine recipes and several reactor components.&r"
	]
	quest.4F52010000010031.quest_subtitle: "Oritech's mid-tier superalloy."
	quest.4F52010000010031.title: "Adamant Ingot"
	quest.4F52010000010032.quest_desc: [
		"&6Adamant Block&r is 9-ingot adamant storage — rare enough that you'll want bulk storage for it."
		""
		"Compact bulk storage for one of Oritech's late-tier alloys."
	]
	quest.4F52010000010032.title: "Block of Adamant"
	quest.4F52010000010035.quest_desc: [
		"&6Energite Ingots&r are Oritech's energy-saturated late-tier alloy. Used in advanced batteries, reactor parts, and high-throughput components."
		""
		"&aThis is the top-tier IR-era alloy in the Oritech ladder.&r Beyond this, you're into Gilded territory."
	]
	quest.4F52010000010035.quest_subtitle: "Energy-infused alloy."
	quest.4F52010000010035.title: "Energite Ingot"
	quest.4F52010000010036.quest_desc: [
		"&6Energite Block&r is 9-ingot energite storage. Glows faintly with the energy bound into the alloy."
		""
		"Decorative bulk storage for the top-tier IR alloy."
	]
	quest.4F52010000010036.title: "Block of Energite"
	quest.4F52010000010037.quest_desc: [
		"&6Advanced Batteries&r are high-capacity portable RF storage — a major upgrade over the Basic Battery."
		""
		"&aHandheld Oritech tools last much longer with one of these slotted.&r Recipe involves energite and biosteel."
	]
	quest.4F52010000010037.quest_subtitle: "High-capacity RF storage."
	quest.4F52010000010037.title: "Advanced Battery"
	quest.4F52010000010038.quest_desc: [
		"&6Nickel Dust&r is the pulverized form of nickel ore. Smelts to one ingot — the ore-doubling step came from pulverizing the raw ore (which yields 2 dust)."
		""
		"Centrifuge nickel dust to recover trace platinum."
	]
	quest.4F52010000010038.title: "Nickel Dust"
	quest.4F52010000010039.quest_desc: [
		"&6Iron Dust&r is the standard ore-doubled iron intermediate. Pulverize iron ore for two dust per ore."
		""
		"Tagged compatibly across MI, Oritech, and Mekanism dust networks."
	]
	quest.4F52010000010039.title: "Iron Dust"
	quest.4F5201000001003A.quest_desc: [
		"&6Copper Dust&r is pulverized copper ore. Tagged for cross-mod compatibility."
		""
		"Smelt for ingots, or feed into the Foundry for alloying."
	]
	quest.4F5201000001003A.title: "Copper Dust"
	quest.4F5201000001003B.quest_desc: [
		"&6Gold Dust&r is pulverized gold ore. Same dust-tag system as iron and copper."
		""
		"Used in electrum alloying via the Foundry."
	]
	quest.4F5201000001003B.title: "Gold Dust"
	quest.4F5201000001003C.quest_desc: [
		"&6Coal Dust&r is pulverized coal. Major use: alloying with iron in the Foundry to produce steel."
		""
		"Also smelts into a coal coke equivalent in some recipes."
	]
	quest.4F5201000001003C.title: "Coal Dust"
	quest.4F5201000001003D.quest_desc: [
		"&6Silver Dust&r is the cross-mod dust form of silver. Pulverize silver ore (or process raw silver) to get it."
		""
		"Used in electrum alloying."
	]
	quest.4F5201000001003D.title: "Silver Dust"
	quest.4F5201000001003E.quest_desc: [
		"&6Aluminum Dust&r is the powdered intermediate from bauxite or aluminum ore processing."
		""
		"Smelts to aluminum ingot. Tagged with MI's aluminum dust."
	]
	quest.4F5201000001003E.title: "Aluminum Dust"
	quest.4F5201000001003F.quest_desc: [
		"&6Electrum Dust&r is pulverized electrum, or the centrifuge output of separating gold + silver dust."
		""
		"Smelts to electrum ingot — useful when you want to bypass the Foundry alloy step."
	]
	quest.4F5201000001003F.title: "Electrum Dust"
	quest.4F52010000010040.quest_desc: [
		"&6Raw Biopolymer&r is the unrefined output of plant matter processed in Oritech's bio-line. The starting material for plastic, polymer resin, and synthetic rubber."
		""
		"&aOritech's bio-line is the alternative to oil cracking — renewable and started purely from farmed crops.&r"
	]
	quest.4F52010000010040.quest_subtitle: "Biomass, polymers, and plastics."
	quest.4F52010000010040.title: "Organic Chemistry"
	quest.4F52010000010041.quest_desc: [
		"&6Biomass&r is the compressed plant-matter intermediate. Oritech's bio-generators run on biomass for clean low-tier power."
		""
		"Made from saplings, crops, or any plant matter in a Pulverizer with the right setup."
	]
	quest.4F52010000010041.title: "Biomass"
	quest.4F52010000010042.quest_desc: [
		"&6Solid Biofuel&r is the burnable product of biomass refinement. Standard furnace fuel, also used as a feedstock for the Bio Generator."
		""
		"More fuel value per unit than raw biomass."
	]
	quest.4F52010000010042.title: "Solid Biofuel"
	quest.4F52010000010044.quest_desc: [
		"&6Plastic Sheets&r are Oritech's primary thermoplastic. Used in advanced casings, cables, and several IR3 onward recipes."
		""
		"Made from raw biopolymer pressed in the Compressor."
	]
	quest.4F52010000010044.quest_subtitle: "The universal crafting material."
	quest.4F52010000010044.title: "Plastic Sheet"
	quest.4F52010000010045.quest_desc: [
		"&6Plastic Block&r is 9-sheet bulk storage for plastic. Decorative and storage."
		""
		"Useful in builds that want a clean white plastic finish."
	]
	quest.4F52010000010045.title: "Plastic Block"
	quest.4F52010000010046.quest_desc: [
		"&6Polymer Resin&r is the liquid intermediate between biopolymer and finished plastic."
		""
		"Stored in tanks, piped into the Assembler. Required for a handful of advanced Oritech recipes."
	]
	quest.4F52010000010046.title: "Polymer Resin"
	quest.4F52010000010047.quest_desc: [
		"&6Carbon Fibre Strands&r are the fibrous precursor to carbon plating. Produced from plastic and resin in advanced processing."
		""
		"Weave into &6Reinforced Carbon Sheets&r for the ultra-strong plating used in late-tier machines."
	]
	quest.4F52010000010047.quest_subtitle: "Coal dust + biomass."
	quest.4F52010000010047.title: "Carbon Fibre Strands"
	quest.4F52010000010048.quest_desc: [
		"&6Reinforced Carbon Sheets&r are Oritech's premium plating material. Multiple layers of carbon fibre laminated together."
		""
		"&aRequired for the highest-tier IR-era Oritech machines.&r"
	]
	quest.4F52010000010048.quest_subtitle: "Advanced composite material."
	quest.4F52010000010048.title: "Reinforced Carbon Sheet"
	quest.4F5201000001004B.quest_desc: [
		"The &6Still Biofuel Bucket&r holds liquid biofuel — the refined fluid version, hotter-burning than solid biofuel."
		""
		"Powers high-tier bio-generators and a couple of liquid-fed machines."
	]
	quest.4F5201000001004B.title: "Biofuel Stockpile"
	quest.4F5201000001004C.quest_desc: [
		"The &6Styrene-Butadiene Rubber Bucket&r holds liquid synthetic rubber, an MI-side product of oil distillation."
		""
		"&aOritech can accept this rubber for plastic-line recipes.&r The tag system bridges MI and Oritech rubber sources."
	]
	quest.4F5201000001004C.title: "Styrene-Butadiene Rubber"
	quest.4F5201000001004F.quest_desc: [
		"&6Biomass Block&r is compressed biomass storage. Compact storage, can be decomposed back to biomass when needed."
		""
		"Useful as a buffer for the Bio Generator's fuel input."
	]
	quest.4F5201000001004F.title: "Biomass Block"
	quest.4F52010000010066.quest_desc: [
		"The &6Treefeller&r is Oritech's automatic logger. Plant a sapling within range; the Treefeller chops the grown tree, breaks each block, and pulls logs back to its inventory."
		""
		"&aFeed the logs into a Pulverizer for biomass or directly into a Bio Generator for raw fuel.&r"
	]
	quest.4F52010000010066.title: "Treefeller"
	quest.4F52010000010067.quest_desc: [
		"The &6Fertilizer Block&r is Oritech's bonemeal-substitute — speeds up adjacent crops or saplings."
		""
		"Pair with the Treefeller and a Placer for fully-automated biomass farming."
	]
	quest.4F52010000010067.title: "Fertilizer"
	quest.4F52010000010077.quest_desc: [
		"&6Clay Catalyst Beads&r are catalytic spheres used in some Oritech advanced processing recipes."
		""
		"Recipe involves clay processed via the Assembler. Specialty intermediate, not always required."
	]
	quest.4F52010000010077.title: "Clay Catalyst Beads"
	quest.4F52010000010080.quest_desc: [
		"The &6Deep Drill&r is Oritech's automated underground miner. Place it on bedrock-adjacent stone, give it power, and it extracts ore from the chunk it's centered on."
		""
		"&aOritech's answer to MI's quarry-style mining.&r Slow but completely automated; it pays back over hours of runtime."
	]
	quest.4F52010000010080.title: "Deep Drill"
	quest.4F52010000010081.quest_desc: [
		"&6Reactor Heat Pipes&r are conductive elements for Oritech's reactor multiblock. They move heat between fuel rods, vents, and turbine plates."
		""
		"Reactor design is multiblock — check the Oritech reactor tutorial to lay out a stable core."
	]
	quest.4F52010000010081.title: "Reactor Heat Pipe"
	quest.4F52010000010082.quest_desc: [
		"The &6Basic Generator&r is Oritech's first power source — a furnace-style block that burns solid fuel for FE."
		""
		"Slow but functional. Useful for bootstrapping the first Pulverizer + Foundry."
	]
	quest.4F52010000010082.title: "Basic Generator (Refinery)"
	quest.4F52010000010087.quest_desc: [
		"The &6Lava Generator&r burns lava as fuel. High output per bucket, slow drain rate."
		""
		"&aPair with a Pump pulling from a nether lava lake for indefinite power.&r"
	]
	quest.4F52010000010087.title: "Lava Generator"
	quest.4F52010000010088.quest_desc: [
		"The &6Steam Engine&r is Oritech's steam-to-FE converter. Pipe steam in, get FE out for Oritech machines."
		""
		"&7Note: This converts STEAM (a fluid) to FE. It does NOT bridge other mod power systems. Mekanism Joules, Create SU, and Electrodynamics V/J each require their own conversion paths if you need cross-system power.&r"
	]
	quest.4F52010000010088.quest_subtitle: "Boiler-driven power."
	quest.4F52010000010088.title: "Steam Engine"
	quest.4F5201000001008B.quest_desc: [
		"The &6Bio Generator&r burns solid biofuel for FE. Cleaner than the Basic Generator; much higher output if you have a steady biomass farm."
		""
		"&aThe centerpiece of an Oritech bio-power loop — Treefeller + Pulverizer + Bio Generator = renewable power.&r"
	]
	quest.4F5201000001008B.quest_subtitle: "Renewable RF from biomass."
	quest.4F5201000001008B.title: "Bio Generator"
	quest.4F5201000001008C.quest_desc: [
		"The &6Big Solar Panel&r generates FE from sunlight. Slow but completely passive once placed."
		""
		"Stack many on a roof for a quiet baseline power supply."
	]
	quest.4F5201000001008C.title: "Big Solar Panel"
	quest.4F5201000001008F.quest_desc: [
		"The &6Reactor Vent&r is a cooling element for Oritech's reactor. Pipe heat from heat pipes into a vent to dump it safely."
		""
		"&cReactor design balance: heat in vs heat dumped. An unbalanced reactor fails catastrophically.&r"
	]
	quest.4F5201000001008F.title: "Reactor Vent"
	quest.4F52010000010090.quest_desc: [
		"The &6Power Pole&r is a wireless power transmitter. Place two within range and they relay FE between them without needing pipe runs."
		""
		"&aClean way to deliver power to remote machines without cable spaghetti.&r"
	]
	quest.4F52010000010090.title: "Power Pole"
	quest.4F52010000010091.quest_desc: [
		"The &6Ceiling Light&r is a clean industrial light source. Higher light level than vanilla torches; takes power from the Oritech network."
		""
		"Pure aesthetic + practical lighting for factory builds."
	]
	quest.4F52010000010091.title: "Ceiling Light"
	quest.4F520100000100A9.quest_desc: [
		"The &6Still Diesel Bucket&r holds Oritech's distilled diesel fuel. Higher energy density than biofuel."
		""
		"Output of distilling oil products in the Oritech fluid line, or accepted from CDG/IP cross-mod via shared tags."
	]
	quest.4F520100000100A9.title: "Diesel Proof"
	quest.4F53010000010002.quest_desc: [
		"Place a &6Bedrock Extractor&r (registry: `oritech:deep_drill_block`) directly &eon top of a Resource Node block&r to start drawing infinite resources — Oritech's quarry/laser-drill style infinite-resource generator. The in-game error if misplaced is literally &7\"Machine must be placed on ore nodes\".&r"
		""
		"The Resource Node is &enot consumed&r — it remains in place and feeds the Extractor a steady stream of its resource forever as long as the Extractor has FE. Iron, diamond, uranium, platinum, lapis, emerald — pick a node, pay the FE, get the output."
		""
		"&aA loaded Bedrock Extractor is one of the cleanest infinite-ore solutions in the pack.&r"
	]
	quest.4F53010000010003.quest_desc: ["The &6Iron Resource Node&r — feeds a deep drill an infinite stream of iron. The most common node and the natural first one to install."]
	quest.4F53010000010004.quest_desc: ["The &6Diamond Resource Node&r — feeds a deep drill an infinite stream of diamonds. Slower per-cycle than iron, but solves diamond scarcity for the rest of the game."]
	quest.4F53010000010005.quest_desc: ["The &6Uranium Resource Node&r — feeds a deep drill an infinite stream of uranium. Oritech's reactor fuel pipeline becomes self-sufficient once this is online."]
	quest.4F53010000010006.quest_desc: ["The &6Platinum Resource Node&r — feeds a deep drill an infinite stream of platinum. Closes the platinum/duratium recipe loop."]
	quest.4F53010000010007.quest_desc: ["&6Coal&r — surprising lurker in this chapter. The deep drill can be tuned to mine coal nodes too, giving you bulk-fuel without ever digging a coal mine."]
	quest.4F53010000010007.title: "Coal Resource Node"
	quest.4F53010000010008.quest_desc: [
		"Hold the trio of redstone-tier nodes — &6Redstone&r, &6Lapis&r, and &6Diamond&r — to confirm your deep-drill collection covers the colored-resource line."
		""
		"Once these three are online, vanilla mining for those resources is effectively retired. Diamond, redstone, and lapis become tap-water."
	]
	quest.4F53010000010009.quest_desc: ["Craft a second &6Laser Arm Block&r — at this point most bases run multiple, each programmed for a different job (mob crowd control, mining, harvesting)."]
	quest.4F5301000001000A.quest_desc: [
		"Place a &6Laser Arm Block&r in the world to put it to work. Configure the target list, point it at a working area, and let it run."
		""
		"&aLaser arms target by block type. Set up an arm over a coal block stockpile and it'll mine coal blocks specifically.&r"
	]
	quest.4F5301000001000A.title: "Laser Assembly"
	quest.4F5301000001000B.quest_desc: [
		"The &6Destroyer Block&r is Oritech's area-effect demolition device — programmable, wide-area block breaking. The brutal-force counterpart to the laser arm's targeted approach."
		""
		"&cKills mobs and breaks blocks indiscriminately in its working area.&r Use carefully near things you don't want destroyed."
	]
	quest.4F5301000001000E.quest_desc: ["&6Coal Block&r — laser arm target proof. Place a coal block, point a laser arm at it, and it gets mined. Confirms the laser-arm targeting and the deep drill output stream are integrated."]
	quest.4F5301000001000E.title: "Gold Resource Node"
	quest.4F5301000001000F.quest_desc: ["&6Diamond Block&r — high-tier laser arm target proof. By this point in the chapter, diamond blocks should be a routine output of your deep-drill diamond pipeline."]
	quest.4F5301000001000F.title: "Nickel Resource Node"
	quest.4F53010000010011.quest_desc: [
		"The &6Spawner Cage Block&r is Oritech's mob-spawning chassis — combine with a Spawner Controller to spawn whichever mob you target."
		""
		"This is Oritech's answer to the Mob Duplicator (IF) and Saw (Mekanism) — a programmable, FE-powered mob spawner."
	]
	quest.4F53010000010012.quest_desc: [
		"The &6Spawner Controller Block&r is the brain of Oritech's spawner setup — programs which mob spawns from adjacent cages and at what rate."
		""
		"Pair with a working laser arm or Mob Crusher for a closed-loop mob farm with no random-spawn dependency."
	]
	quest.4F53010000010014.quest_desc: ["The &6Enchantment Catalyst Block&r is the input/storage block of Oritech's enchanter system — feeds the &6Enchanter Block&r the consumables it needs to apply enchantments."]
	quest.4F53010000010016.quest_desc: ["Use the &6Enchanter Block&r to apply your first automated enchantment. Confirms the pipeline is live: catalyst feeds enchanter, enchanter writes enchantments to gear."]
	quest.4F53010000010016.title: "Industrial Enchanting"
	quest.4F5301000001001A.quest_desc: [
		"Place an &6Arcane Augment Station&r in the world. The Atomic-tier crafting hall starts here."
		""
		"From this station the chapter feeds out into the addon-block tier-6 line, the Atomic-tier weapons, and ultimately the Tier 9 capstone."
	]
	quest.4F5301000001001A.title: "Arcane Augment Station"
	quest.4F5301000001001F.quest_desc: [
		"The augment-station capstone — hold a fully-integrated &6Arcane Augment Station&r setup, with placed station + multiple held + Unholy Intelligence chip integrated."
		""
		"&5The augment-crafting milestone for the specialty chapter. From here the chapter pivots to the actual augments — the Tier 6 and Tier 9 addon-block lines.&r"
	]
	quest.4F5301000001001F.title: "Arcane Mastery"
	quest.4F53010000010020.quest_desc: ["The &6Speed Tier 6 Addon Block&r (Oritech Things) is the apex Atomic Speed augment — six tiers above the basic Speed Addon. Slot it into machines that already have Tier 2 and Combi addons running."]
	quest.4F53010000010021.quest_desc: ["The &6Efficiency Tier 6 Addon Block&r — apex Efficiency variant. Pair with Tier 6 Speed for the cleanest combination of throughput and power efficiency in the pack."]
	quest.4F53010000010022.quest_desc: ["The &6Capacitor Tier 6 Addon Block&r — apex Capacitor variant. The biggest internal energy buffer in Oritech."]
	quest.4F53010000010023.quest_desc: ["The &6Acceptor Tier 6 Addon Block&r — apex Acceptor variant. Highest sustainable input rate from your Oritech reactor or fusion-tier external generator."]
	quest.4F53010000010024.quest_desc: ["The &6Processing Tier 6 Addon Block&r — apex Processing variant. Largest batches per cycle for production machines."]
	quest.4F53010000010026.quest_desc: [
		"The &6Speed Tier 9 Addon Block&r is the absolute apex of Oritech's augment ladder — three tiers above Tier 6, gated behind every Tier 6 augment plus an Unholy Intelligence chip."
		""
		"&5The single most aggressive speedup augment in the engineering spine. Slot it into your highest-throughput machine and watch the recipe queue empty itself.&r"
	]
	quest.4F53010000010026.title: "Tier 9 Addons"
	quest.4F53010000010027.quest_desc: ["The &6Efficient Speed Tier 6 Addon Block&r — bundled Speed + Efficiency at apex tier, slotted into machines that need both buffs but are running short on augment slots."]
	quest.4F53010000010027.title: "Efficient Speed (T6)"
	quest.4F53010000010028.quest_desc: [
		"The &6Promethium Pickaxe&r is built from Prometheum ingot — Oritech's apex mining tool. Mines at the highest tier, holds enchantments well, and refuses to break."
		""
		"&aPair with Mending or autorepair augments and stop carrying spares.&r"
	]
	quest.4F53010000010029.quest_desc: ["The &6Promethium Axe&r — Prometheum-tier wood and combat axe. Same apex-tier durability as the pickaxe, slightly different swing characteristics."]
	quest.4F5301000001002B.quest_desc: [
		"The &6Chainsaw&r is Oritech's dedicated tree-felling tool — chops a whole tree in one stroke for the cost of FE per cycle."
		""
		"&aBeats vanilla axes for any farming setup that processes wood at scale.&r"
	]
	quest.4F5301000001002E.quest_desc: ["&6Jetpack Exo Elytra&r — held proof at Atomic tier. The apex personal-mobility item from the electronics chapter, by now fully integrated into your daily loadout."]
	quest.4F5301000001002E.title: "Exo Elytra Comparison"
	quest.4F5301000001002F.quest_desc: [
		"Place a second &6Reactor Controller&r — multi-reactor setups. Run multiple reactors in parallel, each tuned to a different fuel type, for redundancy and aggregate output."
		""
		"&5Engineering spine bases at this scale often have two reactors running, each with its own steam-boiler/quad-rod stack.&r"
	]
	quest.4F5301000001002F.title: "Oritech Fission Reactor"
	quest.4F53010000010030.quest_desc: ["&6Reactor Energy Port&r reappears at Atomic tier — held proof. By this point you have multiple ports on your reactor's output face routing energy to several downstream networks."]
	quest.4F53010000010030.title: "Reactor Power Output"
	quest.4F53010000010031.quest_desc: ["Place a &6Steam Boiler Addon&r adjacent to your second Oritech reactor — converts the reactor's heat into steam for downstream turbines, doubling effective output for a small infrastructure cost."]
	quest.4F53010000010031.title: "Steam Boiler Integration"
	quest.4F53010000010032.quest_desc: [
		"Hold a &6Reactor Quad Rod&r at Atomic tier — the apex fuel rod, ready to drop into your highest-throughput reactor."
		""
		"&cQuad rods are top-of-line and need top-of-line cooling. Confirm your condenser/heat-pipe stack can absorb the load before installing.&r"
	]
	quest.4F53010000010032.title: "Quad Fuel Rods"
	quest.4F53010000010050.quest_desc: [
		"The specialty chapter capstone — hold &6Laser Arm Block&r, &6Spawner Controller Block&r, &6Reactor Controller&r, and &6Arcane Augment Station&r at once. Four named apex blocks, one quest, the engineering spine's full Atomic loadout."
		""
		"This is the final exit gate of Atomic Oritech. Beyond this point, the engineering spine has nothing more to teach you — the only Oritech work remaining is your own factory expansion."
		""
		"&5Atomic Oritech is the engineering-spine apex. The science spine (Nuclear Science, Chemical Science, Ballistix) and the magic chapters carry the Atomic age forward in parallel from here.&r"
	]
	quest.4F53010000010050.title: "Specialty Complete"
	quest.4F53010000010051.title: "Region: Resource Nodes"
	quest.4F53010000010052.title: "Region: Reactor Components"
	quest.4FB724CDDCB6E709.quest_desc: [
		"&6Molten Amethyst&r — refined from amethyst clusters, glows with stored heat. Used as a reagent in fire- and energy-themed recipes."
		""
		"&aCrystalline and beautiful,&r doubles as a pretty decoration block if you hate yourself enough to use rare reagents on builds."
	]
	quest.4FC72031CD12A930.quest_desc: [
		"This is the &6End Remastered&r challenge — the End is no longer reached with twelve identical Eyes of Ender. Instead, fifteen unique eyes are scattered across every dimension you've explored, each tied to a specific encounter or boss kill."
		""
		"&5The Old Eye, Nether Eye, Cold Eye, Rogue Eye, Black Eye, Lost Eye, Corrupted Eye, Magical Eye, Wither Eye, Guardian Eye, Cursed Eye, Exotic Eye, Evil Eye, Undead Eye, Cryptic Eye.&r You've been collecting these as rewards since the early Renaissance bosses (boss kills, dimension-specific encounters, and structure clears)."
		""
		"&aOnce all fifteen are in hand, the End Portal will accept them. This gear-shaped quest is the gate to the rest of the chapter.&r"
	]
	quest.4FC72031CD12A931.title: "Region: Phantasm"
	quest.4FC72031CD12A932.title: "Region: End Ecology"
	quest.5089554FF27187F8.quest_desc: ["The &6Phoenix Bow&r — Aether dungeon drop. Shoots flaming arrows that ignite targets without consuming flame enchant durability."]
	quest.50C51CF802C0EE76.quest_desc: ["The &6Incubator&r — Aether block for hatching moa eggs. Powered by ambrosium torches."]
	quest.513D49F66B09F9C1.quest_desc: [
		"&6Behemoth Meat&r — raw drop from Phantasm's behemoths. Cook it into Behemoth Steak (high-end food)."
		""
		"&aOne of the best food sources in the chapter. Stockpile.&r"
	]
	quest.514F010000010001.quest_desc: [
		"The &6Growth Lamp&r (PowerGrid) emits artificial sunlight in a downward cone — crops below grow as if in daylight."
		""
		"&aIndoor farming made trivial.&r Place over your wheat/sugar cane and underground farms keep producing through the night."
	]
	quest.514F010000010001.quest_subtitle: "Sun in a box."
	quest.514F010000010001.title: "Growth Lamp"
	quest.514F010000010002.quest_desc: [
		"The &6Basin Heater&r (PowerGrid) heats a fluid basin via electric coil. Useful for steam generation and chemistry recipes that need heated fluid."
		""
		"Pair with PowerGrid's heating coil for the heat source."
	]
	quest.514F010000010002.quest_subtitle: "No more chasing blazes."
	quest.514F010000010002.title: "Basin Heater"
	quest.514F010000010003.quest_desc: [
		"The &6Heating Coil&r (PowerGrid) is the resistive heating element. Generates heat from electrical current."
		""
		"Component for the basin heater and several other PowerGrid heat-flavored devices."
	]
	quest.514F010000010003.title: "Heating Coil"
	quest.514F010000010004.quest_desc: [
		"The &6Electric Fan&r (PowerGrid) blows air in a direction. Useful for entity-pushing, fluid air-cooling, and ventilation aesthetics."
		""
		"Pure utility/decorative."
	]
	quest.514F010000010004.quest_subtitle: "Encased fan, no shaft required."
	quest.514F010000010004.title: "Electric Fan"
	quest.514F010000010005.quest_desc: [
		"The &6Thermometer&r (PowerGrid) reads ambient or block-attached temperature. Outputs the value via redstone or display."
		""
		"&aUseful for chemistry chains where temperature gates recipes.&r"
	]
	quest.514F010000010005.title: "Thermometer"
	quest.514F010000010006.quest_desc: [
		"The &6Plotter&r (PowerGrid) is a real-time data graph block. Plots an input signal over time on a screen face."
		""
		"Visual debugging tool for wattage, voltage, and other PowerGrid metrics."
	]
	quest.514F010000010006.quest_subtitle: "Print circuits."
	quest.514F010000010006.title: "Plotter"
	quest.514F010000010007.quest_desc: [
		"The &6LV Switch&r (PowerGrid) is the low-voltage breaker. Toggle to interrupt LV current flow on a wire."
		""
		"Required for safe maintenance on live circuits."
	]
	quest.514F010000010007.quest_subtitle: "Wire toggle, low voltage."
	quest.514F010000010007.title: "LV Switch"
	quest.514F010000010008.quest_desc: [
		"The &6Relay&r (PowerGrid) is a redstone-controlled switch. Closes the circuit when receiving a redstone signal."
		""
		"&aThe core component of automated electrical control.&r"
	]
	quest.514F010000010008.title: "Relay"
	quest.514F010000010009.quest_desc: [
		"The &6Resistor&r (PowerGrid) is a passive resistance component — reduces current in a circuit."
		""
		"Component in voltage-divider and load-balancing circuits."
	]
	quest.514F010000010009.title: "Resistor"
	quest.514F01000001000A.quest_desc: [
		"The &6Wire Connector&r (PowerGrid) is the wall-mount termination for PowerGrid wires."
		""
		"Place on machines and panel boards to give wires somewhere to anchor."
	]
	quest.514F01000001000A.title: "Wire Connector"
	quest.514F01000001000B.quest_desc: [
		"The &6Magnet&r (PowerGrid) is a permanent-magnet component. Used in motor and generator coil assemblies."
		""
		"Distinct from CNA's redstone magnet — PowerGrid uses its own magnet recipe."
	]
	quest.514F01000001000B.title: "Magnet"
	quest.514F01000001000C.quest_desc: [
		"The &6Electrical Gizmo&r (PowerGrid) is the multi-tool for measuring and configuring PowerGrid components."
		""
		"&aHandheld diagnostic + configuration tool.&r"
	]
	quest.514F01000001000C.title: "Electrical Gizmo"
	quest.514F01000001000D.quest_desc: [
		"The &6Grounding Rod&r (PowerGrid) safely shunts excess voltage to ground."
		""
		"&aPlace at vulnerable points to prevent surge damage to expensive components.&r"
	]
	quest.514F01000001000D.quest_subtitle: "Static drain."
	quest.514F01000001000D.title: "Grounding Rod"
	quest.514F01000001000E.quest_desc: [
		"&6PowerGrid Iron Wire&r is the iron-conductor wire variant. Higher resistance than copper but cheaper."
		""
		"Useful for short low-priority runs."
	]
	quest.514F01000001000E.title: "Iron Wire"
	quest.514F01000001000F.quest_desc: [
		"&6Insulated Copper Wire&r is the safer copper-wire variant. Insulation prevents touch-shock and reduces short-circuit risk."
		""
		"Standard interior-wiring choice."
	]
	quest.514F01000001000F.title: "Insulated Copper Wire"
	quest.514F010000010010.quest_desc: [
		"The &6Copper Cord&r is PowerGrid's heavier-gauge copper cable variant. Carries higher current at the cost of bulkier cable."
		""
		"Used in high-amperage runs."
	]
	quest.514F010000010010.title: "Copper Cord"
	quest.514F010000010011.quest_desc: [
		"The &6Heavy Wire Connector&r is the high-current connector variant. Required for cord-tier wiring terminations."
		""
		"Pair with copper cord for serious throughput."
	]
	quest.514F010000010011.quest_subtitle: "High voltage I/O."
	quest.514F010000010011.title: "Heavy Wire Connector"
	quest.514F010000010012.quest_desc: [
		"The &6Cord Junction&r is the multi-cord splice block. Joins multiple cord runs at a single point."
		""
		"&aThe \"breaker box\" of PowerGrid.&r"
	]
	quest.514F010000010012.title: "Cord Junction"
	quest.514F010000010013.quest_desc: [
		"The &6Circuit Design Table&r is PowerGrid's schematic editor. Author custom electronic circuit layouts; print to circuit substrate."
		""
		"&aAdvanced PowerGrid content — design your own logic blocks.&r"
	]
	quest.514F010000010013.quest_subtitle: "Where circuits are born."
	quest.514F010000010013.title: "Circuit Design Table"
	quest.514F010000010014.quest_desc: [
		"The &6Empty Circuit&r is the blank circuit substrate. Designed via the Circuit Design Table; loaded with logic."
		""
		"Substrate for PowerGrid custom circuits."
	]
	quest.514F010000010014.title: "Empty Circuit"
	quest.514F010000010015.quest_desc: [
		"The &6Resistive Coil&r is the heating-resistance coil component. Used in heater and resistive-load PowerGrid recipes."
		""
		"Higher-tier coil than the standard heating coil."
	]
	quest.514F010000010015.title: "Resistive Coil"
	quest.514F010000010016.quest_desc: [
		"The &6LV Button&r is a wall-mount LV input button — pushes a brief signal into a connected LV circuit."
		""
		"Standard interactive control."
	]
	quest.514F010000010016.title: "LV Button"
	quest.514F010000010017.quest_desc: [
		"The &6MV Switch&r is the medium-voltage breaker variant."
		""
		"Use for MV circuits to safely interrupt current during maintenance."
	]
	quest.514F010000010017.title: "MV Switch"
	quest.514F010000010018.quest_desc: [
		"The &6HV Switch&r is the high-voltage breaker. Required for switching off HV circuits."
		""
		"&cDon't switch HV circuits live without a load — the arc can damage adjacent components.&r"
	]
	quest.514F010000010018.title: "HV Switch"
	quest.514F010000010019.quest_desc: [
		"The &6DPDT Relay&r is a double-pole double-throw relay — switches two independent circuits with one redstone input."
		""
		"Useful for symmetrical switching logic."
	]
	quest.514F010000010019.title: "Relay (DPDT)"
	quest.514F01000001001A.quest_desc: [
		"The &6Contactor&r is the heavy-duty switching component — rated for high inrush current loads (motors, heaters)."
		""
		"Use where a relay would burn out under sustained high-current switching."
	]
	quest.514F01000001001A.quest_subtitle: "High-current relay."
	quest.514F01000001001A.title: "Contactor"
	quest.514F01000001001B.quest_desc: [
		"The &6Rheostat&r is a variable resistor — rotate the input to adjust resistance smoothly."
		""
		"Used for analog speed/dimmer control on motors and lamps."
	]
	quest.514F01000001001B.title: "Rheostat"
	quest.514F01000001001C.quest_desc: [
		"The &6Power Resistor&r is the high-wattage resistor variant — handles serious dissipation without burning out."
		""
		"Use in high-current circuits where standard resistors would fail."
	]
	quest.514F01000001001C.title: "Power Resistor"
	quest.514F01000001001D.quest_desc: [
		"The &6PowerGrid Capacitor&r is a circuit-internal energy-storage component. Smooths voltage in power-conditioning circuits."
		""
		"Component, not a network buffer; pair with the PowerGrid battery for bulk storage."
	]
	quest.514F01000001001D.quest_subtitle: "Buffer the bumps."
	quest.514F01000001001D.title: "Capacitor"
	quest.514F01000001001E.quest_desc: [
		"The &6Transformer Core&r is the iron core component for PowerGrid transformers. Wrapped with primary + secondary coils to step voltage up or down."
		""
		"Required for advanced PowerGrid voltage management."
	]
	quest.514F01000001001E.title: "Transformer Core"
	quest.514F01000001001F.quest_desc: [
		"The &6Energy Analyzer&r (Energized Power) reads a connected EP component's instantaneous voltage, current, and power."
		""
		"Diagnostic handheld for EP networks."
	]
	quest.514F01000001001F.quest_subtitle: "Read every wire."
	quest.514F01000001001F.title: "Energy Analyzer"
	quest.514F010000010020.quest_desc: [
		"The &6Fluid Analyzer&r (Energized Power) reads a connected EP fluid component's flow rate and pressure."
		""
		"Pair with the energy analyzer for full network diagnostics."
	]
	quest.514F010000010020.title: "Fluid Analyzer"
	quest.514F010000010021.quest_desc: [
		"The &6EP Wrench&r is Energized Power's configuration tool. Right-click EP machines and cables to cycle modes."
		""
		"Carry alongside other mod wrenches for full coverage."
	]
	quest.514F010000010021.title: "Wrench"
	quest.514F010000010022.quest_desc: [
		"The &6Connector&r (Create Addition) is the wire-attachment point for CA electrical components."
		""
		"Place on machines and capacitors; right-click with copper wire to start a wire run."
	]
	quest.514F010000010022.quest_subtitle: "Create + FE bridge."
	quest.514F010000010022.title: "Connector"
	quest.514F010000010023.quest_desc: [
		"The &6Large Connector&r (Create Addition) is the high-throughput connector variant. Carries more current than the standard connector."
		""
		"Use for backbone power runs and high-draw machines."
	]
	quest.514F010000010023.quest_subtitle: "Wider FE bridge."
	quest.514F010000010023.title: "Large Connector"
	quest.514F010000010024.quest_desc: [
		"The &6Redstone Relay&r (Create Addition) is a redstone-controlled switch. Acts as a logic gate within Create Addition wiring."
		""
		"&aSimpler than ProjectRed gates — useful for inline conditional power switching.&r"
	]
	quest.514F010000010024.title: "Redstone Relay"
	quest.514F010000010025.quest_desc: [
		"The &6Digital Adapter&r (Create Addition) is the bridge between CA wiring and digital signal protocols. Pulses redstone in response to wire-network events."
		""
		"Niche but powerful for Create-driven automation logic."
	]
	quest.514F010000010025.title: "Digital Adapter"
	quest.514F010000010026.quest_desc: [
		"&6Diamond Grit Sandpaper&r (Create Addition) polishes mechanical components, removing wear and increasing efficiency."
		""
		"Quality-of-life upgrade for the dedicated Create player."
	]
	quest.514F010000010026.quest_subtitle: "Polish, infinitely."
	quest.514F010000010026.title: "Diamond Grit Sandpaper"
	quest.52453550206EC770.quest_desc: [
		"Build a &6Dyer's Hut&r — the citizen who processes flowers and natural pigments into dyes."
		""
		"Required for colored cloth and decorative-block recipes."
	]
	quest.5246010000010001.quest_desc: [
		"The &6Simple Machine Frame&r is Industrial Foregoing's entry-tier chassis. Almost every IF machine in this chapter starts here — frame plus pink slime, plus whatever specialty parts the recipe demands."
		""
		"This is the gateway to the entire IF tree. Make at least a handful — you'll burn through them fast as the chapter opens up."
		""
		"&aIF's three machine tiers (Simple → Advanced → Supreme) gate the chapter. Each tier unlocks more machines.&r"
	]
	quest.5246010000010001.title: "&eThe Refinery&r"
	quest.5246010000010002.quest_desc: [
		"The &6Fluid Extractor&r taps rubberwood-style trees for &6Latex&r — IF's organic precursor to plastic. Aim it at a log, give it power, and it draws fluid out without breaking the tree."
		""
		"Latex feeds the &6Latex Processing Unit&r in the next quest, which turns it into Tiny Dry Rubber and ultimately into plastic — the universal IF crafting material."
	]
	quest.5246010000010002.title: "Fluid Extractor"
	quest.5246010000010003.quest_desc: [
		"The &6Latex Processing Unit&r boils latex into &6Tiny Dry Rubber&r, the precursor to IF's signature &6Plastic&r. Once you have plastic, the rest of the IF tech tree opens up."
		""
		"Plastic shows up in nearly every IF recipe past this point. Build a sustained pipeline — Fluid Extractor on rubberwood, latex piped here, dry rubber piped to crafting — and stop worrying about it."
		""
		"&aPlastic is also a recipe ingredient elsewhere in the pack (PneumaticCraft etc.). Worth automating early.&r"
	]
	quest.5246010000010003.title: "Latex Processing Unit"
	quest.5246010000010004.quest_desc: [
		"The basic IF fluid stack — &6Fluid Pump&r (extracts source blocks from the world), &6Fluid Collector&r (catches fluids in front of it), &6Fluid Placer&r (places fluid blocks), and &6Fluid Crafter&r (auto-crafts using fluid containers)."
		""
		"Together these turn fluid handling from manual bucket-running into actual industrial plumbing. The Pump in particular is your gateway to infinite-water and lava-pumping setups."
	]
	quest.5246010000010004.title: "Fluid Logistics Bundle"
	quest.5246010000010005.quest_desc: [
		"The &6Water Condensator&r generates water from thin air at the cost of FE. Useful when you don't want to plumb in a real water source or you're building somewhere dry."
		""
		"&7Optional. Vanilla infinite water sources are still cheaper.&r"
	]
	quest.5246010000010005.title: "Water Condensator"
	quest.5246010000010006.quest_desc: [
		"The &6Lava Fabricator&r generates lava from FE, no nether trip required. Slow but reliable — good for thermal generators that just need a steady trickle."
		""
		"&7Optional. Cheaper than mining lava if you have the power to spare.&r"
	]
	quest.5246010000010006.title: "Lava Fabricator"
	quest.5246010000010007.quest_desc: [
		"The &6Sludge Refiner&r processes the &6Sludge&r byproduct from the IF mob slaughter / mob crusher pipeline into useful materials — dirt, sand, soul sand, clay, and other terrain blocks."
		""
		"&7Optional. Mostly useful when you have a high-throughput mob farm dumping sludge faster than you can store it.&r"
	]
	quest.5246010000010007.title: "Sludge Refiner"
	quest.5246010000010008.quest_desc: [
		"The &6Fermentation Station&r ferments organic matter into &6Biofuel&r, IF's renewable liquid fuel. Pair it with the Bioreactor + Biofuel Generator stack later in the chapter for a closed-loop power cycle."
		""
		"&7Optional but recommended if you're committing to IF's biofuel power path.&r"
	]
	quest.5246010000010008.title: "Fermentation Station"
	quest.524601000001000A.quest_desc: [
		"The &6Spores Recreator&r grows mushrooms by simulating the right environment. Mushroom-stem and red/brown mushroom production without the slow vanilla growth cycle."
		""
		"&7Optional. Worth it for mushroom-heavy recipes (witchcraft, alchemy, IF mycelial cores).&r"
	]
	quest.524601000001000A.title: "Spores Recreator"
	quest.524601000001000B.quest_desc: [
		"The &6Ore Dictionary Converter&r and &6Fluid Dictionary Converter&r swap between equivalent items or fluids tagged the same way (e.g. one mod's copper ingot for another's). Handy when cross-mod automation produces the wrong namespace."
		""
		"&7Optional. Most useful in mixed-mod factories where tagged equivalents matter.&r"
	]
	quest.524601000001000B.title: "Dictionary Converters"
	quest.524601000001000C.quest_desc: [
		"The &6Advanced Machine Frame&r is IF's mid-tier chassis — every machine gated behind it is more powerful, more specialized, or more dangerous than the Simple-tier set."
		""
		"This is the second of three tier gates. Plant farming, animal management, the slaughter factory, the black-hole storage line — they all sit on this frame."
		""
		"&aBatch-build several frames at once. The chapter expands sharply once you're past this point.&r"
	]
	quest.524601000001000C.title: "&6Advanced Machine Frame&r"
	quest.524601000001000D.quest_desc: [
		"The &6Plant Sower&r plants seeds in its working area and the &6Plant Gatherer&r harvests whatever's grown. Together they're the heart of every IF farm setup."
		""
		"You will build one of these per crop you care about. Sower facing one way, Gatherer facing the other, conveyors carrying outputs back to storage. Set it once and the farm runs forever."
		""
		"&aThe Gatherer is range-limited by upgrade slots. Add range addons for bigger plots.&r"
	]
	quest.524601000001000D.title: "Plant Sower + Gatherer"
	quest.524601000001000E.quest_desc: [
		"The &6Plant Fertilizer&r sprays IF's &6Fertilizer&r over crops in its working area, dramatically boosting growth speed."
		""
		"This is the difference between a farm that produces a steady trickle and one that produces a flood. Pair it with the Sower/Gatherer and your farm output rate jumps several times over."
	]
	quest.524601000001000E.title: "Plant Fertilizer"
	quest.524601000001000F.quest_desc: [
		"The &6Hydroponic Bed&r is IF's vertical farming block — plants grow in it directly, no dirt or water source required, just nutrient-rich fluids piped in."
		""
		"&6Mechanical Dirt&r is the farmable, machine-friendly substrate. Together they let you stack farms vertically and pack tremendous crop output into a tiny footprint."
		""
		"&aCheck JEI for which fluids each crop accepts. Some plants are picky.&r"
	]
	quest.524601000001000F.title: "Hydroponic Farm"
	quest.5246010000010010.quest_desc: [
		"The &6Plant Interactor&r right-clicks plants in its working area — useful for crops that drop on bone-meal interaction, fruit trees, or mods where right-click is the harvest action."
		""
		"&7Optional. Most vanilla and IF-direct crops harvest fine with the standard Plant Gatherer.&r"
	]
	quest.5246010000010010.title: "Plant Interactor"
	quest.5246010000010011.quest_desc: [
		"The &6Bioreactor&r ferments harvested plants into &6Biofuel&r, and the &6Biofuel Generator&r burns it back into FE. This is Industrial Foregoing's first closed-loop power cycle."
		""
		"Plug it into your Sower/Gatherer farm and the farm pays its own power bill. It's not the highest tier of generator in the pack, but it's the simplest to set up and the most resilient."
		""
		"&aYou need biofuel diversity, not volume. The Bioreactor's output scales with how many different plant types you feed it.&r"
	]
	quest.5246010000010011.title: "Biofuel Power Loop"
	quest.5246010000010012.quest_desc: [
		"The &6Animal Feeder&r keeps animals in its working area in love mode by consuming the appropriate breeding food. The &6Animal Rancher&r milks cows, shears sheep, and collects similar non-lethal drops."
		""
		"Together they turn a fenced pasture into a passive byproduct factory. Wool, milk, mooshroom stew, no-kill leather — all of it on a steady drip."
	]
	quest.5246010000010012.title: "Animal Feeder + Rancher"
	quest.5246010000010013.quest_desc: [
		"The &6Animal Baby Separator&r moves baby animals out of the breeding pen and the &6Animal Growth Increaser&r ages them up faster. Together they fix the bottleneck where adults stop breeding because babies clog the area."
		""
		"&7Optional. Worth it for high-throughput meat or wool farms; overkill for a small pasture.&r"
	]
	quest.5246010000010013.title: "Animal Husbandry"
	quest.5246010000010014.quest_desc: [
		"The &6Marine Fisher&r is IF's automated fishing rig — place it over deep water, give it power, and it pulls fish, junk, and treasure on a steady cycle."
		""
		"&7Optional. Niche, but the only reasonable way to bulk-farm fishing-loot enchanted books or treasure-tier drops.&r"
	]
	quest.5246010000010014.title: "Marine Fisher"
	quest.5246010000010015.quest_desc: [
		"The &6Sewer&r collects animal waste from creatures in its working area into &6Sewage&r fluid; the &6Sewage Composter&r turns sewage back into &6Fertilizer&r."
		""
		"&7Optional. A self-sustaining fertilizer loop if you already have a passive animal pen running, but vanilla bone meal is competitive.&r"
	]
	quest.5246010000010015.title: "Sewer + Composter"
	quest.5246010000010016.quest_desc: [
		"The &6Fluid Sieving Machine&r runs fluids through a sieve and pulls dissolved materials out of them — extracting trace materials from sewage, biofuel, or other byproduct fluids."
		""
		"&7Optional. Niche but useful when you have heavy fluid byproducts to mine.&r"
	]
	quest.5246010000010016.title: "Fluid Sieving Machine"
	quest.5246010000010018.quest_desc: [
		"The &6Mob Slaughter Factory&r kills mobs in its working area and converts them into &6Liquid Meat&r, &6Pink Slime&r, and other fluids. It's the IF answer to the standard mob farm — drops are converted to fluids on the spot."
		""
		"This is the mob-farming branch of the chapter. From this single block hangs the pink slime line, the meat-feeder line, and the stasis-chamber line — all the things IF does with captured living mobs."
		""
		"&cKills everything in range.&r Place it carefully, ideally over a darkroom spawner or a Mob Duplicator setup."
	]
	quest.5246010000010018.title: "&cMob Slaughter Factory&r"
	quest.5246010000010019.quest_desc: [
		"The &6Mob Imprisonment Tool&r captures live mobs in a reusable jar — right-click an empty tool on a mob, place the filled tool in a Stasis Chamber or other IF mob device, and the mob comes back out."
		""
		"This is how you move named mobs, keep specific spawns alive, or seed IF mob-handling machines with known creatures."
		""
		"&aOne tool can be reused indefinitely. Don't try to mass-produce them.&r"
	]
	quest.5246010000010019.title: "Mob Imprisonment Tool"
	quest.524601000001001A.quest_desc: [
		"The &6Meat Feeder&r is a worn item that quietly sips &6Liquid Meat&r from a connected source to keep your hunger bar full. Wear it and stop eating, basically."
		""
		"&7Optional QOL.&r Pair with the Mob Slaughter Factory's liquid meat output for permanent self-feeding."
	]
	quest.524601000001001A.title: "Meat Feeder"
	quest.524601000001001B.quest_desc: [
		"&6Pink Slime&r and the &6Pink Slime Bucket&r are byproducts of the Mob Slaughter Factory — when the factory kills enough mobs, pink slime fluid accumulates and pink slime mobs occasionally spawn from it."
		""
		"This is the gateway material to the &6Pink Slime Ingot&r — IF's signature alloy and a recipe ingredient in nearly every higher-tier IF machine. The mob-slaughter branch is what makes the rest of IF affordable."
	]
	quest.524601000001001B.title: "Pink Slime"
	quest.524601000001001C.quest_desc: [
		"&6Pink Slime Ingots&r and &6Pink Slime Blocks&r are the universal IF advanced material. Almost every Advanced or Supreme tier recipe past this point uses pink slime ingots somewhere."
		""
		"This is the linchpin of the chapter. A working pink-slime pipeline (Mob Slaughter Factory → fluid storage → Dissolution Chamber for ingots) is the prerequisite for the rest of IF's advanced tree."
		""
		"&aOnce production is steady, build several stacks of ingots at once. Demand only goes up.&r"
	]
	quest.524601000001001C.title: "&dPink Slime Ingot&r"
	quest.524601000001001D.quest_desc: [
		"The &6Stasis Chamber&r freezes a captured mob in place. Combined with the &6Mob Imprisonment Tool&r, it lets you hold specific creatures (boss spawns, named pets, breeding-stock animals) safely in storage."
		""
		"&7Optional. Useful for keeping a specimen alive without occupying real-world space.&r"
	]
	quest.524601000001001D.title: "Stasis Chamber"
	quest.5246010000010024.quest_desc: [
		"The &6Resourceful Furnace&r is IF's automated furnace — feed it items and fuel, get smelted output. It's a furnace with hopper-friendly faces and a higher item buffer than vanilla."
		""
		"Useful as an early-Gilded auto-smelter for stockpiling iron, gold, food, etc. without thinking about it."
	]
	quest.5246010000010024.title: "Resourceful Furnace"
	quest.5246010000010025.quest_desc: [
		"The &6Ore Processor&r takes raw ores in and gives back a configured ratio of ingots, dusts, or doubled outputs depending on settings."
		""
		"&7Optional. Useful as a pre-Mekanism / pre-Oritech ore-doubler for IF-only bases.&r"
	]
	quest.5246010000010025.title: "Ore Processor"
	quest.5246010000010026.quest_desc: [
		"The &6Material Stonework Factory&r runs stone-family materials through a configurable pipeline — cobblestone to stone to smooth stone, or stone to bricks, slabs, stairs."
		""
		"&7Optional. Worth it for any large building project where vanilla stonecutting is too slow.&r"
	]
	quest.5246010000010026.title: "Material Stonework Factory"
	quest.5246010000010027.quest_desc: [
		"The &6Washing Factory&r runs items through a fluid wash cycle — useful for cleaning byproducts, refining mob drops, or extracting tagged sub-products from raw materials."
		""
		"&7Optional. The single most niche of the IF processing factories — but indispensable when your specific recipe needs it.&r"
	]
	quest.5246010000010027.title: "Washing Factory"
	quest.5246010000010028.quest_desc: [
		"The IF enchantment line — &6Enchantment Extractor&r pulls enchantments off gear into books, &6Enchantment Factory&r generates books from raw XP, and &6Enchantment Applicator&r writes books back onto gear."
		""
		"This is automated enchanting. Combined with a working XP-to-fluid pipeline (Mob Crusher / Mob Slaughter Factory), you can mass-produce enchanted books and apply them on demand."
		""
		"&aPair with the optional Enchantment Sorter to filter books by enchantment type.&r"
	]
	quest.5246010000010028.title: "Enchantment Automation"
	quest.5246010000010029.quest_desc: [
		"The &6Enchantment Sorter&r filters enchanted books by enchantment type — useful for routing specific enchantments to specific destinations in an automated enchanting pipeline."
		""
		"&7Optional. Mostly worth it if the Enchantment Factory is your primary book source.&r"
	]
	quest.5246010000010029.title: "Enchantment Sorter"
	quest.524601000001002A.quest_desc: [
		"The &6Potion Brewer&r is IF's automated brewing stand — bottles in, ingredients in, brewed potions out."
		""
		"&7Optional. The fastest way to mass-produce splash and lingering potions if your build leans on potion effects.&r"
	]
	quest.524601000001002A.title: "Potion Brewer"
	quest.524601000001002B.quest_desc: [
		"The &6Dye Mixer&r takes flowers, dyes, or pigment-bearing materials and produces &6Artificial Dye&r — IF's standard dye output. Sixteen of them is enough for any serious dyeing project."
		""
		"&7Optional. The cheap way to bulk-produce dye if your decor or banner-printing plans call for it.&r"
	]
	quest.524601000001002B.title: "Dye Mixer"
	quest.524601000001002D.quest_desc: [
		"The &6Mob Detector&r emits a redstone signal when mobs are present in its working area. Useful for triggering traps, lighting up arenas, or pausing slaughter factories when no spawns are around."
		""
		"&7Optional. Niche but useful for conditional automation.&r"
	]
	quest.524601000001002D.title: "Mob Detector"
	quest.524601000001002E.quest_desc: [
		"The &6Conveyor&r is IF's transport belt. Place items on top and they slide along; configure with upgrades for filtering, splitting, or directional locking."
		""
		"This is the visual signature of an IF factory. Even if you have AE2 or Mekanism logistics, conveyors are still the cheap, animated, satisfying way to move items between adjacent machines."
	]
	quest.524601000001002E.title: "Conveyor Belt"
	quest.524601000001002F.quest_desc: [
		"The IF block-manipulation set — &6Block Breaker&r breaks the block in front of it, &6Block Placer&r places blocks from its inventory, and &6Item Splitter&r divides item flows on a conveyor."
		""
		"Together they let you build cobblegen-style block loops, automated farms that need block placement (cactus, sugar cane), and basic logistics-splitter routing."
	]
	quest.524601000001002F.title: "Conveyor Logistics"
	quest.5246010000010031.quest_desc: [
		"The &6Machine Settings Copier&r reads upgrade and configuration settings from one IF machine and writes them onto another. Indispensable when you've spent ten minutes tuning a Plant Gatherer and want to clone its config to fifteen more."
		""
		"&7Optional QOL. Save it for the moment you realize you're configuring identical machines by hand.&r"
	]
	quest.5246010000010031.title: "Machine Settings Copier"
	quest.5246010000010032.quest_desc: [
		"Hold the IF mid-tier capstone set at once — &6Advanced Machine Frame&r, &6Supreme Black Hole Tank&r, &6Hydroponic Bed&r, and &6Pink Slime Ingot&r — to confirm IF's Gilded-tier infrastructure is fully online."
		""
		"This is the chapter's exit gate. Plant farming, mob slaughter, pink slime alloys, and supreme storage — all four pillars of IF Gilded — are demonstrated here. Beyond it, the chapter dependencies in &6AT3 Chain Reaction&r and &6AT4 Machine Soul&r open up."
		""
		"&5IF's Gilded-era refinery is complete. Next stop: Atomic-tier supreme machines.&r"
	]
	quest.5246010000010032.title: "&5The Refinery Complete&r"
	quest.526166842F911621.quest_desc: ["The &6Pastel Guidebook&r — read it cover-to-cover before attempting fusion shrine work. Pastel's recipe paths are non-obvious."]
	quest.5265E6A242B2FBBD.quest_desc: [
		"&6Forge Armor Trim Smithing Template&r — a cosmetic trim featuring the Starlight Golem's hammer-and-anvil motif. Apply to any armor piece to engrave the trim."
		""
		"&7Pure cosmetic. Worth doing if you care about how your armor looks; skip otherwise.&r"
	]
	quest.52864CF4C7626519.quest_desc: [
		"&6Resonarium Plate&r — pressed and refined from raw resonarium ingots. The foundation of the resonarium tool tier."
		""
		"You'll need stacks of these for the axe/sword/pickaxe set and the smithing template upgrade."
	]
	quest.52FA3E4B2B33095B.quest_desc: [
		"The &6Dagger of Hunger&r is the fast, hungry Starlight blade — quick stabs, lifesteal flavor, and a name that earns itself in combat."
		""
		"This is the convergence quest before the dimension's four-boss gauntlet. From here you can branch toward any of the four bosses: Starlight Golem, Permafrost, Lunar Monstrosity, or Infernal Dragon."
	]
	quest.530929CF8BDFFCBC.quest_desc: [
		"&6Elite Importer&r (Cable Tiers) — a higher-throughput version of the standard Importer. Faster operation without needing speed upgrades."
		""
		"&aCable Tiers replaces the 'speed-upgrade-stack' approach with discrete tiers. Cleaner inventory, equivalent performance.&r"
	]
	quest.531E4A196A14C825.quest_desc: [
		"The &6Enchantment Workbench&r is Gaze's rune-application station. Place gear in one slot, runes in another, and bind them permanently."
		""
		"&aThe equivalent of Malum's altar but specifically for Gaze runes.&r"
	]
	quest.532666873B8B703D.quest_desc: [
		"&6Warden Upgrade Smithing Template&r — the smithing template needed to forge Warden-tier gear. The Sculk Transmitter chain leads here."
		""
		"&cWithout this, no Warden carapace, no Reinforced Echo Shard, no capstone armor.&r"
	]
	quest.5343010000010001.quest_desc: [
		"&6Red Ingots&r are ProjectRed's signature redstone-infused metal. Made from iron + redstone in a furnace."
		""
		"&aReagent in nearly every ProjectRed recipe.&r The starting material of the redstone-overhaul mod."
	]
	quest.5343010000010001.quest_subtitle: "&7Optional ProjectRed deep-dive.&r"
	quest.5343010000010001.title: "Down the Wire"
	quest.5343010000010003.quest_desc: [
		"&6PR Plates&r are flattened red ingots. Used as a substrate for chips and circuit boards."
		""
		"Made by hammering a red ingot."
	]
	quest.5343010000010003.quest_subtitle: "&7Boards and traces.&r"
	quest.5343010000010003.title: "Plates  Boards"
	quest.5343010000010004.quest_desc: [
		"&6Electrotine Ingots&r are ProjectRed's high-tier conductor metal. Higher capacity than red ingots."
		""
		"&aMid-tier ProjectRed material — required for the bundled wire and advanced gates.&r"
	]
	quest.5343010000010004.quest_subtitle: "&7The motion side.&r"
	quest.5343010000010004.title: "Electrotine Alloy"
	quest.5343010000010005.quest_desc: [
		"The &6Silicon Chip&r is ProjectRed's circuit chip — etched silicon on a plate substrate."
		""
		"&aCore component of every ProjectRed integration gate.&r &cThis pack patches the silicon chip recipe via KubeJS — the vanilla recipe requires &7cb_microblock:diamond_saw&r&c which isn't in the pack.&r"
	]
	quest.5343010000010005.quest_subtitle: "&7Doped silicon — gate brains.&r"
	quest.5343010000010005.title: "Silicon Chip"
	quest.5343010000010006.quest_desc: [
		"&6Wired Plates&r are plate substrates with red-alloy traces etched on. Component in ProjectRed chip and gate recipes."
		""
		"Made by combining plates with red alloy wire."
	]
	quest.5343010000010006.quest_subtitle: "&7One channel or sixteen.&r"
	quest.5343010000010006.title: "Wired  Bundled Plates"
	quest.5343010000010007.quest_desc: [
		"The &6NOT Gate&r is ProjectRed's logic-inverter. Outputs the inverse of its input."
		""
		"&aSingle-block replacement for a vanilla redstone-torch-on-block inverter.&r"
	]
	quest.5343010000010007.quest_subtitle: "&7AND, OR, NOT, XOR, NAND, NOR, XNOR, Buffer.&r"
	quest.5343010000010007.title: "Boolean Logic"
	quest.5343010000010008.quest_desc: [
		"Holding the &6Timer Gate&r confirms your ProjectRed clock is built — cleaner than a redstone-loop clock contraption."
		""
		"Configure interval; outputs pulses at the set rate."
	]
	quest.5343010000010008.quest_subtitle: "&7Timer, Sequencer, Counter, Repeater, Pulse Former.&r"
	quest.5343010000010008.title: "Timing  Counting"
	quest.5343010000010009.quest_desc: [
		"The &6SR Latch Gate&r is ProjectRed's set-reset memory cell. Holds state until reset."
		""
		"Useful for toggle logic and persistent flag states."
	]
	quest.5343010000010009.quest_subtitle: "&7RS Latch, Toggle Latch, State Cell, Synchronizer.&r"
	quest.5343010000010009.title: "Memory  State"
	quest.534301000001000A.quest_desc: [
		"The &6Light Sensor Gate&r outputs a redstone signal based on the local light level."
		""
		"Single-tile alternative to vanilla daylight sensors with finer logic options."
	]
	quest.534301000001000A.quest_subtitle: "&7Light, weather, randomness, comparison.&r"
	quest.534301000001000A.title: "Sensors  World"
	quest.534301000001000B.quest_desc: [
		"The &6Auto Crafter&r (ProjectRed Expansion) is a redstone-triggered automatic crafter. Place a recipe; pulse a redstone signal; craft executes."
		""
		"&aFor focused single-recipe automation, simpler than AE2 patterns.&r"
	]
	quest.534301000001000B.quest_subtitle: "&7Pre-AE2 autocrafting in one block.&r"
	quest.534301000001000B.title: "Autocrafting"
	quest.534301000001000C.quest_desc: [
		"The &6Pneumatic Tube&r (ProjectRed Expansion) is PR's item-transport pipe. Items travel as pneumatic packets through the tube network."
		""
		"&aColored routing supports priority-based sorting.&r"
	]
	quest.534301000001000C.quest_subtitle: "&7Pneumatic tubes + transposers.&r"
	quest.534301000001000C.title: "Item Transport"
	quest.534301000001000D.quest_desc: [
		"The &6Illumar Smart Lamp&r is a redstone-controlled colored light source. Receives bundled signal to set color and brightness."
		""
		"Useful for status displays and color-coded indicators."
	]
	quest.534301000001000D.quest_subtitle: "&7Smart lamps + inverted variants.&r"
	quest.534301000001000D.title: "Smart Lighting"
	quest.5347010000010002.quest_desc: [
		"The &6Unstable Container&r — Oritech's vessel for materials too volatile to store conventionally. Holds reactions that would otherwise erase the surrounding chunks."
		""
		"&aRequired for several Singularity recipes.&r Treat it carefully — the name is descriptive, not metaphorical."
	]
	quest.5347010000010002.title: "Schrodinger's Safe"
	quest.5347010000010004.quest_desc: [
		"The &6Heisenberg Compensator&r — Oritech's quantum-uncertainty stabilizer. Required for any process that needs to know both position and momentum simultaneously."
		""
		"&aReality refuses to cooperate at this scale.&r The compensator is what makes the rest of the chapter possible."
	]
	quest.5347010000010004.title: "Heisenberg Compensation"
	quest.5347010000010006.quest_desc: [
		"The &6Accelerator Controller&r — the brain of Oritech's particle accelerator multiblock. Place this and assemble the ring; collisions inside generate the exotic outputs the rest of the chapter consumes."
		""
		"&aThis is the same kind of project Earth runs at CERN, scaled down to your factory floor.&r"
	]
	quest.5347010000010006.title: "Dimensional Accelerator"
	quest.5347010000010007.quest_desc: [
		"Use a &6Crying Obsidian&r block. The deep purple tear-stone is part of the Singularity ritual chain — its emotional weight, in lore terms, contributes to the gravitational signature the assembly needs."
		""
		"&aRight-click the block to mark it used.&r Symbolic, but the chapter wants the receipt."
	]
	quest.5347010000010007.title: "Reinforced Breach"
	quest.5347010000010008.quest_desc: [
		"Use an &6End Portal Frame&r — the vanilla gateway block that anchors travel between worlds. The Singularity assembly draws on the same dimensional-folding physics."
		""
		"&aA poetic choice by the chapter author:&r before you build a black hole, you touch the block that already does what black holes do — bend space."
	]
	quest.5347010000010008.title: "Ancient Portal Alignment"
	quest.5347010000010009.quest_desc: [
		"&5The Black Hole Block.&r You have, in some abstracted-but-meaningful sense, built a black hole. The block is a stable singularity — gravity, time dilation, and matter compression all packed into a single voxel."
		""
		"Right-click it to engage. The mechanic is dramatic: it eats anything that strays too close and outputs the most exotic resources the pack contains."
		""
		"&5Reality bends around this block.&r You have done what physicists only theorize about."
	]
	quest.5347010000010009.title: "Create the Black Hole"
	quest.534701000001000A.quest_desc: [
		"&5Operate the black hole for one full minute.&r Hold a &6Machine Core T7&r — Oritech's apex tier-7 processing component, the ceiling of conventional Oritech machinery — and let the timer run."
		""
		"This is the chapter's terminal capstone. You're proving that the Singularity is not a one-shot fireworks display. It runs. It sustains. It produces."
		""
		"&5Sixty seconds of stable singularity.&r The black hole pays out."
	]
	quest.534701000001000A.title: "Singularity Achieved"
	quest.5350010000010001.quest_desc: [
		"The &6Copper Pickaxe&r from Overgeared — a milestone marker for the very beginning of the Journey. You crafted your first non-stone tool. The Dark Ages have officially begun."
		""
		"This is the first stop on the Journey waypoint chain that traces the pack from copper to Infinity. Each quest in this chapter is a token of an age or a major transition."
	]
	quest.5350010000010001.quest_subtitle: "&7Dark Ages&r"
	quest.5350010000010001.title: "Copper Pickaxe"
	quest.5350010000010002.quest_desc: [
		"The &6Sol Visage&r from Mowzie's Mobs — the drop from Umvuthi. Symbolic of the journey you've gone through, but Umvuthi alone does not open the Renaissance anymore: finish the &6What Waits In The Grove&r Mowzie's Trial capstone by clearing any 3 of its 4 boss trials."
		""
		"A milestone for Medieval → Renaissance. Clear any 3 of the 4 Grove boss trials, then claim Mowzie's Trial to open the Renaissance."
	]
	quest.5350010000010002.quest_subtitle: "&6Medieval Times&r"
	quest.5350010000010002.title: "Trial of Bosses"
	quest.5350010000010003.quest_desc: [
		"The &6Hephaestus Forge T1&r from Forbidden Arcanus — built in the Renaissance after Nether access opens up. The first of five tier upgrades on the pack's central magic-forge progression."
		""
		"&aEach Hephaestus Forge tier upgrade marks a major age transition:&r T1 = post-Nether Renaissance, T2 = IR-final Obsidilith prep, T3 = Gilded Age, T4 = Atomic, T5 = late Atomic or beyond."
	]
	quest.5350010000010003.quest_subtitle: "&bThe Renaissance&r"
	quest.5350010000010003.title: "Hephaestus Forge (T1)"
	quest.5350010000010004.quest_desc: [
		"The &6Cloud Staff&r from the Aether — a Renaissance milestone. By now you've explored at least one alternate dimension and brought back its signature crafting reward."
		""
		"&aThe Aether is one of the Renaissance side-adventures.&r Cloud staffs, valkyries, and golden friends build power before the Maledictus path opens the Industrial Revolution."
	]
	quest.5350010000010004.quest_subtitle: "&bThe Renaissance&r"
	quest.5350010000010004.title: "Cloud Staff"
	quest.5350010000010005.quest_desc: [
		"The &6Aeternium Sword&r from BetterEnd — a milestone for reaching apex End-tier melee. Faster than netherite, brighter than diamond, and the signature of OW6's BetterEnd branch."
		""
		"&aWhen you hold this, you've engaged with the End deeply enough to know the difference.&r"
	]
	quest.5350010000010005.quest_subtitle: "&9Otherworldly&r"
	quest.5350010000010005.title: "Aeternium Sword"
	quest.5350010000010006.quest_desc: [
		"The &6Soul Elytra&r from Deeper Darker — an upgraded elytra forged from Otherside dimensional materials. Stronger durability, soul-themed visuals, and proof you've explored Deeper Darker's signature dimension."
		""
		"&aA Renaissance mobility milestone.&r Stronger flight makes the End, Deeper Darker, and late Renaissance boss routing much less painful."
	]
	quest.5350010000010006.quest_subtitle: "&bThe Renaissance&r"
	quest.5350010000010006.title: "Soul Elytra"
	quest.5350010000010007.quest_desc: [
		"The &6Precision Mechanism&r from Create — the iconic mid-tier crafting component that gates almost every advanced Create recipe."
		""
		"&aThe Industrial Revolution's signature component.&r After Maledictus opens IR, build Create stress, brass, and deployer automation until precision mechanisms become routine."
	]
	quest.5350010000010007.quest_subtitle: "&8Industrial Revolution&r"
	quest.5350010000010007.title: "Precision Mechanism"
	quest.5350010000010008.quest_desc: [
		"The &6Refined Storage Autocrafter&r — the entry-tier autocrafting block for Refined Storage's network."
		""
		"&aIndustrial Revolution autocrafting milestone.&r Use this after your storage/network chapter teaches patterning; automation should start replacing hand-crafting here."
	]
	quest.5350010000010008.quest_subtitle: "&8Industrial Revolution&r"
	quest.5350010000010008.title: "Autocrafter"
	quest.535001000001000A.quest_desc: [
		"The &6Cursium Ingot&r from Cataclysm — the dark-purple metal forged from defeating Cataclysm bosses. Reagent for the mod's late-tier weapons and proof of mid-game boss conquest."
		""
		"&aA waypoint deep into Cataclysm's boss spine.&r Follow the Maledictus Vigil next: Maledictus is the Renaissance-to-Industrial Revolution gate."
	]
	quest.535001000001000A.quest_subtitle: "&bThe Renaissance&r"
	quest.535001000001000A.title: "Cursium Ingot"
	quest.535001000001000B.quest_desc: [
		"The &6Basic Machine Hull&r from Modern Industrialization — the foundational chassis for every MI machine. The block that says: you have started the engineering spine."
		""
		"&aMI is the IR-to-Gilded engineering progression.&r From here, tier up through Steel, Aluminum, Stainless, Titanium, and Tungstensteel as the factory spine advances."
	]
	quest.535001000001000B.quest_subtitle: "&8Industrial Revolution&r"
	quest.535001000001000B.title: "Basic Machine Hull"
	quest.535001000001000C.quest_desc: [
		"The &6Exo Chestplate&r from Oritech — the body of the exoskeleton system, slot-aware for advanced augments."
		""
		"&aGilded Oritech milestone.&r Once Obsidilith opens Gilded, Oritech expands from machines into powered gear and exosuit progression."
	]
	quest.535001000001000C.quest_subtitle: "&eGilded Age&r"
	quest.535001000001000C.title: "Exo Chestplate"
	quest.535001000001000D.quest_desc: [
		"The &6Advanced Battery Box&r from Energized Power — a high-capacity FE/RF storage block. Marks engagement with Energized Power's electrical progression."
		""
		"&aA mid-IR engineering waypoint for the RF/FE side of the pack.&r Use it as a sign that your power buffers and basic electrical backbone are online."
	]
	quest.535001000001000D.quest_subtitle: "&8Industrial Revolution&r"
	quest.535001000001000D.title: "Advanced Battery Box"
	quest.535001000001000E.quest_desc: [
		"The &6Atomic Alloy&r from Mekanism — the apex Mekanism alloy, made from refined obsidian and processed in late-game MI/Mek crossover recipes."
		""
		"&aLate-IR Mekanism milestone.&r This proves you have pushed Mek alloy crafting past the basics; deeper chemistry and nuclear work continue in later ages."
	]
	quest.535001000001000E.quest_subtitle: "&8Industrial Revolution&r"
	quest.535001000001000E.title: "Atomic Alloy"
	quest.535001000001000F.quest_desc: [
		"The &6Red Ingot&r from ProjectRed — the signature material of ProjectRed's Redstone-logic content. Forged from electrotine and ruby chips."
		""
		"&aHolding one is a marker that you've engaged with ProjectRed's signal-and-circuits sidebar.&r"
	]
	quest.535001000001000F.quest_subtitle: "&8Industrial Revolution&r"
	quest.535001000001000F.title: "Red Alloy Ingot"
	quest.5350010000010010.quest_desc: [
		"The &6AE2 64K Item Storage Cell&r — Applied Energistics 2's high-capacity storage cell, built from late-game spatial-pylon-tier recipes."
		""
		"&aIndustrial storage milestone.&r Holding a 64K cell means AE2 is no longer just storage; it is becoming the backbone of your factory logistics."
	]
	quest.5350010000010010.quest_subtitle: "&8Industrial Revolution&r"
	quest.5350010000010010.title: "64k Storage Cell"
	quest.5350010000010013.quest_desc: [
		"The &6Phoenix Bow&r from the Aether — the high-tier ranged weapon dropped or crafted from late-Aether content. Fire-aspect arrows, beautiful firing animation."
		""
		"&aThe Aether's Renaissance combat-completion milestone.&r Clean up this branch before the final Renaissance gate asks you to prove broader boss readiness."
	]
	quest.5350010000010013.quest_subtitle: "&bThe Renaissance&r"
	quest.5350010000010013.title: "Phoenix Bow"
	quest.5350010000010014.quest_desc: [
		"The &6Obsidian Heart&r — drop from the &5Obsidilith&r boss in Bosses of Mass Destruction, the IR-final age gate."
		""
		"&aThe Industrial Revolution conqueror's trophy.&r You killed Obsidilith. The Gilded Age opened. This shard is the receipt."
	]
	quest.5350010000010014.quest_subtitle: "&eGilded Age&r"
	quest.5350010000010014.title: "Obsidian Heart"
	quest.5350010000010017.quest_desc: [
		"The &6Stellaris Rocket&r — the assembled, fueled vehicle that takes you to space. The Otherworldly gateway artifact."
		""
		"&aOtherworldly begins here.&r The planetary tour, Dyson Cube work, and space-side science spine all start with this rocket."
	]
	quest.5350010000010017.quest_subtitle: "&9Otherworldly&r"
	quest.5350010000010017.title: "Rocket"
	quest.5350010000010018.quest_desc: [
		"&5The Ultimate Crafting Table&r from Extended Crafting — the final waypoint. The crafting station that consumes the most absurd recipes the pack has to offer."
		""
		"This is the end of the Journey to Ascension chapter. You started with a copper pickaxe. You end here, at the table that crafts apex-tier endgame items: Crystal Matrices, Singularities, and Infinity-tier outputs."
		""
		"&5Every waypoint, every age, one pack. You did it.&r"
	]
	quest.5350010000010018.quest_subtitle: "&cAscension&r"
	quest.5350010000010018.title: "The Ultimate Block"
	quest.536B4548A3380007.quest_desc: ["A &6Rune&r — Forbidden Arcanus's basic magical sigil. Used as a reagent on the rune-engraving block to enchant gear."]
	quest.537A8F99CC3F525D.quest_desc: [
		"Field an &6army of 8&r — eight active guards stationed in your colony."
		""
		"Mid-game military milestone."
	]
	quest.53967D6D1E7151E0.quest_desc: [
		"The &6Gnome Hat&r and &6Gnome Boots&r — pointy red wizard hat and boots dropped from gnome encounters."
		""
		"&aWear them for a small theme bonus&r in mushroom biomes (and to look ridiculous). Costume more than armor."
	]
	quest.53F8923B85A8A9CC.quest_desc: [
		"Field an &6army of 80&r — massive standing army. Top-tier MineColonies military milestone."
		""
		"&aOnly achievable in fully matured colonies.&r"
	]
	quest.5449010000010001.quest_desc: [
		"&5The Table of Infinities.&r You've passed through the Black Hole Convergence and the &5Leviathan&r is dead. The Otherworldly age is over. What lies ahead is not another tier — it's the end of tiers."
		""
		"&6Re:Avaritia&r and &6Extended Crafting&r are the pack's apex crafting systems. The &6Ultimate Crafting Table&r consumes recipes whose ingredients are themselves the apex outputs of every age before. Stacks of nether stars become single components. Components become apex tools. Apex tools become the &5Infinity&r tier."
		""
		"&5This is the threshold of Ascension.&r Everything you've built was preparation."
	]
	quest.5449010000010001.quest_subtitle: "The final craft begins."
	quest.5449010000010001.title: "&dThe Table of Infinities"
	quest.54568D3302FC291A.quest_desc: ["The full &6Stormforged Armor Set&r — Deep Aether's stormbreaker tier with electrical-themed bonuses, plus Stormforged Gloves."]
	quest.5468102A19D28104.quest_desc: [
		"&5Ancient Hero&r — Monster Plus's final boss summon. Drops the Ancient Broken Sword."
		""
		"&aOne of the Umvuthi convergence prerequisites; bosses you've fought feed into the Sol Visage encounter.&r"
	]
	quest.5470AB62CB2974DB.quest_desc: ["&6Carved Stone&r — building block from the Aether's bronze dungeons. Decoration with the right runic vibe."]
	quest.5484C17B4608492E.quest_desc: [
		"&6Gold Crafter&r — Extra Storage's mid-tier crafter. More pattern slots than the iron version."
		""
		"Climbing this ladder shrinks your autocrafting footprint without sacrificing capacity."
	]
	quest.54C06B46EFFF84AA.quest_desc: [
		"&6Cthonic Gold&r — gold soaked in eldritch energy. The endgame Malum metal, used for the most powerful runes and tools."
		""
		"&5Reserve for the deepest builds.&r Don't waste it on early experiments."
	]
	quest.54C0B16D9964B4C7.quest_desc: ["The &6Void Depot&r is the receive-side of the void conduit network — items dropped through the void appear here."]
	quest.5570BA2E7BCC50C2.quest_desc: [
		"The &6Mushroomite Ingot&r is Alchemists Garden's signature alloy — fungus-infused metal with a faint biological glow."
		""
		"&aMushroomite tools sit between iron and diamond&r in performance, with a niche bonus around mushroom biomes. The mod's tier-up metal."
	]
	quest.55851524FDDB6959.quest_desc: [
		"Build a &6Kitchen&r — the citizen who prepares cooked meals for the colony."
		""
		"&aHigh-quality cooked food makes citizens happier and work harder than raw food.&r"
	]
	quest.55E3541DEC3D3BE4.quest_desc: [
		"&6Dark Essence&r — Monster Plus convergence reagent. A diamond-shape proof-of-collection of dark essence."
		""
		"&7A second-pass quest after you've finished the dark armor branch.&r"
	]
	quest.5607E15F448C5DC8.quest_desc: [
		"The &6Mortar and Pestle&r grinds plants and reagents into powders, oils, and bottled essences. The herbalist's workbench."
		""
		"&aGrind herbs, petals, and reagents here&r for AG recipes. (Note: blood from blood roses is bottled directly in the world from a `blood_rose_with_blood` block using a glass bottle, NOT milled here. Molten amethyst is smelted from amethyst shards in a furnace and is used to convert cobwebs into chrysite cobwebs — there is no \"oil from molten amethyst\" recipe.)"
	]
	quest.56D14B2368BEA45B.quest_desc: [
		"&6Shattered Pendant&r — a Phantasm Curios accessory. Slot it for a passive End-themed effect."
		""
		"&aOne of three convergence prerequisites for the Aeternium Sword capstone.&r"
	]
	quest.573B3C0F1AD1591E.quest_desc: [
		"&6Gleam Gel&r — a sticky luminescent substance harvested from sculk-saturated fauna. Used in Deeper Darker recipes that need a binding agent with a faint glow."
		""
		"&aReward includes a Lost Eye for the End Remastered progression — keep it for later End-portal work.&r"
	]
	quest.5786EDCFEBE0F04B.quest_desc: [
		"The &6Bezoar Stone&r — a gallstone-like reagent rare in the wild. In medieval medicine, it was a poison cure; here, it's a herbalism crafting component."
		""
		"&aOften dropped from Alchemists Garden mobs.&r Save them for top-tier brews."
	]
	quest.57C889EC980D33D9.quest_desc: [
		"Build a &6Farmer's Hut&r — the citizen who tends crop fields."
		""
		"&aThe centerpiece of any sustainable food economy.&r Pair with multiple Field blocks for diverse crops."
	]
	quest.57E439CDF7D76BB1.quest_desc: [
		"The &6Blood Bottle&r — extracted essence of blood roses, ground in the mortar and bottled. A reagent for high-tier herbal brews."
		""
		"&cThematically grim&r but mechanically useful. Stockpile a few bottles for the gnome's brew chain."
	]
	quest.5805240933864179.quest_desc: [
		"&6Destruction Core&r — RS reagent that lets the network 'unbuild' or break things. Used in the Grid and in the destruction-flavored autocrafter recipes."
		""
		"&aThe Grid uses this in its recipe — the system needs to extract from the world, not just place into it.&r"
	]
	quest.5827E9110E4B19F9.quest_desc: [
		"Upgrade your &6Mystical Site to level 5&r — max-tier happiness building."
		""
		"Late-game colony morale boost."
	]
	quest.58341CF00E4AEDC9.quest_desc: [
		"&6Crystalborn Catalyst&r and &6Tooth of Hunger&r — paired components for the Blazing Starcore Block recipe. The catalyst is harvested from major crystal nodes; the tooth comes from Starlight predators."
		""
		"Both feed into the late-game chain. Authoring two tasks on one quest keeps the chapter map readable without sacrificing progression."
	]
	quest.583A7AA84FEC027F.quest_desc: [
		"Build a &6Builder's Hut&r — the first essential MineColonies structure. The Builder is the citizen who places all other structures."
		""
		"&aWithout a Builder, no other huts can be constructed.&r The first hire after the Town Hall."
	]
	quest.586C89C9AA7339A8.quest_desc: ["&6Cooked Aerglow Fish&r — Deep Aether's bioluminescent fish, caught in floating-island ponds. Restores hunger and gives a brief glow effect."]
	quest.58B78879EDB93602.quest_desc: ["The &6Witherite Block&r — a cataclysm endgame metal block, recovered from the Harbinger fight. Used as a building block and a reagent."]
	quest.58B84DEB7B72D9D3.quest_desc: [
		"&6Warden Carapace&r — the chitinous shell-plating needed for Warden-tier armor crafting. Crafted from Otherside materials, not actually harvested from the boss itself."
		""
		"Feeds the Reinforced Echo Shard recipe. You'll need several."
	]
	quest.58C18AD8E67C7321.quest_desc: [
		"&6Resonarium Sword&r — the matching blade for the resonarium tier. Standard sword profile but tuned to the Deep Dark's damage curve."
		""
		"Pair with resonarium armor (if you've crafted it) or wait for the Warden tier."
	]
	quest.59C3C3544473FD01.quest_desc: [
		"The &6Soulwoven Pouch&r is Malum's sub-inventory bag for spirits. Carry a pouch and spirits collected from kills go straight inside, freeing your hotbar."
		""
		"&aQuality-of-life essential.&r Don't run an altar without one."
	]
	quest.59D880CED416C487.quest_desc: ["&6Cooked Quail&r — Deep Aether's mid-tier roast meat. Hunt quail in Aether forests."]
	quest.5A11A2FC20E5CE2A.quest_desc: [
		"Build a &6Barracks&r — the colony's military headquarters. Houses guards and trains soldiers."
		""
		"&aDefense becomes critical once your colony grows large enough to attract raids.&r"
	]
	quest.5A286602E5DC00A2.quest_desc: [
		"The &6Orb of Prophecy&r is the key to the &6Eternal Starlight&r — a moonlit twilight dimension of mana crystals, fallen stars, and predatory beasts that hunt in the dim. Hold this orb to scry the location of &6The Gatekeeper&r, the entity who opens the way."
		""
		"This is your invitation. The Starlight is one of two parallel Renaissance dimensional adventures (the other being the Aether), each with their own boss ladder and crafting tree."
		""
		"&aJEI will show you how to assemble the orb from materials you already have in the overworld.&r"
	]
	quest.5A2AD14FA6115E35.quest_desc: [
		"The &6Growth Totem&r accelerates plant growth around it when placed — crops, saplings, and farmable plants tick faster within its range."
		""
		"&aPark it next to a wheat field&r and harvest comes sooner. Stacks with bonemeal but doesn't replace it."
	]
	quest.5A333E5549303EF8.quest_desc: [
		"&6Cable&r — RS network wire. Connects machines, drives, grids, and importers to the Controller."
		""
		"&aJust one cable touching another counts as connected — no need for special connectors. Run them like power lines.&r"
	]
	quest.5A6091C51EB6462C.quest_desc: [
		"The first &6Rune Set&r: &6Vitality&r, &6Protection&r, &6Spell Mastery&r, &6Dexterity&r, and &6Flowing Grasp&r. Apply to gear at the spirit altar for permanent stat boosts."
		""
		"&aRunes are Malum's enchantment-flavored upgrade system.&r Each rune slot is permanent — pick wisely."
	]
	quest.5A814F5A06A5B350.quest_desc: [
		"The &6Energy Sword&r is the Starlight Golem's signature drop weapon — a humming, charged blade that crackles with the same energy that animated its source."
		""
		"Distinct from the Crystal Greatsword and Dagger of Hunger. Each of the four boss branches leads to its own unique weapon flavor."
	]
	quest.5AA10F03919D160D.quest_desc: [
		"&6Ambrosium Shard&r — gateway gem of the Aether. Drops from holystone."
		""
		"&5Welcome to the Aether,&r the first sky dimension. Floating islands, bronze dungeons, valkyries, moas. Build a glowstone frame and pour water inside to open the portal."
	]
	quest.5C28EA75507DB346.quest_desc: [
		"&6Filalux Wings&r — Better End's elytra alternative. Crafted from filalux moth materials in End biomes."
		""
		"&aA second flight option besides the Soul Elytra from r6 and the vanilla elytra. Choose your favorite for fashion or stats.&r"
	]
	quest.5C558F162A81B7F8.quest_desc: [
		"&6Music Disc - Swings&r — a Better Archeology track recovered from suspicious gravel in Trail Ruins. Drop into a jukebox for a thematic vibe."
		""
		"&aThe rare archeology disc.&r Worth keeping a backup; you might never find another."
	]
	quest.5CCD513ADC5691EC.quest_desc: ["&6Blazing Quartz&r — quartz infused with Nether fire spirits. A reagent for fire- and heat-flavored Malum recipes."]
	quest.5D083FE043B7BDD1.quest_desc: [
		"The &6Soul Stained Steel Scythe&r — Malum's mid-tier soul harvester. Like the crude scythe, but faster, more durable, with a wider AoE swing."
		""
		"&aThe upgrade you've been waiting for if you do any volume of soul farming.&r"
	]
	quest.5D36816FF59D4B58.quest_desc: [
		"The &6Basalt Fusion Shrine&r — Pastel's larger ritual block, used to combine multiple gems into endgame fused crystals."
		""
		"&aBuilding the shrine&r is the gateway to Pastel's deepest recipes. Worth the investment for any gem-magic build."
	]
	quest.5D36816FF59D4B58.quest_subtitle: "Prismatic mastery begins."
	quest.5DC7713F8BF3C06F.quest_desc: ["Future Age Gate"]
	quest.5E11A3CD8044F7EA.quest_desc: [
		"&6Iron Hammer&r (Better End) — a Better End multi-tool that works as a weapon and ore-processing tool."
		""
		"&aUseful as a stopgap before crafting thallasium and aeternium gear.&r"
	]
	quest.5E12C6355BD0A073.quest_desc: [
		"The &6Warden Axe&r is the finished melee weapon of the chapter — heavy, sonorous, and the natural reward for surviving the Warden fight."
		""
		"Hits hard enough to feel inevitable. A worthy successor to the Resonarium Axe."
	]
	quest.5EB4C3D826C19D59.quest_desc: [
		"The &6Sand Filter&r from the Thirst mod purifies dirty water — pour contaminated water through it and clean water comes out the other side."
		""
		"&aPair with Create's fluid pipes&r for an automated water purification line. Cleaner than boiling, faster than distilling."
	]
	quest.5EB4C3D826C19D59.quest_subtitle: "Use this to purify water, resulting in an endless source of clean water."
	quest.5EEFB0DD54D78E39.quest_desc: [
		"The &6Immortal Embryo&r is Alex's Caves' rare biological drop — from elite encounters in the primordial caves."
		""
		"&aReagent in late-IR Alex's Caves recipes.&r"
	]
	quest.5F0722E18B5F657F.quest_desc: ["&5Block Factory's Bosses&r — additional Aether-themed boss content. Drop the ice gauntlet, sandworm gauntlet, and other unique loot."]
	quest.5F13855F9394DB89.quest_desc: ["The &6Valkyrie Lance&r — fast-attack polearm dropped after the Valkyrie Queen fight."]
	quest.5F3667E7DBDC4EE9.quest_desc: ["&5Kill the Warped Spewer King.&r Warped-themed Luminous Nether elite. Spits projectiles and tanks a lot of damage."]
	quest.5F5DB67F6A470C73.quest_desc: [
		"Field an &6army of 30&r — substantial colony defense force."
		""
		"Late-game military milestone; required for serious raid resistance."
	]
	quest.5FAB2EB4942FDA77.quest_desc: ["&6Block Factory's Boss Gauntlets&r — ice gauntlet and sandworm gauntlet from BFB's Aether content. Right-click charged abilities."]
	quest.6006F3F0566BE51B.quest_desc: [
		"&6Twining Armor Trim Smithing Template&r — a cosmetic trim with a winding lunar motif themed around the Lunar Monstrosity."
		""
		"&7Cosmetic. Pair it with Moonring/Crescent gear for a full themed look.&r"
	]
	quest.6069C51CDA107811.quest_desc: [
		"&6Thermal Springstone Ingot&r — smelted from ore deposits found around the Starlight's geothermal springs. Warm to the touch even when cold."
		""
		"The thermal springstone armor set leans into heat resistance and lava handling. Useful when you start poking into hotter biomes."
	]
	quest.606CCAEE7C6F5D92.quest_desc: [
		"&6Advanced Processor&r — the top-tier RS chip. Required for the Controller, Autocrafter, and the high-density disks."
		""
		"&aThe rate at which you can produce these is the rate at which your storage system grows. Optimize the chain.&r"
	]
	quest.60903BC818083124.quest_desc: ["The &6Skyjade Sword&r — Deep Aether's endgame blade. Gravitite-tier damage with skyjade-themed bonuses."]
	quest.60D3C24718A84EC2.quest_desc: [
		"&6Glacite Shard&r — chipped from frozen ore deposits in the Starlight's tundra biomes. Cold to the touch, faintly luminous."
		""
		"Glacite armor leans into cold resistance and is the natural pick if you're spending a lot of time in the frozen north of the dimension."
	]
	quest.60D53613768CA1F3.quest_desc: [
		"Welcome to &5Ascension of Ages&r — a sprawling progression pack that takes you from stone tools to particle physics to the End of Time."
		""
		"These are the &6Dark Ages&r, the first of eight ages. Cover food, water, warmth, and shelter, then start hunting for copper tools using overgeaerd's forging system. Once you're done with that, you'll move on to the Medieval Times."
		""
		"&aQuests are optional but heavily reward you.&r Read carefully; many introduce mechanics you'd otherwise miss."
	]
	quest.617C23069C9D75E5.quest_desc: [
		"The &6Unidentified Artifact&r is a sealed relic. Right-click to identify it — you might pull a fossil head, a totem, a vase, or junk."
		""
		"&aIdentify on the archeology table&r for better odds. Random rolls — this is gambling for old bones."
	]
	quest.625A3B821819029F.quest_desc: ["The &6Aeternium Axe&r — alternate progression branch via the ingot path."]
	quest.625A3B821819029F.title: "Aeternium Axe Head"
	quest.628AB89452A89F6C.quest_desc: [
		"&6Soulstone Ore&r — found deep underground, glowing with trapped souls. Mining it with an iron pickaxe yields raw soulstone, the cornerstone of Malum's magic system."
		""
		"&5Welcome to the magical Renaissance.&r Three traditions: Malum (souls), Forbidden Arcanus (arcane crystals), and Pastel (gemstone fusion). Pick one or master all three."
	]
	quest.62CA9D0E97DAD5A0.quest_desc: [
		"The full &6Crafting on a Stick&r toolkit: loom, grindstone, cartography table, stonecutter, smithing table, and anvil — all accessible from your hotbar."
		""
		"&aNo more building utility blocks at every base.&r Carry the sticks; the workshops travel with you."
	]
	quest.62E2AC63E7031E0B.quest_desc: ["The &6Cincinnasite Forge&r — Better Nether's smelting altar. Smelts faster and unlocks BN-specific recipes."]
	quest.62FF13481B0696BA.quest_desc: [
		"The &6Calendar&r from Ecliptic Seasons tracks the in-game season — spring, summer, autumn, winter. Different crops grow at different rates depending on the season, so knowing where you are in the cycle matters."
		""
		"Hold it to see the current season and date. Build farms accordingly."
	]
	quest.63ACB2A05379ADD4.quest_desc: ["The Luminous Nether &6Ritual Table&r — feeds essence and pedestal items into the ritual to produce trims, hoods, and totems."]
	quest.63E00A157F4B0AD9.quest_desc: [
		"Three &6Ignitium Ingots&r — Cataclysm's endgame fire metal, dropped or smelted from Ignis-related loot."
		""
		"&aTop-tier crafting reagent for Cataclysm gear.&r"
	]
	quest.649D26540A9A5342.quest_desc: [
		"The &6Soul Totem&r and &6Torrent Totem&r are higher-tier Better Archeology relics — &ehandheld effects, not area auras&r."
		""
		"Per JAR tooltips: &aSoul Totem&r — held use damages a target and heals you (a lifesteal item). &aTorrent Totem&r — used on land to torrent-dash forward (an early movement booster)."
	]
	quest.64F7979B207A5723.quest_desc: [
		"&6Amaramber Ingot&r — a warm, amber-hued metal native to the Starlight's wooded biomes. Mid-tier alloy used in tool and trim recipes."
		""
		"One of several Starlight metals you'll be juggling. Set up dedicated chests now or your storage will descend into chaos."
	]
	quest.652FD9A462FCB968.quest_desc: ["&6Rune of Eir&r — first Gaze rune, named for the Norse goddess of healing. Applied to gear at the enchantment workbench for a regen-flavored bonus."]
	quest.6569911636E8DBB7.quest_desc: [
		"The &6Wireless Transmitter&r broadcasts the network's wireless coverage in a radius around itself. Without this, Wireless Grids don't work."
		""
		"&aPlace it high and centrally. Range Upgrades extend the bubble.&r"
	]
	quest.65D23E7683812E26.quest_desc: [
		"Have a colonist eat rotten flesh — the desperation-feeding milestone. Means your food supply is dangerously low."
		""
		"&aFix the food chain before this becomes a habit; rotten flesh causes negative effects.&r"
	]
	quest.666217DD8114B3FC.quest_desc: [
		"The &6Spirit Catalyzer&r boosts altar speed by feeding additional spirits into a recipe. Stack multiple catalyzers for bigger speedups."
		""
		"&aOptional but quality-of-life.&r Skip if you only do casual altar work; build several if you're producing in bulk."
	]
	quest.66623FE5A9CF0B20.quest_desc: ["&5Kill the Eots Boss.&r Deep Aether's elite encounter. Drops antidote-component reagents and rare loot."]
	quest.6689B369ECBF5D7C.quest_desc: [
		"The full &6Mushroomite Tool Set&r — sword, pickaxe, axe, shovel, hoe. A complete iron-replacement kit themed around the mod's signature material."
		""
		"&aSlightly above iron in stats,&r and the tools have a thematic look that fits any forest or fungal base."
	]
	quest.66DDC482BCEA21FC.quest_desc: [
		"&6Runewood&r and &6Soulwood Planks&r — the two Malum tree types. Runewood grows from runewood saplings (light, plains-flavored); soulwood is the dark, twisted variant for soul magic."
		""
		"&aBoth feed altar and totem builds.&r Plant a small grove of each."
	]
	quest.66E79AE74245067B.quest_desc: ["&6Shimmerstone Gem&r — Pastel's mid-tier crystal, fused from amethyst powder and citrine shards. The keystone for higher-tier fusion."]
	quest.67329E45D8B99DD2.quest_desc: [
		"Three Malum &6Rings&r: &6Arcane Prowess&r, &6The Endless Well&r, &6Echoing Arcana&r. Equipped via curio slots for spellcaster bonuses."
		""
		"&aFavor for magic-focused builds.&r Stack with rune gear for maximum spell efficiency."
	]
	quest.67A64ED4A17C1698.quest_desc: [
		"&6Storage Block 1k&r — same capacity as a 1k disk, but as a network-attached block instead of a portable disk."
		""
		"&aPlace blocks against the network when you have a fixed install; use disks when you want them portable.&r"
	]
	quest.67E8B8DCFC93F832.quest_desc: [
		"Build a &6Warehouse&r — MineColonies' central storage hub. The Warehouse acts as the inventory bus for the entire colony."
		""
		"&aEvery colonist deposits and pulls from the Warehouse.&r Without one, your colony has no logistics."
	]
	quest.6846D8FF4F53AC29.quest_desc: [
		"&5Kill the Void Blossom.&r Bosses of Mass Destruction's mushroom horror. A massive plant boss with AoE poison and root attacks."
		""
		"&cBring antidote and ranged weapons.&r Don't stand in the spore clouds."
	]
	quest.68500900087F92BC.quest_desc: [
		"Add a &6door recipe&r to a building. Teach a citizen-crafter to make doors."
		""
		"Recipe-add system milestone — lets you customize what each building produces."
	]
	quest.68C388E9E943F4E8.quest_desc: [
		"&6Silk Fiber&r (Better End) — collected from silk moth cocoons in Better End's wooded biomes."
		""
		"&aFeeds the Better End cosmetic and recipe chains. Unique crafting material.&r"
	]
	quest.68FC81E133443E76.quest_desc: [
		"Build a &6Library&r — the citizen-knowledge building. Boosts research speed at the University."
		""
		"Pairs with the University for full knowledge economy."
	]
	quest.693818D5656A64A1.quest_desc: [
		"&5The Infernal Dragon&r is a Block Factory's Bosses summon — a hellish wyrm with fire breath, claw swipes, and enough hit points to test your patience and your potion stockpile."
		""
		"The fourth boss kill required for the Soul Dew. Drops the &6Dragon Skull&r and feeds into the &6Dragon Bones&r armor set."
		""
		"&cFire resistance is mandatory. Bring the Dragon Guard Shield and a real bow.&r"
	]
	quest.696BDC29ACCBBE29.quest_desc: [
		"Earn the &6Undertaker's Totem&r — awarded after the Undertaker resurrects a citizen."
		""
		"&aThe colony has a literal life-restoration mechanic.&r"
	]
	quest.6997D4E8772B5E8C.quest_desc: [
		"&5The Lunar Monstrosity&r is the Starlight's nightmare predator — a writhing, multi-limbed horror that prowls under the perpetual twilight."
		""
		"Drops parts feeding the &6Moonring Bow&r and &6Crescent Pendant&r. The third of four boss kills required for Soul Dew."
		""
		"&cIt's faster than you expect for its size. Don't try to outrun it — fight, or die tired.&r"
	]
	quest.69E2424DB14F10CC.quest_desc: [
		"&6Soul Crystal&r — a faceted, faintly luminous chunk of soul-energy crystallized into solid form. Found in the Otherside, harvested with the right tools."
		""
		"One half of the Sculk Transmitter recipe. The other half is the Heart of the Deep."
	]
	quest.6A1E8D4C0F2B7A11.quest_desc: [
		"&6Flint&r drops occasionally from gravel. Break gravel blocks until you get a piece — it's the cutting edge for your first knapping work."
		""
		"&aFlint + stick = arrows, but flint also opens the Overgeared knapping path.&r You're about to learn to shape stone tools by hand."
	]
	quest.6A1E8D4C0F2B7A12.quest_desc: [
		"Four &6Knappable Rocks&r — produced by &eright-clicking stone blocks with flint in hand&r. Each right-click has a ~30% chance to knock a knappable rock off the stone, and a ~15% chance the flint breaks. Bring spare flint."
		""
		"&aThey're shaped via the knapping GUI&r — the precursor step before you can craft proper stone tools."
	]
	quest.6A1E8D4C0F2B7A13.quest_desc: [
		"Knap a knappable rock to produce a &6Stone Pickaxe Head&r. &eHold the rock and right-click&r — this opens the knapping GUI; click cells to chip away at the rock until the negative space matches the pickaxe-head pattern."
		""
		"&aThe Overgeared way of crafting tool heads.&r You'll attach this to a stick to assemble the actual tool."
	]
	quest.6A1E8D4C0F2B7A14.quest_desc: [
		"Combine the stone pickaxe head with a stick to assemble a working &6Stone Pickaxe&r. Slower than vanilla, but it's the gateway to mining copper and iron."
		""
		"&aOvergeared replaces the vanilla tool path&r — you can't craft a stone pickaxe shapeless anymore. Knapping is the new ritual."
	]
	quest.6A1E8D4C0F2B7A15.quest_desc: [
		"Mine three &6Raw Copper&r and smelt three &6Copper Ingots&r. Copper is your stepping stone — softer than iron, but sufficient for the smithing tier."
		""
		"&aCopper smithing hammers and pickaxe heads come next.&r The Overgeared progression demands you forge through copper before iron, so don't skip it."
	]
	quest.6A1E8D4C0F2B7A16.quest_desc: [
		"The &6Copper Smithing Hammer&r is the first real Overgeared tool. Use it on a stone anvil to shape ingots into specialty parts."
		""
		"&aThis is the sound of the Iron Era starting.&r Hammer + anvil = smithing — the central loop of this chapter."
	]
	quest.6A1E8D4C0F2B7A18.quest_desc: [
		"&6Wooden Tongs&r let you handle hot ingots without cooking your hands. Required for working with heated metal at the anvil."
		""
		"&aWithout tongs, you can't pull a glowing ingot off the forge.&r Carry them whenever you're smithing."
	]
	quest.6A1E8D4C0F2B7A19.quest_desc: [
		"The vanilla &6Grindstone&r repairs and disenchants. In the Overgeared workflow, it's also where you sharpen the rough-shaped tool heads to spec."
		""
		"&aTwo planks, one stone slab, two sticks.&r Cheap, but you'll lean on it constantly while smithing."
	]
	quest.6A1E8D4C0F2B7A1A.quest_desc: [
		"The &6Drafting Table&r is where you prepare blueprints — the templates that drive Overgeared smithing."
		""
		"&aPaper + ink + the drafting table = a blueprint&r for the part you want to forge. No blueprint, no smithing."
	]
	quest.6A1E8D4C0F2B7A1B.quest_desc: [
		"A finished &6Blueprint&r — the recipe template for a smithed item. Use the drafting table to convert empty blueprints into specific designs."
		""
		"&aDifferent items need different blueprints.&r Save them; you'll re-use blueprints across many forging sessions."
	]
	quest.6A1E8D4C0F2B7B03.quest_desc: [
		"An &6Empty Blueprint&r — paper bound for a drafting table. Stack a few before sitting down to design tools."
		""
		"&aOne empty blueprint = one design slot.&r Always keep spares; running out mid-forge is annoying."
	]
	quest.6A451493A964873E.quest_desc: [
		"&6Thallasium armor set&r (Better End) — helmet, chestplate, leggings, boots. Better End's mid-tier armor, crafted from thallasium ingots found in End biomes."
		""
		"&aSolid pre-aeternium armor. Wear it while you climb the chapter.&r"
	]
	quest.6A4BE27177E98C96.quest_desc: [
		"&6Sludge&r is a slow, gelatinous Otherside mob — think slime, but corrupted by sculk and a lot more dangerous on contact."
		""
		"The second of three Otherside-mob kills required for the Warden capstone."
	]
	quest.6A60B76053393288.quest_desc: [
		"Build a &6Smeltery&r — the citizen who smelts ore into metal."
		""
		"&aPair with the Miner for the colony's metal supply.&r"
	]
	quest.6A6D060DB1C65C5E.quest_desc: [
		"The &6Archeology Table&r is where you assemble shards into artifacts and identify what you've recovered. Better Archeology's workbench."
		""
		"Place shards in the table and combine. The right shards in the right slots = a real relic; mixed shards = lower quality."
	]
	quest.6A6E6AF1EFA361BB.quest_desc: [
		"The &6Eternal Starlight Book&r is the dimension's in-game guide. It catalogs the biomes, mobs, ores, and crafting chains so you don't have to fumble blindly through twilight."
		""
		"&aRead it before you portal in. The Starlight is more dangerous than it looks — knowing what hunts in each biome saves lives.&r"
	]
	quest.6A9280907C5F9065.quest_desc: [
		"&6Starcore&r — the synthesis of the Starlight's bosses, ores, cores, and crystals condensed into a single object. The dimension's premier crafting reagent."
		""
		"From here, the only step left is &6Unrealium&r."
	]
	quest.6AB8ABFC790675C4.quest_desc: [
		"&6Heart of the Deep&r — a pulsing, organic core ripped from the bowels of the Otherside. The dimension's most prized harvest."
		""
		"One of the two materials feeding the Sculk Transmitter. Carry it carefully; it feels alive even after you've packaged it."
	]
	quest.6ADD447E33627451.quest_desc: [
		"The &6Radiance Totem&r emits a glow effect on players within range, marking them through walls. Useful for parties and dim-tunnel exploration."
		""
		"&aNot the same as a beacon&r — narrower range, simpler effect, but no resource cost to maintain."
	]
	quest.6B0CE8AD86991E28.quest_desc: [
		"Build a &6Composter's Hut&r — turns food waste and plant matter into bonemeal and compost."
		""
		"&aSustainable fertilizer source.&r Pairs with the Florist for renewable crop boost."
	]
	quest.6B26495A9E7D77FC.quest_desc: [
		"Reach a &6colony population of 5&r — first major population threshold."
		""
		"&aThe colony is no longer a single homestead.&r"
	]
	quest.6B80B2314CC47FD6.quest_desc: [
		"Upgrade your &6Smeltery to level 3&r — mid-tier smeltery unlocks more recipes."
		""
		"Each smeltery level expands the citizen's craft library."
	]
	quest.6BB0C51EE8CA5966.quest_desc: [
		"Build a &6Miner's Hut&r — the citizen who digs for stone, ores, and basic materials."
		""
		"Pair with a Stonemason for full stone-product chains."
	]
	quest.6C330A993824F6EC.quest_desc: ["The &6Zanite Sword&r — Aether's iron-tier sword. Bonus damage scales with low durability, encouraging risky play."]
	quest.6C483F0CDE702A4A.quest_desc: ["&6Soul Stone&r from Eternal Nether — found in soul valleys and ash plains. Building block for the eternal-themed structures and a ritual reagent."]
	quest.6C5164B682F4F1F4.quest_desc: [
		"The &6Aeternium Pickaxe&r again — different node in the dependency graph, gated through the aeternium-ingot path rather than the tool-base path."
		""
		"&7Same item, alternate progression branch.&r"
	]
	quest.6C5164B682F4F1F4.title: "Aeternium Pickaxe Head"
	quest.6C7B20D377646F96.quest_desc: [
		"&6256k Item Storage Disk&r (Extra Disks) — extreme-density storage. Built when 64k stops feeling sufficient (a luxury problem, but a real one in late-game pack)."
		""
		"&7More disks like this and you're storing literal millions of items.&r"
	]
	quest.6D061DBB350F5529.quest_desc: [
		"Kill a &6Gnome&r. The little bearded creatures spawn in their burrows and drop mushroomite ingots, gnome shovels, and the occasional gnome's brew."
		""
		"&cGnomes hit harder than they look.&r Bring a sword and don't underestimate the scale — they're small, fast, and stab from below."
	]
	quest.6D08A993695D141E.quest_desc: [
		"Five &6Chameleon Molt&r — drops from chameleons in jungle/savanna biomes (or wherever Cold Sweat configures them). Used to craft chameleon armor, which insulates against both heat and cold."
		""
		"&aChameleons are passive but skittish.&r Approach slowly, or breed pairs to scale up the supply."
	]
	quest.6D1396F9ABD5BB76.quest_desc: [
		"&5The Underworld Knight&r is a Block Factory's Bosses arena boss — heavy plate, real fundamentals, no gimmicks. The closest thing this chapter has to a duel."
		""
		"The third of three bestiary refugee bosses. Required (along with Lich, Frostmaw, and the Warden) for the Warden Helmet capstone."
		""
		"&cFights like a real opponent: blocks, parries, punishes greed. Pace yourself.&r"
	]
	quest.6D56AD1BEC644A10.quest_desc: [
		"Build an &6Archery&r — trains ranged guards."
		""
		"Pair with the Combat Academy for mixed melee/ranged garrisons."
	]
	quest.6D7E8F901A2B100C.quest_desc: [
		"&5The Ferrous Wroughtnaut&r — Mowzie's massive iron-armored sentinel. Slow but devastating, found inside the Wroughtnaut Chamber structure."
		""
		"Drops the &6Wrought Helmet&r and the &6Wrought Axe&r, plus an &6Old Eye&r for End Remastered. One of four bosses contributing to the Umvuthi unlock."
		""
		"&cIts AOE slam destroys terrain. Stay mobile.&r"
	]
	quest.6D7E8F901A2B100D.quest_desc: [
		"&6Wrought Helmet&r — the Ferrous Wroughtnaut's signature drop. Heavy iron helm with a striking visor."
		""
		"&aOne of two prerequisites for the Earthrend Gauntlet diamond.&r"
	]
	quest.6D7E8F901A2B1010.quest_desc: [
		"&5The Sculptor&r — Mowzie's terracotta-army boss. Summons stone soldiers and hurls earth at you from the center of his arena."
		""
		"Drops the &6Sculptor Staff&r and unlocks the geomancer armor. One of the Mowzie's mid-tier bosses."
		""
		"&cBreak the summoned soldiers fast — let them stack and you'll be overwhelmed.&r"
	]
	quest.6D7E8F901A2B1011.quest_desc: [
		"The &6Sculptor Staff&r is the Sculptor's drop weapon — channel earth-themed magic from a distance."
		""
		"&aA fun ranged option for Mowzie's-flavored loadouts.&r"
	]
	quest.6D7E8F901A2B1012.quest_desc: [
		"&6Sol Visage&r — the chapter icon. A sun-faced mask dropped by Umvuthi or pulled from related structures."
		""
		"&aTrophy and convergence prerequisite for the chapter capstone (Umvuthi kill). Hold-only — keep it in your inventory.&r"
	]
	quest.6D7E8F901A2B1013.quest_desc: [
		"&5The Naga&r is Mowzie's flying serpent boss. Charge attacks from the air, deceptively long reach."
		""
		"Drops the &6Naga Fang&r and a &6Rogue Eye&r for End Remastered."
		""
		"&cKeep cover overhead. The Naga dives faster than you can dodge in the open.&r"
	]
	quest.6D7E8F901A2B1014.quest_desc: [
		"&6Naga Fang&r — the Naga's signature drop. Used in Mowzie's recipes; also a trophy."
		""
		"&aCarry it as a snake-themed flex.&r"
	]
	quest.6D7E8F901A2B1016.quest_desc: [
		"&6Foliaath Seed&r — the seed of a Mowzie's foliaath. Plant it and ambush guests."
		""
		"&7Decorative trap. Place near doorways for theme.&r"
	]
	quest.6D7E8F901A2B1018.quest_desc: [
		"&6Bluff Rod&r — small Mowzie's wand-style item, themed around the Bluff."
		""
		"&7Niche utility / collectible.&r"
	]
	quest.6D7E8F901A2B1019.quest_desc: [
		"&6Elokosa Howler&r — a Mowzie's primate-style mob. Hostile to encroachers."
		""
		"Drops elokosa paws — feeding the moon-paw weapon ladder (full → crescent → gibbous)."
	]
	quest.6D7E8F901A2B101A.quest_desc: [
		"&6Elokosa Paw — Full&r: the first phase of the moon-paw weapon. Themed after a full moon."
		""
		"Step one of three on the moon-paw ladder."
	]
	quest.6D7E8F901A2B101B.quest_desc: [
		"&6Grottol&r kill plus &6Umvuthana Mask Fury&r and &6Mask Faith&r — three Mowzie's items in one quest."
		""
		"&aMasks are decorative and wearable as helmets. Different masks signal allegiance to different Umvuthana factions.&r"
	]
	quest.6D7E8F901A2B101C.quest_desc: [
		"&6Earthrend Gauntlet&r — Mowzie's signature melee tool, channeling earth-shattering punches."
		""
		"&aDiamond convergence: requires both the Wrought Helmet and the Sol Visage. The crown jewel of Mowzie's mid-tier loot.&r"
	]
	quest.6D7E8F901A2B101D.quest_desc: [
		"&6Elokosa Paw — Crescent&r: the mid-phase moon-paw, themed after a crescent moon."
		""
		"&aThis quest also serves as the gate for the Born in Chaos branch of the chapter — every dark-metal and undead-themed sidebar branches off here.&r"
	]
	quest.6D7E8F901A2B101F.quest_desc: [
		"&6Dark Metal Ingot&r and &6Dark Metal Block&r — refined and compressed forms of the dark metal."
		""
		"&aStandard ladder. Ingots for tools, blocks for storage and decoration.&r"
	]
	quest.6D7E8F901A2B1020.quest_desc: [
		"&6Orb of the Summoner&r — Born in Chaos summon item. Calls forth a temporary undead minion."
		""
		"&aFlavorful summoning toy. Limited use; pair with the Death Totem for theme.&r"
	]
	quest.6D7E8F901A2B1021.quest_desc: [
		"&6Death Totem&r — Born in Chaos placeable totem. Provides a death-themed area effect."
		""
		"&7Atmospheric base decoration with mild gameplay effects.&r"
	]
	quest.6D7E8F901A2B1022.quest_desc: [
		"&6Monster Skin&r and &6Nightmare Claw&r — Born in Chaos drops feeding higher recipes."
		""
		"&aTrophy + reagent combo.&r"
	]
	quest.6D7E8F901A2B1023.quest_desc: [
		"&6Seed of Chaos&r and &6Shattered Skull&r — Born in Chaos chaos-themed reagents."
		""
		"&7Niche components for late Born in Chaos crafts.&r"
	]
	quest.6D7E8F901A2B1024.quest_desc: [
		"&6Staff of Magic Arrows&r — Born in Chaos magical bow-style ranged weapon."
		""
		"&aFires conjured arrows; no ammunition needed.&r"
	]
	quest.6D7E8F901A2B1025.quest_desc: [
		"&6Spiritual Dust&r — Born in Chaos crafting reagent. Sparkles ominously in the inventory."
		""
		"Used in elixirs and the more arcane Born in Chaos recipes."
	]
	quest.6D7E8F901A2B1026.quest_desc: [
		"&6Nightmare Stalker&r — a Born in Chaos hostile mob. Slow but persistent."
		""
		"&cDoes not stop chasing once aggro'd. "
	]
	quest.6D7E8F901A2B1027.quest_desc: [
		"&6Elixir of Wither Resistance&r — Born in Chaos potion countering wither-type effects."
		""
		"&aCarry one before any wither / wraith encounter.&r"
	]
	quest.6D7E8F901A2B1028.quest_desc: [
		"&6Tombstone the Gentleman Frog&r — Born in Chaos's iconic NPC companion in trinket form. He is exactly what the name says."
		""
		"&7Pure flavor. The single best-named item in the chapter.&r"
	]
	quest.6D7E8F901A2B1029.quest_desc: [
		"&6Transmuting Elixir&r — Born in Chaos transmutation potion. Converts certain items as labeled in JEI."
		""
		"&aSituational utility; check JEI for full transmutation list.&r"
	]
	quest.6D7E8F901A2B102A.quest_desc: [
		"&6Elixir of Vampirism&r — Born in Chaos potion granting limited lifesteal."
		""
		"&aDrink before a tough fight; suck life from your enemies for a time.&r"
	]
	quest.6D7E8F901A2B102C.quest_desc: [
		"&6Elokosa Paw — Gibbous&r: the terminal phase of the moon-paw weapon ladder."
		""
		"&aDiamond convergence: requires the dark metal nugget, the staff of magic arrows, and the transmuting elixir. The chapter's mid-late mid-tier capstone before Umvuthi.&r"
	]
	quest.6D7E8F901A2B1046.quest_desc: [
		"&5Umvuthi&r — Mowzie's solar god-king boss. Wielder of the Sol Visage, summoner of fire and stone, the chapter capstone."
		""
		"&5This hexagonal kill grants the &6the Renaissance&5 stage automatically.&r The Umvuthi convergence requires at least two of: the Bonescaller boss, the Dire Hound Leader boss, the Elokosa Paw Gibbous, the Ancient Hero. A long road home."
		""
		"&cMultiple phases. Solar attacks burn fast and far; bring fire resistance and a real bow.&r"
	]
	quest.6D7E8F901A2B1050.quest_subtitle: "&6Medieval Times&r"
	quest.6D7E8F901A2B1050.title: "Trial: Wroughtnaut"
	quest.6D7E8F901A2B1051.quest_subtitle: "&6Medieval Times&r"
	quest.6D7E8F901A2B1051.title: "Trial: Foliaath"
	quest.6D7E8F901A2B1052.quest_subtitle: "&6Medieval Times&r"
	quest.6D7E8F901A2B1052.title: "Trial: Frostmaw"
	quest.6D7E8F901A2B1053.quest_subtitle: "&6Medieval Times&r"
	quest.6D7E8F901A2B1053.title: "Trial: Grottol"
	quest.6D7E8F901A2B1054.quest_desc: [
		"Mowzie's Mobs is the Medieval boss-prep mod for this pack. Kill any three of four notable encounters before pushing into the Renaissance."
		"Ferrous Wroughtnaut, Foliaath, Frostmaw, and Grottol all count. Umvuthi is intentionally not required; leave the Sunbird fight for prestige."
	]
	quest.6D7E8F901A2B1054.quest_subtitle: "&6Medieval Times&r"
	quest.6D7E8F901A2B1054.title: "Mowzie's Trial"
	quest.6D7E8F901A2B2101.quest_desc: [
		"&6Wrought Axe&r — the Ferrous Wroughtnaut's signature weapon drop. Heavy, slow, brutal."
		""
		"&aCarry it as a trophy or use it as your main melee — both work.&r"
	]
	quest.6D7E8F901A2B2102.quest_desc: [
		"&6Geomancer armor set&r — beads, robe, belt, sandals. Mowzie's Sculptor-themed lightweight robes."
		""
		"&aFour pieces in one quest. Themed Mowzie's outfit; pair with the Sculptor Staff for the full earth-mage build.&r"
	]
	quest.6D7E8F901A2B2103.quest_desc: [
		"&6Glowing Jelly&r — Mowzie's luminescent reagent harvested from elokosa-related sources."
		""
		"&7Decorative + niche crafting use.&r"
	]
	quest.6D7E8F901A2B3001.quest_desc: [
		"&6Bonescaller&r — Born in Chaos undead summoner. Calls minor undead in waves."
		""
		"&aProof-of-presence kill. Sets up the Supreme Bonescaller fight.&r"
	]
	quest.6D7E8F901A2B3002.quest_desc: [
		"&5Supreme Bonescaller&r — the elder boss version of the regular Bonescaller. Larger waves, faster summoning."
		""
		"Drops an &6Undead Eye&r for End Remastered. One of four Umvuthi convergence prerequisites."
		""
		"&cKill the boss before its summoned minion count gets out of control.&r"
	]
	quest.6D7E8F901A2B3003.quest_desc: [
		"&6Dread Hound&r — Born in Chaos pack mob. Five kills required to prove you've cleared a pack."
		""
		"&aHunt them in groups; they're dangerous solo if you let them swarm.&r"
	]
	quest.6D7E8F901A2B3004.quest_desc: [
		"&5Dire Hound Leader&r — the alpha of a Dread Hound pack. Tougher, smarter, and surrounded by lesser hounds."
		""
		"Drops a &6Corrupted Eye&r for End Remastered. One of four Umvuthi convergence prerequisites."
		""
		"&cFocus the leader; the pack scatters if you take it out fast.&r"
	]
	quest.6D7E8F901A2B3005.quest_desc: [
		"&5Sir Pumpkinhead&r — Born in Chaos's spooky knight boss. Cucurbital, armed, and surprisingly fast."
		""
		"&aFun fight. Drops Halloween-themed loot.&r"
	]
	quest.6D7E8F901A2B3006.quest_desc: [
		"&6Door Knight&r and &6Fallen Chaos Knight&r — three of each. Born in Chaos's standard knight enemies."
		""
		"&aChaff to clear before bigger fights. Easy targets in groups.&r"
	]
	quest.6D7E8F901A2B3007.quest_desc: [
		"&6Lifestealer&r — Born in Chaos lifestealing mob. Drains health on hit."
		""
		"&cDon't trade hits with it; close the gap or kite from range.&r"
	]
	quest.6D7E8F901A2B3008.quest_desc: [
		"&6Zombie Bruiser&r and &6Bone Imp&r — three of each. Born in Chaos's heavy and ranged undead."
		""
		"&aPair-clear quest. Both spawn in graveyards/cult structures.&r"
	]
	quest.6D7E8F901A2B3009.quest_desc: [
		"&6Corpse Fly&r and &6Mr. Pumpkin&r — three corpse flies, two Mr. Pumpkins. The lighter side of the Born in Chaos roster."
		""
		"&7Optional. Skip if you've already cleared the heavy hitters.&r"
	]
	quest.6D7E8F901A2B300A.quest_desc: [
		"&6Crystal Zombie&r and &6Spectral Skull&r — Monster Plus undead variants. Crystal-themed zombies and floating skull mobs."
		""
		"&aMonster Plus adds biome-specific monster variants — these are the more crystalline ones.&r"
	]
	quest.6D7E8F901A2B300E.quest_desc: [
		"&6Crystal Shard&r and &6Dark Essence&r — Monster Plus reagents. Crystal shards from caster mobs, dark essence from corrupted ones."
		""
		"&aFeeds the Monster Plus armor chain and the Ancient Hero recipe path.&r"
	]
	quest.6D7E8F901A2B300F.quest_desc: [
		"&6Dark Chestplate&r and &6Dark Helmet&r — Monster Plus armor pieces. Dark-themed, statted between iron and diamond."
		""
		"&aA Monster Plus loadout option separate from your main combat gear.&r"
	]
	quest.6DDBA2A0973F5F0C.quest_desc: [
		"The &6Terracotta Bowl&r from the Thirst mod holds drinking water. Fill it at any water source; drink to restore the thirst meter."
		""
		"&cThirst is now a tracked stat alongside hunger.&r Drink whenever the bar drops, or you'll start taking damage."
	]
	quest.6E240FBB31931AFF.quest_desc: ["&6Malignant Pewter Plating&r — pewter ingots pressed into armor plates at the spirit altar."]
	quest.6F1A4D0C00010001.quest_desc: [
		"The &6Soul Extractor&r — Forbidden Arcanus tool that pulls the soul out of a captured mob into a soul fragment. The first key item for the Maledictus path."
		""
		"&5The vigil begins.&r From here you'll grind through three Cataclysm pre-bosses and a long preparation chain before facing Maledictus himself."
	]
	quest.6F1A4D0C00010002.quest_desc: ["&6Crimson Stone&r — Forbidden Arcanus reagent. Required to manifest the Maledictus encounter."]
	quest.6F1A4D0C00010003.quest_desc: ["&5Kill the Kobolediator.&r Cataclysm mini-boss — armored kobold gladiator with shield-bash and counterattack moves."]
	quest.6F1A4D0C00010004.quest_desc: ["The &6Kobolediator Skull&r — unique drop from the Kobolediator. Wearable trophy."]
	quest.6F1A4D0C00010005.quest_desc: ["&5Kill the Aptrgangr.&r Cataclysm undead boss — Norse draugr-flavored. Drops the Strange Key for the Maledictus chamber."]
	quest.6F1A4D0C00010006.quest_desc: ["&6Strange Key&r — opens the door to Maledictus's chamber inside the Cursed Tombstone."]
	quest.6F1A4D0C00010007.quest_desc: [
		"The &6Cursed Tombstone&r — Cataclysm's summon block for Maledictus, found beneath the central balcony of the &6Frosted Prison&r structure (the prison itself is located by releasing an Eye of Curse, which points like an Ender Pearl toward the nearest one). &eRight-click the in-place Tombstone to summon Maledictus in a burst of turquoise Phantom Flame.&r A held tombstone item proves you've acquired/replicated one for record-keeping."
		""
		"&5One last preparation step.&r The Strange Key (dropped by the Aptgangr mini-boss inside the Prison) is a separate item used on the Door of Seal — NOT on the Tombstone."
	]
	quest.6F1A4D0C00010008.quest_desc: [
		"&5Kill Maledictus.&r The cursed warlord himself — Cataclysm's elite undead boss and the gate-keeper of the Renaissance."
		""
		"&cFull preparation required.&r Cursium-tier and Forbidden Arcanus T2 gear; potions of strength, regen, fire resist; ranged fallback. He has multiple phases — survive the first to learn the rhythm of the second."
		""
		"&aDefeating Maledictus drops cursium ingots and unlocks the path to the Industrial Revolution.&r"
	]
	quest.6F1A4D0C00010009.quest_desc: ["Four &6Cursium Ingots&r — Maledictus's blood-and-curse alloy. The metal of the cursium tier."]
	quest.6F1A4D0C0001000A.quest_desc: ["A &6Cursium Block&r — nine ingots compacted. Storage form."]
	quest.6F1A4D0C0001000B.quest_desc: ["&6Music Disc - Maledictus&r — the cursed warlord's theme. Drops from the kill."]
	quest.6F1A4D0C0001000C.quest_desc: ["&6Cursium Upgrade Smithing Template&r — applies cursium to compatible armor at the smithing table."]
	quest.6F1A4D0C0001000D.quest_desc: ["The full &6Cursium Armor Set&r — helmet, chestplate, leggings, boots. Renaissance-tier endgame armor with curse-themed bonuses."]
	quest.6F1A4D0C0001000E.quest_desc: ["The &6Cursed Bow&r — Maledictus drop. Fires arrows that apply a curse debuff to hit targets."]
	quest.6F1A4D0C0001000F.quest_desc: ["The &6Eye of Curse&r (`cataclysm:cursed_eye`) — Cataclysm's locator for the Frosted Prison. &eCrafted&r (NOT dropped) from 4 gold ingots + 2 phantom membranes + 1 rotten flesh + 1 bone + 1 Eye of Ender on a crafting table. Right-click in the air to release: it points toward the nearest Frosted Prison (Cataclysm's Maledictus arena), the same way an Ender Pearl points to a stronghold. Unrelated to End Remastered's eyes."]
	quest.6F1A4D0C00010013.quest_desc: [
		"The Forbidden Arcanus &6Hephaestus Forge T2 ingredients&r: edelwood planks, arcane crystals, and spawner scraps. Build the second forge tier to unlock the Draco Arcanus recipe."
		""
		"&aFA's tier ladder pays off here.&r You're one craft away from the Renaissance capstone."
	]
	quest.6F1A4D0C00010014.quest_desc: [
		"&5The Draco Arcanus Helmet&r — Forbidden Arcanus's mythic-tier headpiece, the Renaissance capstone."
		""
		"&cThis is the chapter gate.&r Crafting it grants the &6industrial_revolution&r stage, unlocking Mekanism, MI, Oritech, and the entire Industrial Revolution age. Three ages down, five to go."
		""
		"&aThe fight is over. The factory begins.&r"
	]
	quest.6F1A4D0C00010015.quest_desc: ["Kill an &6Ignited Revenant&r — Cataclysm's flaming undead skirmisher. First of the pre-Maledictus mob ladder."]
	quest.6F1A4D0C00010016.quest_desc: ["Kill an &6Ignited Berserker&r — heavier, faster Cataclysm undead. The middle rung of the prep ladder."]
	quest.6F1A4D0C00010017.quest_desc: ["&6Dying Ember&r — drops from Cataclysm's &cIgnited Berserker&r entity (only entity that drops it, per loot tables). Crafts 4×4 into &6Burning Ashes&r, which is the actual feeder material for cursium-tier and other late-Cataclysm recipes."]
	quest.6F1A4D0C00010018.quest_desc: ["&6Vitality Ankh&r and &6Unbreakable Skull&r — rare Cataclysm curio drops. Vitality grants HP regen; Unbreakable Skull prevents one death per cooldown."]
	quest.6F35F66D6BB2F9C1.quest_desc: [
		"The &6Crafting Grid&r is a Grid with an inline crafting table. Pull from network, craft, put back, all without leaving the UI."
		""
		"&aReplace your Grids with Crafting Grids almost everywhere. The crafting table convenience is huge.&r"
	]
	quest.6F697569C417FCCE.quest_desc: [
		"The &6Stone Fillet Knife&r processes whole fish into raw fillets, which cook into more food per fish than the whole-fish version."
		""
		"It's the first tier — iron and diamond knives come later. Filleting is Aquaculture's way of rewarding active food prep over passive raw eating."
	]
	quest.6F7B91FB38EFDC98.quest_desc: [
		"&6Silicon&r — RS's processed semiconductor base. Smelted from raw silicon (or quartz)."
		""
		"Combined with processor binding to make the basic/improved/advanced processors that gate RS's tech tree."
	]
	quest.6FC33E8897F97D48.quest_desc: ["The &6Silver Compass&r — points toward silver dungeons (Valkyrie Queen's lair)."]
	quest.7015044E71E2A547.quest_desc: [
		"&6Dragon Guard Shield&r — a Block Factory's Bosses shield meant for the Infernal Dragon fight. Dense, fire-resistant, and absurdly heavy in the hand."
		""
		"&aBring it to the Infernal Dragon battle. The breath weapon is what kills people, and a shield is the cleanest counter.&r"
	]
	quest.7027A1DD66448C98.quest_desc: ["The &6Cincinnasite Tool Trio&r: pickaxe, sword, axe. Better Nether's gold-replacement tier with fire-themed bonuses."]
	quest.70D99BC8FE5F6FC7.quest_desc: [
		"The &6Hammock&r from Comforts lets you skip daytime to night — the inverse of a bed. Useful when you've got a nocturnal task waiting (mob farming, bartering with piglins) and don't want to wait on the sun."
		""
		"Hammocks are also less restrictive about monsters nearby than beds."
	]
	quest.710BCFAEA5172406.quest_desc: [
		"&6Cultist Armor Trim&r — Luminous Nether smithing template."
		""
		"&cThis quest is currently uncompletable.&r The Cultist Trim is flagged `§cDISABLED §cTEMPORARILY §cAS §cOF §cV1.3` in its own tooltip (pack ships LN 1.3.2). Marked &7optional&r so it does not block chapter progression. When Luminous Nether re-enables the trim, this quest becomes completable as-is."
	]
	quest.716C5BC09B5510A6.quest_desc: ["&5Kill the Mushlin King.&r Luminous Nether's mushroom-themed elite. Lobs spore clouds and summons minion mushlins."]
	quest.71845BF086F2F2AF.quest_desc: [
		"The &6Mirror&r (Enderscape) reflects light into the End's dim corners — and is also the gating component of the Enderscape mid-tier."
		""
		"&aRequired to access shadoline + drift gear. Diamond-shaped quest = key milestone.&r"
	]
	quest.71E6565D1923978A.quest_desc: ["The &6Spirit Crucible&r refines raw spirits into purified essences. Necessary for high-tier Malum recipes that demand specific concentrations of soul energy."]
	quest.7218362698C1805A.quest_desc: [
		"&6Spores&r and &6Glittering Spores&r — drops from mushroom-themed AG mobs and certain plants. Spores grow into mushroom blocks; glittering spores are reagents for the Mushroomite chain."
		""
		"&aCollect both types&r to start the mushroomite ingot pipeline."
	]
	quest.723F5E944741006F.quest_desc: [
		"&6Deepsilver armor set&r — helmet, chestplate, leggings, boots. Heavier than Aethersent, with stats tuned for melee builds."
		""
		"This is your full-plate option in the Starlight mid-tier. If you'd rather get hit and keep swinging than dance at range, this is the kit."
	]
	quest.72A736B300C6F055.quest_desc: [
		"The &6Golden Ring&r — base ring from Alchemists Garden. Equipped in a curio slot, it's the foundation that other rings (regen, speed, glow) are built on."
		""
		"&aUpgrade path&r leads through the speed/glow/regen rings. The plain golden ring is your slot reservation."
	]
	quest.72C624EA044945A9.quest_desc: ["Kill a &6Wither Skeleton Knight&r from Eternal Nether. The armored elite of the wither skeleton family — drops wither essence and exotic gear."]
	quest.72C7007CED332330.quest_desc: ["&6Soulwoven Silk&r is fabric infused with captured spirits. Used to craft pouches and ritual gear."]
	quest.72C749AD9F1C634E.quest_desc: [
		"Hire a &6Citizen&r — populate your colony's residences. Citizens spawn to fill open Residence beds."
		""
		"&aThe colony's labor pool grows with citizen count.&r"
	]
	quest.734E9B04298C7734.quest_desc: [
		"The &6Warden Sword&r is an alternate Warden-tier melee weapon to the Warden Axe — different swing profile, similar power band."
		""
		"&7Optional. Pick the Axe or the Sword based on which animation you prefer — both are top-of-class for the chapter.&r"
	]
	quest.739A211BEB4C9A1F.quest_desc: [
		"The &6Unrealium Sickle&r is the Starlight chapter's hexagonal capstone — an AOE harvesting/combat tool with the dimension's terminal material."
		""
		"&5You've finished the Starlight.&r You stepped through the Orb of Prophecy, beat the Gatekeeper, climbed the four mid-tier metal ladders, killed four major bosses, and forged Unrealium. The dimension is yours."
		""
		"&aTake everything you've built here back to the overworld — you'll need it for what comes next.&r"
	]
	quest.73C8EB5BB682575E.quest_desc: ["&6Amethyst Powder&r — Pastel's grinding-mill output for amethyst clusters. Used in fusion shrine recipes as a base reagent."]
	quest.73C8EB5BB682575E.title: "Gemstone Powder"
	quest.73E9AEDC0604E6CE.quest_desc: [
		"&6Dragon Skull&r — the Infernal Dragon's signature drop. Both a trophy and a crafting ingredient for the Dragon Bones armor set."
		""
		"Mount it on a wall in your base; few items in this dimension look more impressive on display."
	]
	quest.743D7D9204915A13.quest_desc: [
		"Witness a colonist's first burial. The Undertaker handles colony funerals when citizens die."
		""
		"&aMorbid but realistic — the colony has a death-handling system.&r"
	]
	quest.744C7E0F329DA02B.quest_desc: [
		"&5Permafrost&r is the Starlight's frozen apex predator — a hulking ice-bound beast stalking the dimension's tundra. Cold-themed attacks and freezing melee."
		""
		"Drops the &6Coldsnap&r weapon. One of four boss kills feeding the Soul Dew convergence."
		""
		"&cIts ranged attacks slow you to a crawl. Hot food, fire resistance, or strong cold mitigation help.&r"
	]
	quest.74501484B9C89C8A.quest_desc: [
		"The &6Importer&r pulls items from an external inventory into the network. Place against a chest, hopper output, or machine output and items flow into RS."
		""
		"&aAdd a Speed Upgrade (and a filter) for serious throughput.&r"
	]
	quest.748F37C58F253651.quest_desc: [
		"The &6Grid&r is the player-facing inventory window of your RS system — right-click to see and pull from everything in storage."
		""
		"&5The whole 'inventory problem' goes away the first time you open a Grid attached to a real network.&r You search by typing, you sort by stat columns, you bulk-extract with shift-click."
		""
		"&aBuild Grids in every base, every workshop, every farm. They're cheap.&r"
	]
	quest.74C114D0C0D4D374.quest_desc: [
		"Build a &6Hospital&r — the colony's medical building. Heals injured citizens; provides immunity research access."
		""
		"&aCritical for keeping citizens alive during raids and accidents.&r"
	]
	quest.75025272597CCF69.quest_desc: [
		"The &6Interface&r is a 9-slot input/9-slot output network endpoint — items go in, the network claims them; items come out, the network supplies them."
		""
		"&aPair with autocrafters or external machines that need a network-fed input bus.&r"
	]
	quest.75599A9909C7A8C8.quest_desc: [
		"Have a colonist eat their first meal — MineColonies' citizen-feeding intro advancement."
		""
		"&aStock the warehouse with bread, stew, or any food.&r Citizens auto-eat from accessible inventories."
	]
	quest.75CBFD0F90772359.quest_desc: [
		"Build a &6Tavern&r — the colony's social hub. Recruits visiting citizens; tracks happiness."
		""
		"&aImportant for population growth — new citizens visit the Tavern before joining the colony.&r"
	]
	quest.7674B1701342CD1B.quest_desc: ["&6Molten Coal&r — Luminous Nether's superheated coal variant. Burns hotter and longer, used in advanced LN smelting recipes."]
	quest.771A0BD657D158BA.quest_desc: [
		"&5The Convergence&r — collect a Mushroomite Ingot, Leather Glove, and Golden Ring at once. Proof you've explored every branch of this chapter: alchemy, herbalism, and the gnome path."
		""
		"&aThe optional capstone.&r Doesn't gate progression — it's a flavor reward for completionist players who actually walked the whole map."
	]
	quest.7733FF946E05AB9C.quest_desc: [
		"&6Gnome's Brew&r — a fermented herbal drink rarely dropped by gnomes or brewed from rare reagents. Drink for a temporary buff."
		""
		"&aDelicious if you can stomach the smell.&r Save them for boss fights or long expeditions."
	]
	quest.77A4A9B8601767C7.quest_desc: [
		"&6Choral Arrow&r — Phantasm's themed projectile. Crafted from chorus components and crystal."
		""
		"&aFlavor ammunition; works with any bow. Pair with the Filalux Wings for the full chorus aesthetic.&r"
	]
	quest.77D584A90DED2D7D.quest_desc: [
		"&6Construction Core&r — RS reagent that lets the network 'build' (place items into the world). Used in interfaces and the autocrafter."
		""
		"&aPaired with the destruction core, these are the philosophical inputs of automated construction.&r"
	]
	quest.77EA22C1050BEE70.quest_desc: [
		"The &6Sculk Snapper&r is a snapping, lunging Otherside predator — short range, brutal jaw."
		""
		"Per JAR loot table: drops only &6Soul Dust&r (0–1 with looting bonus). Heart of the Deep is a separate world-found drop, not a Snapper kill product. Easy to dodge if you keep moving and don't stand on the same block twice."
	]
	quest.780532C2960D5BF2.quest_desc: ["The &6Executioner Hood&r — drop from the Piglin Executioner. A helmet with bonus crit on melee attacks."]
	quest.7813F9EAC9075122.quest_desc: [
		"Ten &6Pure Water Bottles&r. The Thirst mod ranks water by purity — water from rivers and lakes can carry parasites, but boiled, distilled, or filtered water is safe."
		""
		"&cDrinking dirty water gives you nasty effects.&r Always boil or purify before bottling for travel."
	]
	quest.7819837656F6A955.quest_desc: [
		"&6Speed Upgrade&r — slot into an Importer/Exporter/Autocrafter for faster operations. Stack up to 4 for maximum throughput."
		""
		"&aDouble or quadruple your throughput on bottleneck nodes.&r"
	]
	quest.7870800C28A7E199.quest_desc: [
		"Build a &6Chickenherder's Hut&r — eggs and chicken meat from one citizen."
		""
		"Reliable early protein supply."
	]
	quest.78866870269942D9.quest_desc: ["The &6Agility Cape&r — Aether curio granting movement speed and dodge bonuses."]
	quest.78C710358E9E4CCF.quest_desc: ["&6Ghostly Essence&r from Luminous Nether — drops from haunted Nether mobs. The reagent for the Nether ritual chain."]
	quest.78E0CA2CCA5C41D7.quest_desc: [
		"The &6Exporter&r is the mirror of the Importer — sends items from the network into an external inventory. Filtered, configurable, fast with upgrades."
		""
		"&aExport to machine inputs to feed automated processing chains.&r"
	]
	quest.78EF427D9C73D92E.quest_desc: ["&6Black Moa Egg&r — rarest Moa with the most aerial jumps. The Aether's flying horse."]
	quest.797DF1B61A45B9FD.quest_desc: [
		"The &6Optimized Option&r music disc — a Starlight-flavored ambient track that fits the dimension's twilight perfectly."
		""
		"&7An optional collectible. Drop it in a jukebox in your Starlight base and let it play.&r"
	]
	quest.797F04746D9B7EE1.quest_desc: ["The &6Gravitite Sword&r — diamond-tier Aether sword that knocks targets airborne with each swing."]
	quest.79933C964312F721.quest_desc: [
		"Build a &6Sifter&r — the citizen who passes materials through a sieve to extract rare items."
		""
		"&aChance-based output — long-running sifters produce gems, seeds, and rare drops over time.&r"
	]
	quest.7A1F010000000002.quest_desc: [
		"&6Andesite Alloy&r is Create's universal crafting material — every Create machine starts here. Combine andesite with iron nuggets in a basin (later) or shapeless craft a few at a time."
		""
		"&aStockpile in stacks.&r You'll need it for shafts, cogwheels, casings, and almost everything else."
	]
	quest.7A1F010000000003.quest_desc: [
		"&6Shafts&r carry rotational force — Create's stress system runs on rotating shafts that connect generators to consumers."
		""
		"Two shafts are the simplest power-transfer pair; longer chains can pass under, over, and around walls. Connect a wrench to flip orientations later."
	]
	quest.7A1F010000000004.quest_desc: [
		"The &6Water Wheel&r is your first stress generator. Place it next to flowing water and it spins, producing rotational force you can route through shafts."
		""
		"&aFlow direction matters — water has to actually move past the blades.&r Build a small stream from a higher block, or place the wheel against an existing river. Two adjacent wheels stack output."
	]
	quest.7A1F010000000006.quest_desc: [
		"&6Cogwheels&r transmit rotation between perpendicular shafts. Place one against a shaft to redirect power around corners or onto parallel lines."
		""
		"Cogwheels mesh with each other when placed adjacent — you can build entire gear trains without ever using a shaft."
	]
	quest.7A1F010000000007.quest_desc: [
		"&6Large Cogwheels&r are double-sized cogwheels that transmit rotation across a longer span and let you change rotation speed when meshed with a small cogwheel."
		""
		"&aSmall meshed with large = half speed, double torque.&r Large meshed with small = double speed, half torque. This is how you tune contraption speed without electricity."
	]
	quest.7A1F020000000001.quest_desc: [
		"The &6Hand Crank&r is the simplest stress source — right-click and hold to spin it. Useful for one-off operations like opening a deployer or briefly powering a small contraption."
		""
		"It's a debugging tool more than a real generator. You'll use it to test setups before committing to a water wheel or windmill."
	]
	quest.7A1F020000000002.quest_desc: [
		"The &6Windmill Bearing&r is the anchor block for windmill assemblies. Build a structure of sails attached to it, right-click with a wrench, and it begins spinning."
		""
		"&aThe more sail blocks attached, the more stress it produces.&r Windmills are higher-output than water wheels but bigger and weather-dependent."
	]
	quest.7A1F020000000003.quest_desc: [
		"&6Sail Frames&r are the bare skeleton of a windmill blade. Attach them to a windmill bearing, then right-click with wool to convert into sails for full stress output."
		""
		"&aFrames count as windmill sails for the assembly check, but produce less stress than wool sails.&r Use them as cheap filler if you're short on wool."
	]
	quest.7A1F020000000004.quest_desc: [
		"A &6White Sail&r — a finished windmill blade. Place it on a windmill bearing assembly to get full stress generation."
		""
		"&aWindmills need a minimum size to assemble.&r Build out a respectable cross of sails before right-clicking the bearing, or it'll refuse to spin."
	]
	quest.7A1F020000000005.quest_desc: [
		"The &6Wrench&r is Create's universal interaction tool. Right-click any Create block to rotate it, dismantle it, or reconfigure its settings."
		""
		"&aKeep one in your hotbar at all times.&r Building Create contraptions without a wrench is misery — you'll be breaking and replacing blocks constantly."
	]
	quest.7A1F030000000001.quest_desc: [
		"The &6Gearbox&r transmits rotation in all four horizontal directions from a single shaft input. It's the right-angle splitter Create's gear trains rely on."
		""
		"&aPlace it where one input needs to feed multiple consumers&r — saves you from building cogwheel chains."
	]
	quest.7A1F030000000002.quest_desc: [
		"The &6Gearshift&r reverses rotation direction when powered by redstone. Off = pass-through; on = reversed."
		""
		"&aUseful for piston extend/retract cycles&r and for any contraption that needs to flip directions on command."
	]
	quest.7A1F030000000003.quest_desc: [
		"The &6Clutch&r disengages rotation when powered by redstone. Off = power passes through; on = downstream is cut off."
		""
		"&aThe on/off switch for any rotation line.&r Pair with a lever or pressure plate for manual machine control."
	]
	quest.7A1F030000000004.quest_desc: [
		"The &6Encased Chain Drive&r links rotation along long horizontal runs without dropping torque. Place several in a row and they all spin at the same speed."
		""
		"&aGreat for spreading power over a long factory floor&r where individual shaft chains would clutter the build."
	]
	quest.7A1F030000000005.quest_desc: [
		"The &6Adjustable Chain Gearshift&r changes the speed of an encased chain line based on redstone power level — analog input means analog speed."
		""
		"&aWire it to a comparator or a pulse generator for variable-speed contraptions.&r Speed control without rebuilding gear ratios."
	]
	quest.7A1F040000000001.quest_desc: [
		"The &6Engineer's Goggles&r let you see stress, speed, and capacity numbers when looking at Create blocks. Wear them on the helmet slot."
		""
		"&aEssential diagnostic tool.&r Without goggles, you're guessing at why your contraption stalled. With them, you see exactly which generator is overloaded."
	]
	quest.7A1F040000000002.quest_desc: [
		"The &6Speedometer&r reads the rotation speed of an attached shaft and outputs a comparator signal proportional to RPM."
		""
		"&aPair with goggles for a live readout&r or wire to redstone logic to gate machines based on speed."
	]
	quest.7A1F040000000003.quest_desc: [
		"The &6Rotation Speed Controller&r sets a target RPM for a connected large cogwheel — give it a target value and it forces the cog to that speed regardless of input."
		""
		"&aThe brass-tier alternative to gear ratios.&r One block replaces a stack of cogwheels for setting precise speeds."
	]
	quest.7A1F050000000001.quest_desc: [
		"The &6Millstone&r is Create's small-batch grinder — wheat into flour, gravel into &6flint&r (NOT iron nuggets), plant matter into dyes, and a few softs. Per JAR (Create 6.0.9 `recipe/milling/`), it does &cnot&r process raw ores."
		""
		"&aFor proper ore doubling you'll need &6Crushing Wheels&r&a later — a separate Create multiblock that yields ~5x crushed_raw output per ore.&r The Millstone is your easy, low-tech early-mill. Drop a shaft into the side, hopper in the top, hopper out the bottom."
	]
	quest.7A1F050000000002.quest_desc: [
		"The &6Mechanical Press&r flattens items beneath it — sheet metal, plates, and packing operations on a basin below."
		""
		"&aPress + basin = compacting recipes.&r Drop nine ingots into a basin and the press will compact them into a block. Required for many Create recipe chains, including brass."
	]
	quest.7A1F050000000003.quest_desc: [
		"The &6Basin&r is the recipe vessel for press, fan, and mixer operations. Drop ingredients in; the machine above processes them in place."
		""
		"&aOutputs eject from the side&r — place a chute or funnel below to catch results. Combined with a press, this is your andesite-tier crafting line."
	]
	quest.7A1F050000000004.quest_desc: [
		"The &6Encased Fan&r blows items in front of it. Pass them through fire to smelt, water to wash, lava to smelt fast, or air for sorting."
		""
		"&aBulk smelting and washing.&r The fan + a row of items on a depot or belt = a one-block furnace replacement that runs as long as the fan does."
	]
	quest.7A1F060000000001.quest_desc: [
		"The &6Belt Connector&r places conveyor belts between two shafts. Click the start shaft, click the end shaft, and a leather belt stretches between them."
		""
		"&aBelts move items along their length, can carry players, and run at the speed of their driving shaft.&r Create's most flexible item-transport block."
	]
	quest.7A1F060000000002.quest_desc: [
		"&6Chutes&r drop items vertically between inventories. Place a chute under a hopper, belt, or another chute, and items flow down through them."
		""
		"&aFans pulled into chutes&r let you do vertical processing — smelt-on-the-way-down, wash-on-the-way-down, etc."
	]
	quest.7A1F060000000003.quest_desc: [
		"The &6Depot&r is a single-tile platform where items rest. A funnel can place items on it, a deployer can interact with them, and processed results sit there until another funnel pulls them away."
		""
		"&aThe minimal-belt processing tile.&r Use it when you don't need a moving line, just one slot of working space."
	]
	quest.7A1F060000000004.quest_desc: [
		"&6Andesite Funnels&r move items between belts and inventories. Right-click to flip direction (input vs output) and use a wrench to rotate."
		""
		"&aBetter than vanilla hoppers&r — funnels read filters, work on belt sides, and don't get stuck on full inventories the way hoppers do."
	]
	quest.7A1F060000000005.quest_desc: [
		"&6Filters&r are programmable item-matching cards. Put one in a funnel's filter slot to make it accept only specific items."
		""
		"&aCombine multiple item entries into one filter for AND/OR logic.&r Filters are how you sort a single belt of mixed loot into clean per-item lines."
	]
	quest.7A1F060000000006.quest_desc: [
		"The &6Portable Storage Interface&r exchanges items between a stationary inventory and a moving contraption. Mount one on a contraption and one on the world; when they line up, items transfer."
		""
		"&aEssential for train cargo, mobile farms, and any contraption that drops off harvest at a base.&r"
	]
	quest.7A1F070000000001.quest_desc: [
		"&6Fluid Pipes&r move fluids between tanks, pumps, and machine inputs. Place them like vanilla pipes — they auto-connect to adjacent fluid blocks."
		""
		"&aUse a wrench to add or remove window panels&r if you want to see the contents flowing through."
	]
	quest.7A1F070000000002.quest_desc: [
		"&6Fluid Tanks&r store liquids. Stack them vertically or horizontally; adjacent tanks merge into a single multiblock with combined capacity."
		""
		"&aGlass-windowed by default,&r so you can see contents at a glance. Useful for buffer storage between fluid generators and consumers."
	]
	quest.7A1F070000000003.quest_desc: [
		"The &6Mechanical Pump&r drives fluid through pipes. Place it on a pipe line and feed it rotation; it pushes fluid in one direction."
		""
		"&aRotation direction sets pump direction.&r Reverse the shaft and the pump reverses too. Speed = throughput."
	]
	quest.7A1F080000000001.quest_desc: [
		"&6Super Glue&r bonds blocks into a contraption. Right-click a face of a block to bond it to neighbors; the bonded blocks move together as one structure."
		""
		"&aThe alternative to chassis blocks for small contraptions.&r Use it to glue a few decorative blocks onto a mechanical piston without going full chassis."
	]
	quest.7A1F080000000002.quest_desc: [
		"&6Linear Chassis&r blocks anchor connected structures into a single contraption. Pistons and bearings see chassis-bound blocks as part of their cargo."
		""
		"&aRight-click with a wrench to control which faces are sticky.&r Chassis is how you build big without gluing every face manually."
	]
	quest.7A1F080000000003.quest_desc: [
		"The &6Mechanical Piston&r extends and retracts attached blocks under rotational power. Speed and direction are controlled by the input shaft."
		""
		"&aBuild farms, drawbridges, doors, and elevators.&r Anything that needs to move a block-structure linearly under control is a job for the mechanical piston."
	]
	quest.7A1F080000000004.quest_desc: [
		"The &6Rope Pulley&r raises and lowers attached structures vertically — your mechanical elevator, well bucket, or dropping platform."
		""
		"&aLonger ropes mean longer travel.&r Combine with a contact-detector or a sequenced gearshift for repeatable up/down cycles."
	]
	quest.7A1F080000000005.quest_desc: [
		"The &6Mechanical Bearing&r rotates attached structures around its axis. Glue or chassis-bind blocks to its face, then power it — the structure spins."
		""
		"&aRotating drawbridges, lighthouses, decorative mills, or even functional mob platforms.&r The bearing handles arbitrary structure rotation."
	]
	quest.7A1F080000000006.quest_desc: [
		"The &6Cart Assembler&r converts a static structure into a minecart contraption. Place it on rails, glue a structure on top, power it with redstone — the structure detaches as a moving cart."
		""
		"&aThe baby version of trains.&r Functional, but trains do most of this with way more polish. Cart assemblers are still useful for short rail loops."
	]
	quest.7A1F080000000007.quest_desc: [
		"The &6Mechanical Drill&r breaks blocks in front of its head when powered by rotation. Mount it on a piston or contraption to bore tunnels and excavate."
		""
		"&aThe build-it-yourself quarry.&r Combine drills with pistons and chassis for a moving mining platform — slow but renewable, no fuel needed."
	]
	quest.7A1F080000000008.quest_desc: [
		"The &6Mechanical Harvester&r, &6Saw&r, and &6Plough&r — the farming trinity. Mounted on a contraption, the harvester strips mature crops, the saw cuts trees, and the plough tills dirt and harvests root crops."
		""
		"&aBuild a horizontal cart contraption with all three to fully automate a wheat field&r — plough first to till, harvester to collect, replant from a hopper-deployer."
	]
	quest.7A1F090000000001.quest_desc: [
		"The &6Schematic and Quill&r records a region of the world as a schematic file. Right-click the corners, name the file, and Create saves the layout."
		""
		"&aPaste schematics with a Schematicannon&r — the cannon fires building blocks into place from your inventory until the schematic is rebuilt elsewhere."
	]
	quest.7A1F0A0000000001.quest_desc: [
		"&6Brass Casing&r is the tier-up from andesite — Create's mid-game material. Made by combining andesite alloy and brass ingots, it unlocks deployers, mechanical crafters, mechanical arms, and the rest of the brass tier."
		""
		"&5The gateway to advanced Create.&r Once you have brass casing, the entire automation toolkit opens up."
	]
	quest.7A1F0A0000000002.quest_desc: [
		"The &6Deployer&r is a programmable hand. Place an item in its slot and it'll right-click (or left-click) the block in front of it on every rotation cycle."
		""
		"&aOne of Create's most versatile tools.&r Use it to attack mobs, plant saplings, place blocks, fill bottles, mix potions, even craft on-demand. The robotic hand of the brass age."
	]
	quest.7A1F0A0000000004.quest_desc: [
		"&6Brass Funnels&r upgrade andesite funnels with filter slots and a full LCD readout of contents and direction."
		""
		"&aWhen you need filtered transfer&r — accept only iron, reject diamonds, etc. — brass funnels handle it cleanly."
	]
	quest.7A1F0A0000000005.quest_desc: [
		"The &6Brass Tunnel&r is a smart belt junction — items pass through and split based on programmable distribution rules: round robin, first available, force split, etc."
		""
		"&aThe heart of any sorting line.&r Filter by item or by count, output to multiple lanes, and handle ratios automatically."
	]
	quest.7A1F0A0000000006.quest_desc: [
		"The &6Mechanical Crafter&r automates 3x3 crafting recipes. Arrange a grid, point each crafter at the next, supply items via funnel, and the assembly auto-crafts."
		""
		"&aAutomates Create's complex multi-step recipes&r — including the brass-tier items themselves. Once you've got crafters, you can build a Create factory."
	]
	quest.7A1F0A0000000007.quest_desc: [
		"The &6Sequenced Gearshift&r executes a programmable sequence of rotation moves — turn 4 ticks forward, pause 2 seconds, turn 8 ticks reverse, repeat."
		""
		"&aEssential for clockwork bearings, automatic doors, mechanical mining contraptions&r — anything that needs a fixed motion sequence."
	]
	quest.7A1F0A0000000008.quest_desc: [
		"&6Crushing Wheels&r come in pairs — place two side by side, power them in opposite directions, and they crush items dropped between them at 1.5–2x ore yield."
		""
		"&aThe upgrade from millstone.&r Faster, higher yield, and they crush blocks the millstone can't handle (ingots, dense ores)."
	]
	quest.7A1F0B0000000001.quest_desc: [
		"The &6Flywheel&r stores rotational energy and stabilizes power output. Pair with a Furnace Engine (Create addons) for industrial-scale stress generation."
		""
		"&aMostly decorative on its own,&r but central to the high-end power generators in the Create family. The flywheel is what real engineers stick on top of their best engine."
	]
	quest.7A1F0B0000000002.quest_desc: [
		"&6Electron Tubes&r are crafted from rose quartz and glow blue. Logic-flavored components used in mechanical arms, computers, and other smart Create blocks."
		""
		"It's Create's stand-in for 'integrated circuit' — every smart machine wants a few."
	]
	quest.7A1F0B0000000003.quest_desc: [
		"&6Rose Quartz&r is crafted from quartz and redstone in a basin under a press, then polished into electron tubes and other late-game brass items."
		""
		"&aPolished rose quartz also makes decorative blocks&r — pinkish translucent panels for fancy builds."
	]
	quest.7A1F0B0000000004.quest_desc: [
		"The &6Mechanical Arm&r picks items from one inventory and places them in another, programmable to follow specific rules. Set up to twelve input/output points per arm."
		""
		"&aThe item-routing brain.&r Mechanical arms turn a chaotic depot into a clean assembly station — pick from chest A, place into crafter B, pick result, place into output."
	]
	quest.7A1F0B0000000005.quest_desc: [
		"The &6Clockwork Bearing&r rotates two attached structures (hour hand and minute hand) according to in-game time. The literal mechanical clock."
		""
		"&aMostly aesthetic but legitimately a clock&r — build a tower with two arms and watch them sweep through the day."
	]
	quest.7A1F0C0000000001.quest_desc: [
		"&5The Shopping List&r is the chapter capstone — proof that you've built the full Create brass-tier toolkit and survived an entire Medieval Age."
		""
		"This single item represents thousands of stress units, hundreds of cogwheels, and a working factory floor. From here, you graduate to iron — &cthe Iron Era awaits&r, and with it, the door to Renaissance."
		""
		"&aTake a moment. Look at what you built. Then go forge some real metal.&r"
	]
	quest.7A42FE7D3D95B8B4.quest_desc: [
		"&6Grime Ball&r — a clump of compressed Deep Dark muck. Drops from Deeper Darker mobs and feeds into a few utility recipes."
		""
		"&7Filler crafting reagent. Stockpile a stack and forget about it until JEI tells you it's needed.&r"
	]
	quest.7AC64E6DE95636B9.quest_desc: ["&6Gravitite Gloves&r — Aether curio that slows your falls, complementing the gravitite armor set."]
	quest.7ACD7A4C9DB1CF6F.quest_desc: ["The &6Spirit Saber&r is a Gaze weapon — channels spirit energy with each swing for ranged or AoE damage."]
	quest.7B01000000000001.quest_desc: [
		"&6Pream Berry&r — Phantasm's tart End berry. Eat for moderate hunger restoration."
		""
		"&aFirst step on Phantasm's End food chain — pream → pome → chorus salad.&r"
	]
	quest.7B01000000000002.quest_desc: [
		"&6Pome Slice&r — sliced fruit from Phantasm's End trees. Mid-step on the food chain."
		""
		"Combines into the Chorus Fruit Salad."
	]
	quest.7B01000000000003.quest_desc: [
		"&6Chorus Fruit Salad&r — Phantasm's terminal end-food, combining pream, pome, and chorus components into a sumptuous endgame meal."
		""
		"&aOne of the best food items in the chapter. Saturation for days.&r"
	]
	quest.7B01000000000004.quest_desc: [
		"&6Starflower&r — Phantasm's signature End flower. Found in oblifruit-adjacent biomes."
		""
		"Decorative and a base ingredient for the Crystalily and Dragon Mint chains."
	]
	quest.7B01000000000005.quest_desc: [
		"&6Crystalily&r — a translucent, crystalline lily from Phantasm's End biomes."
		""
		"&aPlant a row in your base for End-themed decor.&r"
	]
	quest.7B01000000000006.quest_desc: [
		"&6Dragon Mint&r — the Phantasm flower chain's terminal harvest, themed after the Ender Dragon."
		""
		"&7Pure flavor / decoration. Trophy for completionists.&r"
	]
	quest.7B01000000000008.quest_desc: [
		"&6Crystal Block&r — Phantasm's compressed crystal building block. Glowing, decorative, useful for endgame architecture."
		""
		"&aBuild towers out of these to reflect End light. Also a step toward void crystal block.&r"
	]
	quest.7B01000000000009.quest_desc: [
		"&6Void Crystal Block&r — the dark counterpart to Crystal Block. Same building utility, different aesthetic."
		""
		"&aPair Crystal + Void Crystal for striking decorative contrast in End builds.&r"
	]
	quest.7B0100000000000D.quest_desc: [
		"&6Music Disc — Abruption&r — Phantasm's themed music disc, a Behemoth boss drop."
		""
		"&7Optional collectible. Drop it in a jukebox in your End base.&r"
	]
	quest.7B0100000000000E.quest_desc: [
		"&6Crystalline Tools&r — Phantasm's full toolkit: sword, pickaxe, axe, shovel, hoe, all crafted from crystal shards."
		""
		"&aThe themed full set. Solid stats, gorgeous appearance. Worth crafting for the aesthetic alone.&r"
	]
	quest.7B02000000000001.quest_desc: [
		"The &6Aeternium Pickaxe&r — BetterEnd's apex mining tool. Strikes faster than netherite, lasts longer, and ignores the usual hardness ceilings on rare End materials."
		""
		"&aMakes mining endgame ores tolerable.&r If you want to spelunk the End productively, build this first."
	]
	quest.7B02000000000001.title: "Aeternium Pickaxe"
	quest.7B02000000000002.quest_desc: ["The &6Aeternium Axe&r — BetterEnd's signature woodcutter and combat backup. Quick swings, high damage."]
	quest.7B02000000000002.title: "Aeternium Axe"
	quest.7B02000000000003.quest_desc: ["The &6Aeternium Shovel&r — fast and clean for End-stone earthworks."]
	quest.7B02000000000003.title: "Aeternium Shovel"
	quest.7B02000000000004.quest_desc: ["The &6Aeternium Hoe&r — for the farming completionist. Tilling End-soil with this is satisfying in a way that's hard to explain."]
	quest.7B02000000000004.title: "Aeternium Hoe"
	quest.7B02000000000006.quest_desc: [
		"The &6Aeternium Block&r — nine ingots compressed into a single decorative storage block. The most ostentatious building material BetterEnd offers."
		""
		"&aShows off your wealth.&r Useful for storing reserve aeternium without the hotbar bloat."
	]
	quest.7B02000000000006.title: "Aeternium Block"
	quest.7B0200000000000A.quest_desc: [
		"Gather four BetterEnd plants — &6Cyan Moss&r, &6Amber Root Seed&r, &6Chorus Grass&r, and &6Blossom Berry Seed&r. Each is biome-specific and represents a different End ecosystem."
		""
		"Useful for landscaping, BetterEnd farming, and downstream alchemy recipes."
	]
	quest.7B0200000000000A.title: "Cyan Moss"
	quest.7B0200000000000D.quest_desc: ["&6Shadow Berries&r — fruit from BetterEnd's Shadow Forest biome. Edible, jelly-able, and a tradeable curio for villagers later."]
	quest.7B0200000000000D.title: "Shadow Berry Seeds"
	quest.7B03000000000004.quest_desc: [
		"&6Rustle Bucket&r — Enderscape's bucketed Rustle. Carry one back to your aquarium and release it."
		""
		"&aGreat decoration in display tanks at your endgame base.&r"
	]
	quest.7B03000000000005.quest_desc: [
		"&6Flanger Berry&r (Enderscape) — a small Enderscape berry. Edible, restores hunger."
		""
		"Goes into the Chorus Cake Roll recipe."
	]
	quest.7B03000000000007.quest_desc: [
		"&6Chorus Cake Roll&r (Enderscape) — a layered chorus dessert. Restores significant hunger and saturation."
		""
		"&aEnd-tier dessert. Carry stacks for long expeditions.&r"
	]
	quest.7B05000000000001.quest_desc: [
		"&6Music Disc — Ender Guardian&r (Cataclysm) — drops from the Cataclysm Ender Guardian boss."
		""
		"&7Trophy disc. Drop in a jukebox to commemorate the kill.&r"
	]
	quest.7B0E9AD7B09A9CD7.quest_desc: ["The &6Veil Dagger&r — Gaze's stealth-flavored quick blade, lighter than the rapier with a crit on backstabs."]
	quest.7B203014B0A62C8E.quest_desc: ["&6Music Disc - Wither Waltz&r — a rare Eternal Nether disc. Drop into a jukebox for a creepy waltz."]
	quest.7B26069EC5CF71D4.quest_desc: [
		"&6Desert Sorceress&r and &6Desert Acolyte&r — Monster Plus desert variants. Two of each."
		""
		"&aSpawn in desert biomes. Cast minor curses; clear them on sight.&r"
	]
	quest.7B2D9F7864AB87B3.quest_desc: [
		"The &6Crafting Emitter&r (RSRequestify) emits a redstone signal when an item is being autocrafted. Use it as a status flag for external automation."
		""
		"&aPair with vanilla redstone to gate other systems on RS state.&r"
	]
	quest.7B4F22359DAEEFFD.quest_desc: ["The &6Shield of Repulsion&r — a Slider drop. Deflects projectiles and knocks back attackers."]
	quest.7B598669D634519A.quest_desc: [
		"An &6Empty Gnome Burrow&r — find one in the wild, abandoned by its previous tenant. Place it down and a gnome will eventually move in."
		""
		"&aThe entry to the gnome subchapter.&r Once a gnome arrives, you can interact, trade, or fight it for drops."
	]
	quest.7B5E2CD676A1A1C4.quest_desc: [
		"Build a &6Baker&r — the citizen who turns flour into bread, cakes, and similar baked goods."
		""
		"Important food-crafting role; pair with the Farmer for grain supply."
	]
	quest.7B756D8E8E7323A5.quest_desc: ["&6Withered Bone&r — Eternal Nether's twisted variant of the wither skeleton drop. Used in higher-tier recipes."]
	quest.7C6DEF08EF7C60DB.quest_desc: [
		"&6Starlit Painting&r — a decorative item depicting a moment from the Starlight. Both submit one and hold one to confirm you've crafted (or looted) the painting and kept it in your inventory long enough to display it."
		""
		"&7Optional collectible. Hang it in your base for atmosphere.&r"
	]
	quest.7C9F1E9C31DC7362.quest_desc: [
		"Kill a &6Piglin Executioner&r. Luminous Nether's elite piglin variant — armored, axe-wielding, hits like a truck."
		""
		"&cA real fight.&r Drops the executioner hood and counts toward the Cursed Eye reward."
	]
	quest.7CA2115E54E97BE0.quest_desc: [
		"&6Soundproof Glass&r — exactly what the name says. Light passes through; sculk vibrations don't."
		""
		"&aBuild a base in the Deep Dark with this and the Warden literally cannot hear you. Indispensable QOL block.&r"
	]
	quest.7D3489901AA47547.quest_desc: [
		"Place a &6Town Hall&r — the foundational block of every MineColonies settlement."
		""
		"&aThe Town Hall block creates the colony.&r Without it, no colony exists."
	]
	quest.7D36D95D74E1588E.quest_desc: [
		"&6Leather Glove&r — the entry-level Alchemists Garden tool. Lets you handle thorny, toxic, or otherwise dangerous plants without taking damage."
		""
		"&aCarry this any time you go gathering exotic herbs.&r Many AG plants will hurt unprotected hands."
	]
	quest.7E45103025EB0FE6.quest_desc: ["The &6Cutlass&r from Eternal Nether — a swashbuckling Nether sword with bonus damage against undead and Nether mobs."]
	quest.7E7C01A700000001.quest_desc: [
		"The &6Empty Blaze Burner&r is the gateway to brass — Create's mid-tier upgrade material. Catch a blaze in this with a soul-soft prismatic glass to start a fire that will smelt brass."
		""
		"This is the chapter's entry quest. The whole tech ladder unfolds from here: brass → mechanisms → trains → IE steel."
		""
		"&aGet to the Nether and grab a blaze first if you haven't already.&r"
	]
	quest.7E7C01A700000002.quest_desc: [
		"The &6Blaze Burner&r is what you get when an Empty Blaze Burner has a blaze in it. It's the heat source for Create's mid-tier processing — feed it fuel and it powers Mixers and Basins."
		""
		"&aFeed it blaze cake (from blaze powder + sugar + pressed dough + cinder flour) for max heat. It accepts plain fuel for low heat too.&r"
	]
	quest.7E7C01A700000003.quest_desc: [
		"&6Brass Ingot&r — Create's mid-tier alloy, made by mixing zinc and copper in a Mechanical Mixer over a Blaze Burner."
		""
		"Once you have brass, you have casings, mechanical crafters, deployers, mechanical arms — basically the entire mid-tier Create toolkit."
	]
	quest.7E7C01A700000004.quest_desc: [
		"&6Brass Casing&r — the universal mid-tier Create housing. Slap one onto wooden parts and you get the brass-tier version of just about every Create kinetic block."
		""
		"You will burn through stacks of these. Set up brass automation early or you'll regret it."
	]
	quest.7E7C01A700000005.quest_desc: [
		"&6Rose Quartz&r — Create's pinkish gem, mined from chromatic compound or grown from quartz blocks soaked in lava and a Spout. Used in electron tubes and decorative blocks."
		""
		"The quartz crafting branch leads to electron tubes and ultimately precision mechanisms — the brain of Create's higher-tier devices."
	]
	quest.7E7C01A700000006.quest_desc: [
		"&6Polished Rose Quartz&r — rose quartz that's been polished by sandpaper or in a deployer/mechanical setup. Translucent, pretty, and the missing ingredient for electron tubes."
		""
		"&aAutomate the polishing step with deployers + sandpaper if you want this in volume.&r"
	]
	quest.7E7C01A700000007.quest_desc: [
		"&6Electron Tube&r — Create's signature electronic-flavored component. Glass tube + polished rose quartz + redstone, assembled at a fan/Mechanical Press."
		""
		"Used in the precision mechanism recipe and many of Create's higher-tier electronics-themed parts. Stockpile a stack."
	]
	quest.7E7C01A700000008.quest_desc: [
		"The &6Precision Mechanism&r is Create's mid-tier multi-step crafted brain — assembled by a Mechanical Crafter from gold sheets, cogwheels, and an electron tube."
		""
		"This is the chapter icon for a reason. Almost every Create high-tier block has one of these in its recipe: trains, mechanical arms, smart chutes."
		""
		"&aSet up an automated Precision Mechanism factory — you will need dozens, not handfuls.&r"
	]
	quest.7E7C01A700000009.quest_desc: [
		"The &6Mechanical Crafter&r is Create's automated multi-step crafting block — chain a 3x3 of these together and they assemble recipes one row at a time."
		""
		"Required for precision mechanisms (and a lot of mod-pack recipes that use the mechanical crafter as their advanced bench). Build at least nine."
	]
	quest.7E7C01A700000010.quest_desc: [
		"The &6Crushing Wheel&r — Create's bulk ore processing solution. Two of them, spinning toward each other, crush whatever you drop between them into dust or particles."
		""
		"Faster than a Millstone, scales better, and runs entirely on rotational power. Two wheels per setup."
	]
	quest.7E7C01A700000011.quest_desc: [
		"The &6Deployer&r holds an item and uses it on whatever's in front of it — like a robotic arm with a single tool."
		""
		"Combine with sandpaper for polishing automation, with a sword for an automated mob farm, with a hoe for tilling — endlessly versatile."
	]
	quest.7E7C01A700000012.quest_desc: [
		"The &6Mechanical Arm&r is Create's pickup-and-place robot — point it at input and output inventories and it shuttles items between them based on filter rules."
		""
		"Brilliant for sorting, mechanical crafter feeders, and conveyor-less automation. Each arm needs a precision mechanism in its recipe."
	]
	quest.7E7C01A700000013.quest_desc: [
		"The &6Transmitter&r broadcasts a redstone signal wirelessly to its paired receivers — Create's clean answer to redstone wiring across distances."
		""
		"&aPair with a Receiver block on the other end. Distances are generous; obstacles don't matter.&r"
	]
	quest.7E7C01A700000014.quest_desc: [
		"The &6Display Link&r reads data from a target block (item count, fluid amount, train station info) and writes it to a sign or display board."
		""
		"&aBuild a stock dashboard or train arrival board with these. They turn 'is the system working' into a glance.&r"
	]
	quest.7E7C01A700000015.quest_desc: [
		"The &6Smart Chute&r is Create's filtered chute — drop items in only when they match the filter, otherwise let them pass."
		""
		"Useful for sorting on belts and routing items by type without dedicated sorters."
	]
	quest.7E7C01A700000016.quest_desc: [
		"The &6Rotation Speed Controller&r lets you set an exact RPM for downstream rotation — useful when a process needs faster/slower than the source provides."
		""
		"&aUse it to decouple a fast generator from a slow process (or vice versa) without messy gear ratios.&r"
	]
	quest.7E7C01A700000017.quest_desc: [
		"&6Railway Casing&r — the housing block for everything in Create's train system. Different from a Brass Casing, has its own recipe with andesite alloy and treated wood."
		""
		"This unlocks the entire train branch: tracks, stations, signals, controls, schedules, handcars."
	]
	quest.7E7C01A700000018.quest_desc: [
		"&6Track&r — Create's flexible rail. Unlike vanilla rails, these snap together at angles, switch automatically, and follow curves your setup actually wants."
		""
		"32 tracks gets you a starter line. Real train networks need hundreds — automate track production with a brass-tier mechanical setup."
	]
	quest.7E7C01A700000019.quest_desc: [
		"The &6Track Station&r is where trains stop — assemble new trains, refuel old ones, and define endpoints for schedules."
		""
		"&aName your stations clearly. The schedule editor uses station names; your future self will thank you.&r"
	]
	quest.7E7C01A700000020.quest_desc: [
		"The &6Train Controls&r block lets you drive a train manually — stand on it, look at the lever, and push throttle/brake."
		""
		"&aMost trains run on schedules, but Controls let you actually drive. Treat it as a luxury cabin upgrade.&r"
	]
	quest.7E7C01A700000021.quest_desc: [
		"The &6Handcar&r (Create: Steam 'n Rails) is a small player-powered cart that runs on Create tracks. Pump the levers to move it."
		""
		"&aGreat for short jaunts and survey runs along your track network — no fuel, no schedule, just legs.&r"
	]
	quest.7E7C01A700000022.quest_desc: [
		"The &6Conductor Cap&r marks a villager as a train conductor for Create: Steam 'n Rails — they will operate trains on schedules without you on board."
		""
		"&aPlace it on a villager and you've delegated a route. Multiple caps = multiple conductors = a real network.&r"
	]
	quest.7E7C01A700000023.quest_desc: [
		"&6Track Signal&r — Create's traffic light for trains. Place pairs along a track to define block sections; trains stop when signals are red."
		""
		"&aCritical for any track network with more than one train. Without signals, two trains share an intersection and you get a wreck.&r"
	]
	quest.7E7C01A700000024.quest_desc: [
		"The &6Track Observer&r emits a redstone pulse when a train passes. Detect arrivals, count cargo runs, trigger automation off train events."
		""
		"&aPair with a Display Link to broadcast 'last train passed N seconds ago' on a board.&r"
	]
	quest.7E7C01A700000025.quest_desc: [
		"&6Train Door&r — a passenger-friendly door for your train cars. Opens automatically when the train stops at a station, closes when it leaves."
		""
		"&7Pure flavor and convenience — your train works without it, but feels less like a real train.&r"
	]
	quest.7E7C01A700000026.quest_desc: [
		"The &6Schedule&r is the routing brain of a Create train — write a list of stations and conditions, hand it to a conductor, and the train runs the route automatically."
		""
		"This is the Steam 'n Rails capstone. With a schedule in hand, your trains run themselves and your factory has its own postal service."
		""
		"&aDon't sleep on conditional steps (cargo full / time elapsed / redstone signal) — they make schedules actually responsive.&r"
	]
	quest.7E7C01A700000027.quest_desc: [
		"The &6Rolling Mill&r is a Create: Crafts  Additions block that converts ingots into rods — replaces the vanilla 'two ingots in a column' recipe with an automatable kinetic process."
		""
		"&aFeed it iron ingots, get iron rods. Pairs naturally with the rest of the CA electrical chain.&r"
	]
	quest.7E7C01A700000028.quest_desc: [
		"&6Iron Rod&r — a Create: Crafts  Additions component, rolled out from iron ingots in a Rolling Mill."
		""
		"Used in many CA and downstream recipes. A small but constant tax on your iron supply."
	]
	quest.7E7C01A700000029.quest_desc: [
		"&6Copper Wire&r — pulled from copper ingots in the Rolling Mill. The base of all CA electrical wiring."
		""
		"Stockpile a stack. Spools, motors, capacitors all need wire."
	]
	quest.7E7C01A700000030.quest_desc: [
		"&6Copper Spool&r — wire wrapped around a core, ready to be assembled into electric motors and generators. The CA workhorse component."
		""
		"&aPart of why r7 is the canonical SU↔FE bridge: this is where Create rotation becomes real electricity.&r"
	]
	quest.7E7C01A700000033.quest_desc: [
		"&6Biomass Pellet&r — compressed organic matter, the basic fuel for several CA and downstream burning generators."
		""
		"&aFeed leaves, saplings, or any biomass through the right press to mass-produce these.&r"
	]
	quest.7E7C01A700000034.quest_desc: [
		"This convergence quest closes out the CA chain. With the Crafts  Additions wiring in place, you have a Create-side rotation-to-FE bridge for downstream RF/FE machines."
		""
		"&7Note: This bridge is RF/FE-compatible only. Mekanism Joules, Electrodynamics V/J, and other mod-specific systems still require their own conversion paths.&r"
	]
	quest.7E7C01A700000035.quest_desc: [
		"&6Chainable Cogwheel&r — GTceu/GN Kinetics' answer to vanilla Create gearing, with chains and gear ratios that work together cleanly."
		""
		"The entry to the GN Kinetics gear branch — worm, planetary, ring, magnet gears all branch off."
	]
	quest.7E7C01A700000036.quest_desc: [
		"&6Worm Gear&r — a high-ratio gear from GN Kinetics. Massive speed reduction or torque multiplication, depending on which end you drive."
		""
		"&aPerfect for processes that need slow, high-torque rotation (like a giant grindstone or a press chain).&r"
	]
	quest.7E7C01A700000037.quest_desc: [
		"&6Planetary Gear&r — the staple compact differential from GN Kinetics. Multiple ratios, three shafts, very efficient for combining torque sources."
		""
		"&7Real engineering nerd-out content. JEI shows the input/output ratios.&r"
	]
	quest.7E7C01A700000038.quest_desc: [
		"&6Ring Gear&r — a large internal-toothed gear used in compound gear assemblies. Pairs with the planetary gear for differentials."
		""
		"Use when you need to wrap multiple smaller gears inside a single rotational unit."
	]
	quest.7E7C01A700000039.quest_desc: [
		"&6Magnet Gear&r — GN Kinetics' magnetic-coupling gear. Transmits rotation through a non-contact magnetic link."
		""
		"&aHandy when you need to send rotation across a small gap without direct contact (think: through a glass barrier or sealed section).&r"
	]
	quest.7E7C01A700000040.quest_desc: [
		"&6Electrum Ingot&r — Immersive Engineering's gold-silver alloy, the entry-level conductive metal for IE wiring."
		""
		"This is the gateway to IE's electrical branch: wirecoils, MV connectors, capacitors, and (eventually) the Blast Furnace for steel."
	]
	quest.7E7C01A700000041.quest_desc: [
		"&6Electrum Wirecoil&r — IE's MV-tier wire for power transmission. Pull-to-place: connect two MV connectors and the wirecoil draws the line."
		""
		"&aIE wiring beats vanilla redstone for distance, but each tier needs its own connector + relay infrastructure.&r"
	]
	quest.7E7C01A700000042.quest_desc: [
		"&6MV Connector&r — IE's medium-voltage power endpoint. Place these on machines or capacitors and string electrum wirecoil between them."
		""
		"Each end of an IE power line needs a connector. Two minimum per circuit."
	]
	quest.7E7C01A700000043.quest_desc: [
		"&6MV Relay&r — IE's relay node. Use these to route MV wires across long distances without machines on every pole."
		""
		"&aBuild proper transmission lines with relay stations. Looks impressive, works well.&r"
	]
	quest.7E7C01A700000044.quest_desc: [
		"The &6MV Capacitor&r is IE's mid-tier energy battery — store FE here for use later."
		""
		"&aPlace one near every machine cluster. Smooths out generation spikes and keeps machines fed during outages.&r"
	]
	quest.7E7C01A700000045.quest_desc: [
		"&6Electronic Component&r — IE's PCB-flavored ingredient, used in many of the higher-tier IE machines."
		""
		"You'll need a couple early; many more once you push into IE's automation tier later."
	]
	quest.7E7C01A700000046.quest_desc: [
		"&6Blast Brick&r — refractory brick for IE's Blast Furnace multiblock. Twelve bricks gets you the structural pieces; you'll need more for the full multiblock."
		""
		"This is the gating component for steel. Without the Blast Furnace, no IE steel; without IE steel, the chapter doesn't close."
	]
	quest.7E7C01A700000047.quest_desc: [
		"&6Coal Coke&r — coal baked in a Coke Oven. Burns hotter and longer than raw coal; required as the carbon source for IE steel."
		""
		"&aBuild the Coke Oven multiblock first — it produces coal coke and creosote oil simultaneously. You need both.&r"
	]
	quest.7E7C01A700000048.quest_desc: [
		"&6Steel Ingot&r — IE's hard-earned steel, smelted by feeding iron + coal coke into the Blast Furnace multiblock. Stronger than iron, used in most IE high-tier recipes."
		""
		"&cThis is the chapter capstone (size 1.5 diamond). Steel unlocks the link to r6 and the rest of Renaissance tech.&r"
		""
		"&aFour ingots is the minimum proof. Production won't stop here — every IE machine and many cross-mod recipes use steel.&r"
	]
	quest.7E7C01A700000049.quest_desc: [
		"The &6Voltmeter&r is IE's diagnostic tool — right-click any IE energy block to read its current charge."
		""
		"&aIndispensable when you're chasing why a machine isn't running. Keep it in your hotbar.&r"
	]
	quest.7E7C01A700000050.quest_desc: [
		"&6Compressed Iron Ingot&r — PneumaticCraft's first tier-defining material. Made by repeatedly hammering iron blocks with explosives or a hydraulic press."
		""
		"This unlocks the entire PneumaticCraft pressure-tech branch: tubes, walls, valves, gauges, vortex cannon, compressed iron armor."
	]
	quest.7E7C01A700000051.quest_desc: [
		"&6Reinforced Stone&r — a compressed iron + stone block used in PneumaticCraft's pressure chamber walls."
		""
		"Reinforced stone is what holds in pressurized air without rupturing. Build the chamber out of these or risk a leak."
	]
	quest.7E7C01A700000052.quest_desc: [
		"&6Pressure Tube&r — PneumaticCraft's pneumatic plumbing. Routes pressurized air between machines and storage."
		""
		"&aPlace network gauges and valves on these tubes to control flow direction and pressure thresholds. PneumaticCraft is more like real pipework than electricity.&r"
	]
	quest.7E7C01A700000054.quest_desc: [
		"The &6Pressure Chamber&r is PneumaticCraft's headline multiblock — a sealed cube of pressure walls + valve + glass that compresses raw materials into refined components when pressurized."
		""
		"Three components in one quest: 16 walls, the valve interface, and 2 glass panels for visibility. Build it as a 5x5x5 hollow cube with the valve as the input/output."
		""
		"&cKeep an eye on pressure — overpressure can cause an explosion. The pressure gauge is mandatory.&r"
	]
	quest.7E7C01A700000055.quest_desc: [
		"The &6Pressure Gauge&r reads PneumaticCraft pressure values from your tube network. Plug it inline to see what's flowing where."
		""
		"&aMonitor before the pressure chamber's max threshold. Going over results in fireworks you didn't order.&r"
	]
	quest.7E7C01A700000056.quest_desc: [
		"The &6Vortex Cannon&r is PneumaticCraft's air-blast weapon — fires pressurized air pulses that knock entities (and items) flying."
		""
		"&aMore utility than weapon: use it to push mobs off platforms, or items into chutes from a distance.&r"
	]
	quest.7E7C01A700000057.quest_desc: [
		"&6Compressed Iron armor set&r — helmet, chestplate, leggings, boots. PneumaticCraft's mid-tier armor; the gateway to the eventual Pneumatic Helmet upgrade tree."
		""
		"&aThe chestplate accepts upgrade modules later — magnet, jet boots, security upgrade — turning ordinary armor into a Tony Stark suit by Industrial Revolution.&r"
	]
	quest.7E7C01A700000058.quest_desc: [
		"The &6Forge Hammer&r is Modern Industrialization's manual processing tool — right-click ores, ingots, plates to convert them between forms before you have machine processing."
		""
		"&aMI's first quest. The whole MI engineering spine starts with this hammer in your hand.&r"
	]
	quest.7E7C01A700000059.quest_desc: [
		"The &6Wrench&r (Modern Industrialization) rotates and configures MI machines — face direction, IO config, pipe orientation."
		""
		"&aKeep one in your hotbar permanently from here on. MI machines are configurable; the wrench is how you configure them.&r"
	]
	quest.7E7C01A700000060.quest_desc: [
		"The &6Steam Mining Drill&r is Modern Industrialization's first auto-mining tool — runs on steam, mines ore veins quickly with a wide pattern."
		""
		"&aMuch faster than vanilla pickaxe work. Bring fuel and water; the drill consumes both.&r"
	]
	quest.7E7C01A700000061.quest_desc: [
		"&6Item Pipe&r (Modern Dynamics) — moves items between inventories. The mid-tier evolution of vanilla hopper chains, with filtering and direction control."
		""
		"This is the canonical item-pipe in this pack: the Modern Dynamics audit confirmed near-full coverage in r7. Use these for inventory routing across your factory."
	]
	quest.7E7C01A700000062.quest_desc: [
		"The &6Extractor&r is Modern Dynamics' pulling node — attach to any inventory and it actively extracts items into the pipe network."
		""
		"&aWithout an extractor, items don't move on their own. With one, you've got automation.&r"
	]
	quest.7E7C01A700000063.quest_desc: [
		"The &6Filter&r (Modern Dynamics) is an upgrade module for pipes and extractors — restrict which items move based on whitelist or blacklist."
		""
		"&aRequired for any nontrivial routing. Without filters, your pipes carry everything indiscriminately.&r"
	]
	quest.7E7C01A700000064.quest_desc: [
		"The &6Redstone Magnet&r (Create New Age) is the spinning core of CnA's electrical generators — pair it with a coil and you've got an alternator."
		""
		"&aCreate New Age is a parallel SU↔FE bridge to Crafts  Additions. Both work; pick whichever wiring style you prefer.&r"
	]
	quest.7E7C01A700000065.quest_desc: [
		"The &6Basic Energiser&r is Create New Age's introductory energy device — converts low-tier sources into FE for distribution."
		""
		"Useful for early-tier electrical loops in CnA's tree."
	]
	quest.7E7C01A700000067.quest_desc: [
		"The &6Charger&r and &6Crank&r are AE2's pre-power infrastructure — turn the crank by hand or with a kinetic shaft to charge certified quartz into charged certus quartz."
		""
		"&aThis is your AE2 entry point in r7. The full AE2 storage system unlocks later in IR; for now, you're prepping the charged certus you'll need then.&r"
	]
	quest.7E7C01A700000068.quest_desc: [
		"The &6Growth Accelerator&r forces certus quartz crystal seeds in adjacent water to grow much faster. The bottleneck-buster of AE2's crystal economy."
		""
		"&aBuild a tower of these around your seed setup and your certus problem solves itself.&r"
	]
	quest.7E7C01A700000069.quest_desc: [
		"The &6Atomic Reconstructor&r is Actually Additions' beam-tool — fires a redstone-energy laser that converts blocks/items in line according to its recipe set."
		""
		"&aUseful for crystal cluster generation and several niche conversions. Fast, low-fuss alternative to multiblocks.&r"
	]
	quest.7E7C01A700000070.quest_desc: [
		"The &6Laser Relay&r (Actually Additions) is a wireless energy/item/fluid transmitter — pair them to network energy across distances without cable."
		""
		"&aGreat for reaching outlying machines without running wire across half the base.&r"
	]
	quest.7E7C01A700000071.quest_desc: [
		"&6Fertilizer Bucket&r (Slice  Dice) — a liquid fertilizer used in the sprinkler. Concentrated bone meal in fluid form."
		""
		"&aPair with the sprinkler for area-of-effect crop growth boost.&r"
	]
	quest.7E7C01A700000072.quest_desc: [
		"The &6Sprinkler&r (Slice  Dice) sprays fertilizer over a radius, growing crops in the area at an accelerated rate."
		""
		"&aSet up a Create-tier farm with these and your food/material problem evaporates.&r"
	]
	quest.7E7C01A700000073.quest_desc: [
		"&6Chicken Roost&r (Create: Integrated Farming) — an automated chicken coop. Breeds and collects eggs/meat with minimal player intervention."
		""
		"&aDrop chickens into it, plug in a feeder, and you've got passive poultry production.&r"
	]
	quest.7E7C01A700000074.quest_desc: [
		"&6Duck Roost&r — same idea as the chicken roost, but for ducks. Different drops (feathers, slightly different egg pool)."
		""
		"&7Variety is its own reward; ducks also waddle, which counts.&r"
	]
	quest.7E7C01A700000074.title: "Region: Mechanical Forging"
	quest.7E7C01A700000075.quest_desc: [
		"&6Goose Roost&r — geese are the third Create: Integrated Farming poultry. Slightly different drop table, same passive production loop."
		""
		"&aCollect all three (chicken, duck, goose) for the full poultry farm aesthetic.&r"
	]
	quest.7E7C01A700000075.title: "Region: Heavy Industry"
	quest.7E7C01A700000076.title: "Region: Electrum Frontier"
	quest.7EB9CE4DAF2B8ED4.quest_desc: [
		"An &6Aureal Bottle&r — captures aureal (FA's mana-flavored magical fluid) for use in spell or ritual recipes."
		""
		"&aFill at an aureal source&r and feed into any FA machine that demands aureal."
	]
	quest.7F383BA68ED3640F.quest_desc: [
		"The &6Edge of Deliverance&r and &6Weight of Worlds&r — Malum's two endgame weapons. Edge is a fast lifesteal sword; Weight is a slow, devastating hammer."
		""
		"&5Pick the playstyle&r that fits you. Both are top-tier."
	]
	quest.7F6D03E293F00049.quest_desc: [
		"The &6Storage Monitor&r displays the count of a specific item from the network and emits redstone when above/below a threshold."
		""
		"&aTrigger autocrafting when stocks dip, or build a wall of monitors as a glanceable inventory dashboard.&r"
	]
	reward_table.FFFFFFFFFFFFFFFF.title: "Internal"
	task.4256010000070106.title: "Hold a Drone Port (paired with Cross-Dimensional addon)"
	task.4256010000070108.title: "Cloak Augment researched (hold the Arcane Research Station)"
	task.4256010000070109.title: "Portal Augment researched (hold the Arcane Research Station)"
}
