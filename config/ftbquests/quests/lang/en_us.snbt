	chapter.6A3FC7739C2D8A7B.title: "&5The Three Traditions&r"
	chapter.6D7E8F901A2B0501.title: "What Waits in the Grove"
	chapter.6F1A4D0C00000000.title: "&cThe Maledictus Vigil&r"
