		{
			id: "34000000000003C1"
			title: "Stone Hoe"
			subtitle: "Break ground and start farming."
			description: [
				"Craft a &bStone Hoe&r and till a patch of grass near water. Tilled soil is where every crop in this chapter starts, so pick a flat, lit spot you can fence off later."
				"Seeds drop from breaking tall grass. Get a small plot going before nightfall, because food runs short fast in the &dDark Ages&r."
			]
			rewards: [{
				count: 8
				id: "34000000000003C2"
				item: {
					count: 1
					id: "minecraft:wheat_seeds"
				}
